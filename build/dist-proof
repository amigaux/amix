#!/bin/sh
# dist-proof: make dist twice, from two clean clones of one commit at two
# different paths, and the two locks compared.
#
# MIT licence, see LICENSE at the top of the repository.
#
#     sh build/dist-proof WORKDIR [COMMIT]
#
# COMMIT (default this checkout's HEAD) is cloned from this checkout into
# WORKDIR/a/amix and WORKDIR/elsewhere/a/much/longer/path/b/amix, and each
# clone runs every make dist step in order, each its own `build/dist.sh
# <step>`, with SYSTEM (or AMIX_SYSTEM), AMIX_IMAGE, AMIX_DISTFILES and LOCK
# passed on: with LOCK=<lock of record>, each run's lock step also refuses a
# lock that differs from it. Only media, while an input it takes by sha256 is not
# to be had, may be a known gap (exit 3 with a [MISSING] line): the run goes on and the summary names it as not
# compared. A gap in any other step stops the proof, since two runs that both
# lost a step would end with locks alike; so does any other failure, an exit 3
# that says nothing included. Each step's log is WORKDIR/<run>/step-<step>.log,
# and WORKDIR/summary says what each step did. Exit 0 when both runs end
# with the same lock, 1 when a step failed or the locks differ, 2 usage.
#
# Two paths on one filesystem list a directory in one order, so a build that
# depends on that order passes unseen. ELSEWHERE=<empty directory on another
# filesystem> puts the second clone there. Without it the summary says the
# order was not compared. Either way both runs are on one machine, which the
# summary names; the proof says nothing about any other.
set -u

here=$(cd "$(dirname "$0")" && pwd)
top=$(dirname "$here")
work=${1:-}
[ -n "$work" ] && [ $# -le 2 ] || { sed -n '/^#     sh/p' "$0" | sed 's/^# *//' >&2; exit 2; }
commit=$(git -C "$top" rev-parse --verify "${2:-HEAD}^{commit}") || exit 2
sys=${SYSTEM:-${AMIX_SYSTEM:-}}
[ -n "$sys" ] && [ -d "$sys" ] || { echo "dist-proof: SYSTEM=<amix-system checkout> (system/fetch-amix-system makes one)" >&2; exit 2; }
sys=$(cd "$sys" && pwd)
[ ! -e "$work" ] || [ -z "$(ls -A "$work")" ] || { echo "dist-proof: $work is not empty" >&2; exit 2; }
mkdir -p "$work"
work=$(cd "$work" && pwd)
b=$work/elsewhere/a/much/longer/path/b
order="both clones on one filesystem: directory order not compared"
if [ -n "${ELSEWHERE:-}" ]; then
	[ -d "$ELSEWHERE" ] && [ -z "$(ls -A "$ELSEWHERE")" ] || { echo "dist-proof: ELSEWHERE=$ELSEWHERE is not an empty directory" >&2; exit 2; }
	ELSEWHERE=$(cd "$ELSEWHERE" && pwd)
	[ "$(stat -c %d "$ELSEWHERE")" != "$(stat -c %d "$work")" ] || { echo "dist-proof: ELSEWHERE=$ELSEWHERE is on $work's filesystem" >&2; exit 2; }
	b=$ELSEWHERE/a/much/longer/path/b
	order="the clones on two filesystems: directory order compared"
fi
STEPS="kit kernel-k30 kernel-k46 modules drivers kspace userland apkg catalogs release media lock"

one() {	# one <step> <dir>: the step in <dir>/amix, its log in <dir>
	( cd "$2/amix" && SYSTEM=$sys sh build/dist.sh "$1" ) >> "$2/step-$1.log" 2>&1
}

run() {	# run <name> <dir>: one make dist in <dir>/amix, its logs in <dir>
	git clone -q --no-local "$top" "$2/amix" &&
		git -C "$2/amix" -c advice.detachedHead=false checkout -q "$commit" || return 1
	echo "$1: amix $commit at $2/amix, on $(stat -f -c %T "$2")" >> "$work/summary"
	start=$(date +%s)
	for s in $STEPS; do
		rc=0
		if [ "$s" = lock ]; then
			# --check writes no lock: this run's own first, then the check
			( unset LOCK; one lock "$2" ) || rc=$?
			[ "$rc" -ne 0 ] || [ -z "${LOCK:-}" ] || one lock "$2" || rc=$?
		else
			one "$s" "$2" || rc=$?
		fi
		n=$(grep -c '^\[MISSING\]' "$2/step-$s.log")
		case $rc:$n in
		0:*) what=ok ;;
		3:0) what="FAILED, exit 3 with no [MISSING] line"; rc=1 ;;
		3:*)
			if [ "$s" = media ]; then
				what="known gap: $n [MISSING]"; gaps="$gaps $1/$s"
			else
				what="FAILED, a gap in a step make dist has: $(grep -m1 '^\[MISSING\]' "$2/step-$s.log")"; rc=1
			fi ;;
		*) what="FAILED, exit $rc" ;;
		esac
		echo "$1: $s $what ($(($(date +%s) - start)) s)" >> "$work/summary"
		case $rc in 0|3) ;; *) tail -20 "$2/step-$s.log" >&2; return 1 ;; esac
	done
	[ -s "$2/amix/out/lock" ] || { echo "$1: no out/lock" >> "$work/summary"; return 1; }
}

cpu=$(sed -n 's/^model name[^:]*: //p' /proc/cpuinfo 2>/dev/null | head -1)
echo "machine: ${cpu:-CPU model unknown}, $(nproc) CPUs" > "$work/summary"
a=$work/a
gaps=
mkdir -p "$a" "$b"
run a "$a" && run b "$b" || { cat "$work/summary"; echo "dist-proof: a run failed" >&2; exit 1; }
if cmp -s "$a/amix/out/lock" "$b/amix/out/lock"; then
	echo "the two locks are identical: $(wc -l < "$a/amix/out/lock" | tr -d ' ') lines, sha256 $(sha256sum < "$a/amix/out/lock" | cut -c1-64)" >> "$work/summary"
	echo "$order" >> "$work/summary"
	[ -z "$gaps" ] || echo "not compared, known gaps:$gaps" >> "$work/summary"
	cat "$work/summary"
	exit 0
fi
echo "the two locks differ ($order):" >> "$work/summary"
diff "$a/amix/out/lock" "$b/amix/out/lock" >> "$work/summary"
cat "$work/summary"
exit 1
