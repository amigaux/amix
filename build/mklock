# Python 3 standard library only.
"""Write, or check, the lock of a make dist build.

  mklock TOP OUT [--check LOCK]

The lock (release/README.md) names every input and output of the build in
OUT, one line each, in fixed sections whose lines are sorted, so one build
has one lock. It is written to OUT/lock. With --check, the lock of OUT is
compared with LOCK instead, and every differing line is printed: a rebuild
that differs from the lock of record is refused. A build with no output, or a
step's output directory that holds nothing, is refused either way: a lock of
it would pass with nothing looked at.

Exit status: 0 written or equal, 1 refused, 2 usage.
"""

import hashlib
import os
import re
import subprocess
import sys

FORMAT = "#amix-lock 1"


class LockError(Exception):
    pass

# What the proof does not compare byte for byte, and why.
EXCEPTIONS = (
    "exception kit-revision-lines kit.conf and NOTICE name the amix and port commits;"
    " the kit's norev digest is compared across commits",
    "exception installed-images the disk and SD images are bench-built and proven by"
    " their contents",
)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as fp:
        for block in iter(lambda: fp.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def git(top, *args):
    return subprocess.run(["git", "-C", top] + list(args), stdout=subprocess.PIPE,
                          stderr=subprocess.DEVNULL, check=True).stdout.decode().strip()


def files(root):
    """Every regular file under ROOT, relative, sorted."""
    out = []
    for r, dirs, fs in os.walk(root):
        dirs.sort()
        for f in fs:
            p = os.path.join(r, f)
            if os.path.isfile(p) and not os.path.islink(p):
                out.append(os.path.relpath(p, root))
    return sorted(out)


def older_files(catalog):
    """The file of each row in a release catalog's block of older versions."""
    found = []
    with open(catalog, errors="replace") as fp:
        for line in fp:
            if not line.startswith("#old "):
                continue
            row = line[5:].strip()
            if row.startswith("#kpkg "):
                m = re.search(r"\bfile=(\S+)", row)
                if not m:
                    raise LockError("%s: an older #kpkg row that names no file" % catalog)
                found.append(m.group(1))
            elif not row.startswith("#"):
                found.append(row.split("|")[3])
    return found


def check_carried(top, out, rel):
    """A release tree's older versions are release/carried-REL's, byte for byte,
    both ways: a tree built with no published tree has none, and is not checked;
    one built on a published tree has them."""
    tree = os.path.join(out, "release", rel)
    older = older_files(os.path.join(tree, "catalog"))
    if not older:
        if os.path.isfile(os.path.join(out, "build", "release-previous")):
            raise LockError("release/%s was built on a published tree and keeps no older version" % rel)
        return
    table = {}
    path = os.path.join(top, "release", "carried-" + rel)
    if os.path.isfile(path):
        with open(path) as fp:
            for line in fp:
                f = line.split()
                if f and not line.startswith("#"):
                    table[f[0]] = f[1]
    for name in older:
        if name not in table:
            raise LockError("%s: an older version not in release/carried-%s" % (name, rel))
        if sha256(os.path.join(tree, "pkgs", name)) != table[name]:
            raise LockError("%s: not the bytes release/carried-%s names" % (name, rel))
    for name in sorted(set(table) - set(older)):
        raise LockError("%s: release/carried-%s names it, and the tree does not have it" % (name, rel))


def lock(top, out):
    """The lock's lines, in order."""
    head = [FORMAT, "amix %s" % git(top, "rev-parse", "HEAD"),
            "epoch package-version (SOURCE_EPOCH, else the package directory's last commit)"]
    tree = git(top, "status", "--porcelain", "--untracked-files=no")
    if tree:
        head.append("dirty %s" % hashlib.sha256(tree.encode()).hexdigest())
    image = "/opt/amix/TOOLCHAIN.sha256"
    head.append("image %s" % (sha256(image) if os.path.isfile(image) else "host"))
    # the media image's tools: the image line cannot see them
    tools = os.path.join(out, "build", "media-tools")
    if os.path.isfile(tools):
        head.append("media-tools %s" % sha256(tools))
    # the published tree the release was built on
    previous = os.path.join(out, "build", "release-previous")
    if os.path.isfile(previous):
        with open(previous) as fp:
            head.append("previous %s" % fp.read().strip())
    sections = []
    # inputs: every pin and distfile pin, and the system input's manifest
    pins = []
    for rel in git(top, "ls-files", "*.pin", "*.distfile").splitlines():
        if rel.endswith(".pin") or rel.endswith(".distfile"):
            with open(os.path.join(top, rel)) as fp:
                text = fp.read()
            kind = "pin" if rel.endswith(".pin") else "distfile"
            f = text.split()
            if len(text.splitlines()) == 1 and len(f) == 2 and f[0].startswith("https://"):
                pins.append("%s %s %s %s" % (kind, rel, f[0], f[1]))
            elif kind == "distfile" and len(text.splitlines()) == 1 and len(f) >= 2:
                # the original site, the sha256, then the fallbacks: as written
                pins.append("%s %s %s" % (kind, rel, " ".join(f)))
            else:   # a pin of another format (kernel/dlm's): the file's digest
                pins.append("%s %s sha256 %s" % (kind, rel, sha256(os.path.join(top, rel))))
    sections.append(sorted(pins))
    sections.append(["system %s %s" % (rel, sha256(os.path.join(top, rel)))
                     for rel in ("system/MANIFEST.sha256", "system/SYMLINKS", "system/stock-1.1.assets",
                                 "release/carried-1.1")
                     if os.path.isfile(os.path.join(top, rel))])
    # outputs
    digests = os.path.join(out, "kit", "kit.digests")
    if os.path.isfile(digests):
        with open(digests) as fp:
            sections.append(sorted(l.rstrip("\n") for l in fp if l.strip()))
    kernels = os.path.join(out, "kernels")
    if os.path.isdir(kernels):
        lines = []
        for rel in files(kernels):
            if rel.endswith(".list"):
                with open(os.path.join(kernels, rel)) as fp:
                    lines += [l.rstrip("\n") for l in fp if l.startswith("kernel ")]
        if not lines:
            raise LockError("%s names no kernel" % kernels)
        sections.append(sorted(lines))
    mods = os.path.join(out, "modules")
    if os.path.isdir(mods):
        if not files(mods):
            raise LockError("%s holds nothing" % mods)
        sections.append(["module %s %s" % (rel, sha256(os.path.join(mods, rel)))
                         for rel in files(mods)])
    # each space: its datastreams (pkgs/, or the directory itself for apkg)
    # and its catalog; a release tree's datastreams in their subdirectories
    spaces = [(s, os.path.join(out, s), os.path.join(out, s, "pkgs")) for s in ("kspace", "userland")]
    spaces.append(("apkg", os.path.join(out, "apkg"), os.path.join(out, "apkg")))
    rels = os.path.join(out, "release")
    if os.path.isdir(rels):
        for r in sorted(os.listdir(rels)):
            if r.endswith(".tmp") or not os.path.isdir(os.path.join(rels, r)):
                continue
            if not os.path.isfile(os.path.join(rels, r, "catalog")):
                raise LockError("release/%s has no catalog" % r)
            check_carried(top, out, r)
        spaces += [("release/" + r, os.path.join(rels, r), os.path.join(rels, r, "pkgs"))
                   for r in sorted(os.listdir(rels))
                   if os.path.isdir(os.path.join(rels, r)) and not r.endswith(".tmp")]
    built = len(sections[-1]) if os.path.isdir(mods) else 0
    if os.path.isdir(kernels) or os.path.isfile(digests):
        built += 1
    for space, d, pkgs in spaces:
        lines = []
        if os.path.isdir(pkgs):
            lines += ["pkg %s %s %d %s" % (space, rel, os.path.getsize(os.path.join(pkgs, rel)),
                                           sha256(os.path.join(pkgs, rel)))
                      for rel in files(pkgs) if rel.endswith(".pkg")]
        beside = os.path.join(d, "beside")
        if os.path.isdir(beside):
            lines += ["beside %s %s %d %s" % (space, rel, os.path.getsize(os.path.join(beside, rel)),
                                              sha256(os.path.join(beside, rel)))
                      for rel in files(beside)]
        cat = os.path.join(d, "catalog")
        if os.path.isfile(cat):
            with open(cat, "rb") as fp:
                md5 = hashlib.md5(fp.read()).hexdigest()
            try:
                with open(os.path.join(d, "catalog.md5")) as fp:
                    said = fp.read().split()[:1]
            except FileNotFoundError:
                said = []
            if said != [md5]:
                raise LockError("%s/catalog.md5 does not say the catalog's md5 %s" % (space, md5))
            lines.append("catalog %s md5 %s sha256 %s" % (space, md5, sha256(cat)))
        if os.path.isdir(d) and not lines:
            raise LockError("%s holds no package and no catalog" % d)
        built += len(lines)
        sections.append(sorted(lines))
    media = os.path.join(out, "media")
    if os.path.isdir(media):
        sections.append(["media %s %d %s" % (rel, os.path.getsize(os.path.join(media, rel)),
                                             sha256(os.path.join(media, rel)))
                         for rel in files(media)])
    if not built:
        raise LockError("%s holds no output of make dist: nothing to lock" % out)
    sections.append(list(EXCEPTIONS))
    return head + [l for s in sections for l in s]


def main(argv):
    if len(argv) not in (2, 4) or (len(argv) == 4 and argv[2] != "--check"):
        sys.stderr.write(__doc__)
        return 2
    top, out = os.path.abspath(argv[0]), os.path.abspath(argv[1])
    lines = lock(top, out)
    if len(argv) == 4:
        with open(argv[3]) as fp:
            want = fp.read().splitlines()
        if want[:1] != [FORMAT]:
            sys.stderr.write("[FAIL] mklock: %s is not an %s file\n" % (argv[3], FORMAT))
            return 1
        gone = [l for l in want if l not in lines]
        new = [l for l in lines if l not in want]
        if gone or new:
            sys.stderr.write("[FAIL] mklock: this build is not the lock %s:\n" % argv[3])
            for l in gone:
                sys.stderr.write("  - %s\n" % l)
            for l in new:
                sys.stderr.write("  + %s\n" % l)
            return 1
        if want != lines:
            sys.stderr.write("[FAIL] mklock: %s holds this build's lines, not in this build's order\n" % argv[3])
            return 1
        print("mklock: this build is the lock %s (%d lines)" % (argv[3], len(lines)))
        return 0
    os.makedirs(out, exist_ok=True)
    with open(os.path.join(out, "lock.new"), "w") as fp:
        fp.write("\n".join(lines) + "\n")
    os.replace(os.path.join(out, "lock.new"), os.path.join(out, "lock"))
    print("mklock: %s, %d lines" % (os.path.join(out, "lock"), len(lines)))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, subprocess.CalledProcessError, LockError) as e:
        sys.stderr.write("[FAIL] mklock: %s\n" % e)
        sys.exit(1)
