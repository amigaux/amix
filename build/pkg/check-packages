#!/bin/sh
# check-packages: CI's check of the packages directories.
#
# MIT licence, see LICENSE at the top of the repository.
#
#     sh build/pkg/check-packages [<packages dir>...]
#
# The default directories are userland/packages and userland/base/pkg, one
# catalog. Every package.sh passes pkgmeta check, one version each over all
# of them, and the generated files of the first directory are current:
# INDEX.md (pkgmeta index) and the catalog fragments in conf/ (pkgmeta
# fragments). Without arguments, the kernel-space recipes' prototypes under
# kernel/ pass pkgmeta dirs too: every shared directory (/opt, /opt/amix and
# its doc and man directories) is 0755 root sys in every package. A directory
# that does not exist is skipped. Nothing to check,
# and exit 0, while none of them holds a package.sh.
set -e

here=$(cd "$(dirname "$0")" && pwd)
top=$(cd "$here/../.." && pwd)
kspace=
[ $# -gt 0 ] || { set -- "$top/userland/packages" "$top/userland/base/pkg"; kspace=$top/kernel; }
out=$1
pkgmeta() { python3 -I "$here/pkgmeta" "$@"; }

for r; do
	shift
	[ -d "$r" ] && set -- "$@" "$r"
done
any=
for r; do
	for p in "$r"/*/package.sh; do
		[ -f "$p" ] && any=1
	done
done
[ -n "$any" ] || {
	echo "check-packages: no package.sh under $out or the other directories yet; nothing to check"
	exit 0
}
pkgmeta check "$@"
[ -z "$kspace" ] || [ ! -d "$kspace" ] || pkgmeta dirs "$kspace"
pkgmeta index "$@" -o "$out/INDEX.md" --check
pkgmeta fragments "$@" -o "$out/conf" --check
