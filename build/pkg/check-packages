#!/bin/sh
# check-packages: CI's check of the packages directories.
#
# MIT licence, see LICENSE at the top of the repository.
#
#     sh build/pkg/check-packages [<packages dir>...]
#
# The default directories are userland/packages and userland/base/pkg, one
# catalog. Every package.sh passes pkgmeta check, one version each over all
# of them (both variants, in BUILD_DEPENDS order), and the
# generated files of the first directory are current: INDEX.md (pkgmeta
# index) and the catalog fragments in conf/ (pkgmeta fragments, the shared
# variant's). Without arguments, the kernel-space recipes' prototypes under
# kernel/ pass pkgmeta dirs too: every shared directory (/opt, /opt/amix and
# its doc and man directories) is 0755 root sys in every package. A directory
# that does not exist, or no package.sh in any of them, is a failure: nothing
# was checked.
#
# A published version's epoch (pkgmeta epochs): a recipe whose version
# release/'s locks or carried-* lists name is refused unless package.sh sets
# SOURCE_EPOCH or its directory's last commit set that version, since a later
# commit moves the epoch and a rebuild is no longer the published bytes. It
# reads the git history, so a shallow clone is refused (CI fetches it whole).
# Checked without arguments, or against CHECK_PACKAGES_RELEASE=<release dir>.
set -e

here=$(cd "$(dirname "$0")" && pwd)
top=$(cd "$here/../.." && pwd)
kspace=
release=${CHECK_PACKAGES_RELEASE:-}
[ $# -gt 0 ] || { set -- "$top/userland/packages" "$top/userland/base/pkg"; kspace=$top/kernel; release=${release:-$top/release}; }
out=$1
pkgmeta() { python3 -I "$here/pkgmeta" "$@"; }

for r; do
	[ -d "$r" ] || { echo "check-packages: no directory $r" >&2; exit 1; }
done
any=
for r; do
	for p in "$r"/*/package.sh; do
		[ -f "$p" ] && any=1
	done
done
[ -n "$any" ] || {
	echo "check-packages: no package.sh under $out or the other directories: nothing was checked" >&2
	exit 1
}
pkgmeta check "$@"
# both variants' build orders: their BUILD_DEPENDS name packages, with no
# cycle, and one version each
pkgmeta build-order --variant shared "$@" >/dev/null
pkgmeta build-order --variant static "$@" >/dev/null
[ -z "$kspace" ] || pkgmeta dirs "$kspace"
pkgmeta index "$@" -o "$out/INDEX.md" --check
pkgmeta fragments "$@" -o "$out/conf" --check
[ -z "$release" ] || pkgmeta epochs "$@" --release "$release"
