#!/usr/bin/env python3
# test-pkgmeta: host test for build/pkg/pkgmeta.
#
# MIT licence, see LICENSE at the top of the repository.
# The recipes under recipes/ are copies of amix-packages' package.sh files;
# expect/ holds what the interim driver and gen-catalog.py made from them
# (see README.md here). pkgmeta must give the same bytes. The rest plants
# one fault per check in a temporary tree and expects a refusal, next to a
# clean control. Prints "N/N passed"; exits non-zero on any failure.

import os
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
PKGMETA = os.path.join(os.path.dirname(HERE), "pkgmeta")
RECIPES = os.path.join(HERE, "recipes")
EXPECT = os.path.join(HERE, "expect")
NAMES = ("diffutils", "bzip2", "coreutils")

passed = failed = 0


def run(*args):
    p = subprocess.run([sys.executable, "-I", PKGMETA] + list(args),
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return p.returncode, p.stdout.decode(), p.stderr.decode()


def check(what, ok, detail=""):
    global passed, failed
    if ok:
        passed += 1
    else:
        failed += 1
        print("FAIL %s%s" % (what, ("\n    " + detail.strip().replace(
            "\n", "\n    ")) if detail else ""))


def refused(what, args, needle):
    rc, out, err = run(*args)
    check(what, rc == 1 and needle in err,
          "rc %d, stderr: %s" % (rc, err or "(none)"))


def read(path):
    with open(path) as fp:
        return fp.read()


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fp:
        fp.write(text)


def recipe(root, name, **over):
    """A copy of the diffutils recipe as NAME, with keys replaced."""
    lines = []
    for line in read(os.path.join(RECIPES, "diffutils", "package.sh")).splitlines():
        key = line.split("=", 1)[0]
        if key == "NAME":
            line = "NAME=%s" % name
        if key in over:
            line = "%s=%s" % (key, over.pop(key))
        lines.append(line)
    lines += ["%s=%s" % kv for kv in over.items()]
    write(os.path.join(root, name, "package.sh"), "\n".join(lines) + "\n")
    return os.path.join(root, name)


def newc(name, data):
    name = name.encode() + b"\0"
    hdr = b"070701" + b"".join(b"%08X" % v for v in (
        1, 0o100644, 0, 0, 1, 0, len(data), 0, 0, 0, 0, len(name), 0))
    pad = lambda n: b"\0" * (-n % 4)
    return hdr + name + pad(len(hdr) + len(name)) + data + pad(len(data))


def datastream(pkg, version):
    head = b"# PaCkAgE DaTaStReAm\n%s 1 8\n# end of header\n" % pkg.encode()
    head += b"\0" * (-len(head) % 512)
    info = ("PKG=%s\nNAME=x\nVERSION=%s\n" % (pkg, version)).encode()
    return head + newc(pkg + "/pkginfo", info) + newc("TRAILER!!!", b"")


# --- the interim driver's bytes ------------------------------------------------

for n in NAMES:
    rc, out, err = run("pkginfo", os.path.join(RECIPES, n))
    want = read(os.path.join(EXPECT, n + ".pkginfo"))
    check("pkginfo %s equals the interim driver's" % n, rc == 0 and out == want,
          err or "got:\n%s\nwant:\n%s" % (out, want))

lines = [l for l in read(os.path.join(EXPECT, "catalog")).splitlines(True)
         if not l.startswith("#")]
for want in lines:
    f = want.split("|")
    rc, out, err = run("catalog", os.path.join(RECIPES, f[0]), "--filename",
                       f[3], "--md5", f[4], "--size", f[5])
    check("catalog line %s equals gen-catalog.py's" % f[0],
          rc == 0 and out == want, err or "got:  %swant: %s" % (out, want))
check("catalog lines for all three", len(lines) == len(NAMES))

rc, out, err = run("check", RECIPES)
check("check passes the fixture recipes", rc == 0, err)
for n in NAMES:
    rc, out, err = run("check", os.path.join(RECIPES, n))
    check("check passes %s alone" % n, rc == 0, err)

rc, out, err = run("fragments", RECIPES)
want = ("==> names.conf <==\n# Generated by build/pkg/pkgmeta from package.sh; do not edit.\n"
        "coreutil: coreutils\ndiffutil: diffutils\n"
        "==> cats.conf <==\n# Generated by build/pkg/pkgmeta from package.sh; do not edit.\n"
        "bzip2: archive\ncoreutils: utility\ndiffutils: utility\n"
        "==> deps.conf <==\n# Generated by build/pkg/pkgmeta from package.sh; do not edit.\n"
        "==> sets.conf <==\n# Generated by build/pkg/pkgmeta from package.sh; do not edit.\n"
        "extra: bzip2,coreutils,diffutils\n")
check("fragments of the fixture recipes", rc == 0 and out == want,
      err or "got:\n%s" % out)

rc, out, err = run("index", RECIPES)
check("index lists the three", rc == 0 and out.count("\n| [") == 3
      and "| [diffutils](diffutils/) | 2.8.1-2 | `diffutil` | utility |" in out,
      err or out)

tmp = tempfile.mkdtemp(prefix="test-pkgmeta.")
try:
    # --- package.sh checks -------------------------------------------------------
    root = os.path.join(tmp, "faults")
    for name, over, needle in (
            ("badcat", {"CATEGORY": "emacs"}, "CATEGORY=emacs is not one of"),
            ("longpkg", {"PKG": "abcdefghij"}, "over 9 characters"),
            ("badset", {"SET": '"extra core"'}, "unknown set 'core'"),
            ("badstyle", {"STYLE": "cmake"}, "STYLE=cmake"),
            ("badtc", {"TOOLCHAIN": "gcc2"}, "TOOLCHAIN=gcc2"),
            ("nosum", {"SUMMARY": '""'}, "SUMMARY is not set"),
            ("pipe", {"SUMMARY": '"a|b"'}, "SUMMARY holds '|'"),
            ("twoline", {"DESC": '"one\ntwo"'}, "DESC must be one line"),
            ("badrev", {"PKGREV": "2a"}, "PKGREV=2a is not a number"),
            ("baddep", {"DEPENDS": '"zlib b@d"'}, "'b@d' is not a package name")):
        refused("check refuses %s" % name, ("check", recipe(root, name, **over)),
                needle)
    r = recipe(root, "elsewhere")
    os.rename(r, os.path.join(root, "moved"))
    refused("check refuses NAME other than the directory",
            ("check", os.path.join(root, "moved")), "is not the directory name")
    rc, out, err = run("check", recipe(os.path.join(tmp, "good"), "fine",
                                       PKG="fine", DEPENDS='"zlib acompat"'))
    check("check passes a clean recipe (control)", rc == 0, err)
    rc, out, err = run("catalog", os.path.join(tmp, "good", "fine"),
                       "--md5", "0" * 32, "--size", "1")
    check("DEPENDS reaches the catalog line as a comma list",
          rc == 0 and out.split("|")[6] == "zlib,acompat", err or out)

    # --- the one-version guard over recipes ------------------------------------------
    two = os.path.join(tmp, "two")
    recipe(two, "diffutils")
    recipe(two, "diffutils2", PKG="diffutil", VERSION="3.10")
    refused("guard refuses a second version of an instance in a recipe tree",
            ("check", two), "package instance diffutil has 2 versions")
    refused("fragments refuse it too", ("fragments", two), "has 2 versions")
    clash = os.path.join(tmp, "clash")
    recipe(clash, "grep", PKG="grep")
    recipe(clash, "ggrep", PKG="Grep")
    refused("guard refuses an instance that is another package's name",
            ("check", clash), "instance Grep")

    # --- the one-version guard over built output ---------------------------------------
    cat = os.path.join(tmp, "catalog")
    write(cat, read(os.path.join(EXPECT, "catalog")))
    rc, out, err = run("guard", cat)
    check("guard passes the catalog of the three (control)", rc == 0, err)
    write(cat, read(cat) + lines[2].replace("2.8.1-2", "2.8.1-3"))
    refused("guard refuses a catalog with a second version of a name",
            ("guard", cat), "package name diffutils has 2 versions")
    write(cat, read(os.path.join(EXPECT, "catalog")) + lines[2])
    rc, out, err = run("guard", cat)
    check("guard passes one version listed twice", rc == 0, err)
    kcat = os.path.join(tmp, "kcatalog")
    write(kcat, "#apkg-catalog 1\n#ext kpkg 1\n"
          "#kpkg monsw 1.0.0-2 role=module pkginst=monsw30 size=1 sha256=0\n"
          "#kpkg monsw 1.0.0-3 role=module pkginst=monsw30 size=1 sha256=0\n"
          "#end kpkg\n")
    refused("guard reads kernel-space rows", ("guard", kcat),
            "monsw has 2 versions")

    stage = os.path.join(tmp, "stage")
    os.makedirs(os.path.join(stage, "sub"))
    for f, pkg, v in (("diffutil-2.8.1-2.pkg", "diffutil", "2.8.1-2"),
                      ("bzip2-1.0.8-2.pkg", "bzip2", "1.0.8-2")):
        with open(os.path.join(stage, f), "wb") as fp:
            fp.write(datastream(pkg, v))
    rc, out, err = run("guard", stage)
    check("guard passes a staging tree with one version each (control)",
          rc == 0 and "2 package(s)" in out, err or out)
    with open(os.path.join(stage, "sub", "old.pkg"), "wb") as fp:
        fp.write(datastream("diffutil", "2.8.1-1"))
    refused("guard refuses a staging tree with a second version",
            ("guard", stage), "package instance diffutil has 2 versions")
    with open(os.path.join(stage, "sub", "old.pkg"), "wb") as fp:
        fp.write(b"not a package")
    refused("guard refuses a .pkg that is not a datastream", ("guard", stage),
            "not a package datastream")
finally:
    shutil.rmtree(tmp)

print("%d/%d passed" % (passed, passed + failed))
sys.exit(1 if failed else 0)
