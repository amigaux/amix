#!/usr/bin/env python3
# test-pkgmeta: host test for build/pkg/pkgmeta.
#
# MIT licence, see LICENSE at the top of the repository.
# The recipes under recipes/ are copies of amix-packages' package.sh files;
# expect/ holds what the interim driver and gen-catalog.py made from them
# (see README.md here). pkgmeta must give the same bytes. The rest plants
# one fault per check in a temporary tree and expects a refusal, next to a
# clean control. Prints "N/N passed"; exits non-zero on any failure.

import os
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
PKGMETA = os.path.join(os.path.dirname(HERE), "pkgmeta")
CHECK_PACKAGES = os.path.join(os.path.dirname(HERE), "check-packages")
RECIPES = os.path.join(HERE, "recipes")
EXPECT = os.path.join(HERE, "expect")
NAMES = ("diffutils", "bzip2", "coreutils")

passed = failed = 0


def run(*args):
    p = subprocess.run([sys.executable, "-I", PKGMETA] + list(args),
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return p.returncode, p.stdout.decode(), p.stderr.decode()


def check(what, ok, detail=""):
    global passed, failed
    if ok:
        passed += 1
    else:
        failed += 1
        print("FAIL %s%s" % (what, ("\n    " + detail.strip().replace(
            "\n", "\n    ")) if detail else ""))


def refused(what, args, needle):
    rc, out, err = run(*args)
    check(what, rc == 1 and needle in err,
          "rc %d, stderr: %s" % (rc, err or "(none)"))


def read(path):
    with open(path) as fp:
        return fp.read()


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fp:
        fp.write(text)


def recipe(root, name, **over):
    """A copy of the diffutils recipe as NAME, with keys replaced."""
    lines = []
    for line in read(os.path.join(RECIPES, "diffutils", "package.sh")).splitlines():
        key = line.split("=", 1)[0]
        if key == "NAME":
            line = "NAME=%s" % name
        if key in over:
            line = "%s=%s" % (key, over.pop(key))
        lines.append(line)
    lines += ["%s=%s" % kv for kv in over.items()]
    write(os.path.join(root, name, "package.sh"), "\n".join(lines) + "\n")
    return os.path.join(root, name)


def newc(name, data):
    name = name.encode() + b"\0"
    hdr = b"070701" + b"".join(b"%08X" % v for v in (
        1, 0o100644, 0, 0, 1, 0, len(data), 0, 0, 0, 0, len(name), 0))
    pad = lambda n: b"\0" * (-n % 4)
    return hdr + name + pad(len(hdr) + len(name)) + data + pad(len(data))


def datastream(pkg, version):
    head = b"# PaCkAgE DaTaStReAm\n%s 1 8\n# end of header\n" % pkg.encode()
    head += b"\0" * (-len(head) % 512)
    info = ("PKG=%s\nNAME=x\nVERSION=%s\n" % (pkg, version)).encode()
    return head + newc(pkg + "/pkginfo", info) + newc("TRAILER!!!", b"")


# --- the interim driver's bytes ------------------------------------------------

for n in NAMES:
    rc, out, err = run("pkginfo", os.path.join(RECIPES, n))
    want = read(os.path.join(EXPECT, n + ".pkginfo"))
    check("pkginfo %s equals the interim driver's" % n, rc == 0 and out == want,
          err or "got:\n%s\nwant:\n%s" % (out, want))

lines = [l for l in read(os.path.join(EXPECT, "catalog")).splitlines(True)
         if not l.startswith("#")]
for want in lines:
    f = want.split("|")
    rc, out, err = run("catalog", os.path.join(RECIPES, f[0]), "--filename",
                       f[3], "--md5", f[4], "--size", f[5])
    check("catalog line %s equals gen-catalog.py's" % f[0],
          rc == 0 and out == want, err or "got:  %swant: %s" % (out, want))
check("catalog lines for all three", len(lines) == len(NAMES))

rc, out, err = run("check", RECIPES)
check("check passes the fixture recipes", rc == 0, err)
for n in NAMES:
    rc, out, err = run("check", os.path.join(RECIPES, n))
    check("check passes %s alone" % n, rc == 0, err)

rc, out, err = run("fragments", RECIPES)
want = ("==> names.conf <==\n# Generated by build/pkg/pkgmeta from package.sh; do not edit.\n"
        "coreutil: coreutils\ndiffutil: diffutils\n"
        "==> cats.conf <==\n# Generated by build/pkg/pkgmeta from package.sh; do not edit.\n"
        "bzip2: archive\ncoreutils: utility\ndiffutils: utility\n"
        "==> deps.conf <==\n# Generated by build/pkg/pkgmeta from package.sh; do not edit.\n"
        "==> sets.conf <==\n# Generated by build/pkg/pkgmeta from package.sh; do not edit.\n"
        "extra: bzip2,coreutils,diffutils\n")
check("fragments of the fixture recipes", rc == 0 and out == want,
      err or "got:\n%s" % out)

rc, out, err = run("index", RECIPES, "-o", "-")
check("index lists the three", rc == 0 and out.count("\n| [") == 3
      and "| [diffutils](diffutils/) | 2.8.1-2 | `diffutil` | utility |" in out,
      err or out)

tmp = tempfile.mkdtemp(prefix="test-pkgmeta.")
try:
    # --- package.sh checks -------------------------------------------------------
    root = os.path.join(tmp, "faults")
    for name, over, needle in (
            ("badcat", {"CATEGORY": "emacs"}, "CATEGORY=emacs is not one of"),
            ("longpkg", {"PKG": "abcdefghij"}, "over 9 characters"),
            ("badset", {"SET": '"extra core"'}, "unknown set 'core'"),
            ("badstyle", {"STYLE": "cmake"}, "STYLE=cmake"),
            ("badtc", {"TOOLCHAIN": "gcc2"}, "TOOLCHAIN=gcc2"),
            ("nosum", {"SUMMARY": '""'}, "SUMMARY is not set"),
            ("pipe", {"SUMMARY": '"a|b"'}, "SUMMARY holds '|'"),
            ("twoline", {"DESC": '"one\ntwo"'}, "DESC must be one line"),
            ("apipe", {"APKG_DESC": '"a|b"'}, "APKG_DESC holds '|'"),
            ("atwoline", {"APKG_DESC": '"one\ntwo"'}, "APKG_DESC must be one line"),
            ("badrev", {"PKGREV": "2a"}, "PKGREV=2a is not a number"),
            ("baddep", {"DEPENDS": '"zlib b@d"'}, "'b@d' is not a package name")):
        refused("check refuses %s" % name, ("check", recipe(root, name, **over)),
                needle)
    r = recipe(root, "elsewhere")
    os.rename(r, os.path.join(root, "moved"))
    refused("check refuses NAME other than the directory",
            ("check", os.path.join(root, "moved")), "is not the directory name")
    rc, out, err = run("check", recipe(os.path.join(tmp, "good"), "fine",
                                       PKG="fine", DEPENDS='"zlib acompat"'))
    check("check passes a clean recipe (control)", rc == 0, err)
    rc, out, err = run("catalog", os.path.join(tmp, "good", "fine"),
                       "--md5", "0" * 32, "--size", "1")
    check("DEPENDS reaches the catalog line as a comma list",
          rc == 0 and out.split("|")[6] == "zlib,acompat", err or out)

    # --- CONFFILES and the prototype ----------------------------------------------
    PROTO = ("i pkginfo\n"
             "d none /etc 0755 root sys\n"
             "f none /etc/foo.conf 0644 root sys\n"
             "f none /opt/amix/bin/foo 0755 root bin\n"
             "f none /opt/amix/man/man1/foo.1 0644 root bin\n"
             "f none /opt/amix/man/man4/foo.conf.4 0644 root bin\n")

    def conf(where, name, proto=PROTO, **over):
        r = recipe(os.path.join(tmp, where), name, **over)
        write(os.path.join(r, "prototype"), proto)
        return r

    good = conf("conf", "cgood", CONFFILES='"/etc/foo.conf"')
    rc, out, err = run("check", good)
    check("CONFFILES: a listed f object under /etc passes, no man warning",
          rc == 0 and "warning" not in err, err)
    rc, out, err = run("pkginfo", good)
    check("CONFFILES: pkginfo says CLASSES=none conffile",
          rc == 0 and "\nCLASSES=none conffile\n" in out, err or out)
    rc, out, err = run("pkginfo", conf("conf", "cnone"))
    check("no CONFFILES: CLASSES=none", rc == 0 and "\nCLASSES=none\n" in out,
          err or out)
    e_proto = PROTO.replace("f none /etc/foo.conf", "e conffile /etc/foo.conf")
    rc, out, err = run("check", conf("conf", "cecls", e_proto, CONFFILES='"/etc/foo.conf"'))
    check("CONFFILES: a listed e object passes", rc == 0, err)
    for name, proto, over, needle in (
            ("cmiss", PROTO, {"CONFFILES": '"/etc/bar.conf"'},
             "/etc/bar.conf is not in the prototype"),
            ("cdir", PROTO, {"CONFFILES": '"/etc"'}, "is a 'd' object, not f or e"),
            ("cunlisted", e_proto, {}, "e /etc/foo.conf is not in CONFFILES"),
            ("cprefix", PROTO, {"CONFFILES": '"/opt/amix/bin/foo"'},
             "is under PREFIX=/opt/amix"),
            ("cusr", PROTO + "f none /usr/lib/foo.rc 0644 root sys\n",
             {"CONFFILES": '"/usr/lib/foo.rc"'}, "is not under /etc or /var"),
            ("crel", PROTO, {"CONFFILES": '"etc/foo.conf"'}, "is not an absolute path"),
            ("ctwice", PROTO, {"CONFFILES": '"/etc/foo.conf /etc/foo.conf"'},
             "lists /etc/foo.conf twice"),
            ("ctwoline", PROTO + "f none /etc/foo.conf 0600 root sys\n",
             {"CONFFILES": '"/etc/foo.conf"'}, "is on 2 lines")):
        refused("check refuses %s" % name,
                ("check", conf("cbad", name, proto, **over)), needle)
    r = recipe(os.path.join(tmp, "cnoproto"), "cnoproto", CONFFILES='"/etc/foo.conf"')
    refused("check refuses CONFFILES without a prototype", ("check", r),
            "no prototype to check it against")
    two = os.path.join(tmp, "ctwo")
    conf("ctwo", "cone", PKG="cone", CONFFILES='"/etc/foo.conf"')
    conf("ctwo", "ctwo", PKG="ctwo", CONFFILES='"/etc/foo.conf"')
    refused("check refuses one conffile listed by two packages", ("check", two),
            "is listed by cone and ctwo; a conffile has one owner")

    # --- run-level links ---------------------------------------------------------
    for link, ok in (("S20monsw", True), ("S69inet", True), ("S75syslogd", True),
                     ("S95display", True), ("S05kbnamelist", True),
                     ("S99zkbootset", True), ("K69inet", True),
                     ("S16firstboot", False), ("S40foo", False), ("S99foo", False),
                     ("S00foo", False), ("Sxxfoo", False)):
        proto = PROTO + "l none /etc/rc2.d/%s=/etc/init.d/foo\n" % link
        rc, out, err = run("check", conf("rc", "rc" + link.lower(), proto))
        check("rc link %s %s" % (link, "passes" if ok else "is refused"),
              (rc == 0) if ok else (rc == 1 and "/etc/rc2.d/" + link in err), err)
    refused("check refuses an object under /etc/rc.d",
            ("check", conf("rc", "rcd", PROTO + "f none /etc/rc.d/foo 0755 root sys\n")),
            "/etc/rc.d is not used")

    # --- man pages (a warning, not a refusal) ----------------------------------------
    rc, out, err = run("check", conf("man", "mnone", PROTO.replace(
        "f none /opt/amix/man/man1/foo.1 0644 root bin\n", "").replace(
        "f none /opt/amix/man/man4/foo.conf.4 0644 root bin\n", "")))
    check("man: a command and an /etc file without pages are warned about",
          rc == 0 and "warning: mnone: no man page for " in err
          and "/opt/amix/bin/foo" in err and "/etc/foo.conf" in err, err)
    rc, out, err = run("check", conf("man", "mlink", PROTO + "l none /opt/amix/bin/unfoo=/opt/amix/bin/foo\n"))
    check("man: a link to a documented command counts", rc == 0 and "warning" not in err, err)
    rc, out, err = run("check", conf("man", "mbrack", PROTO + "f none /opt/amix/bin/test 0755 root bin\n"
                                     "f none /opt/amix/bin/[ 0755 root bin\n"
                                     "f none /opt/amix/man/man1/test.1 0644 root bin\n"))
    check("man: [ is documented by test.1", rc == 0 and "warning" not in err, err)
    rc, out, err = run("check", conf("man", "mgz", PROTO.replace("foo.1 ", "foo.1.gz ")))
    check("man: a compressed page counts", rc == 0 and "warning" not in err, err)

    # --- APKG_DESC --------------------------------------------------------------------
    plain = recipe(os.path.join(tmp, "desc0"), "desc")
    rc, base, err = run("pkginfo", plain)
    withd = recipe(os.path.join(tmp, "desc1"), "desc",
                   APKG_DESC='"the catalog\'s own description"')
    rc, out, err = run("pkginfo", withd)
    want = base.replace("\nDESC=", "\nAPKG_DESC=the catalog's own description\nDESC=")
    check("APKG_DESC is written right after PSTAMP",
          rc == 0 and want != base and out == want
          and out.split("\n")[7].startswith("PSTAMP="), err or out)
    rc, out, err = run("catalog", withd, "--md5", "0" * 32, "--size", "1")
    check("APKG_DESC is the catalog description",
          rc == 0 and out.rstrip("\n").split("|")[8] == "the catalog's own description",
          err or out)

    # --- sources in the tree ---------------------------------------------------------
    tree = os.path.join(tmp, "tree")
    own = recipe(tree, "own", PKG="own", URL='""', SHA256='""')
    write(os.path.join(own, "src", "own.c"), "int main(void) { return 0; }\n")
    rc, out, err = run("check", own)
    check("check passes src/ without URL and SHA256", rc == 0, err)
    rc, out, err = run("check", recipe(tree, "reader", PKG="reader", URL='""',
                                       SHA256='""', SRCPKG="own"))
    check("check passes SRCPKG naming a package with src/", rc == 0, err)
    rc, out, err = run("check", tree)
    check("check passes the tree with both (control)", rc == 0, err)
    both = recipe(tree, "both", PKG="both")
    write(os.path.join(both, "src", "x.c"), "\n")
    refused("check refuses URL and src/ together", ("check", both),
            "URL is set, but the source is in the tree")
    refused("check refuses no URL and no src/",
            ("check", recipe(tmp, "nosrc", URL='""')), "URL is not set (and there is no src/)")
    refused("check refuses SRCPKG without that src/",
            ("check", recipe(tree, "lost", URL='""', SHA256='""', SRCPKG="nothere")),
            "SRCPKG=nothere: no ")
    refused("check refuses SRCPKG naming itself",
            ("check", recipe(tree, "self", URL='""', SHA256='""', SRCPKG="self")),
            "SRCPKG names the package itself")
    twice = recipe(tree, "twice", URL='""', SHA256='""', SRCPKG="own")
    write(os.path.join(twice, "src", "x.c"), "\n")
    refused("check refuses SRCPKG and a src/ of its own", ("check", twice),
            "SRCPKG is set and the package has a src/ of its own")
    refused("check refuses a SHA256 that is not one",
            ("check", recipe(tmp, "badsha", SHA256="abc")), "SHA256 is not 64")

    # --- generated files: INDEX.md and the fragments ---------------------------------
    gen = os.path.join(tmp, "gen")
    shutil.copytree(RECIPES, gen)
    write(os.path.join(gen, "README.md"), "# by hand\n")
    rc, out, err = run("index", gen)
    check("index writes INDEX.md", rc == 0 and read(os.path.join(gen, "INDEX.md"))
          == run("index", gen, "-o", "-")[1], err)
    check("index leaves the README alone",
          read(os.path.join(gen, "README.md")) == "# by hand\n")
    rc, out, err = run("index", gen, "-o", os.path.join(gen, "README.md"))
    check("index refuses to write a README.md",
          rc == 2 and read(os.path.join(gen, "README.md")) == "# by hand\n", err)
    rc, out, err = run("index", gen, "--check")
    check("index --check passes a current INDEX.md", rc == 0, err)
    conf = os.path.join(gen, "conf")
    rc, out, err = run("fragments", gen, "-o", conf)
    rc, out, err = run("fragments", gen, "-o", conf, "--check")
    check("fragments --check passes current fragments", rc == 0, err)
    refused("fragments --check refuses a missing directory",
            ("fragments", gen, "-o", os.path.join(gen, "none"), "--check"),
            "out of date")
    rc, out, err = run("fragments", gen, "--check")
    check("fragments --check needs -o", rc == 2, err)
    pkgsh = os.path.join(gen, "bzip2", "package.sh")
    write(pkgsh, read(pkgsh).replace("CATEGORY=archive", "CATEGORY=utility"))
    refused("index --check refuses a stale INDEX.md", ("index", gen, "--check"),
            "INDEX.md is out of date")
    refused("fragments --check names the stale file",
            ("fragments", gen, "-o", conf, "--check"), "cats.conf out of date")
    os.remove(os.path.join(gen, "INDEX.md"))
    refused("index --check refuses a missing INDEX.md", ("index", gen, "--check"),
            "INDEX.md is out of date")

    # --- check-packages: CI's check of userland/packages --------------------------------
    def check_packages(root):
        p = subprocess.run(["sh", CHECK_PACKAGES, root], stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT)
        return p.returncode, p.stdout.decode()

    empty = os.path.join(tmp, "empty")
    write(os.path.join(empty, "README.md"), "# no packages\n")
    rc, out = check_packages(empty)
    check("check-packages: nothing to check in a directory with no package.sh",
          rc == 0 and "nothing to check" in out, out)
    cp = os.path.join(tmp, "cp")
    shutil.copytree(RECIPES, cp)
    rc, out = check_packages(cp)
    check("check-packages refuses packages without INDEX.md and conf/",
          rc == 1 and "INDEX.md is out of date" in out, out)
    run("index", cp)
    run("fragments", cp, "-o", os.path.join(cp, "conf"))
    rc, out = check_packages(cp)
    check("check-packages passes current generated files",
          rc == 0 and "are current" in out, out)
    pkgsh = os.path.join(cp, "diffutils", "package.sh")
    write(pkgsh, read(pkgsh).replace("CATEGORY=utility", "CATEGORY=text"))
    rc, out = check_packages(cp)
    check("check-packages refuses after a package.sh change", rc == 1, out)

    # --- the one-version guard over recipes ------------------------------------------
    two = os.path.join(tmp, "two")
    recipe(two, "diffutils")
    recipe(two, "diffutils2", PKG="diffutil", VERSION="3.10")
    refused("guard refuses a second version of an instance in a recipe tree",
            ("check", two), "package instance diffutil has 2 versions")
    refused("fragments refuse it too", ("fragments", two), "has 2 versions")
    clash = os.path.join(tmp, "clash")
    recipe(clash, "grep", PKG="grep")
    recipe(clash, "ggrep", PKG="Grep")
    refused("guard refuses an instance that is another package's name",
            ("check", clash), "instance Grep")

    # --- the one-version guard over built output ---------------------------------------
    cat = os.path.join(tmp, "catalog")
    write(cat, read(os.path.join(EXPECT, "catalog")))
    rc, out, err = run("guard", cat)
    check("guard passes the catalog of the three (control)", rc == 0, err)
    write(cat, read(cat) + lines[2].replace("2.8.1-2", "2.8.1-3"))
    refused("guard refuses a catalog with a second version of a name",
            ("guard", cat), "package name diffutils has 2 versions")
    write(cat, read(os.path.join(EXPECT, "catalog")) + lines[2])
    rc, out, err = run("guard", cat)
    check("guard passes one version listed twice", rc == 0, err)
    kcat = os.path.join(tmp, "kcatalog")
    write(kcat, "#apkg-catalog 1\n#ext kpkg 1\n"
          "#kpkg monsw 1.0.0-2 role=module pkginst=monsw30 size=1 sha256=0\n"
          "#kpkg monsw 1.0.0-3 role=module pkginst=monsw30 size=1 sha256=0\n"
          "#end kpkg\n")
    refused("guard reads kernel-space rows", ("guard", kcat),
            "monsw has 2 versions")

    stage = os.path.join(tmp, "stage")
    os.makedirs(os.path.join(stage, "sub"))
    for f, pkg, v in (("diffutil-2.8.1-2.pkg", "diffutil", "2.8.1-2"),
                      ("bzip2-1.0.8-2.pkg", "bzip2", "1.0.8-2")):
        with open(os.path.join(stage, f), "wb") as fp:
            fp.write(datastream(pkg, v))
    rc, out, err = run("guard", stage)
    check("guard passes a staging tree with one version each (control)",
          rc == 0 and "2 package(s)" in out, err or out)
    with open(os.path.join(stage, "sub", "old.pkg"), "wb") as fp:
        fp.write(datastream("diffutil", "2.8.1-1"))
    refused("guard refuses a staging tree with a second version",
            ("guard", stage), "package instance diffutil has 2 versions")
    with open(os.path.join(stage, "sub", "old.pkg"), "wb") as fp:
        fp.write(b"not a package")
    refused("guard refuses a .pkg that is not a datastream", ("guard", stage),
            "not a package datastream")
finally:
    shutil.rmtree(tmp)

print("%d/%d passed" % (passed, passed + failed))
sys.exit(1 if failed else 0)
