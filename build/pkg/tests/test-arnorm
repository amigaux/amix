#!/usr/bin/env python3
# test-arnorm: host test for build/pkg/common/arnorm.py.
#
# MIT licence, see LICENSE at the top of the repository.
# Archives are made here with a build host's member headers (a time, a uid
# and gid, a mode from the umask); arnorm must give them the headers `ar D`
# writes and leave everything else as it was. Prints "N/N passed"; exits
# non-zero on any failure.

import os
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
ARNORM = os.path.join(os.path.dirname(HERE), "common", "arnorm.py")

passed = failed = 0


def check(what, ok, detail=""):
    global passed, failed
    if ok:
        passed += 1
    else:
        failed += 1
        print("FAIL %s%s" % (what, ("\n    " + detail.strip().replace(
            "\n", "\n    ")) if detail else ""))


def hdr(name, size, date=b"1793443915", uid=b"1000", gid=b"1000", mode=b"100664"):
    return (name.ljust(16) + date.ljust(12) + uid.ljust(6) + gid.ljust(6)
            + mode.ljust(8) + str(size).encode().ljust(10) + b"`\n")


def archive(date=b"1793443915", uid=b"1000", gid=b"1000", mode=b"100664"):
    symtab = b"\0\0\0\1\0\0\0\x44f\0"
    obj = b"ELF-ish!x"          # an odd size: padded to even
    return (b"!<arch>\n" + hdr(b"/", len(symtab), date, uid, gid, b"0") + symtab
            + hdr(b"a.o/", len(obj), date, uid, gid, mode) + obj + b"\n")


def run(d):
    p = subprocess.run([sys.executable, "-I", ARNORM, d], capture_output=True, text=True)
    return p.returncode, p.stdout + p.stderr


tmp = tempfile.mkdtemp(prefix="test-arnorm.")
try:
    lib = os.path.join(tmp, "opt", "amix", "lib")
    os.makedirs(lib)
    a = os.path.join(lib, "libx.a")
    with open(a, "wb") as fp:
        fp.write(archive())
    os.utime(a, (1793303717, 1793303717))
    with open(os.path.join(lib, "notes.txt"), "wb") as fp:
        fp.write(b"!<arch> is how a note may begin\n")
    rc, out = run(tmp)
    got = open(a, "rb").read()
    want = archive(date=b"0", uid=b"0", gid=b"0", mode=b"644")
    check("member headers as ar D writes them: date, uid, gid 0, mode 644",
          rc == 0 and got == want and "AR norm   opt/amix/lib/libx.a" in out, out)
    check("the symbol table keeps its mode, the length and data are kept",
          got[8 + 40:8 + 48].strip() == b"0" and len(got) == len(archive())
          and got.endswith(b"ELF-ish!x\n"))
    check("the file's time is kept", int(os.stat(a).st_mtime) == 1793303717)
    check("a file that only starts like a note is left alone",
          open(os.path.join(lib, "notes.txt"), "rb").read().startswith(b"!<arch> is"))
    rc, out = run(tmp)
    check("idempotent: a second run changes nothing", rc == 0 and "AR norm" not in out
          and open(a, "rb").read() == want, out)
    with open(a, "wb") as fp:
        fp.write(b"!<arch>\nnot a header at all, just bytes that go on and on and on and on")
    rc, out = run(tmp)
    check("an archive that does not parse is refused", rc == 1 and "is not an ar header" in out, out)
finally:
    shutil.rmtree(tmp)

print("%d/%d passed" % (passed, passed + failed))
sys.exit(1 if failed else 0)
