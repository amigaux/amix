#!/usr/bin/env python3
# test-dsnorm: host test for build/pkg/common/dsnorm.py, the check that a
# rolled datastream is normalised to the epoch.
#
# MIT licence, see LICENSE at the top of the repository.
# Datastreams are made here: one as the pkgtools engine writes it under
# SOURCE_DATE_EPOCH, which must pass, and that one with one fault each (a
# build host's inode, uid, device or time, an unsorted member, a mode other
# than pkgmap's, a pkgmap modtime), which must be refused and named. The
# file is never changed. Prints "N/N passed"; exits non-zero on any failure.

import os
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
DSNORM = os.path.join(os.path.dirname(HERE), "common", "dsnorm.py")
FIELDS = ("ino", "mode", "uid", "gid", "nlink", "mtime", "filesize",
          "devmajor", "devminor", "rdevmajor", "rdevminor", "namesize", "check")
EPOCH = 1793303717

passed = failed = 0


def check(what, ok, detail=""):
    global passed, failed
    if ok:
        passed += 1
    else:
        failed += 1
        print("FAIL %s%s" % (what, ("\n    " + detail.strip().replace(
            "\n", "\n    ")) if detail else ""))


def run(*args):
    p = subprocess.run([sys.executable, "-I", DSNORM] + list(args),
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return p.returncode, p.stdout.decode(), p.stderr.decode()


def member(name, data=b"", magic=b"070701", **f):
    v = dict(ino=0, mode=0o100644, uid=0, gid=0, nlink=1, mtime=EPOCH,
             filesize=len(data), devmajor=0, devminor=0, rdevmajor=0,
             rdevminor=0, namesize=len(name) + 1, check=0)
    v.update(f)
    hdr = magic + b"".join(b"%08X" % v[k] for k in FIELDS)
    nm = name.encode() + b"\0"
    pad = lambda n: b"\0" * (-n % 4)
    return hdr + nm + pad(len(hdr) + len(nm)) + data + pad(len(data))


def archive(*ms):
    a = b"".join(ms) + member("TRAILER!!!", ino=0, mtime=0)
    return a + b"\0" * (-len(a) % 512)


PKGMAP = (b": 1 8\n1 d none /opt 0755 root sys\n"
          b"1 f none /opt/a 0755 root bin 2 1 %d\n"
          b"1 f none /opt/b 0644 root bin 2 1 %d\n"
          b"1 i pkginfo 20 1 %d\n" % (EPOCH, EPOCH, EPOCH))


def stream(pkgmap=PKGMAP, a=b"a\n", over=None, order=None, magic=b"070701"):
    """The datastream the engine writes; OVER = {member: {field: value}}
    plants one fault, ORDER reorders the second archive's members."""
    over = over or {}
    head = b"# PaCkAgE DaTaStReAm\nrtest 1 8\n# end of header\n"
    head += b"\0" * (-len(head) % 512)
    info = b"PKG=rtest\nVERSION=1\n"
    m = lambda n, d=b"", **f: member(n, d, **dict(f, **over.get(n, {})))
    ctl = archive(m("rtest/pkginfo", info, ino=1), m("rtest/pkgmap", pkgmap, ino=2))
    body = [m("pkginfo", info, ino=1), m("pkgmap", pkgmap, ino=2),
            m("root", mode=0o40755, nlink=3, ino=3),
            m("root/opt", mode=0o40755, nlink=2, ino=4),
            m("root/opt/a", a, magic=magic, mode=0o100755, nlink=1, ino=5),
            m("root/opt/b", a, mode=0o100644, nlink=1, ino=6)]
    if order:
        body = [body[i] for i in order]
    return head + ctl + archive(*body)


tmp = tempfile.mkdtemp(prefix="test-dsnorm.")
try:
    f = os.path.join(tmp, "x.pkg")

    def verdict(data, *extra):
        with open(f, "wb") as fp:
            fp.write(data)
        rc, out, err = run("stream", f, str(EPOCH), *extra)
        return rc, out, err, open(f, "rb").read() == data

    rc, out, err, same = verdict(stream())
    check("a datastream as the engine writes it passes, unchanged",
          rc == 0 and "2 archive(s) normalised to the epoch" in out and same, err or out)
    rc, out, err, same = verdict(stream(over={"root/opt/b": {"ino": 5, "nlink": 2},
                                              "root/opt/a": {"nlink": 2}}))
    check("hard links sharing one ino pass", rc == 0, err or out)

    for what, data, needle in (
            ("a build host's ino", stream(over={"root/opt": {"ino": 33818153}}),
             "root/opt: ino 33818153, not 4"),
            ("the builder's uid", stream(over={"pkgmap": {"uid": 1000}}), "pkgmap: uid 1000, not 0"),
            ("the builder's gid", stream(over={"rtest/pkginfo": {"gid": 1000}}),
             "rtest/pkginfo: gid 1000, not 0"),
            ("a device number", stream(over={"root": {"devmajor": 259}}), "root: devmajor 259, not 0"),
            ("a wall-clock mtime", stream(over={"root/opt/a": {"mtime": EPOCH + 3}}),
             "root/opt/a: mtime %d, not %d" % (EPOCH + 3, EPOCH)),
            ("a directory's nlink from another filesystem", stream(over={"root/opt": {"nlink": 1}}),
             "root/opt: nlink 1, not 2"),
            ("a mode from the umask, not pkgmap's", stream(over={"root/opt/b": {"mode": 0o100664}}),
             "root/opt/b: mode 0664, pkgmap says 0644"),
            ("members in directory order", stream(order=[0, 1, 2, 3, 5, 4]),
             "members not in sorted order"),
            ("a pkgmap modtime that is not the epoch",
             stream(pkgmap=PKGMAP.replace(b"1 i pkginfo 20 1 %d" % EPOCH, b"1 i pkginfo 20 1 1793439106")),
             "modtime 1793439106, not %d" % EPOCH),
            ("a 070702 member", stream(magic=b"070702"), "not newc 070701")):
        rc, out, err, same = verdict(data)
        check("refused, and named, file unchanged: %s" % what,
              rc == 1 and needle in err and same, err or out)

    def ar(date):
        return (b"!<arch>\n" + b"a.o/".ljust(16) + date.ljust(12) + b"0".ljust(6)
                + b"0".ljust(6) + b"644".ljust(8) + b"2".ljust(10) + b"`\n" + b"x\n")
    rc, out, err, same = verdict(stream(a=ar(b"0")))
    check("a payload ar archive as ar D writes it passes", rc == 0, err or out)
    rc, out, err, same = verdict(stream(a=ar(b"1793443915")))
    check("refused, and named: a payload ar archive with a build time in its headers",
          rc == 1 and "root/opt/a: an ar archive whose member headers carry" in err, err or out)

    rc, out, err, same = verdict(b"not a package")
    check("not a datastream is refused", rc == 1 and "not a package datastream" in err, err)
    with open(f, "wb") as fp:
        fp.write(stream())
    rc, out, err = run("stream", f, "yesterday")
    check("an epoch that is not a number is refused", rc == 1, err)
    rc, out, err = run("stream", f, str(EPOCH + 1))
    check("the same stream against another epoch is refused",
          rc == 1 and "not %d" % (EPOCH + 1) in err, err)

    leak = stream(pkgmap=PKGMAP.replace(b"/opt/b", b"/home/b/w/b"))
    rc, out, err, same = verdict(leak, "--host", "/home/b/w")
    check("a build-host path in pkgmap is refused",
          rc == 1 and "control files" in err and "rtest/pkgmap holds /home/b/w" in err, err)
    leak = stream(a=b"built in /home/b/w/src/a.c\n")
    rc, out, err, same = verdict(leak, "--host", "/home/b/w")
    check("a build-host path in the payload is reported, not refused",
          rc == 0 and "payload root/opt/a holds the build-host path /home/b/w" in out, err or out)
    rc, out, err, same = verdict(leak, "--host", "/home/b/w", "--refuse-payload")
    check("with --refuse-payload (gcc14) it is refused",
          rc == 1 and "build-host paths in the payload" in err
          and "root/opt/a holds /home/b/w" in err, err)
    rc, out, err, same = verdict(stream(pkgmap=PKGMAP.replace(b"/opt/a", b"/usr/src/a"),
                                        a=b"/srcx/y\n"), "--host", "/src")
    check("/src is not found in /usr/src or /srcx", rc == 0 and "WARN" not in out, err or out)
finally:
    shutil.rmtree(tmp)

print("%d/%d passed" % (passed, passed + failed))
sys.exit(1 if failed else 0)
