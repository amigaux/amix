#!/usr/bin/env python3
# test-lock: host test of build/mklock, the lock of a make dist build.
#
# MIT licence, see LICENSE at the top of the repository.
# A throwaway checkout (pins of both formats, a distfile pin, the system
# manifest) and an out/ (kit digests, modules, packages, a catalog, media)
# are made here; the lock must name each, in its sections, sorted, the same
# every time, and --check must pass it and refuse any change. Prints "N/N
# passed"; exits non-zero on any failure.

import hashlib
import os
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
MKLOCK = os.path.join(os.path.dirname(HERE), "mklock")

passed = failed = 0


def check(what, ok, detail=""):
    global passed, failed
    if ok:
        passed += 1
    else:
        failed += 1
        print("FAIL %s%s" % (what, ("\n    " + detail.strip().replace(
            "\n", "\n    ")) if detail else ""))


def write(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "wb") as fp:
        fp.write(data if isinstance(data, bytes) else data.encode())


def sha(data):
    return hashlib.sha256(data if isinstance(data, bytes) else data.encode()).hexdigest()


def run(top, out, *extra):
    p = subprocess.run([sys.executable, "-I", MKLOCK, top, out] + list(extra),
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return p.returncode, p.stdout.decode(), p.stderr.decode()


def git(top, *args):
    subprocess.run(["git", "-C", top, "-c", "user.name=t", "-c", "user.email=t@example.invalid",
                    "-c", "commit.gpgsign=false"] + list(args), check=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


tmp = tempfile.mkdtemp(prefix="test-lock.")
try:
    top, out = os.path.join(tmp, "amix"), os.path.join(tmp, "amix", "out")
    write(os.path.join(top, "kernel/port/port.pin"),
          "https://github.com/amigaux/amix-040-060-port.git " + "a" * 40 + "\n")
    write(os.path.join(top, "toolchain/gcc14-cross-amix.pin"),
          "https://github.com/amigaux/gcc14-cross-amix.git " + "b" * 40 + "\n")
    keyed = "# a pin of another format\nurl https://example.invalid/x.git\ncommit " + "c" * 40 + "\n"
    write(os.path.join(top, "kernel/dlm/toolchain.pin"), keyed)
    write(os.path.join(top, "toolchain/x.distfile"),
          "https://github.com/amigaux/amix-distfiles/releases/download/x/x.tgz " + "d" * 64 + "\n")
    write(os.path.join(top, "toolchain/y.distfile"),
          "https://example.invalid/up/y.tgz " + "f" * 64 + " https://github.com/amigaux/amix-distfiles/releases/download/y-1/y.tgz\n")
    write(os.path.join(top, "system/MANIFEST.sha256"), "m\n")
    write(os.path.join(top, "system/SYMLINKS"), "s\n")
    write(os.path.join(top, "system/stock-1.1.assets"), "u\n")
    write(os.path.join(top, ".gitignore"), "/out/\n")
    subprocess.run(["git", "init", "-q", top], check=True)
    git(top, "add", ".")
    git(top, "commit", "-q", "-m", "t")
    head = subprocess.run(["git", "-C", top, "rev-parse", "HEAD"], stdout=subprocess.PIPE).stdout.decode().strip()
    write(os.path.join(out, "kit/kit.digests"),
          "kit k30 k30.1.3 %s %s KIT_REV=1 PORT_REV=-\nkit k46 k46.1.3 %s %s KIT_REV=1 PORT_REV=2\n"
          % ("1" * 64, "2" * 64, "3" * 64, "4" * 64))
    write(os.path.join(out, "kernels/k30.list"), "kernel k30 unix.brel %s\nkernel k30 kabi %s\n" % ("5" * 64, "6" * 64))
    write(os.path.join(out, "modules/k46/ramdisk"), "r46")
    write(os.path.join(out, "modules/k30/ramdisk"), "r30")
    write(os.path.join(out, "userland/pkgs/zlib-1.2.13-8.pkg"), "zlib")
    write(os.path.join(out, "userland/pkgs/amxbase-1.0-8.pkg"), "base")
    write(os.path.join(out, "userland/catalog"), "cat")
    write(os.path.join(out, "userland/catalog.md5"), hashlib.md5(b"cat").hexdigest() + "  catalog\n")
    write(os.path.join(out, "apkg/APKG-0.3.6.pkg"), "apkg")
    write(os.path.join(out, "apkg/names.conf"), "not a datastream")
    write(os.path.join(out, "release/1.1/catalog"), "rcat")
    write(os.path.join(out, "release/1.1/catalog.md5"), hashlib.md5(b"rcat").hexdigest() + "  catalog\n")
    write(os.path.join(out, "release/1.1/pkgs/zlib-1.2.13-8.pkg"), "zlib")
    write(os.path.join(out, "release/1.1/pkgs/stock/core-2.1.pkg"), "core")
    write(os.path.join(out, "release/1.1.tmp/catalog"), "a refused run's leftovers")
    write(os.path.join(out, "media/cd/amix.iso"), "iso")
    write(os.path.join(out, "build/userland/zlib.log"), "not in the lock")

    rc, o, e = run(top, out)
    lock = open(os.path.join(out, "lock")).read().splitlines() if rc == 0 else []
    check("written to out/lock", rc == 0 and bool(lock), e or o)
    check("the head: format, the commit, the epoch rule, no dirty line, image host",
          lock[:4] == ["#amix-lock 1", "amix %s" % head,
                       "epoch package-version (SOURCE_EPOCH, else the package directory's last commit)",
                       "image host"], "\n".join(lock[:5]))
    want = [
        "distfile toolchain/x.distfile https://github.com/amigaux/amix-distfiles/releases/download/x/x.tgz " + "d" * 64,
        "distfile toolchain/y.distfile https://example.invalid/up/y.tgz " + "f" * 64
        + " https://github.com/amigaux/amix-distfiles/releases/download/y-1/y.tgz",
        "pin kernel/dlm/toolchain.pin sha256 " + sha(keyed),
        "pin kernel/port/port.pin https://github.com/amigaux/amix-040-060-port.git " + "a" * 40,
        "pin toolchain/gcc14-cross-amix.pin https://github.com/amigaux/gcc14-cross-amix.git " + "b" * 40,
        "system system/MANIFEST.sha256 " + sha("m\n"),
        "system system/SYMLINKS " + sha("s\n"),
        "system system/stock-1.1.assets " + sha("u\n"),
        "kit k30 k30.1.3 %s %s KIT_REV=1 PORT_REV=-" % ("1" * 64, "2" * 64),
        "kit k46 k46.1.3 %s %s KIT_REV=1 PORT_REV=2" % ("3" * 64, "4" * 64),
        "kernel k30 kabi " + "6" * 64,
        "kernel k30 unix.brel " + "5" * 64,
        "module k30/ramdisk " + sha("r30"),
        "module k46/ramdisk " + sha("r46"),
        "catalog userland md5 %s sha256 %s" % (hashlib.md5(b"cat").hexdigest(), sha("cat")),
        "pkg userland amxbase-1.0-8.pkg 4 " + sha("base"),
        "pkg userland zlib-1.2.13-8.pkg 4 " + sha("zlib"),
        "pkg apkg APKG-0.3.6.pkg 4 " + sha("apkg"),
        "catalog release/1.1 md5 %s sha256 %s" % (hashlib.md5(b"rcat").hexdigest(), sha("rcat")),
        "pkg release/1.1 stock/core-2.1.pkg 4 " + sha("core"),
        "pkg release/1.1 zlib-1.2.13-8.pkg 4 " + sha("zlib"),
        "media cd/amix.iso 3 " + sha("iso"),
    ]
    check("inputs and outputs, in their sections, each sorted",
          lock[4:4 + len(want)] == want, "\n".join(lock[4:]))
    check("the exceptions last", [l.split()[1] for l in lock[4 + len(want):]]
          == ["kit-revision-lines", "installed-images"], "\n".join(lock))
    check("nothing from out/build", not any("zlib.log" in l for l in lock))
    # a lock with nothing behind it is refused
    nothing = os.path.join(tmp, "out-nothing")
    os.makedirs(os.path.join(nothing, "build"))
    rc, o, e = run(top, nothing)
    check("a build with no output: refused", rc == 1 and "nothing to lock" in e and not os.path.exists(os.path.join(nothing, "lock")), e)
    rc, o, e = run(top, nothing, "--check", os.path.join(out, "lock"))
    check("--check of a build with no output: refused", rc == 1 and "nothing to lock" in e, e)
    for name, make, say in (("modules", lambda d: os.makedirs(os.path.join(d, "modules")), "holds nothing"),
                            ("kernels", lambda d: os.makedirs(os.path.join(d, "kernels")), "names no kernel"),
                            ("userland", lambda d: os.makedirs(os.path.join(d, "userland", "pkgs")), "no package and no catalog"),
                            ("a release", lambda d: os.makedirs(os.path.join(d, "release", "1.1", "pkgs")), "has no catalog")):
        d = os.path.join(tmp, "out-empty-" + name.replace(" ", "-"))
        shutil.copytree(out, d)
        shutil.rmtree(os.path.join(d, "release"))
        if name != "a release":
            shutil.rmtree(os.path.join(d, name), ignore_errors=True)
        make(d)
        rc, o, e = run(top, d)
        check("%s directory that holds nothing: refused" % name, rc == 1 and say in e, e)
    first = open(os.path.join(out, "lock")).read()
    run(top, out)
    check("the same build, the same lock", open(os.path.join(out, "lock")).read() == first)

    rec = os.path.join(tmp, "amix-1.1.lock")
    shutil.copy(os.path.join(out, "lock"), rec)
    rc, o, e = run(top, out, "--check", rec)
    check("--check: this build is the lock of record", rc == 0 and "this build is the lock" in o, e)
    write(os.path.join(out, "userland/pkgs/zlib-1.2.13-8.pkg"), "zlib, other bytes")
    rc, o, e = run(top, out, "--check", rec)
    check("--check: a package with other bytes is refused, - and + named",
          rc == 1 and "  - pkg userland zlib-1.2.13-8.pkg 4 " + sha("zlib") in e
          and "  + pkg userland zlib-1.2.13-8.pkg 17 " in e, e)
    write(os.path.join(out, "userland/pkgs/zlib-1.2.13-8.pkg"), "zlib")
    check("--check writes nothing", open(os.path.join(out, "lock")).read() == first)
    write(os.path.join(top, "kernel/port/port.pin"),
          "https://github.com/amigaux/amix-040-060-port.git " + "e" * 40 + "\n")
    rc, o, e = run(top, out)
    lock = open(os.path.join(out, "lock")).read().splitlines()
    check("a tracked file changed: a dirty line, and the pin as it is now",
          rc == 0 and any(l.startswith("dirty ") for l in lock)
          and "pin kernel/port/port.pin https://github.com/amigaux/amix-040-060-port.git " + "e" * 40 in lock,
          "\n".join(lock[:8]))
    rc, o, e = run(top, out, "--check", rec)
    check("--check: so a build from a changed tree is refused", rc == 1 and "+ dirty " in e, e)
    write(os.path.join(out, "userland/catalog.md5"), "0" * 32 + "  catalog\n")
    rc, o, e = run(top, out)
    check("a catalog.md5 that is not its catalog's md5 is refused",
          rc == 1 and "userland/catalog.md5 does not say the catalog's md5" in e, e)
    write(os.path.join(out, "userland/catalog.md5"), hashlib.md5(b"cat").hexdigest() + "  catalog\n")
    # a release built on a published tree: the older versions are the carried table's
    write(os.path.join(out, "release/1.1/pkgs/old-1-1.pkg"), "old")
    write(os.path.join(out, "release/1.1/pkgs/kold-1.pkg"), "kold")
    good = "\n".join(["#apkg-catalog 1", "#ext older 1", "#old old|1-1|old|old-1-1.pkg|x|3|none|utility|text",
                      "#old #isize old 5", "#old #kpkg kold 1 role=kernel file=kold-1.pkg sha256=x", "#end older", ""])
    write(os.path.join(out, "release/1.1/catalog"), good)
    write(os.path.join(out, "release/1.1/catalog.md5"), hashlib.md5(good.encode()).hexdigest() + "  catalog\n")
    rc, o, e = run(top, out)
    check("an older version not in the carried table is refused, named",
          rc == 1 and "old-1-1.pkg: an older version not in release/carried-1.1" in e, e)
    carried = os.path.join(top, "release/carried-1.1")
    write(carried, "# a table\nkold-1.pkg %s c\nold-1-1.pkg %s c\n" % (sha("kold"), sha("old")))
    write(os.path.join(out, "build/release-previous"), "9" * 64 + "\n")
    rc, o, e = run(top, out)
    lock = open(os.path.join(out, "lock")).read().splitlines()
    check("the older versions match the table: the lock names the table and the published tree's digest",
          rc == 0 and "system release/carried-1.1 " + sha("# a table\nkold-1.pkg %s c\nold-1-1.pkg %s c\n" % (sha("kold"), sha("old"))) in lock
          and "previous " + "9" * 64 in lock[:7], e + "\n".join(lock[:7]))
    write(carried, "kold-1.pkg %s c\nold-1-1.pkg %s c\n" % (sha("kold"), sha("other")))
    rc, o, e = run(top, out)
    check("an older version with other bytes than the table's is refused",
          rc == 1 and "old-1-1.pkg: not the bytes release/carried-1.1 names" in e, e)
    write(carried, "kold-1.pkg %s c\nold-1-1.pkg %s c\ngone-1.pkg %s c\n" % (sha("kold"), sha("old"), sha("gone")))
    rc, o, e = run(top, out)
    check("a table row the tree no longer has is refused: nothing goes missing",
          rc == 1 and "gone-1.pkg: release/carried-1.1 names it, and the tree does not have it" in e, e)
    write(carried, "kold-1.pkg %s c\nold-1-1.pkg %s c\n" % (sha("kold"), sha("old")))
    write(rec, "not a lock\n")
    rc, o, e = run(top, out, "--check", rec)
    check("--check: a file that is not a lock is refused", rc == 1 and "is not an #amix-lock 1 file" in e, e)
finally:
    shutil.rmtree(tmp)

print("%d/%d passed" % (passed, passed + failed))
sys.exit(1 if failed else 0)
