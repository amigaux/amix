          '\tcase $5 in /etc/passwd) echo "root:x:0:0:root:/root:/bin/sh" ;; /etc/group) echo "root:x:0:" ;; esac\n'
          '\texit 0\nfi\nprintf "%s\\n" "$@" > "$DOCKER_ARGS"\n', 0o755)
    argf = os.path.join(tmp, "docker.args")
    rc, out = run("kspace", DIST_HOST=None, PATH=os.path.dirname(fake) + ":" + base["PATH"],
                  DOCKER_ARGS=argf, AMIX_IMAGE="amix-toolchain:test")
    args = open(argf).read().split("\n") if os.path.exists(argf) else []
    gitdir = os.path.join(os.path.realpath(top), ".git")
    check("outside the container: dist.sh runs itself in it, as the calling user",
          rc == 0 and args[:2] == ["run", "--rm"] and "--user" in args
          and args[args.index("--user") + 1] == "%d:%d" % (os.getuid(), os.getgid()), " ".join(args))
    check("the container gets the checkout at /src, its git directory, the system read-only",
          "%s:/src" % os.path.realpath(top) in args and "%s:%s:ro" % (gitdir, gitdir) in args
          and "%s:/system:ro" % os.path.realpath(sysdir) in args
          and "AMIX_SYSTEM=/system" in args and "AMIX_IN_CONTAINER=1" in args, " ".join(args))
    ids = os.path.join(os.path.realpath(top), "out", ".ids")
    passwd = open(os.path.join(ids, "passwd")).read() if os.path.exists(os.path.join(ids, "passwd")) else ""
    group = open(os.path.join(ids, "group")).read() if os.path.exists(os.path.join(ids, "group")) else ""
    check("the calling uid and gid get names: the image's passwd and group, the caller added, mounted read-only",
          passwd == "root:x:0:0:root:/root:/bin/sh\nbuilder:x:%d:%d::/tmp:/bin/sh\n" % (os.getuid(), os.getgid())
          and group == "root:x:0:\nbuilder:x:%d:\n" % os.getgid()
          and "%s/passwd:/etc/passwd:ro" % ids in args and "%s/group:/etc/group:ro" % ids in args,
          passwd + group + " ".join(args))
    check("and runs the step there, from /src, in AMIX_IMAGE",
          args[-5:-1] == ["amix-toolchain:test", "sh", "build/dist.sh", "kspace"]
          and "-w" in args and args[args.index("-w") + 1] == "/src", " ".join(args))
    check("no release input set, none mounted", not any("/release-in/" in x for x in args), " ".join(args))
    stock0 = os.path.join(tmp, "stock0")
    os.makedirs(stock0)
    rc, out = run("kernel-k46", DIST_HOST=None, PATH=os.path.dirname(fake) + ":" + base["PATH"],
                  DOCKER_ARGS=argf, STOCK=stock0, STOCK_URL="https://example.invalid/s", RELEASE_PREVIOUS=stock0,
                  RELEASE_PUBLIC="1", LOCK="nosuch", AMIX_IMAGE="amix-toolchain:test")
    args = open(argf).read().split("\n") if os.path.exists(argf) else []
    check("a release input is the release step's: another step's container does not get it",
          rc == 0 and not any(x.startswith(("STOCK", "RELEASE_", "LOCK")) or "/release-in/" in x for x in args),
          out + " ".join(args))
    rc, out = run("media", DIST_HOST=None, PATH=os.path.dirname(fake) + ":" + base["PATH"], DOCKER_ARGS=argf,
                  AMIX_IMAGE="amix-toolchain:test")
    check("media: no media/build.sh, exit 3, no image asked for",
          rc == 3 and "[MISSING] media: not in make dist yet" in out, out)
    write(os.path.join(top, "media", "build.sh"), "exit 0\n")
    rc, out = run("media", DIST_HOST=None, PATH=os.path.dirname(fake) + ":" + base["PATH"], DOCKER_ARGS=argf,
                  AMIX_IMAGE="amix-toolchain:test", AMIX_MEDIA_IMAGE="amix-toolchain:testmedia",
                  )
    args = open(argf).read().split("\n") if os.path.exists(argf) else []
    check("media: its own image, not AMIX_IMAGE",
          rc == 0 and "amix-toolchain:testmedia" in args and "amix-toolchain:test" not in args, out + " ".join(args))
    rc, out = run("media", DIST_HOST=None, PATH=os.path.dirname(fake) + ":" + base["PATH"], DOCKER_ARGS=argf,
                  AMIX_MEDIA_IMAGE="amix-toolchain:testmedia", SOURCE_DATE_EPOCH="1794044172")
    args = open(argf).read().split("\n") if os.path.exists(argf) else []
    check("media: SOURCE_DATE_EPOCH goes in by name", rc == 0 and "SOURCE_DATE_EPOCH=1794044172" in args, " ".join(args))
    rc, out = run("kspace", DIST_HOST=None, PATH=os.path.dirname(fake) + ":" + base["PATH"], DOCKER_ARGS=argf,
                  AMIX_IMAGE="amix-toolchain:test", SOURCE_DATE_EPOCH="1794044172")
    args = open(argf).read().split("\n") if os.path.exists(argf) else []
    check("but not into another step: a recipe's epoch is its own", rc == 0 and
          not any(x.startswith("SOURCE_DATE_EPOCH") for x in args), " ".join(args))
    os.remove(os.path.join(top, "media", "build.sh"))
    reg = os.path.join(tmp, "rom-register")
    write(reg, "")
    rc, out = run("release", DIST_HOST=None, PATH=os.path.dirname(fake) + ":" + base["PATH"],
                  DOCKER_ARGS=argf, STOCK=stock, ROM_MANIFEST=reg, AMIX_IMAGE="amix-toolchain:test")
    args = open(argf).read().split("\n") if os.path.exists(argf) else []
    check("STOCK and ROM_MANIFEST go in read-only under /release-in, by those names",
          rc == 0 and "STOCK=/release-in/STOCK" in args and "%s:/release-in/STOCK:ro" % stock in args
          and "ROM_MANIFEST=/release-in/ROM_MANIFEST" in args and "%s:/release-in/ROM_MANIFEST:ro" % reg in args
          and not any("PRIVACY_PATTERNS" in x for x in args)
          and args.index("STOCK=/release-in/STOCK") < args.index("amix-toolchain:test")
          and args.index("%s:/release-in/ROM_MANIFEST:ro" % reg) < args.index("amix-toolchain:test")
          and args[args.index("amix-toolchain:test"):-1] == ["amix-toolchain:test", "sh", "build/dist.sh", "release"],
          " ".join(args))
    lockf = os.path.join(tmp, "lock-of-record")
    write(lockf, "#amix-lock 1\n")
    rc, out = run("lock", DIST_HOST=None, PATH=os.path.dirname(fake) + ":" + base["PATH"],
                  DOCKER_ARGS=argf, LOCK=lockf, AMIX_IMAGE="amix-toolchain:test")
    args = open(argf).read().split("\n") if os.path.exists(argf) else []
    check("lock: LOCK goes in read-only, wherever it lies",
          rc == 0 and "LOCK=/release-in/LOCK" in args and "%s:/release-in/LOCK:ro" % lockf in args, " ".join(args))
    # make runs dist.sh in build/: a relative path is from the top of the checkout
    rc, out = run("release", DIST_HOST=None, PATH=os.path.dirname(fake) + ":" + base["PATH"], DOCKER_ARGS=argf,
                  cwd=os.path.join(top, "build"), SYSTEM=os.path.relpath(sysdir, top),
                  ROM_MANIFEST=os.path.relpath(reg, top), AMIX_IMAGE="amix-toolchain:test")
    args = open(argf).read().split("\n") if os.path.exists(argf) else []
    check("a relative SYSTEM or ROM_MANIFEST is from the top of the checkout, wherever it is run",
          rc == 0 and "%s:/system:ro" % os.path.realpath(sysdir) in args
          and "%s:/release-in/ROM_MANIFEST:ro" % os.path.realpath(reg) in args, out + " ".join(args))
    rc, out = run("release", DIST_HOST=None, PATH=os.path.dirname(fake) + ":" + base["PATH"], DOCKER_ARGS=argf,
                  STOCK_URL="https://example.invalid/s", RELEASE_PUBLIC="1", AMIX_IMAGE="amix-toolchain:test")
    args = open(argf).read().split("\n") if os.path.exists(argf) else []
    check("release: STOCK_URL and RELEASE_PUBLIC go in by name",
          rc == 0 and "STOCK_URL=https://example.invalid/s" in args and "RELEASE_PUBLIC=1" in args, " ".join(args))
    rc, out = run("release", DIST_HOST=None, PATH=os.path.dirname(fake) + ":" + base["PATH"],
                  DOCKER_ARGS=argf, PRIVACY_PATTERNS=os.path.join(tmp, "nosuch"))
    check("a release input that does not exist: refused before the container",
          rc == 1 and "PRIVACY_PATTERNS=%s does not exist" % os.path.join(tmp, "nosuch") in out, out)
    # dist-proof, with a stand-in dist.sh in the commit it clones
    pt = os.path.join(tmp, "proved")
    write(os.path.join(pt, "build", "dist.sh"), '''mkdir -p out
case $1 in
media) if [ "${GAP_SILENT:-}" != media ]; then echo "[MISSING] media: not yet"; fi; exit 3 ;;
release) if [ -n "${GAP_RELEASE:-}" ]; then echo "[MISSING] release: stock package core-2.1.pkg"; exit 3; fi ;;
lock)
	if [ -n "${LOCK:-}" ]; then cmp -s out/lock "$LOCK"; exit $?; fi
	if [ -n "${BY_PATH:-}" ]; then pwd > out/lock; else echo one lock > out/lock; fi ;;
esac
''')
    shutil.copy2(os.path.join(TOP, "build", "dist-proof"), os.path.join(pt, "build", "dist-proof"))
    git("init", "-q", cwd=pt)
    git("add", ".", cwd=pt)
    git("commit", "-q", "-m", "one", cwd=pt)
    pn = [0]

    def prove(**env):
        pn[0] += 1
        return run(os.path.join(tmp, "pw%d" % pn[0]), where=os.path.join(pt, "build", "dist-proof"),
                   DIST_HOST=None, **env)
    rc, out = prove()
    check("dist-proof: the same lock twice, exit 0", rc == 0 and "the two locks are identical" in out, out)
    check("dist-proof: the summary names the machine", "machine: " in out and " CPUs" in out, out)
    check("dist-proof: and that one filesystem compared no directory order",
          "directory order not compared" in out, out)
    check("dist-proof: and the gaps it did not compare, in both runs",
          "not compared, known gaps: a/media b/media" in out, out)
    rc, out = prove(GAP_SILENT="media")
    check("dist-proof: an exit 3 with no [MISSING] line stops it", rc == 1 and "with no [MISSING] line" in out, out)
    rc, out = prove(GAP_RELEASE="1")
    check("dist-proof: a gap in a step that is in make dist stops it, even in both runs alike",
          rc == 1 and "release FAILED" in out and "the two locks are identical" not in out, out)
    check("dist-proof: and the summary says what was missing",
          "release FAILED, a gap in a step make dist has: [MISSING] release: stock package core-2.1.pkg" in out, out)
    rc, out = prove(BY_PATH="1")
    check("dist-proof: two locks that differ, exit 1", rc == 1 and "the two locks differ" in out, out)
    rec = os.path.join(tmp, "lock-of-record")
    write(rec, "one lock\n")
    rc, out = prove(LOCK=rec)
    check("dist-proof: with a lock of record both runs still write theirs, and pass it",
          rc == 0 and "the two locks are identical" in out, out)
    write(rec, "another lock\n")
    rc, out = prove(LOCK=rec)
    check("dist-proof: a lock of record they are not stops it", rc == 1 and "lock FAILED" in out, out)
    if os.path.isdir("/dev/shm") and os.stat("/dev/shm").st_dev != os.stat(tmp).st_dev:
        far = tempfile.mkdtemp(prefix="test-dist.", dir="/dev/shm")
        try:
            rc, out = prove(ELSEWHERE=far)
            check("dist-proof: the second clone on another filesystem compares the order",
                  rc == 0 and "two filesystems: directory order compared" in out, out)
        finally:
            shutil.rmtree(far)

    # dist-proof refuses a second filesystem that is not one, before it clones
    proof = os.path.join(top, "build", "dist-proof")
    shutil.copy2(os.path.join(TOP, "build", "dist-proof"), proof)
    same = os.path.join(tmp, "same")
    os.makedirs(same)
    rc, out = run(os.path.join(tmp, "p1"), where=proof, ELSEWHERE=same)
    check("dist-proof: ELSEWHERE on the same filesystem refused", rc == 2 and "filesystem" in out, out)
    rc, out = run(os.path.join(tmp, "p2"), where=proof, ELSEWHERE=os.path.join(tmp, "nosuch"))
    check("dist-proof: ELSEWHERE that does not exist refused", rc == 2 and "not an empty directory" in out, out)
    write(os.path.join(same, "x"), "x")
    rc, out = run(os.path.join(tmp, "p3"), where=proof, ELSEWHERE=same)
    check("dist-proof: ELSEWHERE that is not empty refused", rc == 2 and "not an empty directory" in out, out)
finally:
    shutil.rmtree(tmp)

print("%d/%d passed" % (passed, passed + failed))
sys.exit(1 if failed else 0)
