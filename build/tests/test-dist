#!/usr/bin/env python3
# test-dist: host test of build/dist.sh, make dist's driver (P-38 S1.5).
#
# MIT licence, see LICENSE at the top of the repository.
# A throwaway checkout holds dist.sh with what it reads before any step:
# layout.sh, system/check-amix-system with an empty manifest, and the
# toolchain pins. Nothing is built: the preconditions, the steps that are
# not in make dist yet, the order `dist` stops in, and the container's
# command line (through a stand-in docker) are checked. Prints "N/N passed";
# exits non-zero on any failure.

import os
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
TOP = os.path.dirname(os.path.dirname(HERE))

passed = failed = 0


def check(what, ok, detail=""):
    global passed, failed
    if ok:
        passed += 1
    else:
        failed += 1
        print("FAIL %s%s" % (what, ("\n    " + detail.strip().replace(
            "\n", "\n    ")) if detail else ""))


def write(path, text, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fp:
        fp.write(text)
    os.chmod(path, mode)


def git(*args, cwd):
    subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@example.invalid",
                    "-c", "commit.gpgsign=false"] + list(args), cwd=cwd, check=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


tmp = tempfile.mkdtemp(prefix="test-dist.")
try:
    top = os.path.join(tmp, "amix")
    for f in ("build/dist.sh", "build/pkg/layout.sh", "build/pkg/pkgmeta", "system/check-amix-system",
              "userland/pkgtools/tools/repo/gen-catalog.py",
              "userland/pkgtools/tools/repo/deps.conf", "userland/pkgtools/tools/repo/names.conf",
              "userland/pkgtools/tools/repo/cats.conf", "userland/pkgtools/tools/repo/descs.conf",
              "toolchain/gcc-cross-amix.pin", "toolchain/gcc14-cross-amix.pin"):
        os.makedirs(os.path.dirname(os.path.join(top, f)), exist_ok=True)
        shutil.copy2(os.path.join(TOP, f), os.path.join(top, f))
    write(os.path.join(top, "system", "MANIFEST.sha256"), "")
    write(os.path.join(top, "system", "SYMLINKS"), "")
    git("init", "-q", cwd=top)
    git("add", ".", cwd=top)
    git("commit", "-q", "-m", "one", cwd=top)
    write(os.path.join(top, "README"), "two\n")
    git("add", ".", cwd=top)
    git("commit", "-q", "-m", "two", cwd=top)
    sysdir = os.path.join(tmp, "system")
    write(os.path.join(sysdir, "usr", "include", "x.h"), "x\n")
    os.makedirs(os.path.join(sysdir, "etc"))
    MANIFEST = "%s  usr/include/x.h\n" % subprocess.run(
        ["sha256sum", os.path.join(sysdir, "usr", "include", "x.h")],
        stdout=subprocess.PIPE).stdout.decode()[:64]
    write(os.path.join(top, "system", "MANIFEST.sha256"), MANIFEST)
    dist = os.path.join(top, "build", "dist.sh")
    base = {k: v for k, v in os.environ.items()
            if not k.startswith(("AMIX_", "GIT_")) and k not in ("SYSTEM", "GCA", "G14", "DIST_HOST")}

    def run(*steps, where=dist, **env):
        e = dict(base, SYSTEM=sysdir, DIST_HOST="1", GCA="/nonexistent/gca")
        e.update(env)
        for k in [k for k, v in e.items() if v is None]:
            del e[k]
        p = subprocess.run(["sh", where] + list(steps), env=e,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        return p.returncode, p.stdout.decode("utf-8", "replace")

    rc, out = run()
    check("no step: usage, exit 2", rc == 2 and "kernel-k30" in out, out)
    rc, out = run("frobnicate")
    check("an unknown step: exit 2", rc == 2 and "unknown step: frobnicate" in out, out)
    for step, owner in (("kernel-k30", "S2.2"), ("kernel-k46", "S2.3"), ("media", "S6.1")):
        rc, out = run(step)
        check("%s: not in make dist yet, exit 3, names %s" % (step, owner),
              rc == 3 and "[MISSING] %s: not in make dist yet (P-38 %s" % (step, owner) in out, out)
    rc, out = run("recipes/nosuch")
    check("recipes/<name> of no package: refused", rc == 1 and "no userland package nosuch" in out, out)

    rc, out = run("kspace", SYSTEM=os.path.join(tmp, "nothere"))
    check("no system input: refused before any step",
          rc == 1 and "no system input" in out and "MISSING" not in out, out)
    write(os.path.join(top, "system", "MANIFEST.sha256"), "0" * 64 + "  usr/include/x.h\n")
    rc, out = run("kspace")
    check("a system input that does not match the manifest: refused",
          rc == 1 and "does not match system/MANIFEST.sha256" in out and "MISSING" not in out, out)
    write(os.path.join(top, "system", "MANIFEST.sha256"), MANIFEST)

    shallow = os.path.join(tmp, "shallow")
    subprocess.run(["git", "clone", "-q", "--depth", "1", "file://" + top, shallow], check=True)
    write(os.path.join(shallow, "system", "MANIFEST.sha256"), MANIFEST)
    rc, out = run("kspace", where=os.path.join(shallow, "build", "dist.sh"))
    check("a shallow clone: refused, a package's epoch needs the history",
          rc == 1 and "is a shallow clone" in out, out)

    # --- kspace: kernel/<dir>/pkg/build.sh, provider before consumer --------------
    order = os.path.join(tmp, "kspace.order")

    def recipe(d, pkg, version, fail=False):
        write(os.path.join(top, d, "pkg", "build.sh"), """\
echo %s >> "%s"
echo "AMIX_BUILD_ROOT=$AMIX_BUILD_ROOT AMIX_PORT_URL=$AMIX_PORT_URL AMIX_PORT_REPO=$AMIX_PORT_REPO" >> "%s"
%s
python3 -I - "$AMIX_BUILD_ROOT/kspace/pkg/%s-%s.pkg" <<'PY'
import sys
def newc(name, data):
    name = name.encode() + b"\\0"
    hdr = b"070701" + b"".join(b"%%08X" %% v for v in (
        1, 0o100644, 0, 0, 1, 0, len(data), 0, 0, 0, 0, len(name), 0))
    pad = lambda n: b"\\0" * (-n %% 4)
    return hdr + name + pad(len(hdr) + len(name)) + data + pad(len(data))
head = b"# PaCkAgE DaTaStReAm\\n%s 1 8\\n# end of header\\n"
head += b"\\0" * (-len(head) %% 512)
open(sys.argv[1], "wb").write(head + newc("%s/pkginfo", b"PKG=%s\\nVERSION=%s\\n") + newc("TRAILER!!!", b""))
PY
""" % (d, order, order, "exit 1" if fail else "", pkg, version, pkg, pkg, pkg, version))

    for d in ("kernel/dlm", "kernel/k30", "kernel/port", "kernel/modules/monsw/module",
              "kernel/drivers/a4091"):
        os.makedirs(os.path.join(top, d), exist_ok=True)
    portsrc = os.path.join(tmp, "amix-040-060-port")
    write(os.path.join(portsrc, "include-modelb", "sys", "immu.h"), "x\n")
    subprocess.run(["git", "init", "-q", portsrc], check=True)
    git("add", ".", cwd=portsrc)
    git("commit", "-q", "-m", "port", cwd=portsrc)
    portc = subprocess.run(["git", "-C", portsrc, "rev-parse", "HEAD"],
                           stdout=subprocess.PIPE).stdout.decode().strip()
    write(os.path.join(top, "kernel", "port", "port.pin"), "file://%s %s\n" % (portsrc, portc))
    recipe("kernel/dlm", "kbootset", "1.1.0-28")
    recipe("kernel/drivers/a4091", "a4091k30", "1.0.0-6")
    rc, out = run("kspace")
    kp = os.path.join(top, "out", "kspace", "pkgs")
    check("kspace: the directories with recipes run, the rest are named with their owner, exit 3",
          rc == 3 and "[MISSING] kspace: kernel/k30 has no pkg/build.sh yet (P-38 S3.3, the k30 station" in out
          and "kernel/port has no pkg/build.sh" in out and "kernel/modules/monsw has no pkg/build.sh" in out
          and "kernel/dlm has no" not in out and "kernel/drivers/a4091 has no" not in out, out)
    check("kspace: their packages land in out/kspace/pkgs, through the one-version guard",
          sorted(os.listdir(kp)) == ["a4091k30-1.0.0-6.pkg", "kbootset-1.1.0-28.pkg"]
          and "one version per name: 2 package(s)" in out, out)
    log = open(order).read().split("\n")
    rt = os.path.join(os.path.realpath(top), "out")
    check("kspace: provider order, each with AMIX_BUILD_ROOT=out/build/kspace and the port by hash",
          [l for l in log if l.startswith("kernel/")] == ["kernel/dlm", "kernel/drivers/a4091"]
          and "AMIX_BUILD_ROOT=%s AMIX_PORT_URL=file://%s AMIX_PORT_REPO=%s"
              % (os.path.join(rt, "build", "kspace"), portsrc, os.path.join(rt, "cache", "port-repo")) in log
          and subprocess.run(["git", "-C", os.path.join(rt, "cache", "port-repo"), "cat-file", "-t", portc],
                             stdout=subprocess.PIPE).stdout.decode().strip() == "commit",
          "\n".join(log))
    for d, p in (("kernel/k30", "kern30m"), ("kernel/port", "kern46m"), ("kernel/modules/monsw", "monsw30")):
        recipe(d, p, "1.0-1")
    os.remove(order)
    rc, out = run("kspace")
    check("kspace: every directory has its recipes: exit 0, dlm first, k30 and port before the modules",
          rc == 0 and "MISSING" not in out and [l for l in open(order).read().split("\n") if l.startswith("kernel/")]
          == ["kernel/dlm", "kernel/k30", "kernel/port", "kernel/modules/monsw", "kernel/drivers/a4091"], out)
    write(os.path.join(top, "kernel", "k30", "pkg", "build.sh"),
          'echo kernel/k30 >> "%s"\necho "[MISSING] kern30m: no cut 68030-261031-63 output (P-38 S2.2, k30)" >&2\nexit 3\n' % order)
    os.remove(order)
    rc, out = run("kspace")
    check("kspace: a hook's exit 3 is an absent input: its [MISSING] line, the rest still run, exit 3",
          rc == 3 and "[MISSING] kern30m: no cut 68030-261031-63 output" in out
          and "kernel/k30/pkg/build.sh is waiting for an input" in out
          and [l for l in open(order).read().split("\n") if l.startswith("kernel/")]
          == ["kernel/dlm", "kernel/k30", "kernel/port", "kernel/modules/monsw", "kernel/drivers/a4091"]
          and "kern46m-1.0-1.pkg" in os.listdir(os.path.join(top, "out", "kspace", "pkgs")), out)
    recipe("kernel/k30", "kern30m", "1.0-1")
    recipe("kernel/port", "kern46m", "1.0-1", fail=True)
    rc, out = run("kspace")
    check("kspace: a failing build.sh stops the step, exit 1",
          rc == 1 and "kernel/port/pkg/build.sh failed (exit 1)" in out, out)
    write(os.path.join(top, "kernel", "port", "port.pin"), "file://%s %s\n" % (portsrc, portc[:7]))
    rc, out = run("kspace")
    check("kspace: a port.pin with a short hash is refused before any recipe",
          rc == 1 and "is not a full 40-digit commit hash" in out and "--- kernel/dlm" not in out, out)
    shutil.rmtree(os.path.join(top, "kernel"))

    # --- drivers: ours in kernel/drivers, the forks at their pins ---------------------
    gca = os.path.join(tmp, "gca")
    write(os.path.join(gca, "env.sh"), "STUB_CROSS=yes; export STUB_CROSS\n")
    write(os.path.join(top, "kernel", "dlm", "build", "kit.digests"), "kit k30 x\n")
    for line in ("k30", "k46"):
        write(os.path.join(top, "out", "modules", line, "monsw"), "monsw " + line)
    stub = """\
all:
\tfor l in k30 k46; do mkdir -p $(OUTDIR)/build/$$l/mod.d; echo "$(NAME) $$l $$STUB_CROSS" > $(OUTDIR)/build/$$l/mod.d/$(NAME); done
\techo "DLM=$(DLM)" > $(OUTDIR)/build/dlm.seen
clean:
\trm -rf $(OUTDIR)/build
"""
    write(os.path.join(top, "kernel", "drivers", "z3660scsi", "module", "Makefile"),
          "NAME = z3660scsi\nOUTDIR = ..\n" + stub)
    fork = os.path.join(tmp, "amix-paula")
    write(os.path.join(fork, "module", "Makefile"), "NAME = paula\nOUTDIR = ..\n" + stub)
    subprocess.run(["git", "init", "-q", fork], check=True)
    git("add", ".", cwd=fork)
    git("commit", "-q", "-m", "paula", cwd=fork)
    pc = subprocess.run(["git", "-C", fork, "rev-parse", "HEAD"], stdout=subprocess.PIPE).stdout.decode().strip()
    write(os.path.join(top, "kernel", "drivers", "paula", "paula.pin"), "file://%s %s\n" % (fork, pc))

    rc, out = run("drivers/z3660scsi", GCA=gca)
    mods = os.path.join(top, "out", "modules")
    check("drivers/<ours>: built in kernel/drivers/<d>/module against this checkout's kit, both lines",
          rc == 0 and "module k30 z3660scsi " in out and "module k46 z3660scsi " in out
          and open(os.path.join(mods, "k46", "z3660scsi")).read() == "z3660scsi k46 yes\n"
          and open(os.path.join(top, "kernel", "drivers", "z3660scsi", "build", "dlm.seen")).read()
          == "DLM=%s\n" % os.path.join(os.path.realpath(top), "kernel", "dlm"), out)
    rc, out = run("drivers/paula", GCA=gca)
    cache = os.path.join(top, "out", "cache", "forks", "paula")
    check("drivers/<fork>: the fork at its pinned commit, in out/cache/forks, built against this kit",
          rc == 0 and "module k30 paula " in out
          and subprocess.run(["git", "-C", cache, "rev-parse", "HEAD"], stdout=subprocess.PIPE).stdout.decode().strip() == pc
          and open(os.path.join(mods, "k30", "paula")).read() == "paula k30 yes\n", out)
    check("drivers: the generic modules are kept beside the drivers'",
          sorted(os.listdir(os.path.join(mods, "k30"))) == ["monsw", "paula", "z3660scsi"])
    write(os.path.join(top, "kernel", "drivers", "paula", "paula.pin"), "file://%s %s\n" % (fork, pc[:7]))
    rc, out = run("drivers/paula", GCA=gca)
    check("drivers/<fork>: a pin with a short hash is refused",
          rc == 1 and "paula.pin: '%s' is not a full 40-digit commit hash" % pc[:7] in out, out)
    rc, out = run("drivers/nosuch", GCA=gca)
    check("drivers/<unknown>: refused", rc == 1 and "no driver nosuch" in out, out)
    write(os.path.join(top, "kernel", "drivers", "z3660scsi", "module", "Makefile"),
          "all:\n\t@true\nclean:\n\t@true\n")
    shutil.rmtree(os.path.join(top, "kernel", "drivers", "z3660scsi", "build"))
    rc, out = run("drivers/z3660scsi", GCA=gca)
    check("drivers: a driver that builds no module object is refused",
          rc == 1 and "z3660scsi built no module object" in out, out)
    shutil.rmtree(os.path.join(top, "kernel"))
    shutil.rmtree(os.path.join(top, "out"))

    # --- catalogs: pkgtools' gen-catalog over each space's packages --------------------
    rc, out = run("catalogs")
    check("catalogs: refused without the packages of each space",
          rc == 1 and "no out/kspace/pkgs; make kspace first" in out, out)
    for space in ("kspace", "userland"):
        os.makedirs(os.path.join(top, "out", space, "pkgs"))
    write(os.path.join(top, "userland", "packages", "conf", "cats.conf"), "# none\n")
    rc, out = run("catalogs")
    cats = {s: open(os.path.join(top, "out", s, "catalog")).read() for s in ("kspace", "userland")
            if os.path.exists(os.path.join(top, "out", s, "catalog"))}
    check("catalogs: gen-catalog writes each space's catalog and catalog.md5",
          rc == 0 and cats.get("kspace", "").startswith("#apkg-catalog 1")
          and os.path.isfile(os.path.join(top, "out", "userland", "catalog.md5"))
          and "catalog kspace " in out and "catalog userland " in out, out)
    rc2, out2 = run("catalogs")
    check("catalogs: two runs, the same catalogs",
          rc2 == 0 and all(open(os.path.join(top, "out", s, "catalog")).read() == cats[s] for s in cats), out2)
    check("catalogs: the staging layer, tools/repo's four confs, is in each pkgs/",
          all(os.path.isfile(os.path.join(top, "out", s, "pkgs", c + ".conf"))
              for s in ("kspace", "userland") for c in ("deps", "names", "cats", "descs")))
    def datastream(pkg, version):
        def newc(name, data):
            name = name.encode() + b"\0"
            hdr = b"070701" + b"".join(b"%08X" % v for v in (
                1, 0o100644, 0, 0, 1, 0, len(data), 0, 0, 0, 0, len(name), 0))
            pad = lambda n: b"\0" * (-n % 4)
            return hdr + name + pad(len(hdr) + len(name)) + data + pad(len(data))
        head = b"# PaCkAgE DaTaStReAm\n%s 1 8\n# end of header\n" % pkg.encode()
        head += b"\0" * (-len(head) % 512)
        info = ("PKG=%s\nNAME=the %s module\nARCH=Amiga\nVERSION=%s\nCATEGORY=system\n"
                % (pkg, pkg, version)).encode()
        return head + newc(pkg + "/pkginfo", info) + newc("TRAILER!!!", b"")
    with open(os.path.join(top, "out", "kspace", "pkgs", "zeth46-1.0.0-6.pkg"), "wb") as fp:
        fp.write(datastream("zeth46", "1.0.0-6"))
    rc, out = run("catalogs")
    check("catalogs: kernel-space packages and no kernel/conf/names.conf: refused",
          rc == 1 and "kernel-space packages but no kernel/conf/names.conf" in out, out)
    write(os.path.join(top, "kernel", "conf", "names.conf"), "zeth46: z3660eth-k46\n")
    rc, out = run("catalogs")
    kcat = open(os.path.join(top, "out", "kspace", "catalog")).read() if rc == 0 else ""
    check("catalogs: kernel/conf is the kspace layer: zeth46 is catalogued as z3660eth-k46",
          rc == 0 and "\nz3660eth-k46|1.0.0-6|zeth46|" in kcat, out + kcat)
    shutil.rmtree(os.path.join(top, "kernel"))
    check("catalogs: gen-catalog leaves no __pycache__",
          not os.path.exists(os.path.join(top, "userland", "pkgtools", "tools", "repo", "__pycache__")))
    shutil.rmtree(os.path.join(top, "out"))

    rc, out = run("dist")
    check("dist: kit first, and stops at the first step that fails",
          rc != 0 and "=== make dist: kit" in out and "make dist: stopped at kit" in out
          and "=== make dist: kernel-k30" not in out, out)

    fake = os.path.join(tmp, "bin", "docker")
    write(fake, '#!/bin/sh\nprintf "%s\\n" "$@" > "$DOCKER_ARGS"\n', 0o755)
    argf = os.path.join(tmp, "docker.args")
    rc, out = run("kspace", DIST_HOST=None, PATH=os.path.dirname(fake) + ":" + base["PATH"],
                  DOCKER_ARGS=argf, AMIX_IMAGE="amix-toolchain:test")
    args = open(argf).read().split("\n") if os.path.exists(argf) else []
    gitdir = os.path.join(os.path.realpath(top), ".git")
    check("outside the container: dist.sh runs itself in it, as the calling user",
          rc == 0 and args[:2] == ["run", "--rm"] and "--user" in args
          and args[args.index("--user") + 1] == "%d:%d" % (os.getuid(), os.getgid()), " ".join(args))
    check("the container gets the checkout at /src, its git directory, the system read-only",
          "%s:/src" % os.path.realpath(top) in args and "%s:%s:ro" % (gitdir, gitdir) in args
          and "%s:/system:ro" % os.path.realpath(sysdir) in args
          and "AMIX_SYSTEM=/system" in args and "AMIX_IN_CONTAINER=1" in args, " ".join(args))
    check("and runs the step there, from /src, in AMIX_IMAGE",
          args[-5:-1] == ["amix-toolchain:test", "sh", "build/dist.sh", "kspace"]
          and "-w" in args and args[args.index("-w") + 1] == "/src", " ".join(args))
finally:
    shutil.rmtree(tmp)

print("%d/%d passed" % (passed, passed + failed))
sys.exit(1 if failed else 0)
