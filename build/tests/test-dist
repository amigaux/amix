#!/usr/bin/env python3
# test-dist: host test of build/dist.sh, make dist's driver.
#
# MIT licence, see LICENSE at the top of the repository.
# A throwaway checkout holds dist.sh with what it reads before any step:
# layout.sh, system/check-amix-system with an empty manifest, and the
# toolchain pins and check-image. Nothing is built: the preconditions, the steps that are
# not in make dist yet, the order `dist` stops in, and the container's
# command line (through a stand-in docker) are checked. Prints "N/N passed";
# exits non-zero on any failure.

import os
import shutil
import socket
import subprocess
import sys
import tempfile
import threading

HERE = os.path.dirname(os.path.realpath(__file__))
TOP = os.path.dirname(os.path.dirname(HERE))

passed = failed = 0


def check(what, ok, detail=""):
    global passed, failed
    if ok:
        passed += 1
    else:
        failed += 1
        print("FAIL %s%s" % (what, ("\n    " + detail.strip().replace(
            "\n", "\n    ")) if detail else ""))


def write(path, text, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fp:
        fp.write(text)
    os.chmod(path, mode)


def git(*args, cwd):
    subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@example.invalid",
                    "-c", "commit.gpgsign=false"] + list(args), cwd=cwd, check=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


tmp = tempfile.mkdtemp(prefix="test-dist.")
try:
    top = os.path.join(tmp, "amix")
    for f in ("build/dist.sh", "build/pkg/layout.sh", "build/pkg/pkgmeta", "build/pkg/common/fetch.sh", "system/check-amix-system",
              "userland/pkgtools/tools/repo/gen-catalog.py",
              "userland/pkgtools/tools/repo/deps.conf", "userland/pkgtools/tools/repo/names.conf",
              "userland/pkgtools/tools/repo/cats.conf", "userland/pkgtools/tools/repo/descs.conf",
              "toolchain/gcc-cross-amix.pin", "toolchain/gcc14-cross-amix.pin", "toolchain/check-image"):
        os.makedirs(os.path.dirname(os.path.join(top, f)), exist_ok=True)
        shutil.copy2(os.path.join(TOP, f), os.path.join(top, f))
    write(os.path.join(top, "system", "MANIFEST.sha256"), "")
    write(os.path.join(top, "system", "SYMLINKS"), "")
    write(os.path.join(top, "kernel", "dlm", "pkg", "prototype"), "i pkginfo\n")
    git("init", "-q", cwd=top)
    git("add", ".", cwd=top)
    git("commit", "-q", "-m", "one", cwd=top)
    write(os.path.join(top, "README"), "two\n")
    git("add", ".", cwd=top)
    git("commit", "-q", "-m", "two", cwd=top)
    sysdir = os.path.join(tmp, "system")
    write(os.path.join(sysdir, "usr", "include", "x.h"), "x\n")
    os.makedirs(os.path.join(sysdir, "etc"))
    MANIFEST = "%s  usr/include/x.h\n" % subprocess.run(
        ["sha256sum", os.path.join(sysdir, "usr", "include", "x.h")],
        stdout=subprocess.PIPE).stdout.decode()[:64]
    write(os.path.join(top, "system", "MANIFEST.sha256"), MANIFEST)
    dist = os.path.join(top, "build", "dist.sh")
    base = {k: v for k, v in os.environ.items()
            if not k.startswith(("AMIX_", "GIT_")) and k not in ("SYSTEM", "GCA", "G14", "DIST_HOST", "STOCK",
                                                                 "RELEASE_PREVIOUS", "ROM_MANIFEST", "PRIVACY_PATTERNS")}

    def run(*steps, where=dist, cwd=None, **env):
        e = dict(base, SYSTEM=sysdir, DIST_HOST="1", GCA="/nonexistent/gca")
        e.update(env)
        for k in [k for k, v in e.items() if v is None]:
            del e[k]
        p = subprocess.run(["sh", where] + list(steps), env=e, cwd=cwd,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        return p.returncode, p.stdout.decode("utf-8", "replace")

    rc, out = run()
    check("no step: usage, exit 2", rc == 2 and "kernel-k30" in out, out)
    rc, out = run("frobnicate")
    check("an unknown step: exit 2", rc == 2 and "unknown step: frobnicate" in out, out)
    for step in ("media",):
        rc, out = run(step)
        check("%s: no media/build.sh yet, exit 3" % step,
              rc == 3 and "[MISSING] %s: not in make dist yet\n" % step in out, out)
    write(os.path.join(top, "media", "build.sh"), 'echo "hook $AMIX_TOP"; exit 3\n')
    rc, out = run("media")
    check("media: media/build.sh runs, and its exit 3 is the step's",
          rc == 3 and "hook %s" % os.path.realpath(top) in out, out)
    write(os.path.join(top, "media", "build.sh"), 'echo "epoch $SOURCE_DATE_EPOCH"\n')
    ct = subprocess.run(["git", "log", "-1", "--format=%ct"], cwd=top, stdout=subprocess.PIPE).stdout.decode().strip()
    me = os.path.join(top, "out", "build", "media-epoch")
    rc, out = run("media", SOURCE_DATE_EPOCH=None)
    check("media: its dates are the commit's time by default, and out/build/media-epoch says so",
          rc == 0 and "epoch %s\n" % ct in out and open(me).read() == ct + "\n", out)
    rc, out = run("media", SOURCE_DATE_EPOCH="1794044172")
    check("media: SOURCE_DATE_EPOCH sets them",
          rc == 0 and "epoch 1794044172\n" in out and open(me).read() == "1794044172\n", out)
    rc, out = run("media", SOURCE_DATE_EPOCH="yesterday")
    check("media: a SOURCE_DATE_EPOCH that is not seconds is refused",
          rc == 1 and "SOURCE_DATE_EPOCH 'yesterday' is not seconds" in out and not os.path.exists(me), out)
    os.remove(os.path.join(top, "media", "build.sh"))
    rc, out = run("recipes/nosuch")
    check("recipes/<name> of no package: refused", rc == 1 and "no userland package nosuch" in out, out)
    # two recipes that build against each other: refused before anything builds
    shutil.copytree(os.path.join(TOP, "build", "pkg", "styles"), os.path.join(top, "build", "pkg", "styles"))
    for name, dep in (("cx", "cy"), ("cy", "cx")):
        d = os.path.join(top, "userland", "packages", name)
        shutil.copytree(os.path.join(TOP, "userland", "packages", "diffutils"), d)
        ps = [l for l in open(os.path.join(d, "package.sh")).read().splitlines()
              if not l.startswith(("NAME=", "PKG=", "BUILD_DEPENDS="))]
        write(os.path.join(d, "package.sh"), "\n".join(
            ps + ["NAME=%s" % name, "PKG=%s" % name, 'BUILD_DEPENDS="%s"' % dep]) + "\n")
    rc, out = run("recipes/cx")
    check("recipes/<name>: a BUILD_DEPENDS cycle is refused, named, before any build",
          rc == 1 and "[FAIL] userland: BUILD_DEPENDS cycle: cx -> cy -> cx" in out
          and "host pkgtools" not in out, out)
    shutil.rmtree(os.path.join(top, "userland", "packages"))

    # tools: the build container, its gcc14 against the pinned digest, then the
    # media image; a digest the check refuses stops it before the media image
    seen = os.path.join(tmp, "tools.seen")
    for t, rcode in (("container-build.sh", 0), ("extract-g14.sh", "${G14_RC:-0}"),
                     ("container-media.sh", 0), ("image-pull", "${PULL_RC:-0}")):
        write(os.path.join(top, "toolchain", t),
              '#!/bin/sh\necho "%s $*" >> "%s"\nexit %s\n' % (t, seen, rcode), 0o755)
    built = ("container-build.sh %s amix-toolchain:t\nextract-g14.sh --check amix-toolchain:t\n"
             "container-media.sh amix-toolchain:t amix-toolchain:media\n" % sysdir)

    def tools(**env):
        if os.path.exists(seen):
            os.remove(seen)
        rc, out = run("tools", DIST_HOST=None, AMIX_IMAGE="amix-toolchain:t", **env)
        return rc, out, open(seen).read() if os.path.exists(seen) else ""

    rc, out, got = tools()
    check("tools: no toolchain/image.ref: container-build, then extract-g14 --check on that image, "
          "then container-media, and it says it built them",
          rc == 0 and got == built and "building the images from source (no toolchain/image.ref)" in out, got + out)
    rc, out, got = tools(G14_RC="1")
    check("tools: a gcc14 digest the check refuses stops it before the media image",
          rc != 0 and "extract-g14.sh --check" in got and "container-media" not in got, got + out)
    refs = os.path.join(top, "toolchain", "image.ref")
    write(refs, "dist r@sha256:%s\nmedia r@sha256:%s\n" % ("a" * 64, "b" * 64))
    rc, out, got = tools()
    check("tools: with toolchain/image.ref, the published images are pulled and nothing is built",
          rc == 0 and got == "image-pull %s amix-toolchain:t amix-toolchain:media\n" % os.path.realpath(refs)
          and "are the published images" in out, got + out)
    rc, out, got = tools(PULL_RC="1")
    check("tools: a pull that fails builds them from source, and says so",
          rc == 0 and got.startswith("image-pull ") and got.endswith(built)
          and "were not taken (above); building them from source" in out, got + out)
    rc, out, got = tools(TOOLS_FROM_SOURCE="1")
    check("tools: TOOLS_FROM_SOURCE=1 builds them, then compares them with the published ones",
          rc == 0 and got == built + "image-pull --compare %s amix-toolchain:t amix-toolchain:media\n"
          % os.path.realpath(refs) and "(TOOLS_FROM_SOURCE=1)" in out, got + out)
    rc, out, got = tools(TOOLS_FROM_SOURCE="1", PULL_RC="1")
    check("tools: TOOLS_FROM_SOURCE=1 fails when they differ, or cannot be pulled to compare",
          rc == 1 and "are not the published ones" in out, got + out)
    os.remove(refs)
    rc, out, got = tools(TOOLS_FROM_SOURCE="1")
    check("tools: TOOLS_FROM_SOURCE=1 with no toolchain/image.ref builds them and compares nothing",
          rc == 0 and got == built, got + out)
    for t in ("container-build.sh", "extract-g14.sh", "container-media.sh", "image-pull"):
        os.remove(os.path.join(top, "toolchain", t))
    os.remove(seen)

    rc, out = run("kspace", SYSTEM=os.path.join(tmp, "nothere"))
    check("no system input: refused before any step",
          rc == 1 and "no system input" in out and "MISSING" not in out, out)
    write(os.path.join(top, "system", "MANIFEST.sha256"), "0" * 64 + "  usr/include/x.h\n")
    rc, out = run("kspace")
    check("a system input that does not match the manifest: refused",
          rc == 1 and "does not match system/MANIFEST.sha256" in out and "MISSING" not in out, out)
    write(os.path.join(top, "system", "MANIFEST.sha256"), MANIFEST)

    shallow = os.path.join(tmp, "shallow")
    subprocess.run(["git", "clone", "-q", "--depth", "1", "file://" + top, shallow], check=True)
    write(os.path.join(shallow, "system", "MANIFEST.sha256"), MANIFEST)
    rc, out = run("kspace", where=os.path.join(shallow, "build", "dist.sh"))
    check("a shallow clone: refused, a package's epoch needs the history",
          rc == 1 and "is a shallow clone" in out, out)

    # --- kspace: kernel/<dir>/pkg/build.sh, provider before consumer --------------
    order = os.path.join(tmp, "kspace.order")

    def recipe(d, pkg, version, fail=False, beside=(), tail=""):
        write(os.path.join(top, d, "pkg", "build.sh"), """\
echo %s >> "%s"
echo "AMIX_BUILD_ROOT=$AMIX_BUILD_ROOT AMIX_PORT_URL=$AMIX_PORT_URL AMIX_PORT_REPO=$AMIX_PORT_REPO" >> "%s"
%s%s
python3 -I - "$AMIX_BUILD_ROOT/kspace/pkg/%s-%s.pkg" <<'PY'
import sys
def newc(name, data):
    name = name.encode() + b"\\0"
    hdr = b"070701" + b"".join(b"%%08X" %% v for v in (
        1, 0o100644, 0, 0, 1, 0, len(data), 0, 0, 0, 0, len(name), 0))
    pad = lambda n: b"\\0" * (-n %% 4)
    return hdr + name + pad(len(hdr) + len(name)) + data + pad(len(data))
head = b"# PaCkAgE DaTaStReAm\\n%s 1 8\\n# end of header\\n"
head += b"\\0" * (-len(head) %% 512)
open(sys.argv[1], "wb").write(head + newc("%s/pkginfo", b"PKG=%s\\nVERSION=%s\\n") + newc("TRAILER!!!", b""))
PY
%s""" % (d, order, order, "exit 1" if fail else "",
         "".join('mkdir -p "$AMIX_BUILD_ROOT/kspace/beside"; echo boot > "$AMIX_BUILD_ROOT/kspace/beside/%s"\n' % f
                 for f in beside),
         pkg, version, pkg, pkg, pkg, version, tail))

    hb = os.path.join(top, "userland", "pkgtools", "heirloom")
    write(os.path.join(hb, "build-host.sh"),
          '#!/bin/sh\necho built >> "%s/built"\nmkdir -p build-host/bin\n'
          'printf "#!/bin/sh\\n" > build-host/bin/pkgmk; cp build-host/bin/pkgmk build-host/bin/pkgtrans\n'
          'chmod 755 build-host/bin/pkgmk build-host/bin/pkgtrans\n' % tmp, 0o755)
    for d in ("kernel/dlm", "kernel/k30", "kernel/port"):
        os.makedirs(os.path.join(top, d), exist_ok=True)
    # a module's and a driver's directory are listed by the files git tracks
    # there, as in a checkout
    for f in ("kernel/modules/monsw/module/Makefile", "kernel/drivers/a4091/README"):
        write(os.path.join(top, f), "x\n")
        git("add", f, cwd=top)
    portsrc = os.path.join(tmp, "amix-040-060-port")
    write(os.path.join(portsrc, "include-modelb", "sys", "immu.h"), "x\n")
    subprocess.run(["git", "init", "-q", portsrc], check=True)
    git("add", ".", cwd=portsrc)
    git("commit", "-q", "-m", "port", cwd=portsrc)
    portc = subprocess.run(["git", "-C", portsrc, "rev-parse", "HEAD"],
                           stdout=subprocess.PIPE).stdout.decode().strip()
    write(os.path.join(top, "kernel", "port", "port.pin"), "file://%s %s\n" % (portsrc, portc))
    recipe("kernel/dlm", "kbootset", "1.1.0-28", beside=("amix-cdboot",))
    recipe("kernel/drivers/a4091", "a4091k30", "1.0.0-6")
    # tools built in the checkout on the host, as build-host.sh leaves them:
    # make dist must not take them (their BINDIR is another path)
    for t in ("pkgmk", "pkgtrans"):
        write(os.path.join(hb, "build-host", "bin", t), "#!/bin/sh\nexit 99\n", 0o755)
    write(os.path.join(top, ".gitignore"), "/out/\n/userland/pkgtools/heirloom/build-host/\n")
    rc, out = run("kspace")
    own = os.path.join(top, "out", "build", "pkgtools-host", "pkgtools", "heirloom", "build-host", "bin", "pkgmk")
    check("kspace: make dist builds its own host pkgtools in out/build/pkgtools-host, not taking the checkout's",
          "--- host pkgtools" in out and open(os.path.join(tmp, "built")).read() == "built\n"
          and os.access(own, os.X_OK)
          and open(os.path.join(hb, "build-host", "bin", "pkgmk")).read() == "#!/bin/sh\nexit 99\n", out)
    rc2, out2 = run("kspace")
    check("kspace: the same heirloom sources: make dist's pkgtools are not built again",
          "--- host pkgtools" not in out2 and open(os.path.join(tmp, "built")).read() == "built\n", out2)
    write(os.path.join(hb, "NOTES"), "a change\n")
    rc2, out2 = run("kspace")
    check("kspace: a change in heirloom builds them again",
          "--- host pkgtools" in out2 and open(os.path.join(tmp, "built")).read() == "built\nbuilt\n", out2)
    # the checks below read one run's provider order and one build
    write(order, "")
    write(os.path.join(tmp, "built"), "built\n")
    rc, out = run("kspace")
    kp = os.path.join(top, "out", "kspace", "pkgs")
    check("kspace: the directories with recipes run, the rest are named, exit 3",
          rc == 3 and "[MISSING] kspace: kernel/k30 has no pkg/build.sh yet\n" in out
          and "kernel/port has no pkg/build.sh" in out and "kernel/modules/monsw has no pkg/build.sh" in out
          and "kernel/dlm has no" not in out and "kernel/drivers/a4091 has no" not in out, out)
    check("kspace: kernel/dlm's amix-cdboot lands in out/kspace/beside",
          os.listdir(os.path.join(top, "out", "kspace", "beside")) == ["amix-cdboot"], out)
    check("kspace: their packages land in out/kspace/pkgs, through the one-version guard",
          sorted(os.listdir(kp)) == ["a4091k30-1.0.0-6.pkg", "kbootset-1.1.0-28.pkg"]
          and "one version per name: 2 package(s)" in out, out)
    log = open(order).read().split("\n")
    rt = os.path.join(os.path.realpath(top), "out")
    check("kspace: provider order, each with AMIX_BUILD_ROOT=out/build/kspace and the port by hash",
          [l for l in log if l.startswith("kernel/")] == ["kernel/dlm", "kernel/drivers/a4091"]
          and "AMIX_BUILD_ROOT=%s AMIX_PORT_URL=file://%s AMIX_PORT_REPO=%s"
              % (os.path.join(rt, "build", "kspace"), portsrc, os.path.join(rt, "cache", "port-repo")) in log
          and subprocess.run(["git", "-C", os.path.join(rt, "cache", "port-repo"), "cat-file", "-t", portc],
                             stdout=subprocess.PIPE).stdout.decode().strip() == "commit",
          "\n".join(log))
    # a recipe's file beside its package reaches out/kspace/beside, and stops when it does
    a4 = os.path.join(top, "kernel/drivers/a4091/pkg/build.sh")
    a4text, ordertext = open(a4).read(), open(order).read()
    with open(a4, "a") as fp:
        fp.write('mkdir -p "$AMIX_BUILD_ROOT/kspace/beside"\necho boot > "$AMIX_BUILD_ROOT/kspace/beside/a4091.rom"\n')
    rc3, out3 = run("kspace")
    beside = os.path.join(top, "out", "kspace", "beside", "a4091.rom")
    check("kspace: a file built beside a package lands in out/kspace/beside",
          rc3 == 3 and os.path.isfile(beside), out3)
    write(a4, a4text)
    rc3, out3 = run("kspace")
    check("kspace: and is gone when no recipe builds it", rc3 == 3 and not os.path.exists(beside), out3)
    # kernel/dlm's recipes all rolled but left no amix-cdboot: a failure, not
    # a lock without its line; a symlink there is no file of its own
    recipe("kernel/dlm", "kbootset", "1.1.0-28")
    write(order, "")
    rc3, out3 = run("kspace")
    check("kspace: kernel/dlm exits 0 with no beside/amix-cdboot: exit 1, before the next directory",
          rc3 == 1 and "[FAIL] kspace: kernel/dlm's recipes rolled, but left no file beside/amix-cdboot" in out3
          and [l for l in open(order).read().split("\n") if l.startswith("kernel/")] == ["kernel/dlm"], out3)
    recipe("kernel/dlm", "kbootset", "1.1.0-28",
           tail='mkdir -p "$AMIX_BUILD_ROOT/kspace/beside"; ln -s /etc/passwd "$AMIX_BUILD_ROOT/kspace/beside/amix-cdboot"\n')
    rc3, out3 = run("kspace")
    check("kspace: a symlink at beside/amix-cdboot is refused the same way",
          rc3 == 1 and "left no file beside/amix-cdboot" in out3, out3)
    recipe("kernel/dlm", "kbootset", "1.1.0-28", tail='echo "[MISSING] kbootset: an input" >&2\nexit 3\n')
    rc3, out3 = run("kspace")
    check("kspace: kernel/dlm waiting for an input (exit 3) is a gap, not that failure",
          rc3 == 3 and "left no file" not in out3 and "kernel/dlm/pkg/build.sh is waiting" in out3
          and not os.path.exists(os.path.join(top, "out", "kspace", "beside")), out3)
    recipe("kernel/dlm", "kbootset", "1.1.0-28", beside=("amix-cdboot",))
    write(order, ordertext)
    for d, p in (("kernel/k30", "kern30m"), ("kernel/port", "kern46m"), ("kernel/modules/monsw", "monsw30")):
        recipe(d, p, "1.0-1")
    os.remove(order)
    rc, out = run("kspace")
    check("kspace: every directory has its recipes: exit 0, dlm first, k30 and port before the modules",
          rc == 0 and "MISSING" not in out and [l for l in open(order).read().split("\n") if l.startswith("kernel/")]
          == ["kernel/dlm", "kernel/k30", "kernel/port", "kernel/modules/monsw", "kernel/drivers/a4091"], out)
    # a leftover directory git does not track (a removed driver's gitignored
    # build output, an untracked module) is no recipe: not named, not run
    write(os.path.join(top, "kernel", "drivers", ".gitignore"), "build/\n")
    git("add", "kernel/drivers/.gitignore", cwd=top)
    write(os.path.join(top, "kernel", "drivers", "olddrv", "build", "k30", "olddrv.o"), "x\n")
    write(os.path.join(top, "kernel", "modules", "oldmod", "module", "Makefile"), "x\n")
    os.remove(order)
    rc, out = run("kspace")
    check("kspace: untracked leftover driver and module directories are not recipes: exit 0",
          rc == 0 and "olddrv" not in out and "oldmod" not in out, out)
    git("add", "kernel/modules/oldmod/module/Makefile", cwd=top)
    rc, out = run("kspace")
    check("kspace: the same module directory once tracked is named (control), exit 3",
          rc == 3 and "[MISSING] kspace: kernel/modules/oldmod has no pkg/build.sh yet" in out
          and "olddrv" not in out, out)
    git("rm", "-q", "--cached", "kernel/modules/oldmod/module/Makefile", cwd=top)
    shutil.rmtree(os.path.join(top, "kernel", "modules", "oldmod"))
    shutil.rmtree(os.path.join(top, "kernel", "drivers", "olddrv"))
    write(os.path.join(top, "kernel", "k30", "pkg", "build.sh"),
          'echo kernel/k30 >> "%s"\necho "[MISSING] kern30m: no cut 68030-261031-63 output" >&2\nexit 3\n' % order)
    os.remove(order)
    rc, out = run("kspace")
    check("kspace: a hook's exit 3 is an absent input: its [MISSING] line, the rest still run, exit 3",
          rc == 3 and "[MISSING] kern30m: no cut 68030-261031-63 output" in out
          and "kernel/k30/pkg/build.sh is waiting for an input" in out
          and [l for l in open(order).read().split("\n") if l.startswith("kernel/")]
          == ["kernel/dlm", "kernel/k30", "kernel/port", "kernel/modules/monsw", "kernel/drivers/a4091"]
          and "kern46m-1.0-1.pkg" in os.listdir(os.path.join(top, "out", "kspace", "pkgs")), out)
    check("kspace: the host pkgtools are not built again once they exist",
          open(os.path.join(tmp, "built")).read() == "built\n")
    recipe("kernel/k30", "kern30m", "1.0-1")
    recipe("kernel/port", "kern46m", "1.0-1", fail=True)
    rc, out = run("kspace")
    check("kspace: a failing build.sh stops the step, exit 1",
          rc == 1 and "kernel/port/pkg/build.sh failed (exit 1)" in out, out)
    write(os.path.join(top, "kernel", "port", "port.pin"), "file://%s %s\n" % (portsrc, portc[:7]))
    rc, out = run("kspace")
    check("kspace: a port.pin with a short hash is refused before any recipe",
          rc == 1 and "is not a full 40-digit commit hash" in out and "--- kernel/dlm" not in out, out)
    shutil.rmtree(os.path.join(top, "kernel"))

    # --- drivers: ours in kernel/drivers, the forks at their pins ---------------------
    gca = os.path.join(tmp, "gca")
