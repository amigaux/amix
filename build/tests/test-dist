#!/usr/bin/env python3
# test-dist: host test of build/dist.sh, make dist's driver (P-38 S1.5).
#
# MIT licence, see LICENSE at the top of the repository.
# A throwaway checkout holds dist.sh with what it reads before any step:
# layout.sh, system/check-amix-system with an empty manifest, and the
# toolchain pins. Nothing is built: the preconditions, the steps that are
# not in make dist yet, the order `dist` stops in, and the container's
# command line (through a stand-in docker) are checked. Prints "N/N passed";
# exits non-zero on any failure.

import os
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
TOP = os.path.dirname(os.path.dirname(HERE))

passed = failed = 0


def check(what, ok, detail=""):
    global passed, failed
    if ok:
        passed += 1
    else:
        failed += 1
        print("FAIL %s%s" % (what, ("\n    " + detail.strip().replace(
            "\n", "\n    ")) if detail else ""))


def write(path, text, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fp:
        fp.write(text)
    os.chmod(path, mode)


def git(*args, cwd):
    subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@example.invalid",
                    "-c", "commit.gpgsign=false"] + list(args), cwd=cwd, check=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


tmp = tempfile.mkdtemp(prefix="test-dist.")
try:
    top = os.path.join(tmp, "amix")
    for f in ("build/dist.sh", "build/pkg/layout.sh", "build/pkg/pkgmeta", "system/check-amix-system",
              "toolchain/gcc-cross-amix.pin", "toolchain/gcc14-cross-amix.pin"):
        os.makedirs(os.path.dirname(os.path.join(top, f)), exist_ok=True)
        shutil.copy2(os.path.join(TOP, f), os.path.join(top, f))
    write(os.path.join(top, "system", "MANIFEST.sha256"), "")
    write(os.path.join(top, "system", "SYMLINKS"), "")
    git("init", "-q", cwd=top)
    git("add", ".", cwd=top)
    git("commit", "-q", "-m", "one", cwd=top)
    write(os.path.join(top, "README"), "two\n")
    git("add", ".", cwd=top)
    git("commit", "-q", "-m", "two", cwd=top)
    sysdir = os.path.join(tmp, "system")
    write(os.path.join(sysdir, "usr", "include", "x.h"), "x\n")
    os.makedirs(os.path.join(sysdir, "etc"))
    MANIFEST = "%s  usr/include/x.h\n" % subprocess.run(
        ["sha256sum", os.path.join(sysdir, "usr", "include", "x.h")],
        stdout=subprocess.PIPE).stdout.decode()[:64]
    write(os.path.join(top, "system", "MANIFEST.sha256"), MANIFEST)
    dist = os.path.join(top, "build", "dist.sh")
    base = {k: v for k, v in os.environ.items()
            if not k.startswith(("AMIX_", "GIT_")) and k not in ("SYSTEM", "GCA", "G14", "DIST_HOST")}

    def run(*steps, where=dist, **env):
        e = dict(base, SYSTEM=sysdir, DIST_HOST="1", GCA="/nonexistent/gca")
        e.update(env)
        for k in [k for k, v in e.items() if v is None]:
            del e[k]
        p = subprocess.run(["sh", where] + list(steps), env=e,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        return p.returncode, p.stdout.decode("utf-8", "replace")

    rc, out = run()
    check("no step: usage, exit 2", rc == 2 and "kernel-k30" in out, out)
    rc, out = run("frobnicate")
    check("an unknown step: exit 2", rc == 2 and "unknown step: frobnicate" in out, out)
    for step, owner in (("kernel-k30", "S2.2"), ("kernel-k46", "S2.3"), ("drivers", "S3.2"),
                        ("drivers/a4091", "S3.2"), ("catalogs", "S5.1"),
                        ("media", "S6.1")):
        rc, out = run(step)
        check("%s: not in make dist yet, exit 3, names %s" % (step, owner),
              rc == 3 and "[MISSING] %s: not in make dist yet (P-38 %s" % (step, owner) in out, out)
    rc, out = run("recipes/nosuch")
    check("recipes/<name> of no package: refused", rc == 1 and "no userland package nosuch" in out, out)

    rc, out = run("kspace", SYSTEM=os.path.join(tmp, "nothere"))
    check("no system input: refused before any step",
          rc == 1 and "no system input" in out and "MISSING" not in out, out)
    write(os.path.join(top, "system", "MANIFEST.sha256"), "0" * 64 + "  usr/include/x.h\n")
    rc, out = run("kspace")
    check("a system input that does not match the manifest: refused",
          rc == 1 and "does not match system/MANIFEST.sha256" in out and "MISSING" not in out, out)
    write(os.path.join(top, "system", "MANIFEST.sha256"), MANIFEST)

    shallow = os.path.join(tmp, "shallow")
    subprocess.run(["git", "clone", "-q", "--depth", "1", "file://" + top, shallow], check=True)
    write(os.path.join(shallow, "system", "MANIFEST.sha256"), MANIFEST)
    rc, out = run("kspace", where=os.path.join(shallow, "build", "dist.sh"))
    check("a shallow clone: refused, a package's epoch needs the history",
          rc == 1 and "is a shallow clone" in out, out)

    # --- kspace: kernel/<dir>/pkg/build.sh, provider before consumer --------------
    order = os.path.join(tmp, "kspace.order")

    def recipe(d, pkg, version, fail=False):
        write(os.path.join(top, d, "pkg", "build.sh"), """\
echo %s >> "%s"
echo "AMIX_BUILD_ROOT=$AMIX_BUILD_ROOT" >> "%s"
%s
python3 -I - "$AMIX_BUILD_ROOT/kspace/pkg/%s-%s.pkg" <<'PY'
import sys
def newc(name, data):
    name = name.encode() + b"\\0"
    hdr = b"070701" + b"".join(b"%%08X" %% v for v in (
        1, 0o100644, 0, 0, 1, 0, len(data), 0, 0, 0, 0, len(name), 0))
    pad = lambda n: b"\\0" * (-n %% 4)
    return hdr + name + pad(len(hdr) + len(name)) + data + pad(len(data))
head = b"# PaCkAgE DaTaStReAm\\n%s 1 8\\n# end of header\\n"
head += b"\\0" * (-len(head) %% 512)
open(sys.argv[1], "wb").write(head + newc("%s/pkginfo", b"PKG=%s\\nVERSION=%s\\n") + newc("TRAILER!!!", b""))
PY
""" % (d, order, order, "exit 1" if fail else "", pkg, version, pkg, pkg, pkg, version))

    for d in ("kernel/dlm", "kernel/k30", "kernel/port", "kernel/modules/monsw/module",
              "kernel/drivers/a4091"):
        os.makedirs(os.path.join(top, d), exist_ok=True)
    recipe("kernel/dlm", "kbootset", "1.1.0-28")
    recipe("kernel/drivers/a4091", "a4091k30", "1.0.0-6")
    rc, out = run("kspace")
    kp = os.path.join(top, "out", "kspace", "pkgs")
    check("kspace: the directories with recipes run, the rest are named with their owner, exit 3",
          rc == 3 and "[MISSING] kspace: kernel/k30 has no pkg/build.sh yet (P-38 S3.3, the k30 station" in out
          and "kernel/port has no pkg/build.sh" in out and "kernel/modules/monsw has no pkg/build.sh" in out
          and "kernel/dlm has no" not in out and "kernel/drivers/a4091 has no" not in out, out)
    check("kspace: their packages land in out/kspace/pkgs, through the one-version guard",
          sorted(os.listdir(kp)) == ["a4091k30-1.0.0-6.pkg", "kbootset-1.1.0-28.pkg"]
          and "one version per name: 2 package(s)" in out, out)
    log = open(order).read().split("\n")
    check("kspace: provider order, each with AMIX_BUILD_ROOT=out/build/kspace",
          [l for l in log if l.startswith("kernel/")] == ["kernel/dlm", "kernel/drivers/a4091"]
          and "AMIX_BUILD_ROOT=%s" % os.path.join(os.path.realpath(top), "out", "build", "kspace") in log,
          "\n".join(log))
    for d, p in (("kernel/k30", "kern30m"), ("kernel/port", "kern46m"), ("kernel/modules/monsw", "monsw30")):
        recipe(d, p, "1.0-1")
    os.remove(order)
    rc, out = run("kspace")
    check("kspace: every directory has its recipes: exit 0, dlm first, k30 and port before the modules",
          rc == 0 and "MISSING" not in out and [l for l in open(order).read().split("\n") if l.startswith("kernel/")]
          == ["kernel/dlm", "kernel/k30", "kernel/port", "kernel/modules/monsw", "kernel/drivers/a4091"], out)
    recipe("kernel/port", "kern46m", "1.0-1", fail=True)
    rc, out = run("kspace")
    check("kspace: a failing build.sh stops the step, exit 1",
          rc == 1 and "kernel/port/pkg/build.sh failed" in out, out)
    shutil.rmtree(os.path.join(top, "kernel"))

    rc, out = run("dist")
    check("dist: kit first, and stops at the first step that fails",
          rc != 0 and "=== make dist: kit" in out and "make dist: stopped at kit" in out
          and "=== make dist: kernel-k30" not in out, out)

    fake = os.path.join(tmp, "bin", "docker")
    write(fake, '#!/bin/sh\nprintf "%s\\n" "$@" > "$DOCKER_ARGS"\n', 0o755)
    argf = os.path.join(tmp, "docker.args")
    rc, out = run("kspace", DIST_HOST=None, PATH=os.path.dirname(fake) + ":" + base["PATH"],
                  DOCKER_ARGS=argf, AMIX_IMAGE="amix-toolchain:test")
    args = open(argf).read().split("\n") if os.path.exists(argf) else []
    gitdir = os.path.join(os.path.realpath(top), ".git")
    check("outside the container: dist.sh runs itself in it, as the calling user",
          rc == 0 and args[:2] == ["run", "--rm"] and "--user" in args
          and args[args.index("--user") + 1] == "%d:%d" % (os.getuid(), os.getgid()), " ".join(args))
    check("the container gets the checkout at /src, its git directory, the system read-only",
          "%s:/src" % os.path.realpath(top) in args and "%s:%s:ro" % (gitdir, gitdir) in args
          and "%s:/system:ro" % os.path.realpath(sysdir) in args
          and "AMIX_SYSTEM=/system" in args and "AMIX_IN_CONTAINER=1" in args, " ".join(args))
    check("and runs the step there, from /src, in AMIX_IMAGE",
          args[-5:-1] == ["amix-toolchain:test", "sh", "build/dist.sh", "kspace"]
          and "-w" in args and args[args.index("-w") + 1] == "/src", " ".join(args))
finally:
    shutil.rmtree(tmp)

print("%d/%d passed" % (passed, passed + failed))
sys.exit(1 if failed else 0)
