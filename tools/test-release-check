    ("pkg-clean", {"pkgs/good-1.0-1.pkg": datastream("good", [("root/etc/motd", b"hello\n"),
                                                               ("root/usr/bin/x", b"\x7fELF\0\0")])}, None, True),
    ("pkg-kickstart", {"pkgs/bad-1.0-1.pkg": datastream("bad", [("root/opt/kick.rom", KICK)])},
     "rom s0 /pkgs/bad-1.0-1.pkg!root/opt/kick.rom", False),
    ("pkg-crypt", {"pkgs/bad-1.0-1.pkg": datastream("bad", [("root/etc/shadow", "root:" + DES + ":1::::::\n")])},
