    ("binary-pattern", {"bin/tool": b"\x7fELF\0/srv/secretbox/tool.c\0"},
     "privacy /bin/tool: local pattern #1 in a binary file at offset", True),
    ("pkg-binary-pattern", {"pkgs/bad-1.0-1.pkg": datastream("bad", [
        ("root/usr/bin/x", b"\x7fELF\0/srv/secretbox/x.c\0")])},
     "privacy /pkgs/bad-1.0-1.pkg!root/usr/bin/x: local pattern #1 in a binary file at offset", True),
