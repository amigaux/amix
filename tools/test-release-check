        ("root/usr/src/pub/news/nntp/xmit/other.c", "/* " + NNTP + " */\n")])}, "privacy", False),
    ("stock-other-name", {"pkgs/stock/Xsource-2.1.pkg": datastream("Xsource", [
        ("root/usr/src/X/contrib/clients/xpostit/other.c", "/* secretbox */\n")])}, "privacy", False),
]


def rdb_image(swap, store):
    """an RDB disk image with no ufs slice: slice 1 swap ('resv'), slice 2
    a boot store ('UNI\\0'), 64 KiB each from cylinder 1 (8 KiB a cylinder)"""
    cyl, n = 8192, 8
    img = bytearray(cyl * (1 + 2 * n))
    rdsk = bytearray(512)
    rdsk[0:4] = b"RDSK"
    struct.pack_into(">I", rdsk, 28, 1)                     # PartitionList
    struct.pack_into(">II", rdsk, 68, 16, 1)                # sectors, heads
    img[0:512] = rdsk
    for slot, (dostype, name, body) in enumerate(((0x72657376, b"UNIX_Swap", swap),
                                                  (0x554e4900, b"UNIX_Boot", store)), 1):
        pb = bytearray(512)
        pb[0:4] = b"PART"
        struct.pack_into(">I", pb, 16, slot + 1 if slot < 2 else 0xffffffff)
        pb[36] = len(name)
        pb[37:37 + len(name)] = name
        for i, v in ((1, 128), (3, 1), (5, 16), (9, 1 + (slot - 1) * n), (10, slot * n), (16, dostype)):
            struct.pack_into(">I", pb, 128 + 4 * i, v)
        img[slot * 512:(slot + 1) * 512] = pb
        off = cyl * (1 + (slot - 1) * n)
        img[off:off + len(body)] = body
    return bytes(img)


def run(args, env=None):
    r = subprocess.run([sys.executable, CHECK] + args, capture_output=True, text=True,
                       env=env or os.environ, timeout=600)
    return r.returncode, r.stdout + r.stderr


def master(tree, iso):
    r = subprocess.run(["xorriso", "-as", "mkisofs", "-quiet", "-R", "-o", iso, tree],
                       stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    return r.returncode == 0


if not shutil.which("xorriso"):
    print("test-release-check: needs xorriso (the ISO cases)")
    sys.exit(2)

tmp = tempfile.mkdtemp(prefix="test-release-check.")
try:
    reg = os.path.join(tmp, "MANIFEST.sha256")
    write(tmp, "MANIFEST.sha256", "%s  test-rom.bin\n" % hashlib.sha256(ROMBYTES).hexdigest())
    pat = os.path.join(tmp, "patterns.txt")
    write(tmp, "patterns.txt", "secretbox\n")
    env = {k: v for k, v in os.environ.items() if k not in ("ROM_MANIFEST", "PRIVACY_PATTERNS", "RELEASE_PUBLIC")}
    flags = ["--rom-register", reg, "--private-patterns", pat]

    for name, extra, want, iso in CASES:
        tree = os.path.join(tmp, "t", name)
        for rel, data in list(CLEAN.items()) + list(extra.items()):
            write(tree, rel, data)
        targets = [tree]
        if iso:
            img = os.path.join(tmp, name + ".iso")
            check("%s: xorriso masters the tree" % name, master(tree, img))
            targets.append(img)
        for t in targets:
            kind = "an ISO" if t.endswith(".iso") else "a directory"
            rc, out = run(flags + [t], env)
            if want is None:
                check("%s as %s: clean" % (name, kind), rc == 0 and "CLEAN" in out and "HIT" not in out, out)
            else:
                check("%s as %s: refused, %s" % (name, kind, want), rc == 1 and ("HIT  %s" % want) in out, out)

    # an image's slices that are no ufs: swap must be zero, the store is
    # read raw (a Kickstart at a block start, its strings)
    text = b"\0kbootset store\0generation 7\0"
    unaligned = b"\0\0" + KICK[:4] + b"\0\0"
    for name, swap, store, want in (
            ("img-clean", b"", b"\0" * 512 + text + unaligned, None),
            ("img-swap", b"\0" * 40000 + b"\x01", text, "swap s1: not zeroed, 64 KiB written"),
            ("img-kick", b"", b"\0" * 1024 + KICK[:4096], "rom s2 raw+0x400: a Kickstart header"),
            ("img-pattern", b"", text + b"built on secretbox-lab\0", "privacy"),
            ("img-wide", b"", text + "secretbox".encode("utf-16-le"),
             "privacy s2 raw: local pattern #1 in a binary file with its NUL"),
            ("img-crypt", b"", b"\0root:" + DES.encode() + b":0:0::/:/sbin/sh\0",
             "credential /raw/s2-raw-000.txt")):
        img = os.path.join(tmp, name + ".img")
        write(tmp, name + ".img", rdb_image(swap, store))
        rc, out = run(flags + [img], env)
        if want is None:
            check("%s: clean, both slices read raw" % name,
                  rc == 0 and "0 files, 2 raw slice(s), " in out and "CLEAN" in out and " 0 bytes" not in out, out)
        else:
            check("%s: refused, %s" % (name, want), rc == 1 and ("HIT  %s" % want) in out, out)

    # what an installed image must not keep from its build box (trace_hits,
    # which image mode applies to each file of a ufs slice)
    import importlib.machinery
    import importlib.util
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("release_check", CHECK)
    rc_mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("release_check", loader))
    loader.exec_module(rc_mod)
    for slot, p, data, want in (
            (1, "/tmp/catalog", b"x", "a file in /tmp"),
            (1, "/var/tmp/x.1", b"", "a file in /var/tmp"),
            (4, "/tmp/catalog", b"x", None),                    # another slice's tmp is not /tmp
            (1, "/var/adm/wtmpx", b"\1" * 372, "a login record that is not empty"),
            (1, "/var/adm/sulog", b"SU 11/02\n", "a login record that is not empty"),
            (1, "/var/adm/wtmp", b"", None),                    # shipped empty: fine
            (1, "/.sh_history", b"ls\n", "a shell history"),
            (4, "/jussi/.bash_history", b"ls\n", "a shell history"),
            (1, "/root.history", b"ls\n", "a shell history"),
            (1, "/usr/share/doc/history", b"text\n", None)):
        got = rc_mod.trace_hits(slot, p, data)
        check("image trace s%d %s: %s" % (slot, p, want or "none"),
              (not got) if want is None else (len(got) == 1 and want in got[0]), repr(got))

    # image mode reaches a binary file anywhere in a ufs slice, not only /etc
    import contextlib
    import io
    fake = os.path.join(tmp, "fake.img")
    write(tmp, "fake.img", b"\0" * 512)
    real_rdb, real_files = rc_mod.is_rdb_image, rc_mod.image_files
    rc_mod.is_rdb_image = lambda p: True
    rc_mod.image_files = lambda p, raw: iter([(1, "/etc/motd", b"welcome\n"),
                                              (4, "/usr/bin/x", b"\0/srv/secretbox/x.c\0"),
                                              (4, "/usr/bin/y", b"\0nothing here\0"),
                                              (4, "/usr/doc/z", b"plain secretbox text\n")])
    got = io.StringIO()
    with contextlib.redirect_stdout(got):
        verdict = rc_mod.check(fake, {}, pat, [], rc_mod.LocalNames(pat))
    got = got.getvalue()
    rc_mod.image_files = lambda p, raw: iter([(4, "/usr/doc/z", b"plain text\n")])
    try:
        rc_mod.check(fake, {}, pat, [], rc_mod.LocalNames(pat))
        nothing = "no failure"
    except rc_mod.Failure as e:
        nothing = str(e)
    check("image: ufs files, and no /etc in slice 1 for the privacy scan: a failure",
          "no text file in slice 1" in nothing, nothing)
    rc_mod.is_rdb_image, rc_mod.image_files = real_rdb, real_files
    check("image: a binary file outside /etc is searched, a text file there is not",
          not verdict and got.count("HIT") == 2
          and "HIT  privacy s4 /usr/bin/x: local pattern #1 in a binary file at offset 6" in got, got)
    check("the string found in a binary is not printed", "secretbox" not in got, got)

    # image mode on a real ufs: two fixtures, an RDB with s1 a ufs made by
    # the box's own mkfs (invented /etc and first-boot files), s2 swap (zero)
    # and s3 a boot store; "planted" adds a shadow hash and a private address.
    # They are disk images, which privacy-check keeps out of commits: they are
    # distfiles (tools/release-check-fixture-*.distfile), fetched into
    # out/cache by toolchain/fetch-distfile (AMIX_DISTFILES for an offline run).
    import gzip
    top = os.path.dirname(HERE)
    for name, want in (
            ("clean", None),
            ("planted", ["HIT  credential /etc/shadow: a crypt-style password hash for root",
                         "1 etc/inet/hosts private IPv4 address " + ".".join(("10", "11", "12", "13")) + " at line 3",
                         "3 etc/shadow password hash in a shadow file at line 1"])):
        r = subprocess.run(["sh", os.path.join(top, "toolchain", "fetch-distfile"),
                            os.path.join(HERE, "release-check-fixture-%s.distfile" % name),
                            os.path.join(top, "out", "cache")], capture_output=True, text=True)
        gz = r.stdout.strip().splitlines()[-1] if r.returncode == 0 and r.stdout.strip() else ""
        check("fixture-%s.hdf.gz fetched by its pin" % name, r.returncode == 0 and os.path.isfile(gz),
              r.stdout + r.stderr)
        if not os.path.isfile(gz):
            continue
        img = os.path.join(tmp, "fixture-%s.hdf" % name)
        with open(img, "wb") as fp:
            fp.write(gzip.decompress(open(gz, "rb").read()))
        rc, out = run(flags + [img], env)
        if want is None:
            check("ufs fixture clean: CLEAN, its 4 files and both raw slices read",
                  rc == 0 and "4 files, 2 raw slice(s), " in out and "CLEAN" in out, out)
        else:
            check("ufs fixture planted: exactly the shadow hash and the address",
                  rc == 1 and "3 HIT(s)" in out and all(w in out for w in want), out)

    # nothing read is never clean
    rc, out = run(flags + [_empty_dir(tmp)], env)
    check("an empty directory: a failure, nothing read", rc == 2 and "nothing read" in out and "CLEAN" not in out, out)
    write(tmp, "nothing/only-empty", b"")
    rc, out = run(flags + [os.path.join(tmp, "nothing")], env)
    check("a directory of empty files: a failure, nothing read", rc == 2 and "nothing read" in out, out)
    write(tmp, "zero.iso", b"")
    rc, out = run(flags + [os.path.join(tmp, "zero.iso")], env)
    check("a 0-byte .iso: a failure", rc == 2 and "CLEAN" not in out, out)
    write(tmp, "zero.bin", b"")
    rc, out = run(flags + [os.path.join(tmp, "zero.bin")], env)
    check("a 0-byte file: a failure, nothing read", rc == 2 and "nothing read" in out, out)
    write(tmp, "cut.img", rdb_image(b"\0" * 65536, b"store " * 4096)[:64 * 1024])
    rc, out = run(flags + [os.path.join(tmp, "cut.img")], env)
    check("an image cut short: a failure, the slice past its end named",
          rc == 2 and "past the end of the image" in out and "CLEAN" not in out, out)
    if shutil.which("xorriso"):
        src = os.path.join(tmp, "t", "clean")
        whole = os.path.join(tmp, "whole.iso")
        subprocess.run(["xorriso", "-as", "mkisofs", "-quiet", "-o", whole, src],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        data = open(whole, "rb").read()
        write(tmp, "cut.iso", data[:len(data) // 2])
        rc, out = run(flags + [os.path.join(tmp, "cut.iso")], env)
        check("an ISO cut short: a failure, shorter than its volume", rc == 2 and "the volume is" in out, out)
        write(tmp, "nopvd.iso", b"x" * 65536)
        rc, out = run(flags + [os.path.join(tmp, "nopvd.iso")], env)
        check("a .iso that is none: a failure", rc == 2 and "no ISO 9660 volume" in out, out)
        none = os.path.join(tmp, "none.iso")
        os.makedirs(os.path.join(tmp, "empty-iso", "sub"))
        subprocess.run(["xorriso", "-as", "mkisofs", "-quiet", "-o", none, os.path.join(tmp, "empty-iso")],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        rc, out = run(flags + [none], env)
        check("an ISO with no file: a failure, nothing read", rc == 2 and "nothing read" in out, out)
    # an unreadable directory is not an empty one
    if os.geteuid() != 0:
        write(tmp, "shut/ok", "text\n")
        write(tmp, "shut/in/secret", "text\n")
        os.chmod(os.path.join(tmp, "shut", "in"), 0)
        rc, out = run(flags + [os.path.join(tmp, "shut")], env)
        os.chmod(os.path.join(tmp, "shut", "in"), 0o755)
        check("a directory it cannot read: a failure", rc == 2 and "cannot read" in out, out)
    # what is in a tree does not decide what the scan looks at
    addr = ".".join(("10", "1", "2", "3"))
    for name, files in (("a .gitignore of *", {".gitignore": "*\n", "conf/leak": "host %s\n" % addr}),
                        ("a .git directory of its own", {".git/config": "url = %s\n" % addr, "ok": "text\n"}),
                        ("a .git inside a subdirectory", {"sub/.git/config": "url = %s\n" % addr, "ok": "text\n"}),
                        ("a .git file of its own", {".git": "gitdir: %s\n" % addr})):
        d = os.path.join(tmp, "ignored-" + str(abs(hash(name)) % 100000))
        for rel, data in files.items():
            write(d, rel, data)
        rc, out = run(flags + [d], env)
        check("%s: the address is still found" % name, rc == 1 and "HIT  privacy" in out and "CLEAN" not in out, out)
    # privacy-check that searched less than it was given
    short = os.path.join(tmp, "short-privacy-check")
    write(tmp, "short-privacy-check", "import sys\nsys.stderr.write('privacy-check: 0 file(s), 0 hit(s)\\n')\n")
    rc, out = run(["--no-rom-register", "--no-private-patterns", os.path.join(tmp, "t", "clean")],
                  dict(env, PRIVACY_CHECK=short))
    check("a privacy-check that searched fewer files: a failure", rc == 2 and "searched 0 of" in out, out)

    # a list with nothing in it is no list
    blank = os.path.join(tmp, "blank")
    write(tmp, "blank", "# a comment\n\n")
    clean0 = os.path.join(tmp, "t", "clean")
    rc, out = run(["--rom-register", blank, "--private-patterns", pat, clean0], env)
    check("a ROM register that lists nothing: a failure", rc == 2 and "lists nothing" in out, out)
    rc, out = run(["--rom-register", reg, "--private-patterns", blank, clean0], env)
    check("private patterns that list nothing: a failure", rc == 2 and "list nothing" in out, out)
    write(tmp, "bad-register", "not-a-sha  kick.rom\n")
    rc, out = run(["--rom-register", os.path.join(tmp, "bad-register"), "--private-patterns", pat, clean0], env)
    check("a ROM register line that is no sha256: a failure", rc == 2 and "not a sha256 line" in out, out)
    write(tmp, "no-modules", "# none\n")
    rc, out = run(flags + ["--known-bad", os.path.join(tmp, "no-modules"), clean0], env)
    check("a known-bad list with no module: a failure", rc == 2 and "lists no module" in out, out)
    rc, out = run(["--public", "--rom-register", blank, "--private-patterns", blank, clean0], env)
    check("--public: empty lists run, and the output says they were not used",
          rc == 0 and "the ROM register and the private patterns: not used (public rebuild)" in out and "CLEAN" in out, out)
    rc, out = run(["--rom-register", blank, "--private-patterns", blank, clean0], dict(env, RELEASE_PUBLIC="1"))
    check("RELEASE_PUBLIC stands for --public", rc == 0 and "not used (public rebuild)" in out, out)
    rc, out = run(["--public", clean0], env)
    check("--public: no lists given at all, the same", rc == 0 and "not used (public rebuild)" in out, out)
    rc, out = run(["--public", "--rom-register", reg, "--private-patterns", blank, clean0], env)
    check("--public: a list it has is used, and only the other is named",
          rc == 0 and "the private patterns: not used" in out and "ROM register" not in out, out)
    rc, out = run(["--public", "--rom-register", reg, "--private-patterns", pat, os.path.join(tmp, "t", "pattern")], env)
    check("--public: a list it has still finds what it lists", rc == 1 and "HIT" in out, out)
    rc, out = run(["--no-rom-register", "--no-private-patterns", clean0], env)
    check("the opt-outs: the output says what was not used", rc == 0 and "not used (as asked)" in out, out)

    # the register and the patterns come by environment as well
    rc, out = run([os.path.join(tmp, "t", "register")], dict(env, ROM_MANIFEST=reg, PRIVACY_PATTERNS=pat))
    check("ROM_MANIFEST and PRIVACY_PATTERNS stand for the flags", rc == 1 and "HIT  rom" in out, out)
    # without them it refuses to run; the opt-outs run without them
    clean = os.path.join(tmp, "t", "clean")
    rc, out = run(["--private-patterns", pat, clean], env)
    check("no ROM register: refused, exit 2", rc == 2 and "no ROM register" in out, out)
    rc, out = run(["--rom-register", reg, clean], env)
    check("no private patterns: refused, exit 2", rc == 2 and "no private patterns" in out, out)
    rc, out = run(["--no-rom-register", "--no-private-patterns", os.path.join(tmp, "t", "register")], env)
    check("--no-rom-register: a register ROM passes, as asked", rc == 0 and "CLEAN" in out, out)
    rc, out = run(["--no-rom-register", "--no-private-patterns", os.path.join(tmp, "t", "kickstart")], env)
    check("--no-rom-register still refuses a Kickstart header", rc == 1 and "HIT  rom" in out, out)
    rc, out = run(["--no-rom-register", "--no-private-patterns", os.path.join(tmp, "t", "pattern")], env)
    check("--no-private-patterns: the local name passes, as asked", rc == 0, out)
    rc, out = run(["--rom-register", os.path.join(tmp, "none"), "--private-patterns", pat, clean], env)
    check("an unreadable register: a failure, exit 2", rc == 2 and "FAILED" in out, out)

    # no search, no verdict
    bad_pc = os.path.join(tmp, "bad-privacy-check")
    write(tmp, "bad-privacy-check", "this is not python\n")
    rc, out = run(flags + [clean], dict(env, PRIVACY_CHECK=bad_pc))
    check("a privacy-check that does not load: a failure, exit 2", rc == 2 and "FAILED" in out, out)
    write(tmp, "bad-patterns.txt", "(\n")
    rc, out = run(["--rom-register", reg, "--private-patterns", os.path.join(tmp, "bad-patterns.txt"), clean], env)
    check("an invalid pattern: a failure, exit 2", rc == 2 and "FAILED" in out, out)

    # privacy-check's summary ("N file(s), M hit(s)") is no hit, whatever N is
    for n in (1, 3):
        t = os.path.join(tmp, "few%d" % n)
        for k in range(n):
            write(t, "f%d.txt" % k, "plain text %d\n" % k)
        rc, out = run(flags + [t], env)
        check("a tree of %d text file(s): clean" % n, rc == 0 and "CLEAN" in out, out)

    # the control: without the commit-id test, the summary reads as a hit
    os.makedirs(os.path.join(tmp, "tools"))
    for f in ("privacy-check", "privacy-allow.txt", "release-allow.txt", "known-bad-modules.txt"):
        shutil.copy2(os.path.join(HERE, f), os.path.join(tmp, "tools", f))
    shutil.copytree(os.path.join(HERE, "lib"), os.path.join(tmp, "tools", "lib"),
                    ignore=shutil.ignore_patterns("__pycache__"))
    noid = os.path.join(tmp, "tools", "release-check")
    src = open(CHECK).read()
    want = 're.fullmatch(r"[0-9a-f]{7,40}", w[0]) and '
    check("control: release-check tests the hit line's commit id once", src.count(want) == 1)
    with open(noid, "w") as f:
        f.write(src.replace(want, ""))
    r = subprocess.run([sys.executable, noid] + flags + [os.path.join(tmp, "few3")], capture_output=True,
                       text=True, env=env)
    check("control: without it, the 3-file tree is refused", r.returncode == 1, r.stdout + r.stderr)

    # a symbolic link is not followed out of the tree
    t = os.path.join(tmp, "linked")
    write(t, "README", "a tree\n")
    write(tmp, "outside/hosts", PRIV_ADDR + " h\n")
    os.symlink(os.path.join(tmp, "outside"), os.path.join(t, "elsewhere"))
    os.symlink(os.path.join(tmp, "outside", "hosts"), os.path.join(t, "hosts"))
    rc, out = run(flags + [t], env)
    check("symbolic links out of the tree are not followed", rc == 0 and "1 files" in out, out)

    # a datastream part that is not a cpio archive is a failure, never skipped
    t = os.path.join(tmp, "zpart")
    write(t, "pkgs/z-1.0-1.pkg", datastream("z", [("root/a", b"a\n")], tail=b"\x1f\x9d" + b"\x55" * 600))
    rc, out = run(flags + [t], env)
    check("a datastream part that is not cpio: a failure, exit 2",
          rc == 2 and "is not a cpio archive" in out, out)
    rc, out = run(flags + [os.path.join(tmp, "nosuch")], env)
    check("a path that does not exist: a failure, exit 2", rc == 2 and "no such file" in out, out)

    # known-bad modules: a made-up module listed by --known-bad-entry, found
    # by its sha256 as a file or a member, and by its 512-byte pieces in the
    # bytes of an image, a floppy image or a file of a tree
    def pseudo(seed, size):
        out = b""
        while len(out) < size:
            out += hashlib.sha256(b"%s %d" % (seed, len(out))).digest()
        return out[:size]
    mod = pseudo(b"bad", 14006)
    write(tmp, "kb/zbad.bin", mod)
    rc, out = run(["--known-bad-entry", "zbad", os.path.join(tmp, "kb", "zbad.bin"), "a  test\nentry"], env)
    lines = out.splitlines()
    check("--known-bad-entry: a module line and its 27 pieces",
          rc == 0 and len(lines) == 28 and lines[0].startswith("module zbad ") and lines[0].endswith(" a test entry")
          and all(x.startswith("piece ") for x in lines[1:]), out)
    kb = os.path.join(tmp, "kb", "list")
    write(tmp, "kb/list", "# made up\n" + out)
    write(tmp, "kb/short.bin", mod[:511])
    rc, out = run(["--known-bad-entry", "zbad", os.path.join(tmp, "kb", "short.bin"), "short"], env)
    check("--known-bad-entry: a file under one piece is refused", rc == 2, out)
    kbflags = flags + ["--known-bad", kb]
    pieces = [(int(x.split()[1]), int(x.split()[2])) for x in lines[1:]]
    # the next build: other bytes but one shared piece; a near relative: one
    # byte changed in every piece, away from its anchor, so only the sha256
    # tells it apart
    later = pseudo(b"later", 13658)
    later = later[:4096] + mod[7168:7680] + later[4608:]
    kin = bytearray(mod)
    for o, k in pieces:
        kin[o + (k + 200) % 512] ^= 0xff
    kin = bytes(kin)
    frags = b"".join(pseudo(b"gap%d" % i, 1024 * (i % 3 + 1)) + mod[o:o + 1024]
                     for i, o in enumerate(reversed(range(0, len(mod), 1024))))
    adf = bytearray(901120)
    adf[0:4] = b"DOS\x01"
    for name, files, want in (
            ("kb-file", {"BOOT/K46/G1M06.BIN": mod}, "known-bad s0 /BOOT/K46/G1M06.BIN: is zbad by its sha256"),
            ("kb-member", {"pkgs/z3660scsi-1.0-1.pkg": datastream("z3660scsi", [("root/etc/conf/mod.d/zbad", mod)])},
             "known-bad s0 /pkgs/z3660scsi-1.0-1.pkg!root/etc/conf/mod.d/zbad: is zbad by its sha256"),
            ("kb-embedded", {"media/floppy.adf": bytes(adf[:3000]) + mod + bytes(adf[:3000])},
             "known-bad s0 /media/floppy.adf: carries zbad, 27 of its 27 512-byte pieces"),
            ("kb-later", {"BOOT/K46/G1M06.BIN": later}, None),
            ("kb-kin", {"BOOT/K46/G1M06.BIN": kin}, None)):
        t = os.path.join(tmp, "t", name)
        for rel, data in files.items():
            write(t, rel, data)
        rc, out = run(kbflags + [t], env)
        if want is None:
            check("%s as a directory: clean" % name, rc == 0 and "CLEAN" in out, out)
        else:
            check("%s as a directory: refused, %s" % (name, want), rc == 1 and ("HIT  " + want) in out
                  and out.count("HIT  known-bad") == 1, out)
    img = os.path.join(tmp, "kb-file.iso")
    check("kb-file: xorriso masters the tree", master(os.path.join(tmp, "t", "kb-file"), img))
    rc, out = run(kbflags + [img], env)
    check("kb-file as an ISO: refused by its sha256, once",
          rc == 1 and "HIT  known-bad s0 /BOOT/K46/G1M06.BIN: is zbad" in out and out.count("HIT  ") == 1, out)
    check("the fragments fit a 64 KiB store", len(frags) < 65536)
    for name, store, want in (
            ("kb-img-odd", b"\1" * 300 + mod, "carries zbad, 27 of its 27"),
            ("kb-img-frag", frags, "carries zbad, 27 of its 27"),
            ("kb-img-later", b"\1" * 300 + later, None),
            ("kb-img-kin", b"\1" * 300 + kin, None)):
        write(tmp, name + ".img", rdb_image(b"", store))
        rc, out = run(kbflags + [os.path.join(tmp, name + ".img")], env)
        if want is None:
            check("%s: clean" % name, rc == 0 and "CLEAN" in out, out)
        else:
            check("%s: refused, %s" % (name, want), rc == 1 and ("HIT  known-bad %s.img: %s" % (name, want)) in out, out)
    write(tmp, "kb-floppy.adf", bytes(adf[:8192]) + mod + bytes(adf[8192 + len(mod):]))
    write(tmp, "kb-clean.adf", bytes(adf))
    rc, out = run(kbflags + [os.path.join(tmp, "kb-floppy.adf")], env)
    check("a floppy image holding the module: refused, read as a file",
          rc == 1 and "HIT  known-bad kb-floppy.adf: carries zbad" in out, out)
    rc, out = run(kbflags + [os.path.join(tmp, "kb-clean.adf")], env)
    check("a floppy image without it: clean, the file read raw", rc == 0 and "1 files, 1 raw slice(s), " in out and "CLEAN" in out
          and "in the file" in out, out)
    write(tmp, "kb/bad-list", "module zbad " + "0" * 64 + " 14006 why\npiece 100 0 00 " + "0" * 64 + "\n")
    rc, out = run(flags + ["--known-bad", os.path.join(tmp, "kb", "bad-list"), clean], env)
    check("a malformed known-bad list: a failure, exit 2", rc == 2 and "bad-list:2: not a module or piece" in out, out)
    # the list of record loads, and its entry is the one module it names
    shipped = open(os.path.join(HERE, "known-bad-modules.txt")).read().splitlines()
    names = [x.split()[1] for x in shipped if x.startswith("module ")]
    check("tools/known-bad-modules.txt: z3660scsi with its 27 pieces", names == ["z3660scsi"]
          and sum(x.startswith("piece ") for x in shipped) == 27, repr(names))
    # the control: without the sha256 behind each anchor, the near relative
    # reads as the module
    src = open(CHECK).read()
    want = "i >= k and hashlib.sha256(buf[i - k:i - k + PIECE]).hexdigest() == h"
    check("control: release-check confirms an anchor by its piece's sha256 once", src.count(want) == 1)
    with open(noid, "w") as f:
        f.write(src.replace(want, "i >= k"))
    r = subprocess.run([sys.executable, noid] + kbflags + [os.path.join(tmp, "kb-img-kin.img")],
                       capture_output=True, text=True, env=env)
    check("control: without it, the near relative is refused", r.returncode == 1 and "carries zbad" in r.stdout,
          r.stdout + r.stderr)

    # the ufs reader image mode uses: its own hermetic selftest
    r = subprocess.run([sys.executable, os.path.join(HERE, "lib", "ufs.py")], capture_output=True, text=True)
    check("tools/lib/ufs.py's selftest passes", r.returncode == 0 and "selftest: PASS" in r.stdout,
          r.stdout[-800:] + r.stderr)
finally:
    shutil.rmtree(tmp, ignore_errors=True)

print("%d/%d passed" % (passed, passed + failed))
sys.exit(1 if failed else 0)
