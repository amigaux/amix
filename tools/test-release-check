#!/usr/bin/env python3
# test-release-check: host test of tools/release-check.
#
# MIT licence, see LICENSE at the top of the repository.
#
# Each case writes a small tree that holds one thing and runs release-check on
# it, as a directory and, for some, mastered as an ISO 9660 image (xorriso).
# The ROM register and the private patterns are made up here at run time.
# Everything the check must refuse (an RFC 1918 address, a PEM header, the
# hashes, the host key name, a Kickstart header) is assembled at run time and
# never written whole in this file, so this file passes the push check.
# Package datastreams are built here too: their members are checked.
# Two ufs disk image fixtures come as distfiles (release-check-fixture-*),
# fetched into out/cache; AMIX_DISTFILES=<dir> serves them offline.
# Prints "N/N passed"; exits non-zero on any failure.

import hashlib
import os
import shutil
import struct
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
CHECK = os.path.join(HERE, "release-check")

passed = failed = 0


def check(what, ok, detail=""):
    global passed, failed
    if ok:
        passed += 1
    else:
        failed += 1
        print("FAIL %s%s" % (what, ("\n    " + detail.strip().replace("\n", "\n    ")) if detail else ""))


def write(root, rel, data):
    p = os.path.join(root, rel)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "wb") as f:
        f.write(data if isinstance(data, bytes) else data.encode())


def newc(members):
    """a newc cpio archive of (name, bytes) regular files, with its trailer"""
    out = b""
    for ino, (name, body) in enumerate(list(members) + [("TRAILER!!!", None)], 1):
        mode = 0o100644 if body is not None else 0
        body = body.encode() if isinstance(body, str) else body or b""
        nb = name.encode() + b"\0"
        h = b"070701" + b"".join(b"%08X" % v for v in (ino if mode else 0, mode, 0, 0, 1, 0, len(body),
                                                         0, 0, 0, 0, len(nb), 0))
        out += h + nb
        out += b"\0" * (-len(out) % 4) + body
        out += b"\0" * (-len(out) % 4)
    return out


def _empty_dir(tmp, name="empty-dir"):
    d = os.path.join(tmp, name)
    os.makedirs(d, exist_ok=True)
    return d


def datastream(pkg, members, tail=b""):
    """a package datastream: the header, then its archives padded to 512"""
    out = b"# PaCkAgE DaTaStReAm\n%s 1 1\n# end of header\n" % pkg.encode()
    out += b"\0" * (-len(out) % 512)
    for arch in ([("%s/pkginfo" % pkg, b"PKG=%s\n" % pkg.encode())], members):
        out += newc(arch)
        out += b"\0" * (-len(out) % 512)
    return out + tail


CLEAN = {
