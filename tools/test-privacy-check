def ident(who):
    return {"GIT_AUTHOR_NAME": who[0], "GIT_AUTHOR_EMAIL": who[1],
            "GIT_COMMITTER_NAME": who[0], "GIT_COMMITTER_EMAIL": who[1]}


def of(hits, sha):
    return [h for h in hits if sha.startswith(h[0])]


def added_lines(t, env, root, local_env):
    """Text classes judge only added lines; pushes skip published commits."""
    repo = Repo(env, os.path.join(root, "repo2"))
    old_ip, new_ip = dotted(10, 9, 8, 7), dotted(192, 168, 44, 4)
    # A contributor's root commit: a private address and a local name.
    up = repo.commit(OTHER, {"docs/hosts.txt": j(
        "alpha\n", "server ", old_ip, "\n", "beta\n", "ask frobnicator\n")},
        "Add the host list")
    # Ours: edit an unrelated line of that file.
    edit = repo.commit(OURS, {"docs/hosts.txt": j(
        "alpha, edited\n", "server ", old_ip, "\n", "beta\n", "ask frobnicator\n")},
        "Reword the first line")
    # Ours: drop a line and add a line with a private address (new line 4).
    add = repo.commit(OURS, {"docs/hosts.txt": j(
        "alpha, edited\n", "server ", old_ip, "\n", "ask frobnicator\n",
        "peer ", new_ip, "\n")}, "Add a peer")
    pre_merge = add
    # A subtree-style move-in merge of another project.
    repo.git("checkout", "-q", "--orphan", "proj")
    repo.git("rm", "-rq", "--cached", ".")
    for rel in ("docs/hosts.txt",):
        os.remove(os.path.join(repo.path, rel))
    proj = repo.commit(OTHER, {
        "lib/net.txt": j("net\n", "via ", dotted(172, 20, 1, 2), "\n"),
        "etc/app.conf": j("user = x\n", "pass", "word = hunter2hunter2\n")},
        "Start the project")
    repo.git("checkout", "-q", "master")
    repo.git("merge", "-q", "-s", "ours", "--no-commit",
             "--allow-unrelated-histories", "proj", env=ident(OURS))
    repo.git("read-tree", "--prefix=vendor/proj/", "-u", "proj")
    repo.git("commit", "-q", "-m", "Move the project in", env=ident(OURS))
    merge = repo.git("rev-parse", "HEAD")

    rc, hits, out = repo.check(["--all", "master"], env=local_env)
    t.ok(any(h[1] == 1 and h[2] == "docs/hosts.txt" and old_ip in h[3]
             and h[3].endswith("line 2") for h in of(hits, up)),
         "root commit: address caught at line 2", out)
    t.ok(any(h[1] == 1 and "local pattern #3 at line 4" in h[3]
             for h in of(hits, up)), "root commit: local pattern caught", out)
    t.ok(not of(hits, edit),
         "edit of an unrelated line inherits no earlier hits", out)
    t.ok([(h[1], h[2], h[3]) for h in of(hits, add)]
         == [(1, "docs/hosts.txt",
              "private IPv4 address %s at line 4" % new_ip)],
         "added line caught alone, line number of the new file", out)
    t.ok(has(hits, merge, 1, "vendor/proj/lib/net.txt")
         and any("at line 2" in h[3] for h in of(hits, merge)
                 if h[2] == "vendor/proj/lib/net.txt")
         and has(hits, merge, 3, "vendor/proj/etc/app.conf"),
         "subtree merge: the whole incoming project is checked", out)
    t.ok(has(hits, proj, 1, "lib/net.txt"), "--all checks the project's own commit", out)

    # --range is literal; --exclude-remotes skips what a remote has.
    repo.git("update-ref", "refs/remotes/upstream/proj", proj)
    rng = "%s..%s" % (pre_merge, merge)
    rc, hits, out = repo.check(["--range", rng])
    t.ok(has(hits, proj, 1, "lib/net.txt") and has(hits, merge, 1, "vendor/proj/lib/net.txt"),
         "--range stays literal over remote-tracked commits", out)
    rc, hits, out = repo.check(["--range", rng, "--exclude-remotes"])
    t.ok(rc == 1 and not of(hits, proj) and has(hits, merge, 1, "vendor/proj/lib/net.txt"),
         "--range --exclude-remotes skips commits a remote has", out)
    rc, hits, out = repo.check(["--all", "master", "--exclude-remotes"])
    t.ok(not of(hits, proj) and of(hits, up), "--all --exclude-remotes", out)

    # --pre-push: our branch fast-forwards over another remote's commits.
    repo.git("checkout", "-q", "-b", "fork", edit)
    fork_base = edit
    repo.git("update-ref", "refs/remotes/origin/fork", fork_base)
    theirs = repo.commit(OTHER, {"up/new.txt": j("host ", dotted(10, 3, 3, 3), "\n")},
                         "Upstream adds a host")
    repo.git("update-ref", "refs/remotes/upstream/fork", theirs)
    ours = repo.commit(OURS, {"ours/clean.txt": "nothing private\n"}, "Our change")
    line = j("refs/heads/fork ", ours, " refs/heads/fork ", fork_base, "\n")
    rc, hits, out = repo.check(["--pre-push", "origin", "https://example.invalid/r.git"],
                               stdin=line)
    t.ok(rc == 0 and not hits and "1 commit(s), 0 hit(s)" in out,
         "--pre-push skips commits another remote-tracking ref has", out)
    rc, hits, out = repo.check(["--range", "%s..%s" % (fork_base, ours)])
    t.ok(rc == 1 and of(hits, theirs), "same span via --range is still checked", out)
    repo.git("update-ref", "-d", "refs/remotes/upstream/fork")
    rc, hits, out = repo.check(["--pre-push", "origin", "https://example.invalid/r.git"],
                               stdin=line)
    t.ok(rc == 1 and of(hits, theirs) and not of(hits, ours),
         "--pre-push checks them when no remote has them", out)


def binaries_and_compiled(t, env, root):
    """Local patterns in binary files; compiled Python refused by name."""
    repo = Repo(env, os.path.join(root, "repo3"))
    pats = os.path.join(root, "patterns3")
    with open(pats, "w") as f:
        f.write("frobnicator[0-9]*\n")
    local = {"PRIVACY_PATTERNS": pats}
    path_bytes = b"/srv/frobnicator/tool.py"
    head = b"\xa7\r\r\n\0\0\0\0"

    clean = repo.commit(OURS, {
        "data/clean.bin": head + j("gw ", dotted(10, 0, 0, 1), "\n").encode(),
        "notes/pyc.txt": "about pyc files\n",
        "tools/mod.pyc.txt": "not compiled\n",
        "pycache/notes.txt": "not the directory\n",
        "src/__pycache__x/mod.py": "x = 1\n"}, "Add near misses")
    binary = repo.commit(OURS, {"bin/tool.bin": head + path_bytes + b"\0tail"},
                         "Add a binary holding a local path")
    far = repo.commit(OURS, {"bin/far.bin": head + b"\x80" * 100000 + path_bytes},
                      "Add a binary with the path past the text probe")
    wide = repo.commit(OURS, {"bin/wide.bin": head + "frobnicator".encode("utf-16-le")},
                       "Add a binary with the name in UTF-16")
    same = repo.commit(OURS, {"bin/tool.bin": head + path_bytes + b"\0other"},
                       "Change a binary, the same local path stays")
    grew = repo.commit(OURS, {"bin/tool.bin": head + path_bytes + b"\0frobnicator7"},
                       "Change a binary, a new local name")
    pyc = repo.commit(OURS, {
        "probe/__pycache__/tap.cpython-314.pyc": head + path_bytes,
        "old/mod.pyc": head + b"nothing private",
        "more/__pycache__/notes.txt": "plain text\n"}, "Add compiled Python")
    contrib = repo.commit(OTHER, {"up/__pycache__/m.cpython-39.pyc": head},
                          "Add compiled Python from upstream")
    os.remove(os.path.join(repo.path, "old/mod.pyc"))
    os.remove(os.path.join(repo.path, "probe/__pycache__/tap.cpython-314.pyc"))
    gone = repo.commit(OURS, {"notes/gone.txt": "removed\n"}, "Remove compiled Python")

    rc, hits, out = repo.check(["--all", "master"])
    t.ok(not [h for h in hits if h[1] == 1],
         "no local list: nothing searched in a binary", out)
    t.ok(has(hits, pyc, 4, "probe/__pycache__/tap.cpython-314.pyc")
         and has(hits, pyc, 4, "old/mod.pyc")
         and has(hits, pyc, 4, "more/__pycache__/notes.txt"),
         ".pyc and __pycache__/ refused, without a local list", out)
    t.ok(has(hits, contrib, 4, "up/__pycache__/m.cpython-39.pyc"),
         "compiled Python refused in a contributor's commit too", out)
    t.ok(not of(hits, clean), "near misses and an address in a binary pass", out)
    t.ok(not of(hits, gone), "removing compiled Python passes", out)

    rc, hits, out = repo.check(["--all", "master"], env=local)
    t.ok(rc == 1 and has(hits, binary, 1, "bin/tool.bin")
         and any("local pattern #1 in a binary file at offset 13" in h[3]
                 for h in of(hits, binary)),
         "binary holding a local path refused, with its offset", out)
    t.ok(has(hits, far, 1, "bin/far.bin"), "found past the first 8 KiB", out)
    t.ok(has(hits, wide, 1, "bin/wide.bin"), "found in UTF-16", out)
    t.ok(not of(hits, same), "a string the binary already held is not new", out)
    t.ok(has(hits, grew, 1, "bin/tool.bin"), "a new string in a changed binary", out)
    t.ok(has(hits, pyc, 1, "probe/__pycache__/tap.cpython-314.pyc")
         and has(hits, pyc, 4, "probe/__pycache__/tap.cpython-314.pyc"),
         ".pyc holding a local path: both classes", out)
    t.ok("frobnicator" not in out and "/srv/" not in out,
         "the string in a binary is never printed", out)

    rc, hits, out = repo.check(["--tree", same], env=local)
    t.ok(rc == 1 and has(hits, same, 1, "bin/tool.bin"),
         "--tree judges a binary whole", out)

    allow = os.path.join(root, "allow3")
    with open(allow, "w") as f:
        f.write("1 bin/*.bin frobnicator\n")
    rc, hits, out = repo.check(["--range", "%s..%s" % (clean, far), "--allow", allow],
                               env=local)
    t.ok(rc == 0 and not hits, "the allowlist reads the string in a binary", out)

    # The whole of a binary is read, or the check fails.
    big = 16 * 1024 * 1024 + 1024
    large = repo.commit(OURS, {"bin/large.bin": head + b"\0" * big + path_bytes},
                        "Add a binary over the 16 MiB read")
    rng = "%s..%s" % (gone, large)
    rc, hits, out = repo.check(["--range", rng], env=local)
    t.ok(rc == 2 and "not read whole" in out, "a binary not read whole exits 2", out)
    rc, hits, out = repo.check(["--range", rng])
    t.ok(rc == 1 and [h[1] for h in hits] == [4],
         "no local list: only the size hit on that binary", out)
    rc, hits, out = repo.check(["--range", rng, "--max-size", "32M"], env=local)
    t.ok(rc == 1 and has(hits, large, 1, "bin/large.bin"),
         "--max-size reads it whole, the string at its end is found", out)


def ci_range(t, env, root):
    """tools/ci-privacy-check: which commits CI judges."""
    repo = Repo(env, os.path.join(root, "repo4"))
    script = os.path.join(HERE, "ci-privacy-check")
    old = repo.commit(OURS, {"probe/__pycache__/m.cpython-314.pyc": b"\0old"},
                      "A compiled file already in published history")
    pub = repo.commit(OURS, {"notes.txt": "published\n"}, "Published")
    repo.git("update-ref", "refs/remotes/origin/master", pub)
    repo.git("checkout", "-q", "-b", "topic")
    ok1 = repo.commit(OURS, {"a.txt": "clean\n"}, "A clean commit on a branch")
    repo.git("checkout", "-q", "-b", "topic2")
    bad = repo.commit(OURS, {"b.txt": j("gw ", dotted(10, 0, 0, 1), "\n")}, "A private address")

    def ci(**kw):
        e = dict(env.base, EVENT="push", PUSH_BEFORE="", PUSH_AFTER="", PR_BASE="", PR_HEAD="",
                 PRIVACY_PATTERNS="/no/such/file", PRIVACY_BLOCKED="/no/such/file")
        e.update(kw)
        p = subprocess.run(["sh", script], cwd=repo.path, env=e, stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT)
        return p.returncode, p.stdout.decode("utf-8", "replace")

    rc, out = ci(PUSH_BEFORE=pub, PUSH_AFTER=ok1)
    t.ok(rc == 0 and "--range %s..%s" % (pub, ok1) in out and "1 commit(s)" in out,
         "CI: a push checks from its previous tip; no local list is read", out)
    rc, out = ci(PUSH_BEFORE=pub, PUSH_AFTER=bad)
    t.ok(rc == 1 and bad[:10] in out, "CI: a push's new hit fails it", out)
    rc, out = ci(EVENT="pull_request", PR_BASE=pub, PR_HEAD=bad)
    t.ok(rc == 1 and "--range %s..%s" % (pub, bad) in out, "CI: a pull request checks base to head", out)
    for name, before in (("no previous tip", ZERO), ("empty", ""), ("a tip it does not have", "1" * 40)):
        rc, out = ci(PUSH_BEFORE=before, PUSH_AFTER=ok1)
        t.ok(rc == 0 and "--range %s..%s" % (pub, ok1) in out and old[:10] not in out,
             "CI: %s: from the merge base, published history not judged" % name, out)
    rc, out = ci(PUSH_BEFORE=ZERO, PUSH_AFTER=bad)
    t.ok(rc == 1 and bad[:10] in out, "CI: from the merge base a new hit still fails", out)
    rc, out = ci(PUSH_BEFORE=ZERO, PUSH_AFTER=pub)
    t.ok(rc == 0 and "0 commit(s)" in out, "CI: master itself has no new commits", out)
    rc, out = ci(PUSH_BEFORE=ZERO, PUSH_AFTER="1" * 40)
    t.ok(rc == 2, "CI: an unknown commit exits 2", out)
    repo.git("checkout", "-q", "--orphan", "other")
    repo.git("rm", "-rqf", "--cached", ".")
    other = repo.commit(OTHER, {"c.txt": j("gw ", dotted(10, 0, 0, 2), "\n")}, "Unrelated")
    rc, out = ci(PUSH_BEFORE=ZERO, PUSH_AFTER=other)
    t.ok(rc == 1 and "--all " + other in out, "CI: no history in common: all of it is new", out)
    repo.git("update-ref", "-d", "refs/remotes/origin/master")
    rc, out = ci(PUSH_BEFORE=ZERO, PUSH_AFTER=ok1)
    t.ok(rc == 2 and "origin/master" in out, "CI: no origin/master exits 2, never a pass", out)


def main():
    root = tempfile.mkdtemp(prefix="privacy-check-test.")
    t = Tally()
    try:
        env = Env(root)
        repo = Repo(env, os.path.join(root, "repo"))
        c, _ = build(repo)
        tip = c["blocked"]

        pat_file = os.path.join(root, "patterns")
        with open(pat_file, "w") as f:
            f.write("# local names\n\nfrobnicator\n")
        blk_file = os.path.join(root, "blocked")
        with open(blk_file, "w") as f:
            f.write("%s  secret-label-xyz\n"
                    % hashlib.sha256(b"\0blocked payload\n").hexdigest())
        local_env = {"PRIVACY_PATTERNS": pat_file, "PRIVACY_BLOCKED": blk_file}

        plants = [
            ("ipv4", 1, "cfg/hosts.txt"),
            ("apkg_other", 1, "src/apkg/tests/other-tests.sh"),
            ("apkg_other", 1, "src/apkg/run-tests.sh"),
            ("apkg_other", 1, "vendor/pkgtools/src/apkg/tests/run-tests.sh"),
            ("ipv6", 1, "cfg/v6.txt"),
            ("contrib_ip", 1, "contrib/hosts.txt"),
            ("msg_ip", 1, "message"),
            ("toolfile", 2, "CLAUDE.md"),
            ("toolfile", 2, "sub/.claude/settings.json"),
            ("keys", 3, "keys/deploy.pem"),
            ("keys", 3, "keys/id_ed25519"),
            ("keys", 3, ".netrc"),
            ("tokens", 3, "secrets/tokens.txt"),
            ("tokens", 3, "app/settings.conf"),
            ("tokens", 3, "etc/shadow"),
            ("images", 4, "images/disk.adf"),
            ("images", 4, "images/big.bin"),
            ("sysfile", 4, "vendor/payload.dat"),
            ("early_sys", 4, "vendor/early.dat"),
            ("coauthor", 5, "message"),
            ("generated", 5, "message"),
            ("robot", 5, "message"),
        ]
        tip_plants = [(tip, 2, "CLAUDE.md"), (tip, 2, "sub/.claude/settings.json")]
        controls = ["README.md", "data/blob.bin", "data/fw.bin", "notes/dns.txt",
                    "AGENTS.md", "docs/network.txt", "media/profiles/root.shadow",
                    "src/apkg/tests/run-tests.sh",
                    "system/MANIFEST.sha256", "notes/.keep"]

        # --all without local extras.
        rc, hits, out = repo.check(["--all", "master"])
        t.ok(rc == 1, "--all exits 1 on hits", out)
        for key, cls, path in plants:
            t.ok(has(hits, c[key], cls, path),
                 "plant class %d caught: %s (%s)" % (cls, path, key), out)
        for sha, cls, path in tip_plants:
            t.ok(has(hits, sha, cls, path), "local tool file at tip: %s" % path, out)
        for path in controls:
            t.ok(not any(h[2] == path for h in hits), "control passes: %s" % path, out)
        for key in ("readme", "binary", "public", "contrib", "example", "shadow",
                    "apkg", "empty"):
            t.ok(not any(c[key].startswith(h[0]) for h in hits),
                 "control commit clean: %s" % key, out)
        expected = [(c[k], cls, p) for k, cls, p in plants] + tip_plants
        stray = [h for h in hits
                 if not any(s.startswith(h[0]) and h[1] == cls and h[2] == p
                            for s, cls, p in expected)]
        t.ok(not stray, "no unexpected hits without local extras", "%r" % stray)

        # Without the allowlist the exempted controls hit.
        no_allow = os.path.join(root, "no-allow")
        open(no_allow, "w").close()
        rc, hits, out = repo.check(["--all", "master", "--allow", no_allow])
        t.ok(has(hits, c["apkg"], 1, "src/apkg/tests/run-tests.sh")
             and has(hits, c["apkg"], 1, "vendor/pkgtools/src/apkg/tests/run-tests.sh"),
             "an empty allowlist exempts nothing", out)

        # --all with the local extras.
        rc, hits, out = repo.check(["--all", "master"], env=local_env)
        t.ok(has(hits, c["local"], 1, "local/plain.txt"),
             "PRIVACY_PATTERNS hit on file text, class 1", out)
        t.ok(has(hits, c["local"], 1, "<withheld>"),
             "PRIVACY_PATTERNS hit on a path, path withheld", out)
        t.ok(any(c["local"].startswith(h[0]) and "local pattern #3" in h[3]
                 for h in hits), "PRIVACY_PATTERNS hit names the pattern line", out)
        t.ok(has(hits, c["blocked"], 4, "local/blocked.bin"),
             "PRIVACY_BLOCKED hit, class 4", out)
        t.ok("frobnicator" not in out and "secret-label-xyz" not in out,
             "local extras never print their contents", out)

        # --range.
        rc, hits, out = repo.check(["--range", "%s..%s" % (c["readme"], c["shadow"])])
        t.ok(rc == 0 and not hits, "--range over the controls exits 0", out)
        rc, hits, out = repo.check(["--range", "%s..master" % c["shadow"]])
        t.ok(rc == 1 and has(hits, c["ipv4"], 1, "cfg/hosts.txt")
             and not any(h[2] in controls for h in hits),
             "--range over the plants exits 1, controls clean", out)

        # Ours: PRIVACY_OURS adds an identity; --ours replaces the default.
        rc, hits, out = repo.check(["--range", "%s..%s" % (c["public"], c["contrib"])],
                                   env={"PRIVACY_OURS": "%s <%s>\n" % OTHER})
        t.ok(has(hits, c["contrib"], 2, "AGENTS.md") and has(hits, c["contrib"], 5, "message"),
             "PRIVACY_OURS makes classes 2 and 5 apply", out)
        rc, hits, out = repo.check(["--range", "%s..%s" % (c["sysfile"], c["coauthor"]),
                                    "--ours", "Somebody <somebody@example.invalid>"])
        t.ok(rc == 0 and not hits, "--ours replaces the default identity", out)

        # --max-size.
        rc, hits, out = repo.check(["--range", "%s..%s" % (c["tokens"], c["images"]),
                                    "--max-size", "8M"])
        t.ok(not any(h[2] == "images/big.bin" for h in hits)
             and has(hits, c["images"], 4, "images/disk.adf"),
             "--max-size raises the limit; extension still caught", out)

        # --tree.
        rc, hits, out = repo.check(["--tree", c["shadow"]])
        t.ok(rc == 0 and not hits, "--tree on a clean commit exits 0", out)
        rc, hits, out = repo.check(["--tree", "master"])
        t.ok(rc == 1 and has(hits, tip, 2, "CLAUDE.md") and has(hits, tip, 1, "cfg/hosts.txt")
             and has(hits, tip, 4, "images/disk.adf") and has(hits, tip, 4, "vendor/early.dat")
             and not any(h[1] == 5 or h[2] == "AGENTS.md" for h in hits),
             "--tree on master: files and local tool files, no messages", out)

        # --pre-push: a new branch checks only what no remote-tracking ref has.
        repo.git("update-ref", "refs/remotes/origin/master", tip)
        repo.git("checkout", "-q", "-b", "topic", c["shadow"])
        topic = repo.commit(OURS, {"net/new.txt": j("peer ", dotted(192, 168, 7, 7), "\n")},
                            "Add a peer")
        stdin = j("refs/heads/topic ", topic, " refs/heads/topic ", ZERO, "\n",
                  "(delete) ", ZERO, " refs/heads/gone ", c["shadow"], "\n")
        rc, hits, out = repo.check(["--pre-push", "origin", "https://example.invalid/r.git"],
                                   stdin=stdin)
        t.ok(rc == 1 and [(h[1], h[2]) for h in hits] == [(1, "net/new.txt")]
             and topic.startswith(hits[0][0]),
             "--pre-push new branch: only the new commit is checked", out)
        rc, hits, out = repo.check(["--pre-push", "origin", "https://example.invalid/r.git"],
                                   stdin=j("(delete) ", ZERO, " refs/heads/gone ", tip, "\n"))
        t.ok(rc == 0 and not hits, "--pre-push skips a deleted ref", out)

        added_lines(t, env, root, local_env)
        binaries_and_compiled(t, env, root)
        ci_range(t, env, root)

        # Fail closed.
        rc, _, out = repo.check(["--tree", "master", "--exclude-remotes"])
        t.ok(rc == 2, "--exclude-remotes with --tree is a usage error (exit 2)", out)
        rc, _, out = repo.check([])
        t.ok(rc == 2, "no mode is a usage error (exit 2)", out)
        rc, _, out = repo.check(["--all", "no-such-ref"])
        t.ok(rc == 2, "unknown ref exits 2", out)
        rc, _, out = repo.check(["--all", "master"],
                                env={"PRIVACY_PATTERNS": os.path.join(root, "missing")})
        t.ok(rc == 2, "unreadable PRIVACY_PATTERNS exits 2", out)
        bad = os.path.join(root, "bad-patterns")
        with open(bad, "w") as f:
            f.write("(\n")
        rc, _, out = repo.check(["--all", "master"], env={"PRIVACY_PATTERNS": bad})
        t.ok(rc == 2 and "line 1" in out, "invalid PRIVACY_PATTERNS regex exits 2", out)
        # having looked at nothing is an error
        blank = os.path.join(root, "blank-list")
        with open(blank, "w") as f:
            f.write("# a comment\n\n")
        rc, _, out = repo.check(["--all", "master"], env={"PRIVACY_PATTERNS": blank})
        t.ok(rc == 2 and "PRIVACY_PATTERNS lists nothing" in out, "a PRIVACY_PATTERNS that lists nothing exits 2", out)
        rc, _, out = repo.check(["--all", "master"], env={"PRIVACY_BLOCKED": blank})
        t.ok(rc == 2 and "PRIVACY_BLOCKED lists nothing" in out, "a PRIVACY_BLOCKED that lists nothing exits 2", out)
        rc, _, out = repo.check(["--range", "master..master"])
        t.ok(rc == 2 and "has no commits" in out, "a range with no commits exits 2", out)
        rc, _, out = repo.check(["--empty-ok", "--range", "master..master"])
        t.ok(rc != 2 and "0 commit(s)" in out, "--empty-ok: a range with no commits is no error, and says 0", out)
        rc, _, out = repo.check(["--all", "master"])
        t.ok("no local patterns: the public classes only" in out, "without a local list the output says so", out)
        emptytree = subprocess.run(["git", "hash-object", "-t", "tree", "/dev/null"], cwd=repo.path,
                                   stdout=subprocess.PIPE, text=True).stdout.strip()
        rc, _, out = repo.check(["--tree", emptytree])
        t.ok(rc == 2 and "holds no file" in out, "a tree with no file exits 2", out)
        sub = subprocess.run(["git", "mktree"], cwd=repo.path, stdout=subprocess.PIPE, text=True,
                             input="160000 commit %s\tvendored\n" % ("1" * 40)).stdout.strip()
        rc, _, out = repo.check(["--tree", sub])
        t.ok(rc == 2 and "not read" in out, "a tree holding a submodule exits 2", out)
        empty = os.path.join(root, "not-a-repo")
        os.makedirs(empty)
        rc, _, out = repo.check(["--all", "master"], cwd=empty,
                                env={"GIT_CEILING_DIRECTORIES": root})
        t.ok(rc == 2, "outside a repository exits 2", out)
    except Exception as e:
        t.ok(False, "test harness", "%s: %s" % (e.__class__.__name__, e))
    finally:
        shutil.rmtree(root, ignore_errors=True)

    print("%d/%d passed" % (t.passed, t.total))
    return 0 if t.total and t.passed == t.total else 1


if __name__ == "__main__":
    sys.exit(main())
