@@ -660,6 +660,35 @@
  * (20-module-format-and-abi.md section 6, C3-1 section 4).  The
  * syntax was checked by dlm_ld_moddata.
  */
+/* major mj of type 'c' or 'b' is registered to name: 0, else ECONFIG */
+int
+dlm_majowned(type, mj, name)
+	int type, mj;
+	char *name;
+{
+	struct dlm_majreg *r;
+
+	for (r = dlm_majreg; r->r_type; r++)
+		if (r->r_type == type && r->r_major == mj)
+			return strcmp(r->r_name, name) == 0 ? 0 : ECONFIG;
+	return ECONFIG;
+}
+
+/*
+ * A code pointer a module hands the kernel (a switch entry, a qinit
+ * routine): 0, kernel text, or the module's own image.  Kernel data and
+ * the arena, where other modules live, are refused, which
+ * [stext, end) alone did not do (plan patch 13).
+ */
+int
+dlm_okcode(m, a)
+	struct dlm_mod *m;
+	unsigned long a;
+{
+	return a == 0 || (a >= DLM_KLO && a < DLM_KTEXT) ||
+	    (a >= m->m_run && a - m->m_run <= m->m_size - 2 && m->m_size >= 2);
+}
+
 static int
 md_majors(v, name)
 	char *v, *name;
