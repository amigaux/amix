+ * The manifest's root record for name: 0 with its bss= (0 if absent) and
+ * its match= keys (into keys, cap bytes) if there is a "module <name>
+ * root" record whose crc32= is crc, else ENOENT.
  */
 static int
-man_root(name, crc, bssp)
-	char *name;
+man_root(name, crc, bssp, keys, cap)
+	char *name, *keys;
 	unsigned long crc;
 	long *bssp;
+	int cap;
 {
 	char *p = dlm_man, *lim = dlm_man + dlm_manlen, *l, v[16], nm[MODMAXNAMELEN];
 	unsigned long c;
@@ -240,6 +242,8 @@
