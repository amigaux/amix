Subject: modadmin -L: the kernel's message buffer, oldest first

What the core and the modules print after boot reaches putbuf but not the
console (S3-43, 2026-10-26).  -L finds putbuf, putbufsz and putbufwpos in
the namelist /stand/unix that kbootset writes for the booted kernel
(amix-dlm C2-4 section 12), reads them through /dev/kmem and prints the
ring from the write position round.  User side only: dlm.o is unchanged.

--- a/modadmin.c
+++ b/modadmin.c
@@ -22,11 +22,19 @@
  *	modadmin -B			the boot-class modules of the booted
  *					generation, once a boot: the first
  *					sysinit entry runs it (root)
+ *	modadmin -L			the kernel's message buffer, oldest
+ *					first: what the core and the modules
+ *					printed, also after the console
+ *					stopped showing kernel messages
  *
  * -k, -p and -w look a name up with getksym: the kernel's exported names
  * first, then each loaded module's own globals, so a module's tunables
  * and counters, which move with the module, are reached by name.
  *
+ * -L finds putbuf, putbufsz and putbufwpos in the namelist /stand/unix,
+ * which kbootset writes for the booted kernel (amix-dlm C2-4 section 12),
+ * and reads them through /dev/kmem.
+ *
  * Exit status 1 if any operand failed.  Built for AMIX with libmod.a.
  *
  * K&R C.
@@ -68,6 +76,110 @@
 	return buf;
 }
 
+void	fail();
+
+/* big-endian fields of an ELF file in memory */
+static unsigned long
+be32(p)
+	unsigned char *p;
+{
+	return (unsigned long)p[0] << 24 | (unsigned long)p[1] << 16 | (unsigned long)p[2] << 8 | p[3];
+}
+
+/*
+ * The values of the names in /stand/unix's symbol table: val[i] for
+ * name[i], 0 when absent; sz[i] the symbol's size.  0, or -1 when the
+ * namelist cannot be read.
+ */
+int
+namelist(names, n, val, sz)
+	char **names;
+	int n;
+	unsigned long *val, *sz;
+{
+	unsigned char *b, *s, *e;
+	unsigned long shoff, len, so, ss, str, i;
+	int fd, shnum, k, j;
+	long l;
+
+	for (j = 0; j < n; j++)
+		val[j] = sz[j] = 0;
+	if ((fd = open("/stand/unix", O_RDONLY)) < 0)
+		return -1;
+	l = lseek(fd, 0L, 2);
+	if (l < 52 || (b = (unsigned char *)malloc((unsigned)l)) == 0 ||
+	    lseek(fd, 0L, 0) != 0 || read(fd, (char *)b, (unsigned)l) != (int)l) {
+		close(fd);
+		return -1;
+	}
+	close(fd);
+	len = (unsigned long)l;
+	shoff = be32(b + 32);
+	shnum = b[48] << 8 | b[49];
+	if (memcmp(b, "\177ELF", 4) != 0 || shoff + (unsigned long)shnum * 40 > len)
+		return -1;
+	for (k = 0; k < shnum; k++) {
+		s = b + shoff + 40 * k;
+		if (be32(s + 4) != 2 || be32(s + 24) >= (unsigned long)shnum)	/* SHT_SYMTAB */
+			continue;
+		so = be32(s + 16);
+		ss = be32(s + 20);
+		str = be32(b + shoff + 40 * be32(s + 24) + 16);
+		if (so + ss > len)
+			return -1;
+		for (i = 16; i + 16 <= ss; i += 16) {
+			e = b + so + i;
+			if (str + be32(e) >= len)
+				continue;
+			for (j = 0; j < n; j++)
+				if (strcmp((char *)b + str + be32(e), names[j]) == 0) {
+					val[j] = be32(e + 4);
+					sz[j] = be32(e + 8);
+				}
+		}
+	}
+	free((char *)b);
+	return 0;
+}
+
+/* the kernel's message buffer, oldest first */
+void
+msgbuf()
+{
+	static char *names[] = { "putbuf", "putbufsz", "putbufwpos" };
+	unsigned long val[3], sz[3], n, w, i;
+	long v;
+	char *buf;
+	int fd;
+
+	if (namelist(names, 3, val, sz) != 0 || !val[0] || !val[2]) {
+		errno = ENOENT;
+		fail("cannot find putbuf in", "/stand/unix (kbootset namelist)");
+		return;
+	}
+	if ((fd = open("/dev/kmem", O_RDONLY)) < 0) {
+		fail("cannot open", "/dev/kmem");
+		return;
+	}
+	n = sz[0];
+	if (val[1] && lseek(fd, (long)val[1], 0) >= 0 && read(fd, (char *)&v, sizeof v) == sizeof v &&
+	    v > 0 && (unsigned long)v <= sz[0])
+		n = (unsigned long)v;
+	if (n == 0 || (buf = (char *)malloc((unsigned)n)) == 0 ||
+	    lseek(fd, (long)val[2], 0) < 0 || read(fd, (char *)&v, sizeof v) != sizeof v ||
+	    lseek(fd, (long)val[0], 0) < 0 || read(fd, buf, (unsigned)n) != (int)n) {
+		close(fd);
+		fail("cannot read", "putbuf");
+		return;
+	}
+	close(fd);
+	w = (unsigned long)v % n;
+	for (i = 0; i < n; i++)		/* from the write position round: oldest first */
+		if (buf[(w + i) % n])
+			putchar(buf[(w + i) % n]);
+	free(buf);
+}
+
 void
 fail(what, arg)
 	char *what, *arg;
