+/* ---- the halt pass (30 section 2 patch 11, S4-07) ---- */
+extern int dlm_halted;
+static char halt_order[16];
+
+int
+h_hl1(m, a, b)
+	char *m, *a;
+	long b;
+{
+	strcat(halt_order, "1");
+	return 0;
+}
+
+int
+h_hl2(m, a, b)
+	char *m, *a;
+	long b;
+{
+	strcat(halt_order, "2");
+	return 0;
+}
+
+void
+halt_tests()
+{
+	unsigned long v, ok = host_ktext;
+	int i1, i2, i3, i4;
+
+	host_handler("hl1_halt", h_hl1);
+	host_handler("hl2_halt", h_hl2);
+	check(modload("hl1", &i1) == 0 && modload("hl2", &i2) == 0 && modload("hl3", &i3) == 0 &&
+	    modload("hl4", &i4) == 0, "halt: four modules load (two halt entries, one not code, one none)");
+	dlm_blklookup(dlm_ktab, "lbolt", &v, (int *)0);
+	host_ktext = v;		/* kernel text ends below lbolt, kernel data */
+	check(dlm_halt() == 2 && strcmp(halt_order, "21") == 0,
+	    "halt: each halt entry runs once, newest first; one in kernel data is skipped");
+	check(dlm_halt() == 0 && strcmp(halt_order, "21") == 0, "halt: a second call does nothing");
+	host_ktext = ok;
+	dlm_halted = 0;
+	moduload(i4);
+	moduload(i3);
+	moduload(i2);
+	moduload(i1);
+}
+
