Subject: the halt pass: dlm_halt runs each module's halt entry, newest first

30 section 2 patch 11 (S4-07).  The wrapper's halt entry was filled by
the macros and never called.  dlm_halt() runs each settled module's halt
entry, newest first, once, so a board that can interrupt or write memory
is stopped before the kernel halts or reboots (M-HALT1).  The kernel
calls it from mdboot, before haltsys or rtnfirm, for uadmin's A_SHUTDOWN
and A_REBOOT only, never from panic or the keyboard reset.  An entry that
is not code is named and skipped.  It returns how many entries ran.  The
state harness checks the order, the skip and that a second call does
nothing.

--- a/dlm_core.c
+++ b/dlm_core.c
@@ -1296,6 +1296,45 @@
 	return n;
 }
 
+/*
+ * The halt pass (30 section 2 patch 11, S4-07).  Before the kernel halts
+ * or reboots, each settled module's halt entry runs, newest first, so a
+ * board that can interrupt or write memory is stopped (M-HALT1).  The
+ * kernel calls it from mdboot, before haltsys or rtnfirm, for uadmin's
+ * A_SHUTDOWN and A_REBOOT only: never from panic or the keyboard reset,
+ * which reach haltsys too.  It runs once; an entry that is not code is
+ * named and skipped.  Returns how many entries ran.
+ */
+int	dlm_halted;
+
+int
+dlm_halt()
+{
+	struct dlm_mod *m, *done;
+	unsigned long w;
+	int n = 0;
+
+	if (!dlm_inited || dlm_halted++)
+		return 0;
+	for (done = 0; done != dlm_list; done = m) {
+		for (m = dlm_list; m->m_next != done; m = m->m_next)
+			;
+		if ((m->m_flags & (DM_TRANS | DM_SYMOK)) != DM_SYMOK)
+			continue;
+		if ((w = G32(DLM_RP(m, m->m_wrapper) + MW_HALT)) == 0)
+			continue;
+		if (!dlm_okcode(m, w)) {
+			printf("dlm: %s: its halt entry is not code; skipped\n", m->m_name);
+			continue;
+		}
+		(void)DLM_CALL(m, w, 0, 0);
+		n++;
+	}
+	if (n)
+		printf("dlm: halt pass: %d module(s) stopped\n", n);
+	return n;
+}
+
 static int
 dlm_modstat(uap, rvp)
 	struct modstata *uap;
