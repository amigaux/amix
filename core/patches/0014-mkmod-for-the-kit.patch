Subject: mkmod for the ABI kit: MKMOD_CC, driver and STREAMS types

The ABI kit (amix-dlm abi/, S3-10) runs mkmod from its own directory,
with the compiler and flags its make fragment sets in MKMOD_CC, so no
toolchain env.sh is needed beside it; without MKMOD_CC, mkmod sources it
as before.  $modtype accepts drv and str as well as misc (the wrapper
macro does the linkage; the type names the registration line).

--- a/tools/mkmod
+++ b/tools/mkmod
@@ -1,12 +1,14 @@
 #!/bin/sh
-# mkmod -- build a loadable module from a module directory (MISC type).
+# mkmod -- build a loadable module from a module directory (misc, drv or
+# str type: the wrapper macro does the linkage).
 #
 #   mkmod [-k kernel.elf | -e exports] [-d depmodule]... [-K kabi] [-P pin]
 #         [-o outdir] dir
 #
 # dir holds:
 #   Driver.o   the module's code (any number of objects linked into it)
-#   Master     "$depend a b ..." lines (any number), "$modtype misc",
+#   Master     "$depend a b ..." lines (any number), "$modtype misc|drv|str"
+#              (the wrapper macro's type; misc when absent),
 #              the .moddata v2 keys as "$class boot|demand", "$cpu 68020"
 #              (required), "$match", "$majors", "$unload", "$tier",
 #              "$build", "$desc" (one each) and "$param" (any number),
@@ -32,7 +34,12 @@
 HERE=$(cd "$(dirname "$0")" && pwd)
 DLM=$(cd "$HERE/.." && pwd)
 AUX=$(cd "$DLM/../.." && pwd)
-. "$AUX/toolchain/src/gcc-cross-amix/build/env.sh"
+# MKMOD_CC: the compiler and flags, set by the ABI kit's make fragment
+# (amix-dlm abi/mk/module.mk); without it, the tree's toolchain env.sh
+if [ -z "$MKMOD_CC" ]; then
+	. "$AUX/toolchain/src/gcc-cross-amix/build/env.sh"
+	MKMOD_CC="m68k-cbm-sysv4-gcc $AMIX_KERNEL_CFLAGS"
+fi
 TB="${DLM_TOOLS:-$DLM/build/tools}"
 
 KERN= EXP= DEPS= OUT=./build
@@ -59,7 +66,10 @@
 [ -n "$NAME" ] && [ -n "$PREFIX" ] || { echo "mkmod: no definition line in Master" >&2; exit 1; }
 DEPEND=$(sed -n 's/^\$depend[ 	]*//p' "$D/Master" | tr '\n' ' ')
 TYPE=$(sed -n 's/^\$modtype[ 	]*//p' "$D/Master" | tail -1)
-[ -z "$TYPE" ] || [ "$TYPE" = misc ] || { echo "mkmod: \$modtype $TYPE not supported yet" >&2; exit 1; }
+case "${TYPE:=misc}" in
+misc|drv|str) ;;
+*) echo "mkmod: \$modtype $TYPE not supported yet" >&2; exit 1 ;;
+esac
 [ -n "$KABI" ] && [ -n "$PIN" ] || { echo "mkmod: the kernel's kabi and pin (-K, -P or DLM_KABI, DLM_PIN)" >&2; exit 1; }
 key() { sed -n "s/^\\\$$1[ 	]*//p" "$D/Master" | tail -1; }
 CLASS=$(key class) CPU=$(key cpu)
@@ -71,7 +81,7 @@
 mkdir -p "$OUT/mod.d" "$OUT/mod_register.d" "$OUT/loadmods.d"
 W="$OUT/work.$NAME"
 rm -rf "$W"; mkdir -p "$W"
-CC="m68k-cbm-sysv4-gcc $AMIX_KERNEL_CFLAGS -I$DLM/include"
+CC="$MKMOD_CC -I$DLM/include"
 OBJS="$D/Driver.o"
 
 if [ -n "$DELAY" ]; then
@@ -117,7 +127,7 @@
 fi
 "$TB/modfix" ${EXP:+-e "$EXP"} $DEPS -p "$PREFIX" -m "$NAME" "$W/$NAME"
 mv "$W/$NAME" "$OUT/mod.d/$NAME"
-echo "misc	$NAME" > "$OUT/mod_register.d/$NAME"
+echo "$TYPE	$NAME" > "$OUT/mod_register.d/$NAME"
 rm -f "$OUT/loadmods.d/$NAME"
 if [ -f "$D/System" ] && awk -v n="$NAME" '$1==n && $2=="Y"{f=1} END{exit !f}' "$D/System"; then
 	echo "$NAME" > "$OUT/loadmods.d/$NAME"
