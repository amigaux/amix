+/* ---- the registration backstop (dlm_core.c sweep) ---- */
+static int swp_rv;
+static int (*swp_fn)();
+
+int
+h_swp(m, a, b)
+	char *m, *a;
+	long b;
+{
+	swp_fn = (int (*)())modsym((struct dlm_mod *)m, "swp_load");
+	intr_attach(6, swp_fn, (char *)0, "swp");
+	return swp_rv;
+}
+
+static void
+sweep_tests()
+{
+	int id;
+
+	host_handler("swp_load", h_swp);
+	swp_rv = EIO;
+	check(modload("swp", &id) == EIO && !byname("swp") && intr_detach(6, swp_fn, (char *)0) == ENOENT,
+	    "backstop: a handler left by a failed _load is removed");
+	swp_rv = 0;
+	check(modload("swp", &id) == 0 && byname("swp") && moduload(id) == 0 && !byname("swp") &&
+	    intr_detach(6, swp_fn, (char *)0) == ENOENT,
+	    "backstop: a handler an _unload forgot is removed");
+}
+
