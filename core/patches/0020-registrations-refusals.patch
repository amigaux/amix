+/* every ifstats link and the console hook pointing into [lo, hi), removed:
+ * a module's backstop (dlm_core.c sweep); the count */
+int
+dlm_ddi_sweep(lo, hi)
+	unsigned long lo, hi;
+{
+	struct ifs_link **pp;
+	int s, n = 0;
+
+	SPLHI(s);
+	for (pp = &ifstats; *pp; )
+		if ((unsigned long)*pp >= lo && (unsigned long)*pp < hi) {
+			*pp = (*pp)->ifs_next;
+			n++;
+		} else
+			pp = &(*pp)->ifs_next;
+	if (cons_hook && (unsigned long)cons_hook >= lo && (unsigned long)cons_hook < hi) {
+		cons_hook = 0;
+		n++;
+	}
+	SPLX(s);
+	return n;
+}
