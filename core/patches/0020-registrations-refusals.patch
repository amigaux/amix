+/*
+ * After a module's _unload, or after its _load failed: any interrupt
+ * handler, network interface or console hook still pointing into its
+ * image is removed and named, so nothing calls into freed memory.  The
+ * module should have undone them itself (C3-6 section 1.1); this is the
+ * backstop (plan patch 14, "every registration tracked").
+ */
+static void
+sweep(m)
+	struct dlm_mod *m;
+{
+	unsigned long lo = m->m_run, hi = m->m_run + m->m_size;
+	int n;
+
+	n = dlm_intr_sweep(lo, hi);
+#ifndef DLM_HOST
+	n += dlm_ddi_sweep(lo, hi);
+#endif
+	if (n)
+		printf("dlm: %s left %d registration(s) pointing into it (an interrupt handler, "
+		    "network interface or console hook): removed\n", m->m_name, n);
+}
+
