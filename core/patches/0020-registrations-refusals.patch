+/* every chain entry whose handler lies in [lo, hi), removed: a module's
+ * backstop (dlm_core.c sweep); the count */
+int
+dlm_intr_sweep(lo, hi)
+	unsigned long lo, hi;
+{
+	struct dlm_intr *c;
+	int i, l, s, n = 0;
+
+	for (l = 0; l < 2; l++) {
+		c = l ? int6_chain : int2_chain;
+		for (i = 0; i < INTR_MAX; i++)
+			if (c[i].i_fn && (unsigned long)c[i].i_fn >= lo &&
+			    (unsigned long)c[i].i_fn < hi) {
+				SPLHI(s);
+				c[i].i_fn = 0;
+				SPLX(s);
+				n++;
+			}
+	}
+	return n;
+}
+
