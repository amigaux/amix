 /*
+ * Word 0 of .moddata: exactly one relocation there, R_68K_32 with addend
+ * 0 (C3-1 section 1), which the wrapper check then follows.
+ */
+static int
+mdword0(ld)
+	struct dlm_ld *ld;
+{
+	char r[RELASZ];
+	unsigned long i, k, n;
+	int found = 0;
+
+	for (i = 1; i < ld->ld_shnum; i++) {
+		if (SHW(ld, i, SH_TYPE) != SHT_RELA || SHW(ld, i, SH_INFO) != ld->ld_modsec)
+			continue;
+		n = SHW(ld, i, SH_SIZE) / RELASZ;
+		for (k = 0; k < n; k++) {
+			if (rdx(ld, SHW(ld, i, SH_OFFSET) + k * RELASZ, r, (long)RELASZ, ERELOC))
+				return ERELOC;
+			if (G32(r) != 0)
+				continue;
+			if ((G32(r + 4) & 0xff) != R_68K_32 || G32(r + 8) != 0)
+				return ERELOC;
+			found++;
+		}
+	}
+	return found == 1 ? 0 : ERELOC;
+}
+
+/*
  * The type-13 section: read, then checked as .moddata version 2.  Word 0
  * is the wrapper's relocation (checked with the image), bytes 4..7 are
  * "MD2\0", then NUL-terminated key=value strings end with an empty one.
