 dlm_zalloc(n)
 	long n;
 {
+	if (dlm_nosleep)
+		return n > DLM_NOSLEEPMAX ? (char *)0 :
+		    (char *)kmem_zalloc((size_t)(n ? n : 1), KM_NOSLEEP);
 	return (char *)kmem_zalloc((size_t)(n ? n : 1), KM_SLEEP);
 }
 
