+/* ---- no-sleep mode (30 section 2 patch 3, S4-02) ---- */
+extern long host_kblocks, host_km_sleep, host_km_nosleep;
+extern int host_nomem_after;
+
+void
+nosleep_tests()
+{
+	long bytes, blocks, sl;
+	int id, k, e = -1, n = nloaded(), clean = 1;
+
+	dlm_nosleep = 1;
+	check(dlm_zalloc(DLM_NOSLEEPMAX + 1) == 0, "no-sleep: a request over 1 MiB fails (U1)");
+	bytes = host_kbytes;
+	blocks = host_kblocks;
+	sl = host_km_sleep;
+	for (k = 1; k < 200; k++) {
+		host_nomem_after = k;
+		if ((e = modload("pmf", &id)) == 0)
+			break;
+		if (e != ENOMEM || byname("pmf") || nloaded() != n ||
+		    host_kbytes != bytes || host_kblocks != blocks)
+			clean = 0;
+	}
+	host_nomem_after = 0;
+	check(k > 1 && k < 200 && clean,
+	    "no-sleep: each failing allocation of a load -> ENOMEM, the kernel as it was");
+	check(e == 0 && byname("pmf") && host_km_sleep == sl,
+	    "no-sleep: with memory the load succeeds, and nothing asks to sleep");
+	dlm_nosleep = 0;
+	moduload(id);
+	check(!byname("pmf") && host_kbytes == bytes && host_kblocks == blocks,
+	    "no-sleep: the unload returns every byte");
+}
