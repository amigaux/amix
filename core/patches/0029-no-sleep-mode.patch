 /* ---- small helpers ---- */
 
+/*
+ * No-sleep mode (30 section 2 patch 3): the root pass runs at level 7
+ * with the clock stopped (U1), where nothing may sleep.  There a request
+ * may fail, and one over 1 MiB always does; every allocation on a load
+ * path checks for 0 and the load fails with ENOMEM, leaving the kernel
+ * as it was.
+ */
+int	dlm_nosleep;
+
+#define	NOMEM(e)	((e) == ENOMEM && dlm_nosleep)
+
