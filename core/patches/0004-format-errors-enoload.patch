Subject: a file that is not a loadable module is ENOLOAD

dlm_ld_hdr() refused a file that is not an ELF32 big-endian ET_REL
EM_68K object, has a bad section-header size, or lacks exactly one
allocated type-13 section with EINVAL.  amix-dlm's contract
docs/contracts/C3-1-module-object.md (section 4) gives ENOLOAD (164)
for these, so the caller can tell a bad object from a bad argument;
mod.h's comment says so.  The error paths' expectations follow.

--- a/dlm_ld.c
+++ b/dlm_ld.c
@@ -62,16 +62,16 @@
 	unsigned long shoff, t, f, al, off, sz;
 	int e, i, nmod = 0, nsymtab = 0;
 
-	if ((e = rdx(ld, 0L, eh, (long)EHSZ, EINVAL)) != 0)
+	if ((e = rdx(ld, 0L, eh, (long)EHSZ, ENOLOAD)) != 0)
 		return e;
 	if (eh[0] != 0x7f || eh[1] != 'E' || eh[2] != 'L' || eh[3] != 'F' ||
 	    eh[4] != ELFCLASS32 || eh[5] != ELFDATA2MSB ||
 	    G16(eh + 16) != ET_REL || G16(eh + 18) != EM_68K)
-		return EINVAL;
+		return ENOLOAD;
 	shoff = G32(eh + 32);
 	ld->ld_shnum = G16(eh + 48);
 	if (G16(eh + 46) != SHSZ || ld->ld_shnum < 2)
-		return EINVAL;
+		return ENOLOAD;
 	if ((unsigned long)ld->ld_shnum * SHSZ > (unsigned long)dlm_maximage)
 		return ENOMEM;
 	ld->ld_sh = dlm_zalloc((long)ld->ld_shnum * SHSZ);
@@ -88,7 +88,7 @@
 			ld->ld_modsec = i;
 		}
 	if (nmod != 1 || SHW(ld, ld->ld_modsec, SH_SIZE) < 4)
-		return EINVAL;
+		return ENOLOAD;
 
 	ld->ld_secoff[0] = NOSEC;
 	off = 0;
