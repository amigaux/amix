+/* ---- the arena load path (30 section 2 patch 2, S4-01) ---- */
+
+/* a module's file as boot2 places it: 16-aligned, then a zeroed tail */
+static char *
+arfile(name, lenp, tail, skew)
+	char *name;
+	long *lenp, tail;
+	int skew;
+{
+	char path[512], *b;
+	FILE *f;
+	long n;
+
+	sprintf(path, "%s/etc/conf/mod.d/%s", host_root, name);
+	if ((f = fopen(path, "rb")) == 0)
+		return 0;
+	fseek(f, 0L, 2);
+	n = ftell(f);
+	fseek(f, 0L, 0);
+	b = (char *)calloc(1, (size_t)(n + tail + 64));
+	b = (char *)(((unsigned long)b + 15) & ~15UL) + skew;
+	if (fread(b, 1, (size_t)n, f) != (size_t)n)
+		n = 0;
+	fclose(f);
+	*lenp = n;
+	return b;
+}
+
+void
+arena_tests()
+{
+	struct dlm_mod *m;
+	unsigned long t, bv, cm;
+	long len;
+	char *p;
+
+	p = arfile("ar1", &len, 128L, 0);
+	check(p && dlm_load_mem("ar1", p, len, 128L, &m) == 0 && (m = byname("ar1")) != 0 &&
+	    m->m_base == p && m->m_alloc == 0, "arena: a root module links where boot2 put it, nothing allocated");
+	t = m->m_run + ((len + 15) & ~15L);
+	bv = modsym(m, "ar1_bv");
+	cm = modsym(m, "ar1_com");
+	check(bv >= t && bv + 64 <= m->m_run + m->m_size && cm >= t && cm + 32 <= m->m_run + m->m_size,
+	    "arena: its .bss and its common lie in the tail behind the file");
+	check(G32(DLM_RP(m, modsym(m, "ar1_ptr"))) == bv && G32(DLM_RP(m, modsym(m, "ar1_cptr"))) == cm,
+	    "arena: data relocated in place against them");
+	check(moduload(m->m_id) == EBUSY && byname("ar1"), "arena: a root module is pinned");
+	p = arfile("ar1b", &len, 128L, 0);
+	check(p && dlm_load_mem("ar1b", p, len, 16L, &m) == ENOLOAD && !byname("ar1b"),
+	    "arena: a tail smaller than its bss -> ENOLOAD");
+	check(dlm_load_mem("ar1b", arfile("ar1b", &len, 128L, 2), len, 128L, &m) == ENOLOAD &&
+	    !byname("ar1b"), "arena: a file not 16-aligned -> ENOLOAD");
+	p = arfile("ar2", &len, 128L, 0);
+	check(p && dlm_load_mem("ar2", p, len, 128L, &m) != 0 && !byname("ar2") && !byname("ar9"),
+	    "arena: a dependency not linked before it is refused, never read from a file");
+	p = arfile("ardm", &len, 128L, 0);
+	check(p && dlm_load_mem("ardm", p, len, 128L, &m) == ECONFIG && !byname("ardm"),
+	    "arena: a module that is not root class -> ECONFIG");
+}
