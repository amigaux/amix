+/*
+ * A root-class module from the arena (30 section 2 patch 2, C4-4 section
+ * 4): its file at p, len bytes, 16-aligned, with the zeroed tail of bss
+ * bytes boot2 reserved from len rounded up to 16.  The allocated PROGBITS
+ * sections are relocated where they lie, NOBITS and COMMON go into the
+ * tail, and nothing is allocated for the image or ever freed.  A module
+ * it depends on must already be linked.
+ */
+int
+dlm_load_mem(name, p, len, bss, mp)
+	char *name, *p;
+	long len, bss;
+	struct dlm_mod **mp;
+{
+	struct dlm_guard g;
+
+	if (!dlm_inited)
+		return ENOSYS;
+	if (strlen(name) > MODMAXNAMELEN - 1 || p == 0 || len <= 0 || bss < 0)
+		return EINVAL;
+	bzero((caddr_t)&g, sizeof g);
+	g.g_src = p;
+	g.g_srclen = len;
+	g.g_bss = bss;
+	return dlm_load(name, DL_ARENA, 1, &g, mp);
+}
