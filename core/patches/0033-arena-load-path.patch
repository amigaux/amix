+# the arena load path (S4-01): ar1 and ar1b are root class with .bss, a
+# common, and data relocated against both; ar2 needs ar9, never linked
+def armod(p, deps=()):
+    md = ['name=' + p, 'kabi=' + KABI, 'cc=' + PIN, 'cpu=68020', 'class=root',
+          'match=always', 'rank=z3660'] + (['depend=' + ','.join(deps)] if deps else [])
+    mod(p, md=md,
+        text='\t.bss\n\t.globl\t{p}_bv\n{p}_bv:\n\t.space\t64\n'
+             '\t.comm\t{p}_com,32,4\n\t.text\n'.format(p=p),
+        data='\t.globl\t{p}_ptr\n{p}_ptr:\n\t.long\t{p}_bv\n'
+             '\t.globl\t{p}_cptr\n{p}_cptr:\n\t.long\t{p}_com\n'.format(p=p))
+
+
+armod('ar1')
+armod('ar1b')
+armod('ar2', deps=('ar9',))
+mod('ardm')                         # demand class, offered from the arena
+
