+/* the major registry, generated from the ABI kit's file by tools/mkreg */
+struct dlm_majreg {
+	int	r_type;			/* 'c' or 'b'; 0 ends the table */
+	int	r_major;
+	char	*r_name;		/* the module that owns it */
+};
+extern struct dlm_majreg dlm_majreg[];
+
 #endif	/* _DLM_H */
