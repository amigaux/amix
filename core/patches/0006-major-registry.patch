Subject: the major registry: a module's majors are the ones registered to it

A module's .moddata majors= (c:N, b:N) must name numbers the registry
gives to that module; a number registered to another module, or not
registered at all, is refused with ECONFIG (amix-dlm
docs/contracts/C3-1-module-object.md section 4,
20-module-format-and-abi.md section 6).  The registry is a table the
kernel build generates from the ABI kit's file with tools/mkreg
(dlm_majreg[], "c|b major module" lines).  An occupied switch row stays
EEXIST in dlm_creg as before.  30-module-core.md section 2, patch 6.

--- a/dlm_core.c
+++ b/dlm_core.c
@@ -523,6 +523,36 @@
 }
 
 /*
+ * Every major a module's majors= names is registered to it
+ * (20-module-format-and-abi.md section 6, C3-1 section 4).  The
+ * syntax was checked by dlm_ld_moddata.
+ */
+static int
+md_majors(v, name)
+	char *v, *name;
+{
+	struct dlm_majreg *r;
+	int type, n;
+
+	while (*v) {
+		type = *v;
+		for (v += 2, n = 0; *v >= '0' && *v <= '9'; v++)
+			n = n * 10 + (*v - '0');
+		for (r = dlm_majreg; r->r_type; r++)
+			if (r->r_type == type && r->r_major == n)
+				break;
+		if (r->r_type == 0 || strcmp(r->r_name, name) != 0) {
+			printf("dlm: %s: major %c:%d is %s\n", name, type, n,
+			    r->r_type ? "registered to another module" : "not in the registry");
+			return ECONFIG;
+		}
+		if (*v == ',')
+			v++;
+	}
+	return 0;
+}
+
+/*
  * What .moddata says against this kernel (C3-1 sections 3-4): the name
  * is the file's, the kabi family and major are the kernel's and the
  * minor not above it, the compiler pin is the kernel's, a core-tier
@@ -553,6 +583,8 @@
 		printf("dlm: %s: root class is loaded from the arena only\n", name);
 		return ECONFIG;
 	}
+	if (md->md_majoff >= 0 && md_majors(ld->ld_mod + md->md_majoff, name) != 0)
+		return ECONFIG;
 	return 0;
 }
 
