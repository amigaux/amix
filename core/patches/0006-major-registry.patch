 /* the core tier (C3-2): a core-tier kernel name only for a core-tier module */
--- a/tools/mkreg
+++ b/tools/mkreg
@@ -0,0 +1,18 @@
+#!/bin/sh
+# mkreg -- the module core's major registry as C, from the ABI kit's
+# registry file (amix-dlm abi/registry/majors: "c|b major module" lines,
+# '#' comments).  The kernel build compiles the output with the core.
+#
+#   mkreg registry > dlmreg.c
+set -e
+[ $# -eq 1 ] || { echo "usage: mkreg registry" >&2; exit 2; }
+awk -v f="$1" '
+BEGIN { print "/* generated by mkreg from " f "; do not edit */"
+	print "#include \"dlm.h\""
+	print "struct dlm_majreg dlm_majreg[] = {" }
+/^#/ || NF == 0 { next }
+NF != 3 || ($1 != "c" && $1 != "b") || $2 !~ /^[0-9]+$/ || $2 > 255 {
+	print "mkreg: " f ": bad line: " $0 > "/dev/stderr"; bad = 1; exit 1 }
+seen[$1 $2]++ { print "mkreg: " f ": " $1 " " $2 " registered twice" > "/dev/stderr"; bad = 1; exit 1 }
+{ printf "\t{ \x27%s\x27, %d, \"%s\" },\n", $1, $2, $3 }
+END { if (bad) exit 1; print "\t{ 0, 0, 0 }"; print "};" }' "$1"
