+/*
+ * The filesystem switch (C4-6 sections 2 and 3).  The kernel build keeps
+ * the stock table as __amix_vfssw and its count as __amix_nfstype; every
+ * stock reference resolves to the core's, which dmainit fills before
+ * vfsinit walks it.  vfs_register appends a row from a filesystem
+ * module's _load, runs its init as vfsinit would (the row and its index),
+ * and raises nfstype.  There is no unregister: the module is pinned.  A
+ * failed load's row goes with the backstop above.
+ */
+extern struct vfssw __amix_vfssw[];
+extern int	__amix_nfstype;
+
+void
+dlm_vfs_init()
+{
+	int i;
+
+	if (__amix_nfstype > VFS_STATIC)
+		cmn_err(CE_PANIC, "dlm: vfssw has %d stock rows; the module core's table holds %d",
+		    __amix_nfstype, VFS_STATIC);
+	for (i = 0; i < __amix_nfstype; i++)
+		vfssw[i] = __amix_vfssw[i];
+	nfstype = vstatic = __amix_nfstype;
+}
+
+int
+vfs_register(name, init, ops, flag)
+	char *name;
+	int (*init)();
+	struct vfsops *ops;
+	long flag;
+{
+	struct dlm_mod *m = dlm_curmod;
+	struct vfssw *v;
+	int i;
+
+	if (m == 0 || name == 0 || ops == 0 || strcmp(name, m->m_fs)) {
+		printf("dlm: vfs_register: %s is not the calling module's fs=, or no ops\n",
+		    name ? name : "?");
+		return EINVAL;
+	}
+	if (m->m_flags & DM_UNLOADOK) {
+		printf("dlm: %s: a filesystem module must be pinned (no unload=allowed)\n", m->m_name);
+		return EINVAL;
+	}
+	for (i = 1; i < nfstype; i++)
+		if (vfssw[i].vsw_name && strcmp(vfssw[i].vsw_name, name) == 0) {
+			printf("dlm: %s: filesystem type %s is there already\n", m->m_name, name);
+			return EEXIST;
+		}
+	if (nfstype >= vstatic + VFS_SPARE) {
+		printf("dlm: %s: the %d spare vfssw rows are taken\n", m->m_name, VFS_SPARE);
+		return ENOSPC;
+	}
+	v = &vfssw[nfstype];
+	v->vsw_name = name;
+	v->vsw_init = init;
+	v->vsw_vfsops = ops;
+	v->vsw_flag = flag;
+	if (init)			/* as vfsinit: no result (the stock ones are void) */
+		(void)DLM_CALL(m, init, (char *)v, nfstype);
+	nfstype++;
+	return 0;
+}
