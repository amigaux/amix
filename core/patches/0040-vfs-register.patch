+/* ---- vfs_register (C4-6 section 3, S4-41) ---- */
+static int vf_e[8], vf_n, vf_inits, vf_idx;
+static char *vf_row;
+
+int
+h_vfinit(m, a, b)
+	char *m, *a;
+	long b;
+{
+	vf_inits++;
+	vf_row = a;
+	vf_idx = (int)b;
+	return 0;
+}
+
+/* register type t for the calling module, its own init and ops */
+static int
+vf_reg(m, t)
+	char *m, *t;
+{
+	struct dlm_mod *dm = (struct dlm_mod *)m;
+	char sym[16];
+	unsigned long init, ops;
+
+	sprintf(sym, "%s_init", dm->m_name);
+	init = modsym(dm, sym);
+	sprintf(sym, "%s_ops", dm->m_name);
+	ops = modsym(dm, sym);
+	return vfs_register(t, (int (*)())init, (struct vfsops *)ops, 0x10L);
+}
+
+int
+h_vfown(m, a, b)
+	char *m, *a;
+	long b;
+{
+	vf_e[vf_n++] = vf_reg(m, ((struct dlm_mod *)m)->m_name);
+	return 0;
+}
+
+int
+h_vf2(m, a, b)
+	char *m, *a;
+	long b;
+{
+	vf_e[vf_n++] = vf_reg(m, "vfx");
+	vf_e[vf_n++] = vfs_register("vf2", (int (*)())0, (struct vfsops *)0, 0L);
+	return 0;
+}
+
+int
+h_vf3(m, a, b)
+	char *m, *a;
+	long b;
+{
+	vf_e[vf_n++] = vf_reg(m, "ufs");
+	return 0;
+}
+
+int
+h_vf4(m, a, b)
+	char *m, *a;
+	long b;
+{
+	vf_e[vf_n++] = vf_reg(m, "vf4");
+	return EIO;
+}
+
+void
+vfs_tests()
+{
+	static char *own[] = { "vf1_load", "vf5_load", "vf6_load", "vf7_load", "vf8_load",
+		"vf9_load" }, *inits[] = { "vf1_init", "vf4_init", "vf5_init", "vf6_init",
+		"vf7_init", "vf8_init", "vf9_init" };
+	struct dlm_mod *m;
+	int i, id, base = nfstype, ok;
+
+	for (i = 0; i < 6; i++)
+		host_handler(own[i], h_vfown);
+	for (i = 0; i < 7; i++)
+		host_handler(inits[i], h_vfinit);
+	host_handler("vf2_load", h_vf2);
+	host_handler("vf3_load", h_vf3);
+	host_handler("vf4_load", h_vf4);
+	for (ok = base == 12, i = 0; i < 12; i++)
+		ok &= vfssw[i].vsw_name == __amix_vfssw[i].vsw_name;
+	check(ok, "vfs: dmainit copied the 12 stock rows, nfstype 12");
+	check(modload("vfbad", &id) == ECONFIG && !byname("vfbad"), "vfs: a malformed fs= -> ECONFIG");
+	check(vfs_register("vf1", h_vfinit, (struct vfsops *)4, 0L) == EINVAL && nfstype == base,
+	    "vfs: outside a module's _load -> EINVAL");
+	vf_n = vf_inits = 0;
+	check(modload("vf1", &id) == 0 && (m = byname("vf1")) != 0 && vf_e[0] == 0 &&
+	    nfstype == base + 1 && strcmp(vfssw[base].vsw_name, "vf1") == 0 &&
+	    (unsigned long)vfssw[base].vsw_vfsops == modsym(m, "vf1_ops") && vfssw[base].vsw_flag == 0x10,
+	    "vfs: a module registers its fs= type in the next row, nfstype raised");
+	check(vf_inits == 1 && vf_row == (char *)&vfssw[base] && vf_idx == base,
+	    "vfs: its init ran once, with the row and its index, as vfsinit runs it");
+	vf_n = 0;
+	check(modload("vf2", &id) == 0 && vf_e[0] == EINVAL && vf_e[1] == EINVAL && nfstype == base + 1,
+	    "vfs: a name other than the module's fs=, or no ops -> EINVAL");
+	vf_n = 0;
+	check(modload("vf3", &id) == 0 && vf_e[0] == EEXIST && nfstype == base + 1,
+	    "vfs: a type the kernel has already (ufs) -> EEXIST");
+	vf_n = vf_inits = 0;
+	check(modload("vf4", &id) == EIO && !byname("vf4") && vf_e[0] == 0 && vf_inits == 1 &&
+	    nfstype == base + 1 && vfssw[base + 1].vsw_name == 0,
+	    "vfs: a _load that fails after registering leaves no row");
+	vf_n = 0;
+	check(modload("vf5", &id) == 0 && vf_e[0] == EINVAL && nfstype == base + 1,
+	    "vfs: an unloadable module -> EINVAL (a filesystem module is pinned)");
+	moduload(id);
+	vf_n = 0;
+	for (i = 6; i <= 9; i++) {
+		char nm[8];
+
+		sprintf(nm, "vf%d", i);
+		(void)modload(nm, &id);
+	}
+	check(vf_e[0] == 0 && vf_e[1] == 0 && vf_e[2] == 0 && vf_e[3] == ENOSPC && nfstype == base + 4,
+	    "vfs: the four spare rows taken, a fifth type -> ENOSPC");
+	nfstype = base;			/* the rows' modules stay, pinned */
+	bzero((caddr_t)&vfssw[base], 4 * sizeof vfssw[0]);
+}
+
