+# vfs_register (C4-6, S4-41): each fs module has <p>_init and <p>_ops.
+# vf1 registers its own type; vf2 a name not its fs=; vf3 the stock ufs;
+# vf4 fails its _load after registering; vf5 is unloadable; vf6-vf9 fill
+# the spare rows
+def fsmod(p, fs, unload='never'):
+    mod(p, extra=['fs=' + fs, 'unload=' + unload],
+        text='\t.globl\t{p}_init\n{p}_init:\n\trts\n'
+             '\t.globl\t{p}_ops\n{p}_ops:\n\t.long\t0, 0, 0, 0\n'.format(p=p))
+
+
+for p in ('vf1', 'vf2', 'vf4', 'vf6', 'vf7', 'vf8', 'vf9'):
+    fsmod(p, p)
+fsmod('vf3', 'ufs')
+fsmod('vf5', 'vf5', unload='allowed')
+mod('vfbad', extra=['fs=Bad-Name'])
+
