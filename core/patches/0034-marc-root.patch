+/* ---- marc_root (30 section 3, section 2 patch 16; C4-4 section 4) ---- */
+
+#define	AXA1_HDR	32
+#define	AXA1_ENT	48
+#define	AXF_SAFE	0x4		/* a safe-mode member */
+
+/*
+ * The manifest's root record for name: 0 with its bss= (0 if absent) if
+ * there is a "module <name> root" record whose crc32= is crc, else ENOENT.
+ */
+static int
+man_root(name, crc, bssp)
+	char *name;
+	unsigned long crc;
+	long *bssp;
+{
+	char *p = dlm_man, *lim = dlm_man + dlm_manlen, *l, v[16], nm[MODMAXNAMELEN];
+	unsigned long c;
+	long b;
+	int k, h;
+
+	for (; p && p < lim; p = l + 1) {
+		for (l = p; l < lim && *l != '\n'; l++)
+			;
+		if (l - p < 8 || bcmp(p, "module ", 7) != 0)
+			continue;
+		recname(p + 7, l, nm);
+		if (strcmp(nm, name) != 0 || l - (p + 8 + strlen(nm)) < 5 ||
+		    bcmp(p + 8 + strlen(nm), "root ", 5) != 0)
+			continue;
+		if (!attr(p + 8, l, "crc32=", v, sizeof v) || strlen(v) != 8)
+			return ENOENT;
+		for (c = 0, k = 0; k < 8; k++) {
+			h = v[k] >= '0' && v[k] <= '9' ? v[k] - '0' : v[k] >= 'a' && v[k] <= 'f' ?
+			    v[k] - 'a' + 10 : -1;
+			if (h < 0)
+				return ENOENT;
+			c = c << 4 | h;
+		}
+		if (M32(c) != M32(crc))
+			return ENOENT;
+		b = 0;
+		if (attr(p + 8, l, "bss=", v, sizeof v))
+			for (k = 0; v[k]; k++) {
+				if (v[k] < '0' || v[k] > '9' || b > 0x1000000L)
+					return ENOENT;
+				b = b * 10 + (v[k] - '0');
+			}
+		*bssp = b;
+		return 0;
+	}
+	return ENOENT;
+}
+
+/*
+ * The root-class modules in the arena at a, in directory order, in
+ * no-sleep mode: process 0 at level 7 with the clock stopped (U1).  For
+ * each entry its bytes' CRC-32 again (bytes changed after boot2 checked
+ * them are not linked, and that boot never reaches multi-user); the
+ * manifest copy's root record with that name and crc32=, and its bss=;
+ * then dlm_load_mem.  ENXIO (no such board) is silent; any other error
+ * is one line.  In safe mode only the safe-mode members link (70 section
+ * 4).  Returns how many linked.
+ */
+int
+dlm_root_pass(a)
+	char *a;
+{
+	struct dlm_mod *m;
+	char *e, name[16];
+	unsigned long off, len, used, want;
+	long i, count, bss;
+	int n = 0, err;
+
+	if (a == 0 || dlm_man == 0 || !dlm_inited)
+		return 0;
+	count = G32(a + 12);
+	used = G32(a + 24);
+	dlm_nosleep = 1;
+	for (i = 0; i < count; i++) {
+		e = a + AXA1_HDR + AXA1_ENT * i;
+		bcopy(e, name, 16);
+		name[15] = 0;
+		off = G32(e + 16);
+		len = G32(e + 20);
+		want = G32(e + 28);
+		if (G32(e + 24) != 1 || (dlm_safe && !(G32(e + 32) & AXF_SAFE)))
+			continue;
+		if (len == 0 || off > used || len > used - off ||
+		    dlm_crc32(a + off, len) != M32(want)) {
+			printf("dlm: root module %s damaged; not linked\n", name);
+			continue;
+		}
+		if (man_root(name, want, &bss) != 0 || ((len + 15) & ~15L) + bss > used - off) {
+			printf("dlm: root module %s is not the booted manifest's; not linked\n", name);
+			continue;
+		}
+		if ((err = dlm_load_mem(name, a + off, (long)len, bss, &m)) == 0)
+			n++;
+		else if (err != ENXIO)
+			printf("dlm: root module %s: error %d\n", name, err);
+	}
+	dlm_nosleep = 0;
+	return n;
+}
+
+/* the kernel's hook in rth1_mountroot, before rth1_apply (30 section 3) */
+void
+dlm_marc_root()
+{
+	int n;
+
+	if ((n = dlm_root_pass(dlm_arena_base)) > 0)
+		printf("dlm: %d root module(s) linked\n", n);
+}
+
