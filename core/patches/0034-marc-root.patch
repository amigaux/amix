+/* ---- marc_root (30 section 3, section 2 patch 16; C4-4, S4-04) ---- */
+extern long host_km_sleep;
+
+int
+h_enxio(m, a, b)
+	char *m, *a;
+	long b;
+{
+	return ENXIO;
+}
+
+/*
+ * An arena as boot2 fills it: the directory, then each module's file
+ * 16-aligned with a 128-byte tail, and a manifest copy beside it.  flags
+ * per entry; damage flips a byte after the CRC is taken; inman 0 leaves
+ * the module out of the manifest.
+ */
+static char *rp_arena, rp_man[2048];
+
+static int
+rpbuild(names, flags, damage, inman, count)
+	char **names;
+	int *flags, *damage, *inman, count;
+{
+	char *a, *f, line[256];
+	long off, len, i;
+	unsigned long crc;
+
+	if (rp_arena == 0)
+		rp_arena = (char *)(((unsigned long)calloc(1, 0x30000) + 15) & ~15UL);
+	a = rp_arena;
+	bzero(a, 0x20000);
+	strcpy(rp_man, "GMF1\ngeneration 7\nline k46\n");
+	off = (32 + 48 * count + 15) & ~15L;
+	for (i = 0; i < count; i++) {
+		if ((f = arfile(names[i], &len, 0L, 0)) == 0)
+			return -1;
+		bcopy(f, a + off, len);
+		crc = dlm_crc32(a + off, (unsigned long)len);
+		strncpy(a + 32 + 48 * i, names[i], 15);
+		P32(a + 32 + 48 * i + 16, off);
+		P32(a + 32 + 48 * i + 20, len);
+		P32(a + 32 + 48 * i + 24, 1);
+		P32(a + 32 + 48 * i + 28, crc);
+		P32(a + 32 + 48 * i + 32, flags[i]);
+		if (damage[i])
+			a[off + 8] ^= 1;
+		if (inman[i]) {
+			sprintf(line, "module %s root %ld at=0 bss=128 crc32=%08lx sha256=0 match=always\n",
+			    names[i], len, crc);
+			strcat(rp_man, line);
+		}
+		off = (off + len + 15 + 128 + 15) & ~15L;
+	}
+	P32(a + 12, count);
+	P32(a + 24, off);
+	strcat(rp_man, "end crc32=00000000\n");
+	dlm_man = rp_man;
+	dlm_manlen = strlen(rp_man);
+	return 0;
+}
+
+void
+root_tests()
+{
+	static char *n1[] = { "rp1", "rp2", "rp3", "rp5" }, *n2[] = { "rp6", "rp7" };
+	static int f1[] = { 1, 1, 1, 1 }, d1[] = { 0, 1, 0, 0 }, m1[] = { 1, 1, 0, 1 };
+	static int f2[] = { 5, 1 }, d2[] = { 0, 0 }, m2[] = { 1, 1 };
+	char *man = dlm_man;
+	long manlen = dlm_manlen, sl;
+	int n;
+
+	host_handler("rp5_load", h_enxio);
+	check(rpbuild(n1, f1, d1, m1, 4) == 0, "marc_root: an arena of four entries built");
+	sl = host_km_sleep;
+	n = dlm_root_pass(rp_arena);
+	check(n == 1 && byname("rp1") && byname("rp1")->m_base > rp_arena &&
+	    byname("rp1")->m_base < rp_arena + 0x20000, "marc_root: the good entry links, in the arena");
+	check(!byname("rp2"), "marc_root: an entry whose bytes changed after boot2 is not linked");
+	check(!byname("rp3"), "marc_root: an entry the manifest copy does not name is not linked");
+	check(!byname("rp5"), "marc_root: a _load that finds no board (ENXIO) is not linked");
+	check(host_km_sleep == sl && dlm_nosleep == 0,
+	    "marc_root: the pass asks nothing that sleeps, and no-sleep mode ends with it");
+	check(rpbuild(n2, f2, d2, m2, 2) == 0, "marc_root: a second arena built");
+	dlm_safe = 1;
+	n = dlm_root_pass(rp_arena);
+	dlm_safe = 0;
+	check(n == 1 && byname("rp6") && !byname("rp7"), "marc_root: in safe mode only the safe-mode members link");
+	check(dlm_root_pass((char *)0) == 0, "marc_root: no arena, nothing");
+	dlm_man = man;
+	dlm_manlen = manlen;
+}
+
