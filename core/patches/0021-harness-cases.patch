-static int pb1_loads;
+static int pb1_loads, pb3_saw = -1;
+
+int
+h_pb3(m, a, b)
+	char *m, *a;
+	long b;
+{
+	pb3_saw = pb1_loads;
+	return 0;
+}
 
 int
 h_pb1(m, a, b)
