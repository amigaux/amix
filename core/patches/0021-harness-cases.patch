+	/* a boot member's dependency loads before it, whatever the order */
+	{
+		static char s4[65];
+
+		hexsha("pb3", s4);
+		sprintf(man, "GMF1\ngeneration 9\n"
+		    "module pb3 boot 300 path=/stand/gen/7/mod/pb3 sha256=%s match=always depend=pb1\n"
+		    "module pb1 boot 300 path=/stand/gen/7/mod/pb1 sha256=%s match=always\n", s4, s1);
+		mkarena(a, man, 1, 1);
+		dlm_arena_check(a, 4096L, &dlm_man, &dlm_manlen, &gen);
+		host_handler("pb3_load", h_pb3);
+		pb1_loads = 0;
+		dlm_marc_run();
+		check(pb3_saw == 1 && byname("pb1") && byname("pb3"),
+		    "marc_post: a boot member's dependency loads before it");
+		if ((m = byname("pb3")) != 0)
+			moduload(m->m_id);
+		if ((m = byname("pb1")) != 0)
+			moduload(m->m_id);
+	}
 	dlm_plat_match = 0;
