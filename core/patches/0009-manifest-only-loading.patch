Subject: manifest-only loading, and the development-load override

Every load -- modload, a dependency, dlm_loadname, the first-open
trampoline -- goes through dlm_load, which now resolves the module only
as a member of the manifest the loader booted: its path= is where it is
read from, and its bytes must hash to its sha256=.  The file is read
once into memory, hashed, and loaded from that copy, so what was hashed
is what loads.  Anything else is EPERM with a console line.  The
manifest is the verbatim copy the loader leaves in the kernel's module
arena (amix-dlm docs/contracts/C3-4-arena-directory.md); dlm_arena.c
finds it through the kernel's identity record (AXK1, C3-3) at dmainit
and checks the directory and the copy's end crc32.  No valid arena means
no module loads that boot; the floor boots.  The loader record's
development-load flag (dlm_devload, set by the platform from AXL1) lets
a module outside the manifest load from the path asked for, said on the
console each time.  modpath adds no search directory a member could use.
SHA-256 and CRC-32 are amix-dlm's loader/common code.
30-module-core.md section 2, patch 17.

--- a/dlm_arena.c
+++ b/dlm_arena.c
@@ -0,0 +1,161 @@
+/*
+ * dlm_arena.c -- manifest-only loading (amix-dlm docs/spec/30-module-core.md
+ * section 2, patch 17; docs/contracts/C3-4-arena-directory.md).
+ *
+ * The loader leaves, in the kernel's module arena, a directory (AXA1) and
+ * a verbatim copy of the manifest it booted.  dlm_arena_init() finds the
+ * arena through the kernel's identity record (AXK1, C3-3) and checks both;
+ * that copy is then the only reference for which modules may load and
+ * what their bytes must hash to.  The loader record's development-load
+ * flag (dlm_devload, set by the platform) lifts that rule, and only that.
+ *
+ * The CRC-32 and SHA-256 are amix-dlm's loader/common code, compiled by
+ * the kernel build with the core.
+ *
+ * K&R C.
+ */
+
+#include "dlm.h"
+
+extern unsigned long ax_crc32();
+extern void ax_crc32_init();
+
+#define	AXA1_MAGIC	0x41584131L	/* 'AXA1' */
+#define	AXK1_MAGIC	0x41584b31L	/* 'AXK1' */
+#define	AXA1_HDR	32
+#define	AXA1_ENT	48
+
+static unsigned long crctab[256];
+
+static int
+hexval(c)
+	int c;
+{
+	return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1;
+}
+
+/*
+ * Check an arena of cap bytes at a: the directory (magic, version,
+ * longwords summing to zero, offsets inside the arena) and the manifest
+ * copy (GMF1, its end crc32= over every byte before the end line).  0 and
+ * *manp, *lenp, *genp if usable, -1 if not.
+ */
+int
+dlm_arena_check(a, cap, manp, lenp, genp)
+	char *a;
+	long cap;
+	char **manp;
+	long *lenp, *genp;
+{
+	unsigned long sum = 0, crc, want = 0;
+	long count, d, len, used, i, e;
+	char *m;
+	int v;
+
+	if (cap < AXA1_HDR || G32(a) != AXA1_MAGIC || G32(a + 4) != (1L << 16 | AXA1_HDR))
+		return -1;
+	count = G32(a + 12);
+	if (count < 0 || count > (cap - AXA1_HDR) / AXA1_ENT)
+		return -1;
+	for (i = 0; i < (AXA1_HDR + AXA1_ENT * count) / 4; i++)
+		sum += G32(a + 4 * i);
+	d = G32(a + 16);
+	len = G32(a + 20);
+	used = G32(a + 24);
+	if (M32(sum) != 0 || d != AXA1_HDR + AXA1_ENT * count || len < 20 ||
+	    d + len > used || used > cap)
+		return -1;
+	m = a + d;
+	if (bcmp(m, "GMF1\n", 5) != 0 || m[len - 1] != '\n')
+		return -1;
+	for (e = len - 2; e > 0 && m[e - 1] != '\n'; e--)
+		;
+	if (len - e != 19 || bcmp(m + e, "end crc32=", 10) != 0)
+		return -1;
+	for (i = 0; i < 8; i++) {
+		if ((v = hexval(m[e + 10 + i])) < 0)
+			return -1;
+		want = want << 4 | v;
+	}
+	if (crctab[1] == 0)
+		ax_crc32_init(crctab);
+	crc = ax_crc32(crctab, m, (unsigned long)e);
+	if (M32(crc) != M32(want))
+		return -1;
+	*manp = m;
+	*lenp = len;
+	*genp = G32(a + 28);
+	return 0;
+}
+
+#ifndef DLM_HOST
+extern char dlm_ident[];		/* AXK1, from the kernel build (C3-3) */
+
+/*
+ * At dmainit: the identity record names the arena (an image offset from
+ * stext) and its capacity.  A kernel without one, or an arena the loader
+ * did not fill, leaves dlm_man 0: no module loads this boot, the floor
+ * boots as always.
+ */
+void
+dlm_arena_init()
+{
+	char *volatile id = dlm_ident;	/* weak: 0 in a kernel without one */
+	unsigned long sum = 0;
+	int i;
+
+	__asm__(".weak dlm_ident");
+	dlm_man = 0;
+	if (id != 0 && G32(id) == AXK1_MAGIC && G32(id + 4) == (1L << 16 | 64)) {
+		for (i = 0; i < 16; i++)
+			sum += G32(id + 4 * i);
+		if (M32(sum) == 0 && dlm_arena_check(stext + G32(id + 40), (long)G32(id + 44),
+		    &dlm_man, &dlm_manlen, &dlm_mangen) == 0) {
+			printf("dlm: modules from generation %d's manifest\n", (int)dlm_mangen);
+			return;
+		}
+	}
+	dlm_man = 0;
+	printf("dlm: no valid arena directory; modules are refused this boot\n");
+}
+#endif
+
+/*
+ * The manifest's record for a boot- or demand-class module: 0 with its
+ * path= (into path, at most cap bytes) and sha256= (64 hex digits into
+ * sha), ENOENT if the manifest names no such module.
+ */
+int
+dlm_man_member(name, path, cap, sha)
+	char *name, *path, *sha;
+	int cap;
+{
+	char *p = dlm_man, *lim = dlm_man + dlm_manlen, *l, *t;
+	int n = strlen(name), k;
+
+	for (; p && p < lim; p = l + 1) {
+		for (l = p; l < lim && *l != '\n'; l++)
+			;
+		if (l - p < 8 + n || bcmp(p, "module ", 7) != 0 || bcmp(p + 7, name, n) != 0 ||
+		    p[7 + n] != ' ')
+			continue;
+		t = p + 8 + n;
+		if (!(l - t > 5 && bcmp(t, "boot ", 5) == 0) && !(l - t > 7 && bcmp(t, "demand ", 7) == 0))
+			continue;
+		path[0] = sha[0] = 0;
+		for (; t < l; t++) {
+			if (t[-1] != ' ')
+				continue;
+			if (l - t > 5 && bcmp(t, "path=", 5) == 0) {
+				for (t += 5, k = 0; t < l && *t != ' ' && k < cap - 1; )
+					path[k++] = *t++;
+				path[k] = 0;
+			} else if (l - t >= 71 && bcmp(t, "sha256=", 7) == 0) {
+				bcopy(t + 7, sha, 64);
+				sha[64] = 0;
+			}
+		}
+		return path[0] == '/' && sha[0] ? 0 : ENOENT;
+	}
+	return ENOENT;
+}
