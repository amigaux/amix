+/* ---- manifest-only loading and the arena directory (patch 17, C3-4) ---- */
+extern unsigned long ax_crc32();
+extern void ax_crc32_init();
+
+/* the SHA-256 of a harness module file, in hex */
+static void
+hexsha(name, out)
+	char *name, *out;
+{
+	static char b[65536];
+	unsigned char s[32];
+	char p[1024];
+	size_t n = 0;
+	FILE *f;
+	int i;
+
+	snprintf(p, sizeof p, "%s/etc/conf/mod.d/%s", host_root, name);
+	if ((f = fopen(p, "rb")) != 0) {
+		n = fread(b, 1, sizeof b, f);
+		fclose(f);
+	}
+	ax_sha256(b, (unsigned long)n, s);
+	for (i = 0; i < 32; i++)
+		sprintf(out + 2 * i, "%02x", s[i]);
+}
+
+/* an AXA1 directory without entries and the manifest man, as boot2 writes */
+static void
+mkarena(a, man, sum_ok, crc_ok)
+	char *a, *man;
+	int sum_ok, crc_ok;
+{
+	static unsigned long tab[256];
+	unsigned long sum = 0, crc;
+	long ml = strlen(man), i;
+
+	memset(a, 0, 4096);
+	P32(a, 0x41584131L);
+	P32(a + 4, 1L << 16 | 32);
+	P32(a + 16, 32);
+	memcpy(a + 32, man, ml);
+	ax_crc32_init(tab);
+	crc = ax_crc32(tab, a + 32, (unsigned long)ml) ^ (crc_ok ? 0 : 1);
+	sprintf(a + 32 + ml, "end crc32=%08lx\n", crc & 0xffffffffUL);
+	ml += 19;
+	P32(a + 20, ml);
+	P32(a + 24, 32 + ml);
+	P32(a + 28, 7);
+	for (i = 0; i < 8; i++)
+		sum += G32(a + 4 * i);
+	P32(a + 8, (0 - sum + (sum_ok ? 0 : 1)) & 0xffffffffUL);
+}
+
+void
+man_tests()
+{
+	static char a[4096], man[2048], s1[65], sd[65];
+	char *m;
+	long len, gen;
+	int id;
+
+	hexsha("pm1", s1);
+	hexsha("pmd", sd);
+	sprintf(man, "GMF1\ngeneration 7\nline k46\n"
+	    "module pm1 boot 300 path=/etc/conf/mod.d/pm1 sha256=%s\n"
+	    "module pm2 demand 300 path=/etc/conf/mod.d/pm2 sha256=%s\n"
+	    "module pmd boot 300 path=/etc/conf/mod.d/pmd sha256=%s\n", s1, s1, sd);
+	mkarena(a, man, 1, 1);
+	check(dlm_arena_check(a, 4096L, &m, &len, &gen) == 0 && m == a + 32 && gen == 7,
+	    "arena: a valid directory and manifest copy");
+	check(dlm_arena_check(a, 64L, &m, &len, &gen) == -1, "arena: a manifest past the arena -> refused");
+	mkarena(a, man, 0, 1);
+	check(dlm_arena_check(a, 4096L, &m, &len, &gen) == -1, "arena: a bad directory check -> refused");
+	mkarena(a, man, 1, 0);
+	check(dlm_arena_check(a, 4096L, &m, &len, &gen) == -1,
+	    "arena: a manifest copy with a wrong end crc32 -> refused");
+	mkarena(a, man, 1, 1);
+	dlm_arena_check(a, 4096L, &dlm_man, &dlm_manlen, &dlm_mangen);
+	dlm_devload = 0;
+	check(modload("pm1", &id) == 0 && byname("pm1"), "manifest: a member whose bytes match loads");
+	check(modload("pm2", &id) == EPERM && !byname("pm2"),
+	    "manifest: a member whose SHA-256 differs -> EPERM");
+	check(modload("pm3", &id) == EPERM && !byname("pm3"), "manifest: a module outside it -> EPERM");
+	check(modload("/etc/conf/mod.d/pm3", &id) == EPERM && !byname("pm3"),
+	    "manifest: an absolute path outside it -> EPERM");
+	check(modload("pmd", &id) != 0 && !byname("pmd") && !byname("pmdep"),
+	    "manifest: a member whose dependency is outside it does not load");
+	dlm_devload = 1;
+	check(modload("pm3", &id) == 0 && byname("pm3"),
+	    "development load: a module outside the manifest loads");
+	dlm_devload = 0;
+	m = dlm_man;
+	dlm_man = 0;
+	check(modload("pmdep", &id) == EPERM && !byname("pmdep"), "no booted manifest: nothing loads");
+	dlm_man = m;
+	dlm_devload = 1;
+}
