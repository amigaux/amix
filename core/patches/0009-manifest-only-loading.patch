+/* the file's bytes from the buffer lf_hashload read */
+static int
+mem_read(ld, off, buf, len)
+	struct dlm_ld *ld;
+	unsigned long off;
+	char *buf;
+	long len;
+{
+	struct dlm_lf *lf = (struct dlm_lf *)ld->ld_rh;
+	long n;
+
+	if (off >= (unsigned long)lf->lf_msz)
+		return len ? DLM_ESHORT : 0;
+	n = lf->lf_msz - (long)off;
+	if (n > len)
+		n = len;
+	bcopy(lf->lf_mbuf + off, buf, n);
+	return n < len ? DLM_ESHORT : 0;
+}
+
+/* free what lf_gate and lf_hashload allocated */
+static void
+lf_mfree(lf)
+	struct dlm_lf *lf;
+{
+	if (lf->lf_mbuf)
+		dlm_free(lf->lf_mbuf, lf->lf_mcap);
+	if (lf->lf_mpath)
+		dlm_free(lf->lf_mpath, (long)MAXPATHLEN);
+	lf->lf_mbuf = lf->lf_mpath = 0;
+}
+
+/*
+ * Manifest-only loading (patch 17): a module loads only as a member of
+ * the manifest the loader booted, from its path=, and only if its bytes
+ * hash to its sha256=.  Development load lets a module outside the
+ * manifest load from the path asked for, and says so every time.
+ */
+static int
+lf_gate(lf, name, pathp)
+	struct dlm_lf *lf;
+	char *name, **pathp;
+{
+	lf->lf_mpath = dlm_zalloc((long)MAXPATHLEN);
+	lf->lf_sha[0] = 0;
+	if (dlm_man && dlm_man_member(name, lf->lf_mpath, MAXPATHLEN, lf->lf_sha) == 0) {
+		*pathp = lf->lf_mpath;
+		return 0;
+	}
+	lf->lf_sha[0] = 0;
+	if (dlm_devload) {
+		printf("dlm: DEVELOPMENT LOAD: %s, outside the booted manifest\n", name);
+		return 0;
+	}
+	if (dlm_man == 0)
+		printf("dlm: %s: no booted manifest, so no module loads this boot\n", name);
+	else
+		printf("dlm: %s is not a member of the booted generation\n", name);
+	return EPERM;
+}
+
+/* Read the whole file once, check its SHA-256, and load from the copy. */
+static int
+lf_hashload(lf)
+	struct dlm_lf *lf;
+{
+	unsigned char sha[32];
+	long cap = 8192, n = 0, i;
+	char *b, *nb;
+	int resid, e;
+	static char hex[] = "0123456789abcdef";
+
+	b = dlm_zalloc(cap);
+	for (;;) {
+		if (n == cap) {
+			if (cap >= dlm_maximage) {
+				dlm_free(b, cap);
+				return ENOMEM;
+			}
+			nb = dlm_zalloc(cap * 2);
+			bcopy(b, nb, n);
+			dlm_free(b, cap);
+			b = nb;
+			cap *= 2;
+		}
+		resid = 0;
+		e = vn_rdwr(UIO_READ, lf->lf_vp, (caddr_t)(b + n), (int)(cap - n), (off_t)n,
+		    UIO_SYSSPACE, 0, 0x7fffffffL, u.u_cred, &resid);
+		if (e) {
+			dlm_free(b, cap);
+			return e;
+		}
+		n += (cap - n) - resid;
+		if (resid)
+			break;
+	}
+	lf->lf_mbuf = b;
+	lf->lf_mcap = cap;
+	lf->lf_msz = n;
+	ax_sha256(b, n, sha);
+	for (i = 0; i < 32; i++)
+		if (lf->lf_sha[2 * i] != hex[sha[i] >> 4] || lf->lf_sha[2 * i + 1] != hex[sha[i] & 15]) {
+			printf("dlm: %s: SHA-256 differs from the booted manifest\n", lf->lf_mod->m_name);
+			return EPERM;
+		}
+	lf->lf_ld.ld_read = mem_read;
+	return 0;
+}
