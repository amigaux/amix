+/* ---- marc_post (patch 16, C3-5) ---- */
+static char pb1_params[256];
+static int pb1_loads;
+
+int
+h_pb1(m, a, b)
+	char *m, *a;
+	long b;
+{
+	pb1_loads++;
+	strcpy(pb1_params, a ? a : "(none)");
+	return 0;
+}
+
+/* the platform's matcher: no board here answers to "dead" */
+int
+hmatch(key)
+	char *key;
+{
+	return strstr(key, "dead") == 0;
+}
+
+void
+post_tests()
+{
+	static char a[4096], man[2048], s1[65], s2[65], s3[65];
+	extern struct cdevsw cdevsw[];
+	extern int dlm_cdev_open(), copen();
+	char *om = dlm_man;
+	long ol = dlm_manlen, gen;
+	struct dlm_mod *m;
+	int id;
+
+	hexsha("pb1", s1);
+	hexsha("pb2", s2);
+	hexsha("pdm", s3);
+	sprintf(man, "GMF1\ngeneration 9\n"
+	    "module pb1 boot 300 path=/etc/conf/mod.d/pb1 sha256=%s match=zorro:144b:01,always\n"
+	    "module pb2 boot 300 path=/etc/conf/mod.d/pb2 sha256=%s match=zorro:dead:01\n"
+	    "module pdm demand 300 path=/etc/conf/mod.d/pdm sha256=%s majors=c:58\n"
+	    "param pb1.x=1\nparam pb2.z=3\nparam pb1.y=two\n", s1, s2, s3);
+	mkarena(a, man, 1, 1);
+	dlm_arena_check(a, 4096L, &dlm_man, &dlm_manlen, &gen);
+	dlm_devload = 0;
+	dlm_plat_match = hmatch;
+	host_handler("pb1_load", h_pb1);
+	dlm_marc_post();
+	check(pb1_loads == 1 && byname("pb1"), "marc_post: a boot member whose match= is satisfied loads");
+	check(strcmp(pb1_params, "x=1 y=two") == 0, "marc_post: its parameters reach _load as one string");
+	check(!byname("pb2"), "marc_post: a boot member whose match= names no board here is not loaded");
+	check(cdevsw[58].d_open == dlm_cdev_open && !byname("pdm"),
+	    "marc_post: a demand member's major is registered, the module not yet loaded");
+	if ((m = byname("pb1")) != 0)
+		moduload(m->m_id);
+	dlm_safe = 1;
+	dlm_marc_post();
+	check(pb1_loads == 1 && !byname("pb1"), "marc_post: in safe mode nothing loads");
+	check(copen(58, 0, OTYP_CHR) != 0 && !byname("pdm") && modload("pb1", &id) == EPERM &&
+	    !byname("pb1"), "safe mode: a first open and a modload are refused too");
+	dlm_safe = 0;
+	dlm_plat_match = 0;
+	dlm_man = om;
+	dlm_manlen = ol;
+	dlm_devload = 1;
+}
+
 void
 hook_tests()
 {
@@ -1000,6 +1066,7 @@
 	host_handler("cd_close", h_cdclose);
 	drv_tests();
 	man_tests();
+	post_tests();
 
 	printf("%d passed, %d failed\n", passes, fails);
