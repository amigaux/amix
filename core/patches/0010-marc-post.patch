--- a/dlm_post.c
+++ b/dlm_post.c
@@ -0,0 +1,157 @@
+/*
+ * dlm_post.c -- marc_post: the boot-class modules, after the root
+ * filesystem is mounted (amix-dlm docs/spec/30-module-core.md section 3,
+ * section 2 patch 16; docs/contracts/C3-5-module-member.md).
+ *
+ * The kernel calls dlm_marc_post() once, in process 0 after vfs_mountroot
+ * returns (or from the first sysinit entry, if loading files in process 0
+ * proves unsafe, U15).  It reads the manifest the loader booted:
+ *
+ *   1. every demand-class record's character majors= are registered for
+ *      that module, so the first open of one loads it;
+ *   2. every boot-class record is loaded, in manifest order (kbootset
+ *      writes them in depend order, and a dependency loads first anyway),
+ *      unless its match= keys name no board in this box.
+ *
+ * Each outcome is one console line; what loaded is in kinfo's module list.
+ * In safe mode nothing loads (70-static-floor.md section 4).
+ *
+ * K&R C.
+ */
+
+#include "dlm.h"
+
+/* the value of key= in the record [p, l) into out; 1 if present */
+static int
+attr(p, l, key, out, cap)
+	char *p, *l, *key, *out;
+	int cap;
+{
+	int n = strlen(key), k;
+
+	for (; p < l; p++) {
+		if (p[-1] != ' ' || l - p <= n || bcmp(p, key, n) != 0)
+			continue;
+		for (p += n, k = 0; p < l && *p != ' ' && k < cap - 1; )
+			out[k++] = *p++;
+		out[k] = 0;
+		return 1;
+	}
+	return 0;
+}
+
+/* the record's module name into name; p points past "module " */
+static void
+recname(p, l, name)
+	char *p, *l, *name;
+{
+	int k;
+
+	for (k = 0; p < l && *p != ' ' && k < MODMAXNAMELEN - 1; )
+		name[k++] = *p++;
+	name[k] = 0;
+}
+
+/* does one of the comma-separated keys name a board here? */
+static int
+matches(keys)
+	char *keys;
+{
+	char key[64], *p = keys;
+	int k;
+
+	if (dlm_plat_match == 0)
+		return 1;		/* no matcher: the module's _load decides */
+	while (*p) {
+		for (k = 0; *p && *p != ',' && k < (int)sizeof key - 1; )
+			key[k++] = *p++;
+		key[k] = 0;
+		if (strcmp(key, "always") == 0 || (*dlm_plat_match)(key))
+			return 1;
+		if (*p == ',')
+			p++;
+	}
+	return 0;
+}
+
+void
+dlm_marc_post()
+{
+	char name[MODMAXNAMELEN], v[MD_MAXSTR + 1], *p, *l, *lim, *q;
+	int pass, e, n;
+
+	if (!dlm_inited || dlm_man == 0)
+		return;
+	if (dlm_safe) {
+		printf("dlm: safe mode: no boot- or demand-class module loads this boot\n");
+		return;
+	}
+	lim = dlm_man + dlm_manlen;
+	for (pass = 1; pass <= 2; pass++)
+		for (p = dlm_man; p < lim; p = l + 1) {
+			for (l = p; l < lim && *l != '\n'; l++)
+				;
+			if (l - p < 8 || bcmp(p, "module ", 7) != 0)
+				continue;
+			recname(p + 7, l, name);
+			q = p + 8 + strlen(name);
+			if (pass == 1 && l - q > 7 && bcmp(q, "demand ", 7) == 0) {
+				if (!attr(q, l, "majors=", v, sizeof v))
+					continue;
+				for (q = v; *q; ) {
+					if (*q != 'c') {
+						printf("dlm: demand module %s: block majors come with "
+						    "stage 4\n", name);
+						break;
+					}
+					for (q += 2, n = 0; *q >= '0' && *q <= '9'; q++)
+						n = n * 10 + (*q - '0');
+					if ((e = dlm_creg(name, n)) != 0)
+						printf("dlm: demand module %s: major %d not registered "
+						    "(error %d)\n", name, n, e);
+					if (*q == ',')
+						q++;
+				}
+			} else if (pass == 2 && l - q > 5 && bcmp(q, "boot ", 5) == 0) {
+				if (attr(q, l, "match=", v, sizeof v) && !matches(v)) {
+					printf("dlm: boot module %s not loaded: no board matches %s\n",
+					    name, v);
+					continue;
+				}
+				if ((e = dlm_loadname(name)) == 0)
+					printf("dlm: boot module %s loaded\n", name);
+				else
+					printf("dlm: boot module %s not loaded: error %d\n", name, e);
+			}
+		}
+}
+
+/*
+ * A member's parameters from the manifest ("param <name>.<pname>=<value>"
+ * records), as one string "<pname>=<value> ..." into buf; buf[0] is 0 when
+ * there are none.  C3-5: passed to the module's _load.
+ */
+void
+dlm_man_params(name, buf, cap)
+	char *name, *buf;
+	int cap;
+{
+	char *p = dlm_man, *l, *lim = dlm_man + dlm_manlen;
+	int n = strlen(name), k = 0, m;
+
+	buf[0] = 0;
+	for (; p && p < lim; p = l + 1) {
+		for (l = p; l < lim && *l != '\n'; l++)
+			;
+		if (l - p <= 7 + n || bcmp(p, "param ", 6) != 0 || bcmp(p + 6, name, n) != 0 ||
+		    p[6 + n] != '.')
+			continue;
+		m = l - (p + 7 + n);
+		if (k + m + 2 > cap)
+			break;
+		if (k)
+			buf[k++] = ' ';
+		bcopy(p + 7 + n, buf + k, m);
+		buf[k += m] = 0;
+	}
+}
