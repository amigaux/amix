# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Jussi Alanärä <jussi@alanara.fi>
#
# i.apkgconf -- APKG class action script for class "apkgconf" (/etc/apkg.conf).
#
# pkgadd runs this with "<src> <dst>" pairs on stdin, one per line, for every
# object of the class it has to lay down (and once with $1 = ENDOFCLASS).
# The class exists so that an UPGRADE of APKG never resets the box's own
# configuration (2026-10-06: APKG 0.2.2 delivered /etc/apkg.conf as a plain
# `e none` object, which pkgadd copies over whatever is there, so an
# `apkg upgrade apkg` put a box with an edited repo= back on the default):
#
#   * <dst> does not exist  -> install the shipped default;
#   * <dst> exists          -> leave it exactly as it is.
#
# The shipped default of the installed version is always readable at
# /usr/apkg/lib/apkg.conf (a plain package file).  Every key in it is also
# apkg's built-in default, so a key that a kept file does not name still has
# its documented value -- a new key needs no edit to take effect.
#
# The contents DB records the PACKAGE's size/cksum for this object whether
# this script kept a local file or not (heirloom engine, verified host-side
# 2026-10-06; the stock engine is owed a check on a box).  So a kept local
# file is reported by a plain `pkgchk APKG`, exactly as a hand edit of any
# SVR4 `e` file is; `pkgchk -n APKG`, the SVR4 post-installation check that
# skips editable files, is clean.
#
# A box whose file is still the unedited default of an earlier version is
# not flagged: the 0.2.3 default is byte-identical to 0.2.2's, the heirloom
# pkgadd resets the kept file's mtime to the pkgmap's, and the record then
# matches.  A future template change gives up that property for every box
# still on an older default -- weigh it before editing the template.
#
# Must run under the stock Amix 2.1 pkginstall (/sbin/sh, looks for
# <pkg>/install/i.<class>) and the heirloom engine alike: Bourne sh builtins
# and cp (cmp only for the message), nothing that a miniroot might lack.
#
# MIT License, amix-packagemanager project.

PATH=/sbin:/usr/sbin:/usr/bin:/bin:$PATH
export PATH

rc=0
while read src dst
do
	[ -n "$dst" ] || continue
	if [ -f "$dst" ]
	then
		# say so only when it differs (no cmp on a miniroot: say so)
		cmp -s "$src" "$dst" 2>/dev/null ||
		echo "$dst: kept as it is; the new default is /usr/apkg/lib/apkg.conf"
	else
		cp "$src" "$dst" || rc=2
	fi
done
exit $rc
