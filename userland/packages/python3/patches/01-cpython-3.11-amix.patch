+#elif defined(__amix__)
+    if (amix_python_monotonic(tp) < 0) {
+        if (raise_exc) PyErr_SetFromErrno(PyExc_OSError);
+        return -1;
+    }
+    if (info) {
+        info->implementation = "AMIX times() elapsed ticks";
+        info->resolution = 1.0 / amix_python_clock_hz();
+        info->monotonic = 1;
+        info->adjustable = 0;
