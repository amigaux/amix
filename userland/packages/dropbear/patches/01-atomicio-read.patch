Amix declares read(2) as int read(int, void *, unsigned), and GCC 14's
size_t is unsigned long: the same width, but a different type, so passing
read where atomicio() wants ssize_t (*)(int, void *, size_t) is an error.
amix_read (port/amix-compat.h) is read cast to that type.

diff -ru a/src/cli-agentfwd.c b/src/cli-agentfwd.c
--- a/src/cli-agentfwd.c	2026-11-01 10:52:09.416484125 +0200
+++ b/src/cli-agentfwd.c	2026-11-01 10:52:09.428439010 +0200
@@ -142,7 +142,7 @@
 	TRACE(("Wrote out bytes for agent_request"))
 	/* Now we read the response */
 	inbuf = buf_new(4);
-	ret = atomicio(read, fd, buf_getwriteptr(inbuf, 4), 4);
+	ret = atomicio(amix_read, fd, buf_getwriteptr(inbuf, 4), 4);
 	if (ret != 4) {
 		TRACE(("read of length failed for agent_request"))
 		goto out;
@@ -158,7 +158,7 @@
 	
 	inbuf = buf_resize(inbuf, readlen);
 	buf_setpos(inbuf, 0);
-	ret = atomicio(read, fd, buf_getwriteptr(inbuf, readlen), readlen);
+	ret = atomicio(amix_read, fd, buf_getwriteptr(inbuf, readlen), readlen);
 	if ((size_t)ret != readlen) {
 		TRACE(("read of data failed for agent_request"))
 		goto out;
