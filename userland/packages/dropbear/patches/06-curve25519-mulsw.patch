+/* x*38 by shifts and adds: GCC makes a 64-bit multiply a call to
+ * libgcc's __muldi3 on the 68020-68060, and folds plain shifts and adds
+ * back into one; the empty asm hides a term from that fold. */
+static i64 mul38(i64 x)
+{
+  u64 a=(u64)x<<1,b=a<<4,c=a<<1;
+#ifdef __GNUC__
+  __asm__("" : "+g"(b), "+g"(c));
+#endif
+  return (i64)(b+c+a);
+}
+#define MUL38(x) mul38(x)
+
