 }
 
+/* Column k of the product is the sum of x[i]*y[k-i].  Each 32-bit
+ * product gets 2^31 added (its top bit flipped), so the terms are
+ * unsigned and the 64-bit sum needs only add/addx; the 2^31s come off at
+ * the end.  The square sums each cross product once and doubles it. */
+sv M(gf o,const gf a,const gf b)
+{
+  i16 x[16],y[16];
+  i64 t[31];
+  int i,k,lo;
+  u64 acc;
+  norm16(x,a);
+  norm16(y,b);
+  FOR(k,31) {
+    lo=k>15?k-15:0;
+    acc=0;
+    for(i=lo;i<=k-lo;i++) acc+=(w32)((i32)x[i]*y[k-i])^0x80000000U;
+    t[k]=(i64)(acc-((u64)(i-lo)<<31));
+  }
+  fold(o,t);
+}
