+/* The field multiply in 16x16->32 products, which every 68020-68060
+ * does in one instruction (MULS.W), summed in 64 bits by add/addx: no
+ * 64-bit multiply, which GCC calls libgcc's __muldi3 for.  Each operand
+ * is first carried into 16 signed limbs in [-2^15,2^15), the same value
+ * mod p; three passes always get there (the third can only carry out of
+ * limb 0 when the second carried out of limb 15, which leaves limbs
+ * 1-15 at the far end, so the carry stops at limb 1).  Constant time:
+ * no branch or index depends on the data. */
+typedef short i16;
+typedef int i32;
+typedef unsigned int w32;
+
+sv norm16(i16 *r,const gf a)
+{
+  int i,k;
+  i64 x,c=0;
+  i32 s[16],d,e;
+  FOR(i,16) {
+    x=a[i]+c;
+    c=(x+0x8000)>>16;
+    s[i]=(i32)(x-(i64)((u64)c<<16));
+  }
+  e=(i32)c;
+  FOR(k,2) {
+    s[0]+=(i32)(((unsigned)e<<5)+((unsigned)e<<2)+((unsigned)e<<1));
+    e=0;
+    FOR(i,16) {
+      d=s[i]+e;
+      e=(d+0x8000)>>16;
+      s[i]=d-(i32)((unsigned)e<<16);
+    }
+  }
+  s[0]+=(i32)(((unsigned)e<<5)+((unsigned)e<<2)+((unsigned)e<<1));
+  FOR(i,16) r[i]=(i16)s[i];
+}
