PKG=patch
NAME=GNU patch 2.5.9 - apply a diff to an original
ARCH=Amiga
VERSION=2.5.9-2
CATEGORY=development
CLASSES=none
VENDOR=amix-packages
# PSTAMP is authored rather than left to pkgmk.  Unset, pkgmk stamps the package
# with <build-host-name><timestamp>, which leaks whichever machine ran the build
# into a file meant for distribution.
PSTAMP=amix-packages-patch-2.5.9-2
# The description used to say "SVR4 ships no patch at all".  The bench run
# disproved that on Amix specifically: the stock `public` package installs Larry
# Wall's patch 12u4 (1990) at /usr/public/bin/patch, and it does read unified
# diffs.  The honest claim is the one below -- this is a 2003 GNU release
# replacing a 1990 one, and /usr/local/bin precedes /usr/public/bin on the stock
# PATH, so it takes precedence without displacing anything.
DESC=GNU patch 2.5.9 applies unified, context and ed-format diffs. Supersedes the 1990 Larry Wall patch 12u4 in /usr/public/bin. Installs /usr/local/bin/patch plus a /usr/bin/patch symlink.
