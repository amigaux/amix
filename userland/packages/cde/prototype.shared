#
# prototype -- CDE 2.5.3 under /opt/amix/dt, with /usr/dt linking to it.
#
# Listed from the stage hook's install (make install into the staging tree,
# moved from /usr/dt to /opt/amix/dt), one line per object as this build
# ships it; this header is written by hand.  pkginfo is generated from
# package.sh.  No install scripts.  /usr/dt is an absolute symlink
# (SYSTEM_PATHS); /usr, /var, /var/spool, /etc and its init.d and rc
# directories, and /usr/share/lib/terminfo/d, belong to the stock system and
# are not declared.  dtterm's terminfo entry (SYSTEM_PATHS) is the box's own
# tic's output, kept in the recipe (README).  The boot
# script /etc/init.d/cde-rpc (cde-rpc(1M)) is one file under three names,
# hard links (l), 0444 root sys as rc.subr(1M)'s scripts are.  Every symbolic link is absolute: the stock pkgadd
# mangles a relative target.  Directories 0755 root sys, files 0644 root
# bin, programs 0755 root bin; dtterm, dtsession and dtappgather setuid
# root and dtmail setgid mail, as CDE's own install makes them (dtterm
# for the utmpx entry of its pty, dtsession to check the password that
# unlocks the screen, dtappgather to gather the application manager under
# /var/dt, dtmail to lock the mail spool).
#
i pkginfo
d none /opt 0755 root sys
f none /etc/init.d/cde-rpc 0444 root sys
l none /etc/rc0.d/K38cde-rpc=/etc/init.d/cde-rpc
l none /etc/rc1.d/K38cde-rpc=/etc/init.d/cde-rpc
l none /etc/rc2.d/S78cde-rpc=/etc/init.d/cde-rpc
d none /opt/amix 0755 root sys
d none /opt/amix/dt 0755 root sys
d none /opt/amix/man 0755 root sys
