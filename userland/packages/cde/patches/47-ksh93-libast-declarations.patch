ksh93: libast declares what Amix's headers do not.

- settimeofday is in Amix's libc with no prototype in <sys/time.h>: the
  tvlib probe declares it when it has none.
- mbrtowc and wcrtomb are libast's own (comp/wc.c) where libc has none,
  as on Amix, but nothing declared mbrtowc, and sfio claimed both were in
  libc before <wchar.h> read that they were not, so neither was declared:
  <wchar.h> declares both and sfio includes it first.
- error_info.write is ssize_t (*)(int, const void*, size_t); Amix declares
  write with int and unsigned, the same types under other names: libast's
  default is a function of that type which calls write.
- procopen calls setenv, which is libast's own (comp/setenv.c) and which
  Amix's <stdlib.h> does not declare: procopen declares it.

--- a/programs/dtksh/ksh93/src/lib/libast/features/tvlib
+++ b/programs/dtksh/ksh93/src/lib/libast/features/tvlib
@@ -1,5 +1,6 @@
 hdr	time
 lib	clock_settime,gettimeofday,settimeofday,stime,utimes
+npt	settimeofday sys/time.h
 lib	nanosleep,usleep
 lib	utimensat -D_ATFILE_SOURCE sys/stat.h note{ complete utimensat implementation }end link{
 	#include <fcntl.h>
@@ -88,6 +89,9 @@
 			return 1;
 		printf("#define tmgettimeofday(p)	gettimeofday(p,(struct timezone*)0)\n");
 #if _lib_settimeofday
+#if _npt_settimeofday
+		printf("extern int	settimeofday(struct timeval*, struct timezone*);\n");
+#endif
 		printf("#define tmsettimeofday(p)	settimeofday(p,(struct timezone*)0)\n");
 #endif
 #endif
