The App Builder's BIL parser under its own names.

dtbuilder links libABil, whose BIL parser is a yacc parser, and Motif's
libUil, whose UIL compiler is another; both define yyparse, yylval, yychar
and yynerrs.  With a shared libUil the program's own definitions win and
the clash goes unseen; linked statically, it is two definitions of each.
The BIL parser takes the prefix abil_yy (bison's api.prefix), and its
lexer, error function and caller follow.

--- a/programs/dtappbuilder/src/libABil/bil_parse.y
+++ b/programs/dtappbuilder/src/libABil/bil_parse.y
@@ -25,9 +25,12 @@
 
 #define TOK (bilP_load_get_token())
 
-void yyerror(char *);
-int yylex(void);
+void abil_yyerror(char *);
+int abil_yylex(void);
 %}
+/* the parser's names apart from other yacc parsers linked into the same program
+ * (Motif's UIL compiler in dtbuilder) */
+%define api.prefix {abil_yy}
 /*
  * We assume that yacc spits out the symbols in the order they are 
  * declared.
--- a/programs/dtappbuilder/src/libABil/bil_lexer.c
+++ b/programs/dtappbuilder/src/libABil/bil_lexer.c
@@ -108,7 +108,7 @@
 
 
 int
-yylex(void)
+abil_yylex(void)
 {
     return get_token(yyin);
 }
@@ -370,7 +370,7 @@
  * Called by the lexical analyzer or parser whenever an error occurs.
  */
 void 
-yyerror(const char *message)
+abil_yyerror(const char *message)
 {
     char        tokenMsg[1024] = "";
     char        errMsg[1024] = "";
--- a/programs/dtappbuilder/src/libABil/bilP.h
+++ b/programs/dtappbuilder/src/libABil/bilP.h
@@ -81,7 +81,7 @@
 /*
  * Symbols generated by lex/yacc
  */
-extern int      yyparse(void);
+extern int      abil_yyparse(void);
 extern FILE     *yyin;
  
 /*
