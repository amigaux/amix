DtWidget and DtTerm: build for SVR4.

- Editor.c: <wctype.h> and <wchar.h> on SVR4, as on Linux and the BSDs.
- TermPrimOSDepI.h: an SVR4 block (not Sun): STREAMS ptys with ttcompat,
  tcsendbreak.
- TermPrimSetUtmp.c: SVR4 keeps utmpx, as Solaris does: ut_host and
  ut_syslen, no pututline; and its ut_id branch.

--- a/lib/DtTerm/TermPrim/TermPrimOSDepI.h	2026-11-20 12:03:13
+++ b/lib/DtTerm/TermPrim/TermPrimOSDepI.h	2026-11-20 12:03:13
@@ -89,6 +89,15 @@
 # endif /* (_XOPEN_VERSION == 3) */
 #endif /* SUN */
 
+#if defined(SVR4) && !defined(sun)
+/* Amiga UNIX (Amix) and other SVR4 systems: STREAMS ptys (/dev/ptmx,
+ * grantpt, ptem, ldterm, ttcompat) and tcsendbreak; no seteuid in an
+ * SVR4.0 libc.so */
+# define USE_STREAMS		/* use streams			*/
+# define USE_STREAMS_TTCOMPAT	/* use ttcompat streams mod	*/
+# define USE_TCSENDBREAK	/* use tiocbreak()		*/
+#endif /* SVR4 */
+
 #ifdef	IBM_ARCHITECTURE
 /* this seems to be #define'ed in the world of imake... */
 # define USE_TIOCCONS		/* use tioccons for -C		*/
--- a/lib/DtTerm/TermPrim/TermPrimSetUtmp.c	2026-11-20 12:03:13
+++ b/lib/DtTerm/TermPrim/TermPrimSetUtmp.c	2026-11-20 12:03:13
@@ -72,6 +72,14 @@
 #define	UT_NO_pututline
 #endif	/* __AIX */
 
+#if	defined(SVR4) && !defined(sun)
+/* Amiga UNIX (Amix) and other SVR4 systems: utmpx, as Solaris */
+#define	UT_UTMPX
+#define	UT_HOST		ut_host
+#define	UT_HOST_LEN	ut_syslen
+#define	UT_NO_pututline
+#endif	/* SVR4 */
+
 
 /* /etc/utmp include files... */
 #ifdef	UT_UTMPX
@@ -357,7 +365,7 @@
 #if defined(__AIX)
 	(void) strncpy(utPtr->ut_id, utmpLine,
 		sizeof(utPtr->ut_id));
-#elif defined(__linux__) || defined(sun)
+#elif defined(__linux__) || defined(sun) || defined(SVR4)
 	if (c = strchr(utmpLine, '/')) {
 	    c++;
 	} else {
--- a/lib/DtWidget/Editor.c	2026-11-20 12:03:13
+++ b/lib/DtWidget/Editor.c	2026-11-20 12:03:13
@@ -64,7 +64,7 @@
 #  include <wchar.h>
 # endif
 # include <libintl.h>
-#elif defined(__linux__) || defined(CSRG_BASED)
+#elif defined(__linux__) || defined(CSRG_BASED) || defined(SVR4)
 # include <wctype.h>
 # include <wchar.h>
 #endif /* linux || CSRG_BASED */
