+		$(KSH_FOR_BUILD) $(DTDOCBOOK) -H $(DTHELP_HTAG2) -L $(LANG) \
 			-o $@ `basename $@ .sdl`/book.sgm
 
 APPMANAGER_SRCS = Appmanager/GEntity.sgm Appmanager/TOC.sgm		\
--- a/doc/en_US.UTF-8/man/Makefile.am	2026-11-20 12:03:13
