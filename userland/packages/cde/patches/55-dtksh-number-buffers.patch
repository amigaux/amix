dtksh: its number buffers hold any long.

catopen and seven text commands print a number into a 10-byte buffer.
On Amix a message catalogue is a heap address, ten digits as a long:
catopen wrote its eleventh byte past the buffer, and dtksh jumped to a
broken return address (dtlp died at start). They hold 24 bytes, as
dtksh's other number buffers do.

--- a/programs/dtksh/xmcmds.c
+++ b/programs/dtksh/xmcmds.c
@@ -3730,7 +3730,7 @@
    char * arg0 = argv[0];
    char * var = argv[1];
    char * catName = argv[2];
-   char buf[10];
+   char buf[24];
    char * altCatName;
    char * ptr;
    nl_catd nlmsg_fd = (nl_catd)-1;
@@ -3966,7 +3966,7 @@
