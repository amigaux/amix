ksh93: probes print 64-bit values without printf's %ll.

Amix's C library printf does not know the ll size: "%016llx" and "%llu"
print the low 32 bits or nothing. The probe for a 64-bit integer type
checked the compiler's 64-bit arithmetic through sprintf "%016llx", failed,
and libast took int as its widest integer (intmax_t), so ksh's arithmetic
and strtoll were 32-bit; the limits and float probes printed LLONG_MAX as
4294967295 and LLONG_MIN as 0. They format those values themselves.

--- a/programs/dtksh/ksh93/src/lib/libast/features/common
+++ b/programs/dtksh/ksh93/src/lib/libast/features/common
@@ -189,8 +189,14 @@
 		p = 0x12345678;
 		p <<= 32;
 		p |= 0x9abcdef0;
-		sprintf(buf, "0x%016llx", p);
-		if (strcmp(buf, "0x123456789abcdef0"))
+		/* format by hand: an old libc printf may not know %ll */
+		for (t = 15; t >= 0; t--)
+		{
+			buf[t] = "0123456789abcdef"[p & 0xf];
+			p >>= 4;
+		}
+		buf[16] = 0;
+		if (strcmp(buf, "123456789abcdef0"))
 			return 1;
 	#endif
 		for (s = 0; s < elementsof(int_size); s++)
--- a/programs/dtksh/ksh93/src/lib/libast/features/limits.c
+++ b/programs/dtksh/ksh93/src/lib/libast/features/limits.c
@@ -69,6 +69,21 @@
 #undef	getpagesize
 #undef	getdtablesize   
 
+#if _typ_uint64_t
+/* an old libc printf may not know %ll: format by hand */
+static char*
+ullstr(uint64_t v)
+{
+	static char	buf[2][24];
+	static int	i;
+	char*		s = buf[i = !i] + sizeof(buf[0]) - 1;
+
+	*s = 0;
+	do *--s = '0' + v % 10; while (v /= 10);
+	return s;
+}
+#endif
+
 int main()
 {
 	char			c;
@@ -251,9 +266,9 @@
 		vll = ull;
 		printf("#ifndef ULLONG_MAX\n");
 		printf("#if _ast_LL\n");
-		printf("#define ULLONG_MAX	%lluULL\n", vll);
+		printf("#define ULLONG_MAX	%sULL\n", ullstr(vll));
 		printf("#else\n");
-		printf("#define ULLONG_MAX	%llu\n", vll);
+		printf("#define ULLONG_MAX	%s\n", ullstr(vll));
 		printf("#endif\n");
 		printf("#endif\n");
 #endif
@@ -262,9 +277,9 @@
