 		printf("#else\n");
-		printf("#define LLONG_MIN	(-%llu-1)\n", vll - 1);
+		printf("#define LLONG_MIN	(-%s-1)\n", ullstr(vll - 1));
 		printf("#endif\n");
 		printf("#endif\n");
 #endif
@@ -273,9 +288,9 @@
