ksh93: a script without #! no longer writes past the stack.

ksh runs a script that has no #! line itself, in a child, and rewrites
its own argument strings so that ps shows the script's command line. The
rewrite cleared one byte past the end of those strings. When the
environment is short ksh moves it and takes its strings into the area
too, and on Amix they end at the top of the stack: the byte past them is
not mapped, and ksh died with a memory fault. It stays within the area.

--- a/programs/dtksh/ksh93/src/cmd/ksh93/sh/main.c
+++ b/programs/dtksh/ksh93/src/cmd/ksh93/sh/main.c
@@ -811,16 +811,18 @@
 		}
 		return;
 	}
-	while((cp = *argv++) && offset < buffsize)
+	/* the area is buff[0] to buff[buffsize-1]; where the strings end at
+	 * the top of the stack, buff[buffsize] is not mapped */
+	while((cp = *argv++) && offset < buffsize - 1)
 	{
-		if(offset + (size=strlen(cp)) >= buffsize)
-			size = buffsize - offset;
+		if(offset + (size=strlen(cp)) >= buffsize - 1)
+			size = buffsize - 1 - offset;
 		memcpy(buff+offset,cp,size);
 		offset += size;
 		buff[offset++] = ' ';
 	}
 	offset--;
-	memset(&buff[offset], 0, buffsize - offset + 1);
+	memset(&buff[offset], 0, buffsize - offset);
 #   endif
 }
 #endif /* !fixargs_disabled */
