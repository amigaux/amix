+    if [[ -n ${DTPRINTCWD-} ]]
     then
         print_cwd=$DTPRINTCWD
         print_cwd_flag=1
     fi
 
-    if (( ${#DTPRINTFILEREMOVE} ))
+    if [[ -n ${DTPRINTFILEREMOVE-} ]]
     then
         HASH check for True
         Uppercase_string=$DTPRINTFILEREMOVE
@@ -197,7 +198,7 @@
         Uppercase_string=""
     fi
 
-    if (( ${#DTPRINTSILENT} ))
