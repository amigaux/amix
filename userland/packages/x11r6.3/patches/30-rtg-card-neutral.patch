-    RegionPtr    clip = cfbGetCompositeClip(pGC);
-    BoxPtr       pextent, pbox;
-    int          i, n, any, x1, y1, x2, y2, bx1, by1, bx2, by2;
-
-    /* nothing large enough for the blitter: cfb's own fill is the fastest */
-    any = 0;
-    if (zz9000BlitMin > 0)
-        for (i = 0; i < nrect && !any; i++)
-            if ((long) prect[i].width * prect[i].height >= zz9000BlitMin)
-                any = 1;
-    if (!any) {
-        (*pPriv->cfbOps->PolyFillRect)(pDraw, pGC, nrect, prect);
-        return;
-    }
-
-    pextent = REGION_EXTENTS(pDraw->pScreen, clip);
-    for (; nrect > 0; nrect--, prect++) {
-        x1 = prect->x + pDraw->x;
-        y1 = prect->y + pDraw->y;
-        x2 = x1 + (int) prect->width;
-        y2 = y1 + (int) prect->height;
-        if (x1 < pextent->x1) x1 = pextent->x1;
-        if (y1 < pextent->y1) y1 = pextent->y1;
-        if (x2 > pextent->x2) x2 = pextent->x2;
-        if (y2 > pextent->y2) y2 = pextent->y2;
-        if (x1 >= x2 || y1 >= y2)
-            continue;
-        n = REGION_NUM_RECTS(clip);
-        pbox = REGION_RECTS(clip);
-        for (; n > 0; n--, pbox++) {
-            bx1 = x1 > pbox->x1 ? x1 : pbox->x1;
-            by1 = y1 > pbox->y1 ? y1 : pbox->y1;
-            bx2 = x2 < pbox->x2 ? x2 : pbox->x2;
-            by2 = y2 < pbox->y2 ? y2 : pbox->y2;
-            if (bx1 < bx2 && by1 < by2)
-                ZZ9000FillBox(pRTG, bx1, by1, bx2, by2,
-                              (unsigned short) pGC->fgPixel);
-        }
-    }
-    ZZ9000BlitFlush();
-}
-
-/* CopyWindow: as cfbCopyWindow, with the blitter. */
-static void
-zzCopyWindow(pWin, ptOldOrg, prgnSrc)
-WindowPtr   pWin;
-DDXPointRec ptOldOrg;
-RegionPtr   prgnSrc;
-{
-    ScreenPtr pScreen = pWin->drawable.pScreen;
-    RegionRec rgnDst;
-    int       dx, dy;
-
-    if (zz9000BlitMin <= 0) {
-        (*zzCfbCopyWindow)(pWin, ptOldOrg, prgnSrc);
-        return;
-    }
-    REGION_INIT(pScreen, &rgnDst, NullBox, 0);
-    dx = ptOldOrg.x - pWin->drawable.x;
-    dy = ptOldOrg.y - pWin->drawable.y;
-    REGION_TRANSLATE(pScreen, prgnSrc, -dx, -dy);
-    REGION_INTERSECT(pScreen, &rgnDst, &pWin->borderClip, prgnSrc);
-    ZZ9000CopyBoxes(GetRTGScreen(pScreen), REGION_RECTS(&rgnDst),
-                    REGION_NUM_RECTS(&rgnDst), dx, dy);
-    ZZ9000BlitFlush();
-    REGION_UNINIT(pScreen, &rgnDst);
-}
-
-/* PaintWindow: a solid background or border to the blitter, else cfb's. */
-static void
-zzPaintWindow(pWin, pRegion, what)
-WindowPtr pWin;
-RegionPtr pRegion;
-int       what;
-{
-    rtgScreenPtr  pRTG = GetRTGScreen(pWin->drawable.pScreen);
-    unsigned long pixel;
-    BoxPtr        pbox;
-    int           n;
-
-    if (what == PW_BACKGROUND) {
-        if (pWin->backgroundState != BackgroundPixel) {
-            (*zzCfbPaintWindowBackground)(pWin, pRegion, what);
-            return;
-        }
-        pixel = pWin->background.pixel;
-    } else {
-        if (!pWin->borderIsPixel) {
-            (*zzCfbPaintWindowBorder)(pWin, pRegion, what);
-            return;
-        }
-        pixel = pWin->border.pixel;
-    }
-    n = REGION_NUM_RECTS(pRegion);
-    pbox = REGION_RECTS(pRegion);
-    for (; n > 0; n--, pbox++)
-        ZZ9000FillBox(pRTG, pbox->x1, pbox->y1, pbox->x2, pbox->y2,
-                      (unsigned short) pixel);
-    ZZ9000BlitFlush();
-}
-
-/* ---------------------------------------------------------------------- */
-/* The GC wrapper                                                          */
-
-static void zzValidateGC(), zzChangeGC(), zzCopyGC(), zzDestroyGC();
-static void zzChangeClip(), zzDestroyClip(), zzCopyClip();
-
-static GCFuncs zzGCFuncs = {
-    zzValidateGC, zzChangeGC, zzCopyGC, zzDestroyGC,
-    zzChangeClip, zzDestroyClip, zzCopyClip,
-};
-
-/* back to cfb's funcs and ops, before calling cfb */
-static void
-zzUnwrap(pGC)
-GCPtr pGC;
-{
-    ZZGCPrivPtr pPriv = ZZGCPriv(pGC);
-
-    pGC->funcs = pPriv->funcs;
-    if (pPriv->wrapped)
-        pGC->ops = pPriv->cfbOps;
-    pPriv->wrapped = FALSE;
-}
-
-/*
-** Ours over cfb's: whatever cfb chose, plus our ops where the state allows
-** (window, GXcopy, all planes; a solid fill for PolyFillRect).  Only a
-** ValidateGC knows the drawable; the other funcs leave cfb's ops in place
-** until the next ValidateGC, which DIX runs before any drawing after them.
-*/
-static void
-zzWrap(pGC, onWindow)
-GCPtr pGC;
-int   onWindow;
-{
-    ZZGCPrivPtr pPriv = ZZGCPriv(pGC);
-
-    pPriv->funcs = pGC->funcs;
-    pGC->funcs = &zzGCFuncs;
-    pPriv->cfbOps = pGC->ops;
-    if (!onWindow || pGC->alu != GXcopy || !ALLPLANES(pGC->planemask))
-        return;
-    pPriv->ops = *pGC->ops;
-    pPriv->ops.CopyArea = zzCopyArea;
-    pPriv->ops.PutImage = ZZ9000PutImage;
-    if (pGC->fillStyle == FillSolid)
-        pPriv->ops.PolyFillRect = zzPolyFillRect;
-    pGC->ops = &pPriv->ops;
-    pPriv->wrapped = TRUE;
-}
-
-static void
-zzValidateGC(pGC, changes, pDraw)
-GCPtr         pGC;
-unsigned long changes;
-DrawablePtr   pDraw;
-{
-    zzUnwrap(pGC);
-    (*pGC->funcs->ValidateGC)(pGC, changes, pDraw);
-    zzWrap(pGC, pDraw->type == DRAWABLE_WINDOW);
-}
-
-static void
-zzChangeGC(pGC, mask)
-GCPtr         pGC;
-unsigned long mask;
-{
-    zzUnwrap(pGC);
-    (*pGC->funcs->ChangeGC)(pGC, mask);
-    zzWrap(pGC, FALSE);
-}
-
-static void
-zzCopyGC(pGCSrc, mask, pGCDst)
-GCPtr         pGCSrc, pGCDst;
-unsigned long mask;
-{
-    zzUnwrap(pGCDst);
-    (*pGCDst->funcs->CopyGC)(pGCSrc, mask, pGCDst);
-    zzWrap(pGCDst, FALSE);
-}
-
-static void
-zzDestroyGC(pGC)
-GCPtr pGC;
-{
-    zzUnwrap(pGC);
-    (*pGC->funcs->DestroyGC)(pGC);
-}
-
-static void
-zzChangeClip(pGC, type, pvalue, nrects)
-GCPtr   pGC;
-int     type, nrects;
-pointer pvalue;
-{
-    zzUnwrap(pGC);
-    (*pGC->funcs->ChangeClip)(pGC, type, pvalue, nrects);
-    zzWrap(pGC, FALSE);
-}
-
-static void
-zzDestroyClip(pGC)
-GCPtr pGC;
-{
-    zzUnwrap(pGC);
-    (*pGC->funcs->DestroyClip)(pGC);
-    zzWrap(pGC, FALSE);
-}
-
-static void
-zzCopyClip(pGCDst, pGCSrc)
-GCPtr pGCDst, pGCSrc;
-{
-    zzUnwrap(pGCDst);
-    (*pGCDst->funcs->CopyClip)(pGCDst, pGCSrc);
-    zzWrap(pGCDst, FALSE);
-}
-
-static Bool
-zzCreateGC(pGC)
-GCPtr pGC;
-{
-    ZZGCPrivPtr pPriv = ZZGCPriv(pGC);
-
-    if (!(*zzCfbCreateGC)(pGC))
-        return FALSE;
-    pPriv->wrapped = FALSE;
-    zzWrap(pGC, FALSE);
-    return TRUE;
-}
-
-/* ---------------------------------------------------------------------- */
-/* Colormaps                                                               */
-
-/*
-** TrueColor has no colour table to load, but one map is always the
-** installed one and clients are told when it changes.  zzInstalledMap is
-** cleared at every screen init, so a reset never leaves it pointing at a
-** freed map.
-*/
-static ColormapPtr zzInstalledMap = (ColormapPtr) NULL;
-
-static int
-zzListInstalledColormaps(pScreen, pmaps)
-ScreenPtr pScreen;
-Colormap *pmaps;
-{
-    if (!zzInstalledMap)
-        return 0;
-    *pmaps = zzInstalledMap->mid;
-    return 1;
-}
-
-static void
-zzInstallColormap(pmap)
-ColormapPtr pmap;
-{
-    ColormapPtr old = zzInstalledMap;
-
-    if (pmap == old)
-        return;
-    if (old)
-        WalkTree(pmap->pScreen, TellLostMap, (pointer) &old->mid);
-    zzInstalledMap = pmap;
-    WalkTree(pmap->pScreen, TellGainedMap, (pointer) &pmap->mid);
-}
-
-static void
-zzUninstallColormap(pmap)
-ColormapPtr pmap;
-{
-    ColormapPtr def;
-
-    if (pmap != zzInstalledMap || pmap->mid == pmap->pScreen->defColormap)
-        return;
-    def = (ColormapPtr) LookupIDByType(pmap->pScreen->defColormap, RT_COLORMAP);
-    if (def)
-        (*pmap->pScreen->InstallColormap)(def);
-}
-
-/* ---------------------------------------------------------------------- */
-/* Screen                                                                  */
-
-/*
-** ZZ9000ScreenInit - cfb16 on the mapped framebuffer, the visual made the
-** card's RGB565, and the blitter's wrappers in.  The caller (rtgInit.c) adds
-** the cursor, input, SaveScreen and CloseScreen, and the default colormap.
-*/
-Bool
-ZZ9000ScreenInit(pScreen, pRTG, dpix, dpiy)
-ScreenPtr    pScreen;
-rtgScreenPtr pRTG;
-int          dpix, dpiy;
-{
-    VisualPtr v;
-    int       i;
-
-    if (zzGeneration != serverGeneration) {
-        zzGCPrivateIndex = AllocateGCPrivateIndex();
-        if (zzGCPrivateIndex < 0)
-            return FALSE;
-        zzGeneration = serverGeneration;
-    }
-
-    /* the card has no colour table at 16 bits: TrueColor only */
-    if (!cfbSetVisualTypes(ZZ9000_DEPTH, 1 << TrueColor, 6))
-        return FALSE;
-    if (!cfbScreenInit(pScreen, (pointer) pRTG->fbBase, pRTG->width,
-                       pRTG->height, dpix, dpiy, pRTG->pitch / 2))
-        return FALSE;
-
-    /* cfb's depth-16 TrueColor is 6-5-5 red-low; the card is RGB565 */
-    for (i = 0, v = pScreen->visuals; i < pScreen->numVisuals; i++, v++) {
-        if (v->class != TrueColor || v->nplanes != ZZ9000_DEPTH)
-            continue;
-        v->redMask         = ZZ9000_RED_MASK;
-        v->greenMask       = ZZ9000_GREEN_MASK;
-        v->blueMask        = ZZ9000_BLUE_MASK;
-        v->offsetRed       = ZZ9000_RED_SHIFT;
-        v->offsetGreen     = ZZ9000_GREEN_SHIFT;
-        v->offsetBlue      = ZZ9000_BLUE_SHIFT;
-        v->bitsPerRGBValue = 6;
-        v->ColormapEntries = 64;
-    }
-
-    /* cfb sets the colormap hooks only when built STATIC_COLOR, which it
-     * is not here: the DDX sets them.  TrueColor: no StoreColors */
-    zzInstalledMap = (ColormapPtr) NULL;
-    pScreen->InstallColormap        = zzInstallColormap;
-    pScreen->UninstallColormap      = zzUninstallColormap;
-    pScreen->ListInstalledColormaps = zzListInstalledColormaps;
-    pScreen->StoreColors            = (void (*)()) NoopDDA;
-
-    if (!AllocateGCPrivate(pScreen, zzGCPrivateIndex, sizeof(ZZGCPrivRec)))
-        return FALSE;
-    zzCfbCreateGC = pScreen->CreateGC;
-    pScreen->CreateGC = zzCreateGC;
-    zzCfbCopyWindow = pScreen->CopyWindow;
-    pScreen->CopyWindow = zzCopyWindow;
-    zzCfbPaintWindowBackground = pScreen->PaintWindowBackground;
-    pScreen->PaintWindowBackground = zzPaintWindow;
-    zzCfbPaintWindowBorder = pScreen->PaintWindowBorder;
-    pScreen->PaintWindowBorder = zzPaintWindow;
-    return TRUE;
-}
