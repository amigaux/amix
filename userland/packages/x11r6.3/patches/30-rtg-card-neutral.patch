+/*
+ * rtgscreen.c -- the RTG screen on X's cfb16 code.
+ *
+ * Written for the x11r63 package: MIT, Copyright (c) 2026 Jussi Alanärä.
+ * It replaces the screen code of Ignacio Soriano's ZZ9000 driver (MIT,
+ * Copyright (c) 2026 isoriano1968), which was based on Antti Sokero's
+ * xrtg-amix (its rtg/ layer and VA2000 driver; MIT, Copyright (c) 2025-2026
+ * Antti Sokero), and keeps a few of its lines.  The notices and licence
+ * texts are in the package's doc/x11r63/LICENSE.ddx.
+ */
+
+/*
+** rtgscreen.c -- the RTG screen: X's own 16-bit framebuffer code (cfb16) on
+** the card's framebuffer, with the card's blitter for large copies and fills.
+**
+** cfbScreenInit (cfb16: PSZ 16) owns the screen: visuals, windows, pixmaps
+** (mfb for depth 1), GCs and their validation, every drawing operation,
+** colormaps and text.  Four places hand work to the card's blitter instead
+** (rtgdraw.c calls the card through rtgCard):
+**   - CopyArea, window to window, GXcopy, all planes: cfb's own BitBlt
+**     (clipping, exposures) with a doBitBlt that sends the boxes to the
+**     blitter in a safe order;
+**   - CopyWindow, the same box walk;
+**   - PolyFillRect, window, FillSolid, GXcopy, all planes;
+**   - PaintWindowBackground and PaintWindowBorder with a solid pixel.
+** Each of them flushes the card's queue before it returns, so the queue is
+** empty whenever cfb's CPU code touches the framebuffer.  PutImage of a
+** picture of the screen's depth into a window under GXcopy uses the direct
+** path (rtgPutImage); everything else is cfb's.
+**
+** MIT licence: holder and text in /opt/amix/X11R6/doc/x11r63/LICENSE.
+*/
+
+#include "X.h"
+#include "Xmd.h"
+#include "Xproto.h"
+#include "scrnintstr.h"
+#include "pixmapstr.h"
+#include "windowstr.h"
+#include "gcstruct.h"
+#include "regionstr.h"
+#include "servermd.h"
+#include "colormapst.h"
+#include "resource.h"
+#include "mi.h"
+#include "cfb.h"
+#include "../amix.h"
+#include "rtg.h"
+#include "rtgdraw.h"
+
+extern RegionPtr cfbBitBlt();
+
+/* The GC wrapper: cfb's funcs and ops, and our copy of the ops when the
+** GC's state lets the blitter or the direct PutImage take some of them. */
+typedef struct {
+    GCFuncs *funcs;         /* cfb's GC funcs */
+    GCOps   *cfbOps;        /* cfb's ops, as its last ValidateGC chose them */
+    GCOps    ops;           /* cfb's ops with ours in; pGC->ops when wrapped */
+    int      wrapped;       /* pGC->ops is &ops */
+} RTGGCPrivRec, *RTGGCPrivPtr;
+
+static int           rtgGCPrivateIndex = -1;
+static unsigned long rtgScrGeneration = 0;
+
+/* cfb's screen functions we wrap (one RTG screen) */
+static Bool (*rtgCfbCreateGC)();
+static void (*rtgCfbCopyWindow)();
+static void (*rtgCfbPaintWindowBackground)();
+static void (*rtgCfbPaintWindowBorder)();
+
+#define RTGGCPriv(pGC) ((RTGGCPrivPtr) (pGC)->devPrivates[rtgGCPrivateIndex].ptr)
+#define ALLPLANES(pm) (((pm) & 0xffff) == 0xffff)
+
+/* ---------------------------------------------------------------------- */
+/* Operations                                                              */
+
+/* CopyArea: window to window goes through cfb's BitBlt with the blitter. */
+static RegionPtr
+rtgCopyArea(pSrc, pDst, pGC, srcx, srcy, w, h, dstx, dsty)
+DrawablePtr pSrc, pDst;
+GCPtr       pGC;
+int         srcx, srcy, w, h, dstx, dsty;
+{
+    RTGGCPrivPtr pPriv = RTGGCPriv(pGC);
+
+    if (pSrc->type == DRAWABLE_WINDOW && pDst->type == DRAWABLE_WINDOW &&
+        rtgBlitMin > 0 && (long) w * h >= rtgBlitMin)
+        return cfbBitBlt(pSrc, pDst, pGC, srcx, srcy, w, h, dstx, dsty,
+                         rtgDoBitbltBlit, 0L);
+    return (*pPriv->cfbOps->CopyArea)(pSrc, pDst, pGC, srcx, srcy, w, h,
+                                      dstx, dsty);
+}
+
+/* PolyFillRect, solid: the clipped boxes to the blitter (or the CPU). */
+static void
+rtgPolyFillRect(pDraw, pGC, nrect, prect)
+DrawablePtr pDraw;
+GCPtr       pGC;
+int         nrect;
+xRectangle *prect;
+{
+    RTGGCPrivPtr  pPriv = RTGGCPriv(pGC);
+    rtgScreenPtr pRTG = GetRTGScreen(pDraw->pScreen);
+    RegionPtr    clip = cfbGetCompositeClip(pGC);
+    BoxPtr       pextent, pbox;
+    int          i, n, any, x1, y1, x2, y2, bx1, by1, bx2, by2;
+
+    /* nothing large enough for the blitter: cfb's own fill is the fastest */
+    any = 0;
+    if (rtgBlitMin > 0)
+        for (i = 0; i < nrect && !any; i++)
+            if ((long) prect[i].width * prect[i].height >= rtgBlitMin)
+                any = 1;
+    if (!any) {
+        (*pPriv->cfbOps->PolyFillRect)(pDraw, pGC, nrect, prect);
+        return;
+    }
+
+    pextent = REGION_EXTENTS(pDraw->pScreen, clip);
+    for (; nrect > 0; nrect--, prect++) {
+        x1 = prect->x + pDraw->x;
+        y1 = prect->y + pDraw->y;
+        x2 = x1 + (int) prect->width;
+        y2 = y1 + (int) prect->height;
+        if (x1 < pextent->x1) x1 = pextent->x1;
+        if (y1 < pextent->y1) y1 = pextent->y1;
+        if (x2 > pextent->x2) x2 = pextent->x2;
+        if (y2 > pextent->y2) y2 = pextent->y2;
+        if (x1 >= x2 || y1 >= y2)
+            continue;
+        n = REGION_NUM_RECTS(clip);
+        pbox = REGION_RECTS(clip);
+        for (; n > 0; n--, pbox++) {
+            bx1 = x1 > pbox->x1 ? x1 : pbox->x1;
+            by1 = y1 > pbox->y1 ? y1 : pbox->y1;
+            bx2 = x2 < pbox->x2 ? x2 : pbox->x2;
+            by2 = y2 < pbox->y2 ? y2 : pbox->y2;
+            if (bx1 < bx2 && by1 < by2)
+                rtgFillBox(pRTG, bx1, by1, bx2, by2, pGC->fgPixel);
+        }
+    }
+    rtgFlush(pRTG);
+}
+
+/* CopyWindow: as cfbCopyWindow, with the blitter. */
+static void
+rtgCopyWindow(pWin, ptOldOrg, prgnSrc)
+WindowPtr   pWin;
+DDXPointRec ptOldOrg;
+RegionPtr   prgnSrc;
+{
+    ScreenPtr    pScreen = pWin->drawable.pScreen;
+    rtgScreenPtr pRTG = GetRTGScreen(pScreen);
+    RegionRec    rgnDst;
+    int          dx, dy;
+
+    if (rtgBlitMin <= 0) {
+        (*rtgCfbCopyWindow)(pWin, ptOldOrg, prgnSrc);
+        return;
+    }
+    REGION_INIT(pScreen, &rgnDst, NullBox, 0);
+    dx = ptOldOrg.x - pWin->drawable.x;
+    dy = ptOldOrg.y - pWin->drawable.y;
+    REGION_TRANSLATE(pScreen, prgnSrc, -dx, -dy);
+    REGION_INTERSECT(pScreen, &rgnDst, &pWin->borderClip, prgnSrc);
+    rtgCopyBoxes(pRTG, REGION_RECTS(&rgnDst), REGION_NUM_RECTS(&rgnDst),
+                 dx, dy);
+    rtgFlush(pRTG);
+    REGION_UNINIT(pScreen, &rgnDst);
+}
+
+/* PaintWindow: a solid background or border to the blitter, else cfb's. */
+static void
+rtgPaintWindow(pWin, pRegion, what)
+WindowPtr pWin;
+RegionPtr pRegion;
+int       what;
+{
+    rtgScreenPtr  pRTG = GetRTGScreen(pWin->drawable.pScreen);
+    unsigned long pixel;
+    BoxPtr        pbox;
+    int           n;
+
+    if (what == PW_BACKGROUND) {
+        if (pWin->backgroundState != BackgroundPixel) {
+            (*rtgCfbPaintWindowBackground)(pWin, pRegion, what);
+            return;
+        }
+        pixel = pWin->background.pixel;
+    } else {
+        if (!pWin->borderIsPixel) {
+            (*rtgCfbPaintWindowBorder)(pWin, pRegion, what);
+            return;
+        }
+        pixel = pWin->border.pixel;
+    }
+    n = REGION_NUM_RECTS(pRegion);
+    pbox = REGION_RECTS(pRegion);
+    for (; n > 0; n--, pbox++)
+        rtgFillBox(pRTG, pbox->x1, pbox->y1, pbox->x2, pbox->y2, pixel);
+    rtgFlush(pRTG);
+}
+
+/* ---------------------------------------------------------------------- */
+/* The GC wrapper                                                          */
+
+static void rtgValidateGC(), rtgChangeGC(), rtgCopyGC(), rtgDestroyGC();
+static void rtgChangeClip(), rtgDestroyClip(), rtgCopyClip();
+
+static GCFuncs rtgGCFuncs = {
+    rtgValidateGC, rtgChangeGC, rtgCopyGC, rtgDestroyGC,
+    rtgChangeClip, rtgDestroyClip, rtgCopyClip,
+};
+
+/* back to cfb's funcs and ops, before calling cfb */
+static void
+rtgUnwrap(pGC)
+GCPtr pGC;
+{
+    RTGGCPrivPtr pPriv = RTGGCPriv(pGC);
+
+    pGC->funcs = pPriv->funcs;
+    if (pPriv->wrapped)
+        pGC->ops = pPriv->cfbOps;
+    pPriv->wrapped = FALSE;
+}
+
+/*
+** Ours over cfb's: whatever cfb chose, plus our ops where the state allows
+** (window, GXcopy, all planes; a solid fill for PolyFillRect).  Only a
+** ValidateGC knows the drawable; the other funcs leave cfb's ops in place
+** until the next ValidateGC, which DIX runs before any drawing after them.
+*/
+static void
+rtgWrap(pGC, onWindow)
+GCPtr pGC;
+int   onWindow;
+{
+    RTGGCPrivPtr pPriv = RTGGCPriv(pGC);
+
+    pPriv->funcs = pGC->funcs;
+    pGC->funcs = &rtgGCFuncs;
+    pPriv->cfbOps = pGC->ops;
+    if (!onWindow || pGC->alu != GXcopy || !ALLPLANES(pGC->planemask))
+        return;
+    pPriv->ops = *pGC->ops;
+    pPriv->ops.CopyArea = rtgCopyArea;
+    pPriv->ops.PutImage = rtgPutImage;
+    if (pGC->fillStyle == FillSolid)
+        pPriv->ops.PolyFillRect = rtgPolyFillRect;
+    pGC->ops = &pPriv->ops;
+    pPriv->wrapped = TRUE;
+}
+
+static void
+rtgValidateGC(pGC, changes, pDraw)
+GCPtr         pGC;
+unsigned long changes;
+DrawablePtr   pDraw;
+{
+    rtgUnwrap(pGC);
+    (*pGC->funcs->ValidateGC)(pGC, changes, pDraw);
+    rtgWrap(pGC, pDraw->type == DRAWABLE_WINDOW);
+}
+
+static void
+rtgChangeGC(pGC, mask)
+GCPtr         pGC;
+unsigned long mask;
+{
+    rtgUnwrap(pGC);
+    (*pGC->funcs->ChangeGC)(pGC, mask);
+    rtgWrap(pGC, FALSE);
+}
+
+static void
+rtgCopyGC(pGCSrc, mask, pGCDst)
+GCPtr         pGCSrc, pGCDst;
+unsigned long mask;
+{
+    rtgUnwrap(pGCDst);
+    (*pGCDst->funcs->CopyGC)(pGCSrc, mask, pGCDst);
+    rtgWrap(pGCDst, FALSE);
+}
+
+static void
+rtgDestroyGC(pGC)
+GCPtr pGC;
+{
+    rtgUnwrap(pGC);
+    (*pGC->funcs->DestroyGC)(pGC);
+}
+
+static void
+rtgChangeClip(pGC, type, pvalue, nrects)
+GCPtr   pGC;
+int     type, nrects;
+pointer pvalue;
+{
+    rtgUnwrap(pGC);
+    (*pGC->funcs->ChangeClip)(pGC, type, pvalue, nrects);
+    rtgWrap(pGC, FALSE);
+}
+
+static void
+rtgDestroyClip(pGC)
+GCPtr pGC;
+{
+    rtgUnwrap(pGC);
+    (*pGC->funcs->DestroyClip)(pGC);
+    rtgWrap(pGC, FALSE);
+}
+
+static void
+rtgCopyClip(pGCDst, pGCSrc)
+GCPtr pGCDst, pGCSrc;
+{
+    rtgUnwrap(pGCDst);
+    (*pGCDst->funcs->CopyClip)(pGCDst, pGCSrc);
+    rtgWrap(pGCDst, FALSE);
+}
+
+static Bool
+rtgCreateGC(pGC)
+GCPtr pGC;
+{
+    RTGGCPrivPtr pPriv = RTGGCPriv(pGC);
+
+    if (!(*rtgCfbCreateGC)(pGC))
+        return FALSE;
+    pPriv->wrapped = FALSE;
+    rtgWrap(pGC, FALSE);
+    return TRUE;
+}
+
+/* ---------------------------------------------------------------------- */
+/* Colormaps                                                               */
+
+/*
+** TrueColor has no colour table to load, but one map is always the
+** installed one and clients are told when it changes.  rtgInstalledMap is
+** cleared at every screen init, so a reset never leaves it pointing at a
+** freed map.
+*/
+static ColormapPtr rtgInstalledMap = (ColormapPtr) NULL;
+
+static int
+rtgListInstalledColormaps(pScreen, pmaps)
+ScreenPtr pScreen;
+Colormap *pmaps;
+{
+    if (!rtgInstalledMap)
+        return 0;
+    *pmaps = rtgInstalledMap->mid;
+    return 1;
+}
+
+static void
+rtgInstallColormap(pmap)
+ColormapPtr pmap;
+{
+    ColormapPtr old = rtgInstalledMap;
+
+    if (pmap == old)
+        return;
+    if (old)
+        WalkTree(pmap->pScreen, TellLostMap, (pointer) &old->mid);
+    rtgInstalledMap = pmap;
+    WalkTree(pmap->pScreen, TellGainedMap, (pointer) &pmap->mid);
+}
+
+static void
+rtgUninstallColormap(pmap)
+ColormapPtr pmap;
+{
+    ColormapPtr def;
+
+    if (pmap != rtgInstalledMap || pmap->mid == pmap->pScreen->defColormap)
+        return;
+    def = (ColormapPtr) LookupIDByType(pmap->pScreen->defColormap, RT_COLORMAP);
+    if (def)
+        (*pmap->pScreen->InstallColormap)(def);
+}
+
+/* ---------------------------------------------------------------------- */
+/* Screen                                                                  */
+
+/* the shift of a mask: its lowest set bit */
+static int
+maskShift(m)
+unsigned long m;
+{
+    int s;
+
+    for (s = 0; m && !(m & 1); s++)
+        m >>= 1;
+    return s;
+}
+
+/*
+** rtgScreenSetup - cfb16 on the mapped framebuffer, the visual made the
+** card's pixel layout (caps), and the blitter's wrappers in.  The caller
+** (rtgInit.c) adds the cursor, input, SaveScreen and CloseScreen, and the
+** default colormap.
+*/
+Bool
+rtgScreenSetup(pScreen, pRTG, dpix, dpiy)
+ScreenPtr    pScreen;
+rtgScreenPtr pRTG;
+int          dpix, dpiy;
+{
+    rtgCardCaps *caps = &rtgCard->caps;
+    VisualPtr    v;
+    int          i;
+
+    if (rtgScrGeneration != serverGeneration) {
+        rtgGCPrivateIndex = AllocateGCPrivateIndex();
+        if (rtgGCPrivateIndex < 0)
+            return FALSE;
+        rtgScrGeneration = serverGeneration;
+    }
+
+    /* no colour table at 16 bits: TrueColor only */
+    if (!cfbSetVisualTypes(caps->depth, 1 << TrueColor, caps->bitsPerRGB))
+        return FALSE;
+    if (!cfbScreenInit(pScreen, (pointer) pRTG->fbBase, pRTG->width,
+                       pRTG->height, dpix, dpiy, pRTG->pitch / 2))
+        return FALSE;
+
+    /* cfb's depth-16 TrueColor is 6-5-5 red-low; the card says its own */
+    for (i = 0, v = pScreen->visuals; i < pScreen->numVisuals; i++, v++) {
+        if (v->class != TrueColor || v->nplanes != caps->depth)
+            continue;
+        v->redMask         = caps->redMask;
+        v->greenMask       = caps->greenMask;
+        v->blueMask        = caps->blueMask;
+        v->offsetRed       = maskShift(caps->redMask);
+        v->offsetGreen     = maskShift(caps->greenMask);
+        v->offsetBlue      = maskShift(caps->blueMask);
+        v->bitsPerRGBValue = caps->bitsPerRGB;
+        v->ColormapEntries = 1 << caps->bitsPerRGB;
+    }
+
+    /* cfb sets the colormap hooks only when built STATIC_COLOR, which it
+     * is not here: the DDX sets them.  TrueColor: no StoreColors */
+    rtgInstalledMap = (ColormapPtr) NULL;
+    pScreen->InstallColormap        = rtgInstallColormap;
+    pScreen->UninstallColormap      = rtgUninstallColormap;
+    pScreen->ListInstalledColormaps = rtgListInstalledColormaps;
+    pScreen->StoreColors            = (void (*)()) NoopDDA;
+
+    if (!AllocateGCPrivate(pScreen, rtgGCPrivateIndex, sizeof(RTGGCPrivRec)))
+        return FALSE;
+    rtgCfbCreateGC = pScreen->CreateGC;
+    pScreen->CreateGC = rtgCreateGC;
+    rtgCfbCopyWindow = pScreen->CopyWindow;
+    pScreen->CopyWindow = rtgCopyWindow;
+    rtgCfbPaintWindowBackground = pScreen->PaintWindowBackground;
+    pScreen->PaintWindowBackground = rtgPaintWindow;
+    rtgCfbPaintWindowBorder = pScreen->PaintWindowBorder;
+    pScreen->PaintWindowBorder = rtgPaintWindow;
+    return TRUE;
+}
