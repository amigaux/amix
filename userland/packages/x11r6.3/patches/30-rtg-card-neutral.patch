-static void
-cpuFill(pRTG, x1, y1, x2, y2, color)
-rtgScreenPtr   pRTG;
-unsigned short x1, y1, x2, y2, color;
-{
-    unsigned short *base;
-    unsigned short *p;
-    int stride;
-    int x, y;
-
-    base = pRTG->fbBase;
-    stride = ZZ9000_selected_mode->w;
-
-    for (y = y1; y <= y2; ++y) {
-        p = base + ((unsigned long)y * stride) + x1;
-        fillRun(p, color, x2 - x1 + 1);
-    }
-}
