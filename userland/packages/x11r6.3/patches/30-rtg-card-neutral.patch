--- /dev/null
+++ b/programs/Xserver/hw/amix/rtg/rtgdraw.c
@@ -0,0 +1,489 @@
+/*
+ * rtgdraw.c -- the RTG layer's drawing: CPU runs, fills and copies, the
+ * box order of a region copy, the direct PutImage.
+ *
+ * Based on Antti Sokero's xrtg-amix (its rtg/ layer and VA2000 driver),
+ * MIT, Copyright (c) 2025-2026 Antti Sokero.  The ZZ9000 version: Ignacio
+ * Soriano, MIT, Copyright (c) 2026 isoriano1968.  The changes for the Z3660
+ * and Amix (amix-z3660rtg, and the x11r63 package's patches): MIT,
+ * Copyright (c) 2026 Jussi Alanärä.  The notices and licence texts are in
+ * the package's doc/x11r63/LICENSE.ddx.
+ */
+
+/*
+** rtgdraw.c - drawing for the cfb16 screen (rtgscreen.c) that does not
+** depend on the card: the CPU fills and copies for what the card's blitter
+** does not take, the ordered copy of a box list, and the direct PutImage
+** path.  The card's blitter is reached only through rtgCard (rtg.h).  All
+** coordinates are absolute screen coordinates; pRTG->fbBase is pixel (0,0),
+** pRTG->pitch bytes a line.
+*/
+
+#include <string.h>
+#include <errno.h>
+#include "X.h"
+#include "Xmd.h"
+#include "scrnintstr.h"
+#include "regionstr.h"
+#include "windowstr.h"
+#include "pixmapstr.h"
+#include "gcstruct.h"
+#include "servermd.h"
+#include "mi.h"
+#include "cfb.h"
+#include "../amix.h"
+#include "rtg.h"
+#include "rtgdraw.h"
+
+#ifndef max
+#define max(a,b) ((a) > (b) ? (a) : (b))
+#endif
+#ifndef min
+#define min(a,b) ((a) < (b) ? (a) : (b))
+#endif
+
+#define RTG_STRIDE(pRTG)  ((pRTG)->pitch / 2)  /* pixels per scanline */
+
+/* ---------------------------------------------------------------------- */
+/* Run helpers: 32-bit stores where both ends allow it.                     */
+
+/*
+** A 32-bit store moves two pixels in one bus cycle where a 16-bit store moves
+** one (Antti measured 0.41 against 0.79 us/pixel on the VA2000 over Zorro III).
+** The high word is the left pixel (big-endian).  Only aligned longs are used:
+** a misaligned 32-bit access to the card's space is split by the CPU in ways
+** this driver does not want to depend on, so a copy whose two ends differ in
+** alignment keeps the 16-bit loop.
+*/
+#define RUN_ODD(p)  (((unsigned long)(p)) & 2)
+
+/*
+** Below this many pixels the alignment work costs more than the longs save:
+** dots, 1x1 rectangles and short line spans (x11perf -dot/-rect1/-line10
+** lost 10-17 % to the 32-bit path on the rig), so short runs keep the plain
+** 16-bit loop.
+*/
+#define RUN_SHORT   4
+
+/* Fill w pixels with one colour. */
+static void
+fillRun(dst, pixel, w)
+unsigned short *dst;
+unsigned short  pixel;
+int             w;
+{
+    unsigned long  two;
+    unsigned long *l;
+    int            n;
+
+    if (w < RUN_SHORT) {
+        while (w-- > 0)
+            *dst++ = pixel;
+        return;
+    }
+    if (RUN_ODD(dst)) {
+        *dst++ = pixel;
+        w--;
+    }
+    two = ((unsigned long)pixel << 16) | pixel;
+    l = (unsigned long *)dst;
+    for (n = w >> 1; n > 0; n--)
+        *l++ = two;
+    if (w & 1)
+        *(unsigned short *)l = pixel;
+}
+
+/* Copy w pixels, left to right. */
+static void
+copyRun(dst, src, w)
+unsigned short *dst;
+unsigned short *src;
+int             w;
+{
+    unsigned long *ld, *ls;
+    int            n;
+
+    if (w < RUN_SHORT || RUN_ODD(dst) != RUN_ODD(src)) {
+        while (w-- > 0)
+            *dst++ = *src++;
+        return;
+    }
+    if (RUN_ODD(dst)) {
+        *dst++ = *src++;
+        w--;
+    }
+    ld = (unsigned long *)dst;
+    ls = (unsigned long *)src;
+    for (n = w >> 1; n > 0; n--)
+        *ld++ = *ls++;
+    if (w & 1)
+        *(unsigned short *)ld = *(unsigned short *)ls;
+}
+
+/* Copy w pixels, right to left (an overlapping move to the right). */
+static void
+copyRunBack(dst, src, w)
+unsigned short *dst;
+unsigned short *src;
+int             w;
+{
+    unsigned long *ld, *ls;
+    int            n;
+
+    if (w <= 0)
+        return;
+    dst += w;                       /* one past the last pixel */
+    src += w;
+    if (w < RUN_SHORT || RUN_ODD(dst) != RUN_ODD(src)) {
+        while (w-- > 0)
+            *--dst = *--src;
+        return;
+    }
+    if (RUN_ODD(dst)) {
+        *--dst = *--src;
+        w--;
+    }
+    ld = (unsigned long *)dst;
+    ls = (unsigned long *)src;
+    for (n = w >> 1; n > 0; n--)
+        *--ld = *--ls;
+    if (w & 1)
+        *((unsigned short *)ld - 1) = *((unsigned short *)ls - 1);
+}
+
+/* ---------------------------------------------------------------------- */
+/* CPU rectangle helpers                                                   */
+
+/* Fill the screen box [x1,x2) x [y1,y2) with pixel, on the CPU. */
+void
+rtgCpuFill(rtgScreenPtr pRTG, int x1, int y1, int x2, int y2,
+           unsigned long pixel)
+{
+    unsigned short *p;
+    int stride, y;
+
+    stride = RTG_STRIDE(pRTG);
+    p = pRTG->fbBase + (unsigned long)y1 * stride + x1;
+    for (y = y1; y < y2; ++y, p += stride)
+        fillRun(p, (unsigned short) pixel, x2 - x1);
+}
+
+/*
+** Pixel base and stride for a drawable (window -> VRAM; pixmap -> host mem).
+*/
+static unsigned short *
+drawBase(pDraw, pRTG)
+DrawablePtr  pDraw;
+rtgScreenPtr pRTG;
+{
+    if (pDraw->type == DRAWABLE_WINDOW)
+        return pRTG->fbBase;
+    return (unsigned short *) ((PixmapPtr)pDraw)->devPrivate.ptr;
+}
+
+static int
+drawStride(pDraw)
+DrawablePtr pDraw;
+{
+    if (pDraw->type == DRAWABLE_WINDOW)
+        return RTG_STRIDE(GetRTGScreen(pDraw->pScreen));
+    return (int)((PixmapPtr)pDraw)->devKind / 2;
+}
+
+/*
+** rtgCpuCopy - copy a screen rectangle in mapped framebuffer memory, rows
+** and columns ordered so that an overlapping move reads every source pixel
+** before it is overwritten.
+*/
+void
+rtgCpuCopy(rtgScreenPtr pRTG, int srcx, int srcy, int w, int h,
+           int dstx, int dsty)
+{
+    unsigned short *fbBase = pRTG->fbBase;
+    int             stride = RTG_STRIDE(pRTG);
+    unsigned short *src;
+    unsigned short *dst;
+    int row;
+    int row_start, row_end, row_step;
+    int back;
+
+    if (w <= 0 || h <= 0)
+        return;
+
+    if (dsty > srcy) {
+        row_start = h - 1; row_end = -1; row_step = -1;
+    } else {
+        row_start = 0; row_end = h; row_step = 1;
+    }
+    back = (dsty == srcy && dstx > srcx);
+
+    for (row = row_start; row != row_end; row += row_step) {
+        src = fbBase + ((unsigned long)(srcy + row) * stride) + srcx;
+        dst = fbBase + ((unsigned long)(dsty + row) * stride) + dstx;
+        if (back)
+            copyRunBack(dst, src, w);
+        else
+            copyRun(dst, src, w);
+    }
+}
+
+/* ---------------------------------------------------------------------- */
+/* The card's blitter, through rtgCard                                     */
+
+/*
+** -blitmin N: window fills (SolidRect GXcopy, PaintWindow) and window-to-
+** window copies (CopyArea GXcopy, CopyWindow) of N pixels or more go to the
+** card's blitter (rtgCard->fillBox, ->copyBox); anything smaller, any other
+** raster op and every pixmap stay on the CPU.  -blitmin 0 never blits.
+** Unset, it is the card's default (caps.blitMin; for the ZZ9000 1024, MG10's:
+** it keeps the 100x100 gains, rect100 585 -> 8140/s and scroll100 311 ->
+** 2260, that 16384 gives up).
+**
+** The common case -- a small area -- must cost no more than before the
+** blitter existed (MG10: -rect1 lost 20 % to three extra calls per 1x1
+** fill), so the tests are macros (RTG_BLIT_WANT) and a flush of an empty
+** queue is one compare (RTG_FLUSH).
+*/
+int rtgBlitMin = -1;            /* -1: unset, the card's caps.blitMin */
+
+/* Fill the screen box [x1,x2) x [y1,y2): the blitter or the CPU. */
+void
+rtgFillBox(pRTG, x1, y1, x2, y2, pixel)
+rtgScreenPtr  pRTG;
+int           x1, y1, x2, y2;
+unsigned long pixel;
+{
+    if (RTG_BLIT_WANT(x2 - x1, y2 - y1) &&
+        (*rtgCard->fillBox)(pRTG, x1, y1, x2, y2, pixel)) {
+        pRTG->queued = 1;
+        return;
+    }
+    RTG_FLUSH(pRTG);
+    rtgCpuFill(pRTG, x1, y1, x2, y2, pixel);
+}
+
+/* Copy a w x h screen box from (srcx,srcy) to (dstx,dsty): blitter or CPU. */
+static void
+copyVRAMBox(pRTG, srcx, srcy, w, h, dstx, dsty)
+rtgScreenPtr pRTG;
+int          srcx, srcy, w, h, dstx, dsty;
+{
+    if (w <= 0 || h <= 0)
+        return;
+    if (RTG_BLIT_WANT(w, h) &&
+        (*rtgCard->copyBox)(pRTG, srcx, srcy, w, h, dstx, dsty)) {
+        pRTG->queued = 1;
+        return;
+    }
+    RTG_FLUSH(pRTG);
+    rtgCpuCopy(pRTG, srcx, srcy, w, h, dstx, dsty);
+}
+
+/* Send what is queued; the card has finished when this returns. */
+void
+rtgFlush(pRTG)
+rtgScreenPtr pRTG;
+{
+    RTG_FLUSH(pRTG);
+}
+
+/* ---------------------------------------------------------------------- */
+/* rtgPutImage                                                             */
+
+/*
+** -move16 turns the move16 line burst on (68040/68060 only: a 68030 has no
+** move16, so it is off by default).  Measured on the A3000 with
+** the Z3660's 68060 (bench/vrambw.c, 2026-10-25): single long writes reach
+** about 10.6 MB/s into VRAM and into RAM alike (the data cache writes
+** through), move16 26 MB/s into VRAM.  move16 wants source and destination
+** on 16-byte boundaries, so it only applies when both rows have the same
+** phase; staging a misaligned row first costs as much as the plain copy.
+*/
+int rtgMove16 = 0;	/* -move16: 68040/68060 only, a 68030 has no move16 */
+
+/*
+** burstRun - copyRun for a host-memory source: the 16-byte-aligned middle
+** moved by move16 when src and dst share their phase in a line, misaligned
+** long reads when they differ by two bytes.  move16 (a0)+,(a1)+ is spelled
+** as words: the AMIX assembler knows no 68040 mnemonics.
+*/
+static void
+burstRun(dst, src, w)
+unsigned short *dst;
+unsigned short *src;
+int             w;
+{
+    register unsigned short *s asm("a0");
+    register unsigned short *d asm("a1");
+    int head, k;
+
+    if (w >= RUN_SHORT && RUN_ODD(dst) != RUN_ODD(src))
+    {
+        /*
+        ** Ends two bytes apart (an odd window x): copyRun would move one
+        ** pixel per store, 59 ms for 512x320 where longs take 34.  The
+        ** source of a PutImage is host memory, never the card, so its longs
+        ** may be read misaligned (the 060 splits them, mostly from the
+        ** cache); every store to the drawable stays an aligned long.
+        */
+        unsigned long *ld;
+        int n;
+
+        if (RUN_ODD(dst))
+        {
+            *dst++ = *src++;
+            w--;
+        }
+        ld = (unsigned long *) dst;
+        for (n = w >> 1; n > 0; n--, src += 2)
+            *ld++ = *(unsigned long *) src;
+        if (w & 1)
+            *(unsigned short *) ld = *src;
+        return;
+    }
+    if (!rtgMove16 || w < 16 ||
+        (((unsigned long) dst ^ (unsigned long) src) & 15) != 0)
+    {
+        copyRun(dst, src, w);
+        return;
+    }
+    head = ((16 - ((unsigned long) dst & 15)) & 15) >> 1;
+    if (head)
+        copyRun(dst, src, head);
+    s = src + head;
+    d = dst + head;
+    w -= head;
+    for (k = w >> 3; k > 0; k--)
+        __asm__ volatile (".word 0xf620,0x9000"     /* move16 (a0)+,(a1)+ */
+                          : "=a" (s), "=a" (d) : "0" (s), "1" (d) : "memory");
+    if (w & 7)
+        copyRun(d, s, w & 7);
+}
+
+/*
+** rtgPutImage - a ZPixmap of the screen's depth into a window under GXcopy,
+** all planes (every XPutImage of a picture), straight from the request into
+** the framebuffer, one clip-box intersection at a time, with 32-bit stores
+** and optionally move16.  rtgscreen.c installs it only for such GCs;
+** anything else that reaches it (bitmaps, XYPixmap) goes to cfb's PutImage.
+*/
+void
+rtgPutImage(pDraw, pGC, depth, x, y, w, h, leftPad, format, pImage)
+DrawablePtr pDraw;
+GCPtr       pGC;
+int         depth, x, y, w, h, leftPad, format;
+char       *pImage;
+{
+    rtgScreenPtr    pRTG;
+    unsigned short *base;
+    int             stride, srcPix, nbox, x1, x2, y1, y2, row;
+    RegionPtr       clip;
+    BoxPtr          pbox;
+    unsigned short *src;
+
+    pRTG = GetRTGScreen(pDraw->pScreen);
+    if (format != ZPixmap || depth != pRTG->depth || pGC->alu != GXcopy ||
+        (pGC->planemask & 0xffff) != 0xffff || w <= 0 || h <= 0)
+    {
+        cfbPutImage(pDraw, pGC, depth, x, y, w, h, leftPad, format, pImage);
+        return;
+    }
+    base   = drawBase(pDraw, pRTG);
+    stride = drawStride(pDraw);
+    clip   = cfbGetCompositeClip(pGC);
+    srcPix = PixmapBytePad(w, depth) / 2;
+    if (pGC->miTranslate)               /* the composite clip's frame */
+    {
+        x += pDraw->x;
+        y += pDraw->y;
+    }
+    if (pDraw->type == DRAWABLE_WINDOW)
+        RTG_FLUSH(pRTG);                /* no queued blit may land on top */
+
+    nbox = REGION_NUM_RECTS(clip);
+    pbox = REGION_RECTS(clip);
+    for (; nbox--; pbox++)
+    {
+        x1 = max(x, pbox->x1);
+        x2 = min(x + w, pbox->x2);
+        y1 = max(y, pbox->y1);
+        y2 = min(y + h, pbox->y2);
+        if (x1 >= x2 || y1 >= y2)
+            continue;
+        src = (unsigned short *) pImage + (long)(y1 - y) * srcPix + (x1 - x);
+        for (row = y1; row < y2; row++, src += srcPix)
+            burstRun(base + (long) row * stride + x1, src, x2 - x1);
+    }
+}
+
+
+/*
+** rtgCopyBoxes - copy the boxes of a YX-banded region, each from (box + dx,dy),
+** in an order that never overwrites a source pixel before it is read: bands
+** bottom-up when the copy moves down (dy < 0: the source lies above), boxes
+** within a band right-to-left when it moves right (dx < 0) -- as cfb does.
+** copyVRAMBox (and the card's copyBox) order rows and columns inside one
+** box.  (CopyWindow used to choose the order from the sign of old - new the
+** wrong way round, which smeared a partly covered window's contents into
+** itself on every move.)
+*/
+void
+rtgCopyBoxes(pRTG, pbox, nbox, dx, dy)
+rtgScreenPtr pRTG;
+BoxPtr       pbox;
+int          nbox, dx, dy;
+{
+    BoxPtr pboxEnd = pbox + nbox, pboxBand, pboxNext, first, last, b;
+    int    bandsUp = (dy < 0), boxesLeft = (dx < 0);
+
+    pboxBand = bandsUp ? pboxEnd : pbox;
+    while (bandsUp ? (pboxBand > pbox) : (pboxBand < pboxEnd))
+    {
+        if (bandsUp)
+        {
+            last  = pboxBand - 1;
+            first = last;
+            while (first > pbox && (first - 1)->y1 == last->y1)
+                first--;
+            pboxNext = first;
+        }
+        else
+        {
+            first = pboxBand;
+            last  = first;
+            while (last + 1 < pboxEnd && (last + 1)->y1 == first->y1)
+                last++;
+            pboxNext = last + 1;
+        }
+        for (b = boxesLeft ? last : first;
+             boxesLeft ? (b >= first) : (b <= last);
+             b += boxesLeft ? -1 : 1)
+            copyVRAMBox(pRTG, b->x1 + dx, b->y1 + dy,
+                        b->x2 - b->x1, b->y2 - b->y1, b->x1, b->y1);
+        pboxBand = pboxNext;
+    }
+}
+
+/*
+** The doBitBlt of cfb's BitBlt for a window-to-window CopyArea: every box
+** of prgnDst from its point in pptSrc, which for a copy within the screen is
+** the box moved by one offset.  GXcopy, all planes (rtgscreen.c checks).
+*/
+void
+rtgDoBitbltBlit(pSrc, pDst, alu, prgnDst, pptSrc, planemask)
+DrawablePtr   pSrc, pDst;
+int           alu;
+RegionPtr     prgnDst;
+DDXPointPtr   pptSrc;
+unsigned long planemask;
+{
+    BoxPtr       pbox = REGION_RECTS(prgnDst);
+    int          nbox = REGION_NUM_RECTS(prgnDst);
+    rtgScreenPtr pRTG;
+
+    if (nbox == 0)
+        return;
+    pRTG = GetRTGScreen(pDst->pScreen);
+    rtgCopyBoxes(pRTG, pbox, nbox, pptSrc->x - pbox->x1, pptSrc->y - pbox->y1);
+    RTG_FLUSH(pRTG);
+}
