--- a/programs/Xserver/hw/amix/rtg/zz9000/zz9000hw.c
+++ b/programs/Xserver/hw/amix/rtg/zz9000/zz9000hw.c
@@ -0,0 +1,190 @@
+/*
+** zz9000hw.c - MNT ZZ9000 hardware init/close for xamix-rtg.
+*/
+
+#include <sys/types.h>
+#include <sys/mman.h>
+#include <fcntl.h>
+#include <errno.h>
+#include "../../amix.h"
+#include "../rtg.h"
+#include "zz9000.h"
+
+static ZZ9000ModeRec zz9000_modes[] = {
+    { "640x480",   640,  480 },
+    { "800x600",   800,  600 },
+    { "1024x768", 1024,  768 },
+    { "1280x720", 1280,  720 },
+    { "1280x1024",1280, 1024 },
+    { "1920x800", 1920,  800 },
+    { "1920x1080",1920, 1080 },
+    { "1280x800", 1280,  800 },
+    { (char *)0 }
+};
+
+ZZ9000ModePtr ZZ9000_selected_mode = &zz9000_modes[5];
+
+Bool
+ZZ9000SetMode(name)
+char *name;
+{
+    ZZ9000ModePtr m;
+
+    for (m = zz9000_modes; m->name; m++) {
+        if (strcmp(m->name, name) == 0) {
+            ZZ9000_selected_mode = m;
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+Bool
+ZZ9000Probe()
+{
+    int fd;
+
+    fd = open(ZZ9000_DEV, O_RDWR);
+    if (fd < 0)
+        return FALSE;
+    if (ioctl(fd, ZZ9KIOC_PROBE, 0) < 0) {
+        (void) close(fd);
+        return FALSE;
+    }
+    (void) close(fd);
+    return TRUE;
+}
+
+Bool
+ZZ9000InitHW(pRTG)
+rtgScreenPtr pRTG;
+{
+    ZZ9000ScreenPtr pZZ;
+    struct zz9k_mode mode;
+    struct zz9k_info info;
+    struct zz9k_fbinfo fbi;
+    struct zz9k_fill fill;
+    caddr_t base;
+    int fd;
+
+    ErrorF("ZZ9000InitHW: starting\n");
+
+    pZZ = (ZZ9000ScreenPtr) xalloc(sizeof(ZZ9000ScreenRec));
+    if (!pZZ) {
+        ErrorF("ZZ9000InitHW: xalloc failed\n");
+        return FALSE;
+    }
+    memset((char *)pZZ, 0, sizeof(ZZ9000ScreenRec));
+
+    fd = open(ZZ9000_DEV, O_RDWR);
+    if (fd < 0) {
+        ErrorF("ZZ9000InitHW: cannot open %s (%s)\n",
+               ZZ9000_DEV, strerror(errno));
+        xfree((pointer)pZZ);
+        return FALSE;
+    }
+
+    if (ioctl(fd, ZZ9KIOC_PROBE, 0) < 0) {
+        ErrorF("ZZ9000InitHW: probe failed (%s)\n", strerror(errno));
+        (void) close(fd);
+        xfree((pointer)pZZ);
+        return FALSE;
+    }
+
+    mode.width = (unsigned short)ZZ9000_selected_mode->w;
+    mode.height = (unsigned short)ZZ9000_selected_mode->h;
+    mode.color_mode = ZZ9K_COLOR_16BIT565;
+    mode.scale_mode = 0;
+
+    if (ioctl(fd, ZZ9KIOC_SETMODE, &mode) < 0) {
+        ErrorF("ZZ9000InitHW: SETMODE %dx%d failed (%s)\n",
+               ZZ9000_selected_mode->w, ZZ9000_selected_mode->h,
+               strerror(errno));
+        (void) close(fd);
+        xfree((pointer)pZZ);
+        return FALSE;
+    }
+
+    if (ioctl(fd, ZZ9KIOC_GETINFO, &info) < 0 ||
+        ioctl(fd, ZZ9KIOC_GETFBINFO, &fbi) < 0) {
+        ErrorF("ZZ9000InitHW: GETINFO failed (%s)\n", strerror(errno));
+        (void) close(fd);
+        xfree((pointer)pZZ);
+        return FALSE;
+    }
+
+    base = (caddr_t)mmap(0, info.board_size,
+                         PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (base == (caddr_t)-1) {
+        ErrorF("ZZ9000InitHW: mmap failed (%s)\n", strerror(errno));
+        (void) close(fd);
+        xfree((pointer)pZZ);
+        return FALSE;
+    }
+
+    fill.offset = 0;
+    fill.bytes = (unsigned long)fbi.height * fbi.stride;
+    fill.value = 0;
+    (void) ioctl(fd, ZZ9KIOC_FILL, &fill);
+
+    if (ioctl(fd, ZZ9KIOC_SETSWITCH, ZZ9K_SWITCH_RTG) < 0)
+        ErrorF("ZZ9000InitHW: SETSWITCH RTG failed (%s)\n", strerror(errno));
+
+    pZZ->fd       = fd;
+    pRTG->devFd   = fd;             /* for the rtg/ layer's monitor switch */
+    pZZ->mapBase  = (pointer)base;
+    pZZ->mapSize  = info.board_size;
+    pZZ->fbOffset = fbi.fb_offset;
+    pZZ->fbSize   = fbi.fb_size;
+    pZZ->fbBase   = (unsigned short *)(base + fbi.fb_offset);
+
+    pRTG->width        = fbi.width;
+    pRTG->height       = fbi.height;
+    pRTG->pitch        = fbi.stride;
+    pRTG->bitsPerPixel = ZZ9000_BPP;
+    pRTG->depth        = ZZ9000_DEPTH;
+    pRTG->fbOffset     = fbi.fb_offset;
+    pRTG->frameBase    = (pointer)base;
+    pRTG->fbBase       = pZZ->fbBase;
+    pRTG->cardPrivate  = (pointer)pZZ;
+
+    ErrorF("ZZ9000InitHW: done %dx%d stride %d\n",
+           pRTG->width, pRTG->height, pRTG->pitch);
+    return TRUE;
+}
+
+void
+ZZ9000CloseHW(pRTG)
+rtgScreenPtr pRTG;
+{
+    ZZ9000ScreenPtr pZZ = GetZZ9000Screen(pRTG);
+
+    if (!pZZ)
+        return;
+
+    /*
+    ** Restore RTG mode (not CAPTURE) on exit.  The zz9000 kernel driver's
+    ** own console (see zz9000.c:zz9000consoleputc/zz9k_console_test in the
+    ** zz9000-amix driver repo) lives in the card's own RTG-mode framebuffer
+    ** and reclaims the display by switching to ZZ9K_SWITCH_RTG on every
+    ** console write.  Forcing ZZ9K_SWITCH_CAPTURE here instead leaves the
+    ** hardware muxed to the native Amiga chipset passthrough, which is not
+    ** where the console lives when console redirection (S99zz9000 /
+    ** ZZ9K_CONSOLE_REDIRECT) is active - so the screen does not return to
+    ** the zz9000 console until something happens to write to it again, if
+    ** ever.  Leaving/restoring RTG mode here makes whatever is already in
+    ** the console framebuffer visible immediately, matching how the driver
+    ** itself reclaims the screen.
+    */
+    if (pZZ->fd >= 0)
+        (void) ioctl(pZZ->fd, ZZ9KIOC_SETSWITCH, ZZ9K_SWITCH_RTG);
+    if (pZZ->mapBase)
+        (void) munmap(pZZ->mapBase, pZZ->mapSize);
+    if (pZZ->fd >= 0)
+        (void) close(pZZ->fd);
+
+    xfree((pointer)pZZ);
+    pRTG->cardPrivate = (pointer)NULL;
+    pRTG->frameBase = (pointer)NULL;
+    pRTG->fbBase = (unsigned short *)NULL;
+}
--- a/programs/Xserver/hw/amix/rtg/zz9000/zz9000pix.c
+++ b/programs/Xserver/hw/amix/rtg/zz9000/zz9000pix.c
@@ -0,0 +1,125 @@
+/*
+** ZZ9000pix.c - Pixmap and font operations for ZZ9000 RTG.
+**
+** Off-screen pixmaps live entirely in host memory (not in VRAM).
+** Native 16-bit pixmaps use the X11R6 AllocatePixmap() layout.  Depth-1
+** bitmap pixmaps use the VA2000/XRTG layout (PixmapRec followed directly
+** by pixels) because these are the glyph/cursor masks consumed by mfb.
+**
+** Supported depths: 16 (native TrueColor) and 1 (bitmaps for fonts).
+**
+** RealizeFont / UnrealizeFont are no-ops; the ZZ9000 has no hardware
+** font cache and font rendering is handled entirely by the mi layer.
+*/
+
+#include "X.h"
+#include "scrnintstr.h"
+#include "pixmap.h"
+#include "pixmapstr.h"
+#include "servermd.h"
+#include "dixfont.h"
+#include "../../amix.h"
+#include "../rtg.h"
+#include "zz9000.h"
+
+/*
+** ZZ9000CreatePixmap - allocate a host-memory pixmap.
+**
+** PixmapRec, pixmap-private records, and pixel data are allocated in one
+** block.  With PIXPRIV, pixel data starts at pScreen->totalPixmapSize;
+** otherwise it starts immediately after PixmapRec.  devKind is the
+** scanline size in bytes, padded to BITMAP_SCANLINE_PAD bits.
+**
+** Returns NullPixmap on unsupported depth or allocation failure.
+*/
+PixmapPtr
+ZZ9000CreatePixmap(pScreen, width, height, depth)
+ScreenPtr pScreen;
+int       width;
+int       height;
+int       depth;
+{
+    PixmapPtr pPixmap;
+    int       size;
+    int       datasize;
+
+    if (depth != ZZ9000_DEPTH && depth != 1)
+        return NullPixmap;
+
+    size     = PixmapBytePad(width, depth);
+    datasize = height * size;
+
+    if (depth == 1)
+        pPixmap = (PixmapPtr) xalloc(sizeof(PixmapRec) + datasize);
+    else
+        pPixmap = AllocatePixmap(pScreen, datasize);
+
+    if (!pPixmap)
+        return NullPixmap;
+
+    pPixmap->drawable.type         = DRAWABLE_PIXMAP;
+    pPixmap->drawable.class        = 0;
+    pPixmap->drawable.pScreen      = pScreen;
+    pPixmap->drawable.depth        = depth;
+    pPixmap->drawable.bitsPerPixel = depth;
+    pPixmap->drawable.id           = 0;
+    pPixmap->drawable.serialNumber = NEXT_SERIAL_NUMBER;
+    pPixmap->drawable.x            = 0;
+    pPixmap->drawable.y            = 0;
+    pPixmap->drawable.width        = width;
+    pPixmap->drawable.height       = height;
+    pPixmap->devKind               = size;
+    pPixmap->refcnt                = 1;
+    if (depth == 1)
+        pPixmap->devPrivate.ptr = (pointer)(pPixmap + 1);
+    else
+    {
+#ifdef PIXPRIV
+        pPixmap->devPrivate.ptr = datasize ?
+            (pointer)((char *)pPixmap + pScreen->totalPixmapSize) : NULL;
+#else
+        pPixmap->devPrivate.ptr = (pointer)(pPixmap + 1);
+#endif
+    }
+
+    return pPixmap;
+}
+
+/*
+** ZZ9000DestroyPixmap - release a host-memory pixmap.
+**
+** Decrements the reference count; frees only when it reaches zero.
+** Because the header and data share one allocation, a single xfree
+** releases both.
+*/
+Bool
+ZZ9000DestroyPixmap(pPixmap)
+PixmapPtr pPixmap;
+{
+    if (--pPixmap->refcnt)
+        return TRUE;
+    xfree((pointer) pPixmap);
+    return TRUE;
+}
+
+/*
+** ZZ9000RealizeFont - no hardware font cache; always succeeds.
+*/
+Bool
+ZZ9000RealizeFont(pScreen, pFont)
+ScreenPtr pScreen;
+FontPtr   pFont;
+{
+    return TRUE;
+}
+
+/*
+** ZZ9000UnrealizeFont - no hardware font cache; always succeeds.
+*/
+Bool
+ZZ9000UnrealizeFont(pScreen, pFont)
+ScreenPtr pScreen;
+FontPtr   pFont;
+{
+    return TRUE;
+}
