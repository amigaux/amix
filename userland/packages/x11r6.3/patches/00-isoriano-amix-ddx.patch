+#ifdef TIGA
+    ErrorF("-res<#>                Use /dev/dmi<#> as display.\n");
+    ErrorF("-gfxmgr filename       Tiga graphics manager.\n");
+    ErrorF("-tigamode int          Set tiga mode.\n");
+#ifndef DONT_PANIC
+    ErrorF("-panic [mask int]      Debugging Stuff.\n");
+#endif
+#endif /* TIGA */
+}
