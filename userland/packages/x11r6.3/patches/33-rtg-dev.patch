Ours.  -dev PATH: the device node of the RTG card, for a machine with two
graphics cards (a real ZZ9000 beside a Z3660 is /dev/zz9001), so the
display start-up can hand the server the node its card file names.

- the layer: rtgDevice (-dev; unset, each card opens its own node,
  rtgCardOps.device, as before) and rtgCardDevice(card), which a card's
  probe and initHW open instead of a fixed path;
- with -card auto and -dev, each card's probe is tried on that node and
  the first that answers is taken;
- a node no card answers on stops the server with "RTG card not found at
  <node>" (a named card) or "no RTG card found at <node>" (auto);
- the ZZ9000 driver opens rtgCardDevice(&zz9000CardOps); the -dev usage
  line.

--- a/programs/Xserver/hw/amix/amixIo.c
+++ b/programs/Xserver/hw/amix/amixIo.c
@@ -451,6 +451,11 @@
 	    FatalError("-card %s: no such card in this server\n", argv[i]);
 	return 2;
     }
+    if (!strcmp(argv[i], "-dev")) {	/* RTG card's device node */
+	if (++i >= argc) UseMsg ();
+	rtgDevice = argv[i];
+	return 2;
+    }
     if (!strcmp(argv[i], "-blitmin")) {	/* card blitter from this area on */
 	if (++i >= argc) UseMsg ();
 	rtgBlitMin = atoi(argv[i]);
@@ -584,6 +589,7 @@
     ErrorF("-height int            screen height in pixels.\n");
     ErrorF("-depth int             screen depth in planes.\n");
     ErrorF("-card name             RTG: the card (zz9000, va2000 or auto; default: X<card>'s card, else auto)\n");
+    ErrorF("-dev path              RTG: the card's device node (default: the card's own, /dev/zz9000, /dev/va2000)\n");
     ErrorF("-mode WxH              RTG video mode (e.g. 800x600, 1024x768)\n");
     ErrorF("-blitmin int           RTG: card blitter for fills/copies of this many pixels or more (default: the card's, 1024; 0 = never)\n");
     ErrorF("-blitmax int           ignored (the driver splits blitter operations itself)\n");
