+/*
+** -dev PATH: the device node of the card, for a machine with two graphics
+** cards (a real ZZ9000 beside a Z3660 is /dev/zz9001).  Unset, each card
+** opens its own node (rtgCardOps.device).  With -card auto, each card's
+** probe is tried on this node and the first that answers is taken.
+*/
+char *rtgDevice = (char *) NULL;
+
+char *
+rtgCardDevice(rtgCardOps *c)
+{
+    return rtgDevice ? rtgDevice : c->device;
+}
