-static KeybdCtrl *pKbdCtrl = (KeybdCtrl *) 0;
+/*
+** The time to the next repeat, in microseconds (0 = due now).  The first
+** repeat comes autoRepeatInitiate after the press, then one every
+** autoRepeatDelay.
+*/
+static long
+amixRepeatDue()
+{
+    struct timeval now, d;
+    long           wait, elapsed;
+
+    gettimeofday(&now, (struct timezone *) NULL);
+    tvminus(d, now, autoRepeatLastKeyDownTv);
+    wait = autoRepeatFirst ? autoRepeatInitiate : autoRepeatDelay;
+    if (d.tv_sec < 0)
+	return wait;                    /* the clock went back: start over */
+    if (d.tv_sec >= wait / 1000000 + 1)
+	return 0;
+    elapsed = d.tv_sec * 1000000 + d.tv_usec;
+    return elapsed >= wait ? 0 : wait - elapsed;
+}
 
+static Bool
+amixRepeating()
+{
+    return autoRepeatKeyDown && noXkbExtension &&
+	   sysKbPriv.ctrl->autoRepeat == AutoRepeatModeOn;
+}
