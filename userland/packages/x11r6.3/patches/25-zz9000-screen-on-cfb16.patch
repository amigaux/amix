-/*
-** ZZ9000StoreColors - no-op for TrueColor.
-**
-** TrueColor pixels encode colour directly; there is no CLUT to update.
-*/
-void
-ZZ9000StoreColors(pMap, ndef, pdefs)
-ColormapPtr pMap;
-int         ndef;
-xColorItem *pdefs;
-{
-}
