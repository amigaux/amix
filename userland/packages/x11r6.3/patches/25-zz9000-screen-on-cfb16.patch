-/*
-** ZZ9000ListInstalledColormaps - return the ID of the installed map.
-**
-** X protocol guarantees exactly one colormap is installed at all times.
-*/
-int
-ZZ9000ListInstalledColormaps(pScreen, pMaps)
-ScreenPtr pScreen;
