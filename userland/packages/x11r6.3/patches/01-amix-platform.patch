Ours.  The Amix platform for imake and the server: Imake.cf selects our amix.cf, imake's cpp
gets -DAMIX -DSVR4 -Dm68k, servermd.h knows Amix's byte and bit order, the server Imakefile has
an Xzz9000 target, mfb uses the portable bit-field code, Xos.h takes the two-argument
gettimeofday gcc14-cross-amix declares, and site.def includes the cross build's host.def.
It follows isoriano's analysis (amix-userland, x11r6.3 overlay) of: mfb's 68020 bfextu/bfins
asm dropping bits (maskbits.h), Xaw without wchar.h/wctype.h (XawI18nDefines), and how imake
must be told about AMIX (Imake.cf, imakemdep.h).

--- a/config/cf/amix.cf
+++ b/config/cf/amix.cf
@@ -0,0 +1,74 @@
+XCOMM platform:  amix.cf
+
+/*
+ * The amigaux X11R6.3 package: what the platform is, and what the package
+ * builds.  The cross build's compiler, tools and paths are in host.def.
+ */
+
+#define OSName			Amiga UNIX System V Release 4.0
+#define OSVendor		Commodore-Amiga
+#define OSMajorVersion		4
+#define OSMinorVersion		0
+#define OSTeenyVersion		0
+#define OSDefines		-DAMIX -Dm68k
+#define OSRelease		-DSVR4
+
+XCOMM operating system:  OSName (OSMajorVersion./**/OSMinorVersion./**/OSTeenyVersion)
+
+#define SystemV4		YES
+#define BootstrapCFlags		OSDefines OSRelease
+#define StandardDefines		OSDefines OSRelease
+#define StandardCppDefines	OSDefines OSRelease
+#define ProjectRulesFile	<X11.rules>
+#define ProjectTmplFile		<X11.tmpl>
+
+#define HasGcc			YES
+#define HasGcc2			YES
+#define HasGcc2ForCplusplus	NO
+#define UnixCpp			YES
+
+/* static libraries: the package ships no shared ones */
+#define HasSharedLibraries	NO
+/* xdm's greeter linked in: nothing to dlopen */
+#define SharedLibXdmGreet	NO
+
+/* sockets in libsocket/libnsl; the BSD calls and strcasecmp in libc and
+ * libamixc99; no secure RPC */
+#define ConnectionFlags		-DTCPCONN -DUNIXCONN
+#define HasSockets		YES
+#define SocketLibraries		-lsocket -lnsl
+#define ExtraLibraries		SocketLibraries
+#define NeedBerklib		NO
+#define HasStrcasecmp		YES
+#define HasPutenv		YES
+#define HasSecureRPC		NO
+
+/* no wchar.h/wctype.h: Xaw uses Xlib's own wide-character helpers */
+#define XawI18nDefines		-DUSE_XWCHAR_STRING -DUSE_XMBTOWC
+
+/* the server: Xzz9000, the Amiga DDX on a ZZ9000 or Z3660 RTG */
+#define XAmixServer		YES
+#define BuildXKB		YES
+#define BuildXKBlib		YES
+/* not shipped: PEX, XIE, LBX, the print server, Xnest */
+#define BuildPexExt		NO
+#define BuildXIE		NO
+#define BuildLBX		NO
+#define XprtServer		NO
+#define XnestServer		NO
+/* MIT-SHM: safe with the 68040/68060 kernel's shared-memory fixes (README) */
+#define HasShm			YES
+/* colours from rgb.txt: the server's rgb reader is Amix's classic dbm, whose
+ * .dir/.pag format no build-host tool writes */
+#define UseRgbTxt		YES
+/* the font path the server starts with: the directories this package ships */
+#define DefaultFontPath	$(FONTDIR)/misc/,$(FONTDIR)/75dpi/,$(FONTDIR)/100dpi/
+
+/* man pages in the stock section names */
+#define ManSuffix		1
+#define LibManSuffix		3
+#define FileManSuffix		4
+#define MiscManSuffix		5
+
+/* the package strips after its gates */
+#define StripInstalledPrograms	NO
