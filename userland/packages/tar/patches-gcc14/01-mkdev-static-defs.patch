--- src/system.h
+++ src/system.h
@@ -281,7 +281,19 @@
    major is #define'd.  */
 
 #if MAJOR_IN_MKDEV
-# include <sys/mkdev.h>
+/* GCC 14: AMIX's <sys/mkdev.h> declares makedev/major/minor extern and then
+   defines them static, which GCC 14 rejects (gcc 2.7 accepted it).  These are
+   that header's three static definitions, in the NEWDEV (expanded) device
+   format, through the same libc.so.1 entry points.  */
+# undef makedev
+# undef major
+# undef minor
+dev_t __makedev (const int, const major_t, const minor_t);
+major_t __major (const int, const dev_t);
+minor_t __minor (const int, const dev_t);
+static dev_t makedev (major_t maj, minor_t min) { return __makedev (1, maj, min); }
+static major_t major (dev_t dev) { return __major (1, dev); }
+static minor_t minor (dev_t dev) { return __minor (1, dev); }
 # define GOT_MAJOR
 #endif
 
