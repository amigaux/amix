#
# prototype -- GNU tar 1.14's installed layout under /opt/amix.
#
# AUTHORED, NOT GENERATED, no host paths: build.sh runs `pkgmk -r <destroot>`.
# PREFIX /opt/amix (COEXISTENCE.md, ROADMAP D11); nothing lands outside it.
#
# COEXISTENCE.  Stock ships /usr/sbin/tar (and /etc/tar), owned by `core`.
# This package does NOT claim, overwrite or symlink either path -- ours is
# /opt/amix/bin/tar and wins for interactive users purely by PATH order, while
# stock scripts that name /usr/sbin/tar keep stock behaviour.  The PKG is
# `gtar`, so the catalog never lists two packages called tar.
#
# NO INSTALL SCRIPTS (D9).  No rmt: remote-tape support is not built or
# shipped.  No man page: tar 1.14 documents itself in texinfo only, which the
# box cannot read; `tar --help` is the reference.  Every basename <= 14 bytes.
#
i pkginfo
#
# --- the shared add-on prefix ----------------------------------------------
d none /opt 0755 root sys
d none /opt/amix 0755 root sys
#
# --- the program -----------------------------------------------------------
d none /opt/amix/bin 0755 root sys
f none /opt/amix/bin/tar 0755 root bin
#
# --- licence and upstream notes --------------------------------------------
#
# GPL-2.0-or-later: the COPYING text (GPLv2) travels with the binary.
d none /opt/amix/doc 0755 root sys
d none /opt/amix/doc/tar 0755 root sys
f none /opt/amix/doc/tar/COPYING 0644 root bin
f none /opt/amix/doc/tar/NEWS 0644 root bin
f none /opt/amix/doc/tar/README 0644 root bin
d none /opt/amix/man 0755 root sys
d none /opt/amix/man/1 0755 root sys
f none /opt/amix/man/1/tar 0644 root bin
d none /opt/amix/man/whatis.d 0755 root sys
f none /opt/amix/man/whatis.d/gtar 0644 root bin
