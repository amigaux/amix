PKG=gzip
NAME=GNU gzip 1.3.12 - the .gz compressor
ARCH=Amiga
VERSION=1.3.12-2
CATEGORY=utility
CLASSES=none
VENDOR=amix-packages
# Authored PSTAMP -- an unset one leaks the build host into a distributed file.
PSTAMP=amix-packages-gzip-1.3.12-2
# The first .gz on Amix.  Stock compression is 1985 BSD/Spencer `compress` (LZW,
# .Z) plus pack/zcat -- none of which reads or writes gzip's deflate format.
# gzip does not touch compress/pack; it installs alongside under /opt/amix.
DESC=GNU gzip 1.3.12 reads and writes the universal .gz (deflate) format, which stock Amix cannot -- stock ships only 1985 LZW compress/.Z. Installs /opt/amix/bin/{gzip,gunzip,zcat}. Integer-only; links nothing outside the stock libc. Add /opt/amix/bin to PATH to use it.
