PKG=acompat
NAME=libacompat - missing-libc shim for Amix ports
ARCH=Amiga
VERSION=0.1-2
CATEGORY=development
CLASSES=none
VENDOR=amix-packages
# PSTAMP is authored rather than left to pkgmk.  Unset, pkgmk stamps the package
# with <build-host-name><timestamp> -- which leaks whichever machine happened to
# run the build into a file meant for distribution, and makes two builds of the
# same source differ for a reason nobody cares about.
PSTAMP=amix-packages-acompat-0.1-2
DESC=Static library and headers for the libc surface Amix lacks: long-long snprintf/vsnprintf, setenv/unsetenv, strcasecmp/strncasecmp, mkstemp, usleep, gettimeofday. Link -lacompat.
