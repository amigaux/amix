#
# prototype -- ftpdfix: the stock /usr/sbin/in.ftpd, its data connection
# closed safely.
#
# AUTHORED, NOT GENERATED, no host paths (pkgmk -r <destroot>).  pkginfo is
# generated from package.sh.  The server keeps the stock shape: the same
# path, type, mode and owner as net's line.  The path stays claimed by net
# too (pkgadd reports the shared path); pkgrm would leave these bytes there,
# so the package is essential and never removed.  Every basename <= 14 bytes.
#
i pkginfo
#
# net's own lines for the two directories, attributes as net has them
d none /usr 0755 bin bin
d none /usr/sbin 0755 bin bin
f none /usr/sbin/in.ftpd 0555 bin bin
#
d none /opt 0755 root sys
d none /opt/amix 0755 root sys
d none /opt/amix/doc 0755 root sys
d none /opt/amix/doc/ftpdfix 0755 root sys
f none /opt/amix/doc/ftpdfix/README.md 0644 root bin
f none /opt/amix/doc/ftpdfix/LICENSE.amix 0644 root bin
#
# ftpdfix(1M); replaces.d says it is the page of /usr/sbin/in.ftpd
d none /opt/amix/man 0755 root sys
d none /opt/amix/man/1m 0755 root sys
f none /opt/amix/man/1m/ftpdfix 0644 root bin
d none /opt/amix/man/replaces.d 0755 root sys
f none /opt/amix/man/replaces.d/ftpdfix 0644 root bin
d none /opt/amix/man/whatis.d 0755 root sys
f none /opt/amix/man/whatis.d/ftpdfix 0644 root bin
