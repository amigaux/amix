+/* zz9k_alloc_shared's Amix body: ZZSIOC_ALLOC, then mmap(2) of the cookie
+ * unless the buffer is card-only.  Buffers are page-aligned. */
+static int zz9k_amix_alloc_shared(ZZ9KContext *ctx, uint32_t length,
+                                  uint32_t alignment, uint32_t flags,
+                                  ZZ9KSharedBuffer *buffer)
+{
+  struct zzs_alloc za;
+  void *p;
+  long page = sysconf(_SC_PAGESIZE);
+
+  memset(buffer, 0, sizeof(*buffer));
+  if (page <= 0 || alignment > (uint32_t)page ||
+      (alignment & (alignment - 1U)) != 0U || length > (uint32_t)ZZS_QUOTA) {
+    return ZZ9K_STATUS_UNSUPPORTED;
+  }
+  memset(&za, 0, sizeof(za));
+  za.za_length = (long)length;
+  za.za_flags = (flags & ZZ9K_ALLOC_CARD_ONLY) ? ZZS_ALLOC_CARDONLY : 0;
+  if (ioctl(ctx->amix_fd, ZZSIOC_ALLOC, &za) != 0) {
+    return zz9k_amix_status(errno);
+  }
+  if (za.za_handle < 0 || za.za_handle >= ZZS_NHANDLE) {
+    return ZZ9K_STATUS_INTERNAL_ERROR;
+  }
+  buffer->handle = (uint32_t)za.za_handle;
+  buffer->length = (uint32_t)za.za_length;
+  if (!(flags & ZZ9K_ALLOC_CARD_ONLY)) {
+    p = (void *)mmap(0, (size_t)za.za_length, PROT_READ | PROT_WRITE,
+                     MAP_SHARED, ctx->amix_fd, (off_t)za.za_cookie);
+    if (p == (void *)-1) {
+      (void)ioctl(ctx->amix_fd, ZZSIOC_FREE, (int)za.za_handle);
+      memset(buffer, 0, sizeof(*buffer));
+      return ZZ9K_STATUS_IO_ERROR;
+    }
+    buffer->data = p;
+    ctx->amix_map[za.za_handle].addr = p;
+    ctx->amix_map[za.za_handle].length = (uint32_t)za.za_length;
+  }
+  return ZZ9K_STATUS_OK;
+}
+
+/* zz9k_free_shared's Amix body: unmap exactly what was mapped, then FREE.
+ * The kernel holds a buffer that was mapped until this open is closed. */
+static int zz9k_amix_free_shared(ZZ9KContext *ctx, uint32_t handle)
+{
+  if (handle >= ZZS_NHANDLE) {
+    return ZZ9K_STATUS_BAD_HANDLE;
+  }
+  if (ctx->amix_map[handle].addr) {
+    (void)munmap(ctx->amix_map[handle].addr,
+                 (size_t)ctx->amix_map[handle].length);
+    ctx->amix_map[handle].addr = 0;
+    ctx->amix_map[handle].length = 0;
+  }
+  if (ioctl(ctx->amix_fd, ZZSIOC_FREE, (int)handle) != 0) {
+    return zz9k_amix_status(errno);
+  }
+  return ZZ9K_STATUS_OK;
+}
