+#if ZZ9K_HOST_AMIX
+/* The status for an errno of the channel. */
+static int zz9k_amix_status(int e)
+{
+  switch (e) {
+  case ENXIO:
+  case ENODEV:
+  case ENOENT:
+    return ZZ9K_STATUS_NOT_FOUND;   /* no board, runtime or node */
+  case EINVAL:
+  case EPERM:
+  case EACCES:
+    return ZZ9K_STATUS_UNSUPPORTED; /* the kernel does not pass it on */
+  case EBADF:
+    return ZZ9K_STATUS_BAD_HANDLE;
+  case EAGAIN:
+  case EBUSY:
+    return ZZ9K_STATUS_BUSY;
+  case ENOSPC:
+  case ENOMEM:
+    return ZZ9K_STATUS_NO_MEMORY;
+  case ETIMEDOUT:
+    return ZZ9K_STATUS_TIMEOUT;
+  default:
+    return ZZ9K_STATUS_IO_ERROR;
+  }
+}
+
+int zz9k_open_unit(ZZ9KContext **ctx, int unit)
+{
+  char path[16];
+  struct zzs_info zi;
+  ZZ9KContext *new_ctx;
+  int fd;
+  int e;
+
+  if (!ctx) {
+    return ZZ9K_STATUS_BAD_REQUEST;
+  }
+  *ctx = 0;
+  if (unit < 0 || unit >= ZZ9K_AMIX_NUNIT) {
+    return ZZ9K_STATUS_BAD_REQUEST;
+  }
+  memcpy(path, "/dev/zz9ksvc", 12);
+  path[12] = (char)('0' + unit);
+  path[13] = '\0';
+  fd = open(path, O_RDWR);
+  if (fd < 0) {
+    return zz9k_amix_status(errno);
+  }
+  memset(&zi, 0, sizeof(zi));
+  if (ioctl(fd, ZZSIOC_INFO, &zi) != 0) {
+    e = errno;
+    close(fd);
+    return zz9k_amix_status(e);
+  }
+  if (zi.zi_abimajor != ZZ9K_ABI_VERSION_MAJOR) {
+    close(fd);
+    return ZZ9K_STATUS_UNSUPPORTED;
+  }
+  new_ctx = (ZZ9KContext *)zz9k_alloc_host(sizeof(*new_ctx));
+  if (!new_ctx) {
+    close(fd);
+    return ZZ9K_STATUS_NO_MEMORY;
+  }
+  memset(new_ctx, 0, sizeof(*new_ctx));
+  (void)fcntl(fd, F_SETFD, FD_CLOEXEC);
+  new_ctx->amix_fd = fd;
+  new_ctx->amix_unit = unit;
+  new_ctx->board.product = (uint16_t)(zi.zi_id & 0xffff);
+  new_ctx->board.zorro_version =
+      (uint32_t)zi.zi_id ==
+              ((ZZ9K_MNT_MANUFACTURER << 16) | ZZ9K_PRODUCT_Z2) ? 2U : 3U;
+  new_ctx->board.firmware_version =
+      ((uint32_t)zi.zi_abimajor << 16) | (uint32_t)zi.zi_abiminor;
+  /* the kernel rings the doorbell and polls: no interrupt here */
+  new_ctx->capability_bits = (uint32_t)zi.zi_caps &
+      ~(uint32_t)(ZZ9K_CAP_IRQ_COMPLETION | ZZ9K_CAP_DOORBELL);
+  new_ctx->request_ring_entries = (uint32_t)zi.zi_reqn;
+  new_ctx->completion_ring_entries = (uint32_t)zi.zi_cmpn;
+  new_ctx->next_request_id = 1;
+  new_ctx->sync_cookie_mask = ZZ9K_SYNC_COOKIE_MASK;
+  *ctx = new_ctx;
+  return ZZ9K_STATUS_OK;
+}
+
+int zz9k_unit(const ZZ9KContext *ctx)
+{
+  return ctx ? ctx->amix_unit : -1;
+}
+
+/* zz9k_call's Amix body: SUBMIT, then WAIT for that request, which the
+ * kernel bounds (ctx->offload_timeout_ms, else its own 10 s).  A signal
+ * does not end the call: the request stays the kernel's until waited for. */
+static int zz9k_amix_call(ZZ9KContext *ctx, ZZ9KRequest *request,
+                          ZZ9KMailboxEntry *reply)
+{
+  struct zzs_submit zs;
+  struct zzs_wait zw;
+  uint32_t len = request->entry.payload_len;
+
+  if (len > ZZS_PAYLOAD) {
+    return ZZ9K_STATUS_BAD_REQUEST;
+  }
+  memset(&zs, 0, sizeof(zs));
+  zs.zs_opcode = request->entry.opcode;
+  zs.zs_len = (long)len;
+  memcpy(zs.zs_payload, request->entry.payload.inline_data, len);
+  if (ioctl(ctx->amix_fd, ZZSIOC_SUBMIT, &zs) != 0) {
+    return zz9k_amix_status(errno);
+  }
+  memset(&zw, 0, sizeof(zw));
+  zw.zw_id = zs.zs_id;
+  zw.zw_ms = ctx->offload_timeout_ms > 600000U ? 600000L :
+                                                  (long)ctx->offload_timeout_ms;
+  while (ioctl(ctx->amix_fd, ZZSIOC_WAIT, &zw) != 0) {
+    if (errno != EINTR) {
+      return zz9k_amix_status(errno);
+    }
+  }
+  memset(reply, 0, sizeof(*reply));
+  reply->request_id = (uint32_t)zs.zs_id;
+  reply->opcode = request->entry.opcode;
+  reply->status = (uint16_t)zw.zw_status;
+  reply->user_cookie = request->entry.user_cookie;
+  len = zw.zw_len < 0 ? 0U : (uint32_t)zw.zw_len;
+  if (len > ZZS_PAYLOAD || len > sizeof(reply->payload.inline_data)) {
+    return ZZ9K_STATUS_INTERNAL_ERROR;
+  }
+  reply->payload_len = (uint16_t)len;
+  memcpy(reply->payload.inline_data, zw.zw_payload, len);
+  return reply->status;
+}
