+/*
+ * A message with long long conversions on stderr.  The system's printf
+ * family reads %lld as %ld; vsnprintf (libamixc99) formats them.
+ */
+static void
+llerr(const char *fmt, ...)
+{
+	char	buf[256];
+	va_list	ap;
+
+	va_start(ap, fmt);
+	vsnprintf(buf, sizeof buf, fmt, ap);
+	va_end(ap);
+	fputs(buf, stderr);
+}
