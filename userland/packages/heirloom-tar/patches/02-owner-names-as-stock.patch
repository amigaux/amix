Restore owners on extraction the way the system's own tar does.  Heirloom
tar sets an extracted file's owner and group from the header's numeric
uid and gid only.  Amix's tar, for a ustar or GNU header, uses the local
id of the header's user and group names instead.  Ids differ between
systems (bin is 1 on Linux and 2 here), so the two disagree on most
archives made elsewhere.  With this patch a name that exists here gives
its local id; an empty name, or one this system lacks, leaves the
numeric id.  That last case is where the stock tar read through a failed
getpwnam and crashed.  Only extraction as root without `o' looks names
up; listings show the header's ids, as before.

--- a/tar/tar.c
+++ b/tar/tar.c
@@ -302,6 +302,7 @@
 static void	tgetgnu(char **, long *);
 static void	tgetpax(struct stat *, long long *, long long *);
 static enum paxrec	tgetrec(char **, char **, char **);
+static void	tgetowner(struct stat *);
 static long long	tgetval(const char *, int);
 static void	passtape(struct stat *);
 static void	putfile(const char *, const char *, int, int);
@@ -837,6 +838,8 @@
 		sp->st_uid = tgetval(dblock.dbuf.uid, sizeof dblock.dbuf.uid);
 	if ((paxrec & PR_GID) == 0)
 		sp->st_gid = tgetval(dblock.dbuf.gid, sizeof dblock.dbuf.gid);
+	if (xflag && oflag == 0 && memcmp(dblock.dbuf.magic, "ustar", 5) == 0)
+		tgetowner(sp);
 	if ((paxrec & PR_SIZE) == 0)
 		sp->st_size =
 			tgetval(dblock.dbuf.size, sizeof dblock.dbuf.size);
@@ -869,6 +872,67 @@
 	}
 }
 
+/*
+ * Owners on extraction as the system's own tar restores them: for a ustar
+ * or GNU header, a user or group name that exists here gives its local
+ * id; an empty name or one this system lacks leaves the numeric id from
+ * the header.  The answers are cached, since getpwnam and getgrnam read
+ * /etc/passwd and /etc/group from the top on every call.
+ */
+#define	OWNCACHE	16
+
+static int
+ownlookup(const char *field, int group, uid_t *id)
+{
+	static struct {
+		char	name[33];
+		uid_t	id;
+		int	found;
+	} cache[2][OWNCACHE];
+	static int	next[2];
+	char	name[33];
+	struct passwd	*pw;
+	struct group	*gr;
+	int	i;
+
+	memcpy(name, field, 32);
+	name[32] = '\0';
+	if (name[0] == '\0')
+		return 0;
+	for (i = 0; i < OWNCACHE; i++)
+		if (cache[group][i].name[0] &&
+				strcmp(cache[group][i].name, name) == 0)
+			goto found;
+	i = next[group]++ % OWNCACHE;
+	strcpy(cache[group][i].name, name);
+	cache[group][i].found = 0;
+	if (group) {
+		if ((gr = getgrnam(name)) != NULL) {
+			cache[group][i].id = gr->gr_gid;
+			cache[group][i].found = 1;
+		}
+	} else {
+		if ((pw = getpwnam(name)) != NULL) {
+			cache[group][i].id = pw->pw_uid;
+			cache[group][i].found = 1;
+		}
+	}
+found:	if (cache[group][i].found)
+		*id = cache[group][i].id;
+	return cache[group][i].found;
+}
+
+static void
+tgetowner(struct stat *sp)
+{
+	uid_t	id;
+
+	if (ownlookup(dblock.dbuf.uname, 0, &id))
+		sp->st_uid = id;
+	if (ownlookup(dblock.dbuf.gname, 1, &id))
+		sp->st_gid = (gid_t)id;
+}
+
 static void
 tgetnam(void)
 {
