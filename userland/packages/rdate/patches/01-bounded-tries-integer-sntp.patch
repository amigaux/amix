+/* one try at one host, bounded by an alarm of tmo seconds */
+static int
+try_host(const char *hname, int ntp, int family, int port, int useudp,
+         int tmo, int verbose, struct timeval *new, struct timeval *adjust)
+{
+    struct sigaction sa, osa;
+    volatile int ret;
+
+    rdate_err[0] = '\0';
+    rdate_addr[0] = '\0';
+    rdate_sock = -1;
+    memset(&sa, 0, sizeof(sa));
+    sa.sa_handler = on_alarm;
+    sigemptyset(&sa.sa_mask);
+    sigaction(SIGALRM, &sa, &osa);
+    if (sigsetjmp(alarm_env, 1) == 0) {
+        alarm(tmo);
+        if (ntp)
+            ret = ntp_client(hname, family, new, adjust, port, verbose, tmo);
+        else
+            ret = rfc868time_client(hname, family, new, adjust, useudp, port);
+        alarm(0);
+    } else {
+        ret = RD_TIMEOUT;
+    }
+    alarm(0);
+    sigaction(SIGALRM, &osa, NULL);
+    if (rdate_sock >= 0) {
+        close(rdate_sock);
+        rdate_sock = -1;
+    }
+    return ret;
+}
