isoriano's errno save for the mcsc machine context (from isoriano1968/amix-userland,
components/library/pth/patches; Ignacio Soriano, LGPL-2.1-or-later as Pth is), with
our changes: no __amix__ guard and a corrected comment.  It fixes a generic Pth
2.0.7 bug, not an Amix quirk: the sjlj switch keeps each thread's errno through
pth_mctx_save/restore, the mcsc switch (swapcontext) did not.

--- a/pth_mctx.c
+++ b/pth_mctx.c
@@ -126,9 +126,24 @@
 #define  _pth_mctx_switch_debug /*NOP*/
 #endif
 #if PTH_MCTX_MTH(mcsc)
+/*
+ * errno is one variable for all the threads of a process.  The sjlj
+ * switch keeps each thread's errno through pth_mctx_save and
+ * pth_mctx_restore; the mcsc switch calls swapcontext directly and did
+ * not: each thread's errno is saved on the way out and restored on the
+ * way back.
+ * The store before swapcontext is for a thread that starts at its
+ * makecontext entry, which never runs the line after the swap: it starts
+ * with its own errno (0 from pth_mctx_set), not the switching thread's.
+ */
 #define pth_mctx_switch(old,new) \
-    _pth_mctx_switch_debug \
-    swapcontext(&((old)->uc), &((new)->uc));
+    do { \
+        _pth_mctx_switch_debug \
+        (old)->error = errno; \
+        errno = (new)->error; \
+        swapcontext(&((old)->uc), &((new)->uc)); \
+        errno = (old)->error; \
+    } while (0)
 #elif PTH_MCTX_MTH(sjlj)
 #define pth_mctx_switch(old,new) \
     _pth_mctx_switch_debug \
@@ -171,6 +186,8 @@
     mctx->uc.uc_stack.ss_size  = pth_sksize(makecontext, sk_addr_lo, sk_addr_hi-sk_addr_lo);
     mctx->uc.uc_stack.ss_flags = 0;
 
+    mctx->error = 0;
+
     /* configure startup function (with no arguments) */
     makecontext(&(mctx->uc), func, 0+1);
 
