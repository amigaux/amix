From isoriano1968/amix-userland, components/library/pth/patches (Ignacio Soriano; LGPL-2.1-or-later
port change to GNU Pth 2.0.7), unchanged.  Guarded by __amix__ (build.sh defines it).

--- a/pthread.c
+++ b/pthread.c
@@ -358,15 +358,40 @@
     return OK;
 }
 
+#if defined(__amix__)
+static void pthread_once_amix_reset(void *argument)
+{
+    *(pthread_once_t *)argument = PTHREAD_ONCE_INIT;
+}
+#endif
+
 int pthread_once(
     pthread_once_t *once_control, void (*init_routine)(void))
 {
     pthread_initialize();
     if (once_control == NULL || init_routine == NULL)
         return pth_error(EINVAL, EINVAL);
+#if defined(__amix__)
+    /* No preemption: checking and setting state needs no kernel atomic. */
+    while (*once_control != 1) {
+        if (*once_control == PTHREAD_ONCE_INIT) {
+            *once_control = 2;
+            if (!pth_cleanup_push(pthread_once_amix_reset, once_control)) {
+                *once_control = PTHREAD_ONCE_INIT;
+                return errno;
+            }
+            init_routine();
+            *once_control = 1;
+            pth_cleanup_pop(FALSE);
+        }
+        else
+            pth_yield(NULL);
+    }
+#else
     if (*once_control != 1)
         init_routine();
     *once_control = 1;
+#endif
     return OK;
 }
 
