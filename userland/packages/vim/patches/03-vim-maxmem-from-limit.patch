With no way to read the RAM, Vim's mch_total_mem() fell back to 2 Gbyte
whatever the limits, so 'maxmemtot' was 1 Gbyte: Vim kept every block of a
file in memory, and a 57 MB file took the whole swap before Vim used its own
swap file.  On Amix it now takes the data limit, then the address-space one,
and 20 Mbyte with neither ('maxmemtot' half of that, as elsewhere).

--- a/src/os_unix.c
+++ b/src/os_unix.c
@@ -660,6 +660,25 @@
 
     if (mem > 0)
 	return mem >> shiftright;
+# ifdef __amix__
+    // Amix has no call that tells the RAM, so without a limit Vim took 2
+    // Gbyte and kept a whole file's blocks in memory.  The data limit, then
+    // the address-space one; with neither, 20 Mbyte ('maxmemtot' 10 Mbyte).
+    {
+	struct rlimit	rlp;
+	long_u		lim = 20L * 1024L * 1024L;
+
+	if (getrlimit(RLIMIT_DATA, &rlp) == 0 && rlp.rlim_cur != RLIM_INFINITY
+					      && (long_u)rlp.rlim_cur < lim)
+	    lim = (long_u)rlp.rlim_cur;
+#  ifdef RLIMIT_VMEM
+	if (getrlimit(RLIMIT_VMEM, &rlp) == 0 && rlp.rlim_cur != RLIM_INFINITY
+					      && (long_u)rlp.rlim_cur < lim)
+	    lim = (long_u)rlp.rlim_cur;
+#  endif
+	return lim >> 10;
+    }
+# endif
     return (long_u)0x1fffff;
 }
 #endif
