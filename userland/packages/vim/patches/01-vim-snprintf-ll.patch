vim_snprintf() formats each integer conversion itself by handing a one-
conversion format to libc sprintf.  AMIX's libc printf family reads "ll" as
"l" (a long long is 8 bytes on the stack, ll is taken as 4), so every Number
printed through it -- ":echo 5", "%lld bytes", "Word %lld of %lld" -- came out
as garbage.  The two long long cases now go through snprintf, which is
libamixc99's on Amix and handles ll; tmp is TMP_LEN bytes.

--- a/src/strings.c
+++ b/src/strings.c
@@ -3489,8 +3489,9 @@
 			    case 'l': str_arg_l += sprintf(
 						tmp + str_arg_l, f, long_arg);
 				      break;
-			    case 'L': str_arg_l += sprintf(
-					       tmp + str_arg_l, f, llong_arg);
+			    case 'L': str_arg_l += snprintf(
+					       tmp + str_arg_l, TMP_LEN - str_arg_l,
+					       f, llong_arg);
 				      break;
 			    }
 			}
@@ -3510,8 +3511,9 @@
 			    case 'l': str_arg_l += sprintf(
 					       tmp + str_arg_l, f, ulong_arg);
 				      break;
-			    case 'L': str_arg_l += sprintf(
-					      tmp + str_arg_l, f, ullong_arg);
+			    case 'L': str_arg_l += snprintf(
+					      tmp + str_arg_l, TMP_LEN - str_arg_l,
+					      f, ullong_arg);
 				      break;
 			    }
 			}
