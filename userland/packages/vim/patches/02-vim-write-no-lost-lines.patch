Out of memory, Vim could write a file with "???" in place of lines it could no
longer read back, and say it had written it ("907264 lines written").  ml_get
now records such a line and the write stops at it as on a write error, which
puts the backup back, with an E316 that names the line.  Under "vim -es",
which shows no error messages, this one and E342 (out of memory) also go to
stderr: before, an edit that ran out of memory ended with rc 1 and nothing
said.  Measured with a 57 MB file under a 16 and a 24 Mbyte data limit.

--- a/src/globals.h
+++ b/src/globals.h
@@ -1562,6 +1562,10 @@
 #endif
 
 EXTERN int	did_outofmem_msg INIT(= FALSE);
+#ifdef __amix__
+// set when ml_get could not read a line and gave "???" in its place
+EXTERN int	ml_get_failed INIT(= FALSE);
+#endif
 					    // set after out of memory msg
 EXTERN int	did_swapwrite_msg INIT(= FALSE);
 					    // set after swap write error msg
--- a/src/memline.c
+++ b/src/memline.c
@@ -2704,6 +2704,9 @@
 	}
 	ml_flush_line(buf);
 errorret:
+#ifdef __amix__
+	ml_get_failed = TRUE;
+#endif
 	STRCPY(questions, "???");
 	buf->b_ml.ml_line_len = 4;
 	buf->b_ml.ml_line_lnum = lnum;
--- a/src/bufwrite.c
+++ b/src/bufwrite.c
@@ -2025,11 +2025,35 @@
 	fileformat = get_fileformat_force(buf, eap);
 	s = buffer;
 	len = 0;
+#ifdef __amix__
+	ml_get_failed = FALSE;
+#endif
 	for (lnum = start; lnum <= end; ++lnum)
 	{
 	    // The next while loop is done once for each character written.
 	    // Keep it fast!
 	    ptr = ml_get_buf(buf, lnum, FALSE) - 1;
+#ifdef __amix__
+	    // A line that could not be read back (out of memory) comes as
+	    // "???": writing on would replace the file with damaged text.
+	    // Stop as on a write error, so the backup is put back.
+	    if (ml_get_failed)
+	    {
+		static char lost[120];
+
+		vim_snprintf(lost, sizeof(lost),
+			"E316: Cannot read line %ld back (out of memory?): not written",
+			(long)lnum);
+		errmsg = (char_u *)lost;
+		if (silent_mode && p_verbose == 0)
+		{
+		    mch_errmsg(lost);
+		    mch_errmsg("\n");
+		}
+		end = 0;
+		break;
+	    }
+#endif
 #ifdef FEAT_PERSISTENT_UNDO
 	    if (write_undo_file)
 		sha256_update(&sha_ctx, ptr + 1,
--- a/src/alloc.c
+++ b/src/alloc.c
@@ -343,6 +343,18 @@
     did_outofmem_msg = TRUE;
 
     semsg(_(e_out_of_memory_allocating_nr_bytes), (long_u)size);
+#ifdef __amix__
+    // "vim -es" shows no error messages: this one must not go unseen
+    if (silent_mode && p_verbose == 0)
+    {
+	char	m[80];
+
+	vim_snprintf(m, sizeof(m), _(e_out_of_memory_allocating_nr_bytes),
+								(long_u)size);
+	mch_errmsg(m);
+	mch_errmsg("\n");
+    }
+#endif
 
     if (starting == NO_SCREEN)
 	// Not even finished with initializations and already out of
