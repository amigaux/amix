#
# prototype -- amix-benchmark's installed layout under /opt/amix.
#
# AUTHORED, NOT GENERATED, no host paths: build.sh runs `pkgmk -r <destroot>`,
# which resolves each path against the staged tree (recipes/README.md).
# PREFIX /opt/amix (COEXISTENCE.md, ROADMAP D11); nothing lands outside it.
#
# ★ THE KIT IS SELF-LOCATING.  runbench.sh finds its binaries with
# `dirname $0`, so the driver, the five binaries and BUILD-INFO all live in ONE
# directory, /opt/amix/lib/amix-bench.  The entry command /opt/amix/bin/amix-bench
# is a tiny wrapper that execs that runbench.sh by its absolute path -- no
# binary path is hard-coded and no foreign directory is assumed (the metal
# failure mode a wrapper pointing at /usr/amiga/bin caused is avoided this way).
#
# ★ THIS IS OUR OWN TOOL -- no stock equivalent, so nothing here shadows or
# claims a stock path; the pkgadd conflict machinery never fires and a stock
# pkgrm can never take a stock binary with it.  Only /opt/amix is touched.
#
# ★ NO `whet`.  The fieldkit's sixth benchmark statically links the stock SVR4
# /usr/ccs/lib/libm.a, so it is omitted for licence (pin.sh has the measurement
# and the argument).  runbench.sh reports `fpu.whet status=skipped` by design;
# tests/smoke.sh refuses any package whose binaries carry libm.a symbols.
#
# NO INSTALL SCRIPTS (D9).  Every object is an ordinary file or directory.
# Every basename is <= 14 bytes (the s5 dirent limit); the two same-named
# `amix-bench` objects sit in DIFFERENT directories (bin vs lib), so they do
# not collide.  The benchmark binaries are shipped UNSTRIPPED and verbatim --
# they are the validated reference bytes and stripping would change them.
#
i pkginfo
#
# --- the shared add-on prefix ----------------------------------------------
d none /opt 0755 root sys
d none /opt/amix 0755 root sys
#
# --- the entry command on PATH ---------------------------------------------
d none /opt/amix/bin 0755 root sys
f none /opt/amix/bin/amix-bench 0755 root bin
#
# --- the kit: driver + prebuilt m68k SVR4 binaries + provenance ------------
d none /opt/amix/lib 0755 root sys
d none /opt/amix/lib/amix-bench 0755 root sys
f none /opt/amix/lib/amix-bench/runbench.sh 0755 root bin
f none /opt/amix/lib/amix-bench/dhry 0755 root bin
f none /opt/amix/lib/amix-bench/iobench 0755 root bin
f none /opt/amix/lib/amix-bench/fpbench 0755 root bin
f none /opt/amix/lib/amix-bench/membench 0755 root bin
f none /opt/amix/lib/amix-bench/vmbench 0755 root bin
f none /opt/amix/lib/amix-bench/BUILD-INFO 0644 root bin
f none /opt/amix/lib/amix-bench/PROVENANCE 0644 root bin
#
# --- manual page -----------------------------------------------------------
d none /opt/amix/man 0755 root sys
d none /opt/amix/man/man1 0755 root sys
f none /opt/amix/man/man1/amix-bench.1 0644 root bin
#
# --- field documentation ---------------------------------------------------
d none /opt/amix/doc 0755 root sys
d none /opt/amix/doc/amix-benchmark 0755 root sys
f none /opt/amix/doc/amix-benchmark/README.txt 0644 root bin
