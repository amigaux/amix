#!/bin/sh
# display -- the graphical login at boot: /etc/init.d/display, run as
# /etc/rc2.d/S95display.
#
# Off unless /etc/display says "start xdm" or "start dtlogin" (display(4);
# the default is manual). rc.conf's display=no turns the step off whatever
# /etc/display says. "xstart -xdm" starts X11R6's xdm, "xstart -dtlogin"
# CDE's dtlogin, each with the server line xstart builds from /etc/display
# and the card file; no display manager file is edited by hand. When the
# display manager is not installed, xstart says so and the box stays at
# its text logins (as with manual). Output: /var/adm/rclog/display.
# stop: nothing; the display manager and its server end with the system.
#
# The package declares its S link with it, so an update that installs the
# file anew makes it to it again.
#
# MIT licence: /opt/amix/doc/amix-base/LICENSE (LICENSE at the top of the
# repository).

RC_SUBR=${RC_SUBR:-/usr/lib/amix/rc.subr}
DISP_SUBR=${DISP_SUBR:-/usr/lib/amix/display.subr}
XSTART=${XSTART:-/usr/amix/bin/xstart}

case "$1" in
start)
	. "$RC_SUBR"
	rc_enabled display yes || exit 0
	. "$DISP_SUBR"
	dm=`disp_val "$DISP_CONF" start`
	case "$dm" in
	xdm|dtlogin) ;;
	*) exit 0 ;;
	esac
	rc_log display "start $dm: `$XSTART -n -$dm 2>&1 | sed -n "s/^$dm *//p"`"
	# not rc_bg: its bound would stop the display manager, a daemon of its own
	$XSTART -$dm < /dev/null >> "$RC_BGLOG/display" 2>&1 &
	;;
stop)
	;;
*)
	echo "usage: $0 start | stop" >&2
	exit 1
	;;
esac
exit 0
