#!/bin/sh
# test-tools: host test of toolchain/fetch-distfile, toolchain/m68k-gnu-bin and
# toolchain/sysroot-links.
#
# MIT licence, see LICENSE at the top of the repository.
#
#     sh toolchain/test-tools
#
# Needs no network: the distfile comes from a local AMIX_DISTFILES, and the
# gcc14 tools are stand-ins. Prints "N/N passed"; exits non-zero on a failure.

here=$(cd "$(dirname "$0")" && pwd)
T=$(mktemp -d "${TMPDIR:-/tmp}/test-tools.XXXXXX") && [ -n "${T:?}" ] || exit 1
trap 'rm -rf "${T:?}"' EXIT
pass=0 fail=0
check() {	# check <what> <command...>
	what=$1; shift
	if "$@" >"$T/out" 2>&1; then pass=$((pass + 1)); else fail=$((fail + 1)); echo "FAIL $what"; sed 's/^/    /' "$T/out"; fi
}
refused() {	# refused <what> <needle> <command...>: exits non-zero and says <needle>
	what=$1 needle=$2; shift 2
	if "$@" >"$T/out" 2>&1; then
		fail=$((fail + 1)); echo "FAIL $what (it passed)"; sed 's/^/    /' "$T/out"
	elif grep -qF "$needle" "$T/out"; then pass=$((pass + 1))
	else fail=$((fail + 1)); echo "FAIL $what (not: $needle)"; sed 's/^/    /' "$T/out"; fi
}

# --- fetch-distfile ------------------------------------------------------------
mkdir -p "$T/dist" "$T/cache"
printf 'the distfile\n' > "$T/dist/thing-1.0.tgz"
sha=$(sha256sum "$T/dist/thing-1.0.tgz" | cut -c1-64)
# example.invalid never resolves: a fetch of the URL fails at once, offline
echo "https://example.invalid/amix-distfiles/releases/download/thing-1.0/thing-1.0.tgz $sha" > "$T/thing.pin"
fetch() { AMIX_DISTFILES=$T/dist sh "$here/fetch-distfile" "$@"; }

check "fetch: from AMIX_DISTFILES into the cache, checked, path printed last" \
	env AMIX_DISTFILES="$T/dist" sh -c 'p=$(sh "$0" "$1" "$2" 2>/dev/null | tail -1) && [ "$p" = "$2/thing-1.0.tgz" ] && cmp -s "$p" "$3"' \
	"$here/fetch-distfile" "$T/thing.pin" "$T/cache" "$T/dist/thing-1.0.tgz"
check "fetch: a cached file that matches is not fetched again" \
	sh -c 'AMIX_DISTFILES=/nonexistent sh "$0" "$1" "$2" 2>&1 | grep -q "^  cached"' \
	"$here/fetch-distfile" "$T/thing.pin" "$T/cache"
printf 'other bytes\n' > "$T/dist/thing-1.0.tgz"
rm -f "${T:?}/cache/thing-1.0.tgz"
refused "fetch: other bytes in AMIX_DISTFILES are not taken; the URL is tried" "is not the pinned bytes; fetching the URL" fetch "$T/thing.pin" "$T/cache"
check "fetch: a refused file is not left in the cache" test ! -e "$T/cache/thing-1.0.tgz" -a ! -e "$T/cache/thing-1.0.tgz.part"
refused "fetch: a file missing from AMIX_DISTFILES: the URL is tried" "download failed: https://example.invalid/" \
	env AMIX_DISTFILES="$T/cache" sh "$here/fetch-distfile" "$T/thing.pin" "$T/cache"
echo "http://example.invalid/thing-1.0.tgz $sha" > "$T/bad.pin"
refused "fetch: a pin without an https URL is refused" "is not an https URL" fetch "$T/bad.pin" "$T/cache"
echo "https://example.invalid/thing-1.0.tgz $sha http://example.invalid/ours/thing-1.0.tgz" > "$T/bad.pin"
refused "fetch: a fallback that is not https is refused" "is not an https URL" fetch "$T/bad.pin" "$T/cache"
echo "https://example.invalid/thing-1.0.tgz abc" > "$T/bad.pin"
refused "fetch: a pin without a sha256 is refused" "no sha256" fetch "$T/bad.pin" "$T/cache"
rm -rf "${T:?}/cache"
echo "https://example.invalid/up/thing-1.0.tgz $sha https://example.invalid/ours/thing-1.0.tgz" > "$T/two.pin"
refused "fetch: the original, then our copy; neither reachable, both named" "       https://example.invalid/ours/thing-1.0.tgz" \
	env AMIX_DISTFILES="$T/empty" sh "$here/fetch-distfile" "$T/two.pin" "$T/cache"
check "fetch: netbsd-syssrc.distfile names archive.netbsd.org first, our copy second, under the upstream's name" \
	grep -Eqx 'https://archive\.netbsd\.org/[^ ]+/syssrc\.tgz [0-9a-f]{64} https://github\.com/amigaux/amix-distfiles/releases/download/netbsd-10\.1/syssrc\.tgz' "$here/netbsd-syssrc.distfile"

# --- the media image ---------------------------------------------------------------
check "media: amitools.distfile names the original first, our copy second, under its own name" \
	grep -Eqx 'https://[^ ]+/amitools-[0-9.]+\.tar\.gz [0-9a-f]{64} https://github\.com/amigaux/amix-distfiles/releases/download/amitools-[0-9.]+/amitools-[0-9.]+\.tar\.gz' "$here/amitools.distfile"
check "media: Containerfile.media is on the build container, and leaves the toolchains' directories alone" \
	sh -c 'grep -q "^FROM \${BASE}$" "$0" && ! grep -v "^#" "$0" | grep -Eq "/opt/amix(-cross)?(/| |$)"' "$here/Containerfile.media"

# --- m68k-gnu-bin -------------------------------------------------------------------
mkdir -p "$T/g14/prefix/bin"
for t in gcc as ld ar nm objcopy objdump readelf size; do
	printf '#!/bin/sh\necho m68k-elf-%s "$@"\n' "$t" > "$T/g14/prefix/bin/m68k-elf-$t"
	chmod 755 "$T/g14/prefix/bin/m68k-elf-$t"
done
check "m68k-gnu-bin: every m68k-linux-gnu tool the port calls, linked to gcc14's" \
	sh -c 'G14=$1 sh "$0" "$2" && for t in gcc as ld ar nm objcopy objdump readelf size; do
		[ "$("$2/m68k-linux-gnu-$t" x)" = "m68k-elf-$t x" ] || exit 1; done' \
	"$here/m68k-gnu-bin" "$T/g14" "$T/gnu"
check "m68k-gnu-bin: the port's lookup finds the directory" \
	sh -c '[ "$(PATH=$0:$PATH; dirname "$(command -v m68k-linux-gnu-nm)")" = "$0" ]' "$T/gnu"
rm "${T:?}/g14/prefix/bin/m68k-elf-objcopy"
refused "m68k-gnu-bin: a missing gcc14 tool is refused" "no $T/g14/prefix/bin/m68k-elf-objcopy" \
	env G14="$T/g14" sh "$here/m68k-gnu-bin" "$T/gnu2"
refused "m68k-gnu-bin: G14 unset is refused" "G14 is not set" env -u G14 sh "$here/m68k-gnu-bin" "$T/gnu3"

# --- sysroot-links -----------------------------------------------------------
# a stand-in sysroot: empty files where amix-system has the real ones
sr=$T/sysroot
mkdir -p "$sr/usr/amiga/include/amiga" "$sr/usr/amiga/lib" "$sr/usr/ucblib" "$sr/usr/lib" \
	"$sr/usr/include" "$sr/usr/ccs/lib" "$sr/usr/X/include"
: > "$sr/usr/amiga/include/amiga/screen.h"
: > "$sr/usr/amiga/lib/libscreen.so"
: > "$sr/usr/ucblib/libdbm.a"
ln -s /usr/amiga/lib/libscreen.so "$sr/usr/lib/libscreen.so"
ln -s /usr/amiga/include/amiga "$sr/usr/include/amiga"
ln -s /usr/ucblib/libdbm.a "$sr/usr/ccs/lib/libdbm.a"
ln -s /usr/ucblib/libucb.a "$sr/usr/ccs/lib/libucb.a"
ln -s /usr/X/include "$sr/usr/include/X11"
check "sysroot-links: the links into usr/amiga and usr/ucblib become relative and resolve" \
	sh -c 'sh "$0" "$1" >/dev/null && cd "$1" &&
		[ "$(readlink usr/lib/libscreen.so)" = ../amiga/lib/libscreen.so ] &&
		[ "$(readlink usr/include/amiga)" = ../amiga/include/amiga ] &&
		[ "$(readlink usr/ccs/lib/libdbm.a)" = ../../ucblib/libdbm.a ] &&
		[ -e usr/lib/libscreen.so ] && [ -e usr/include/amiga/screen.h ] && [ -e usr/ccs/lib/libdbm.a ]' \
	"$here/sysroot-links" "$sr"
check "sysroot-links: a target not in the sysroot and a link elsewhere stay as they were" \
	sh -c '[ "$(readlink "$0/usr/ccs/lib/libucb.a")" = /usr/ucblib/libucb.a ] &&
		[ "$(readlink "$0/usr/include/X11")" = /usr/X/include ]' "$sr"
check "sysroot-links: a second run changes nothing" \
	sh -c '[ -z "$(sh "$0" "$1")" ]' "$here/sysroot-links" "$sr"
mkdir -p "$T/oldsys/usr/amiga"
refused "sysroot-links: a sysroot without usr/ucblib is refused" "has no usr/ucblib" \
	sh "$here/sysroot-links" "$T/oldsys"

# --- check-image -------------------------------------------------------------------
mkdir -p "$T/ck/tc" "$T/ck/PINS"
cp "$here/check-image" "$T/ck/tc/"
printf 'https://example.invalid/a.git %s\n' 1111111111111111111111111111111111111111 > "$T/ck/tc/a.pin"
printf 'https://example.invalid/b.git %s\n' 2222222222222222222222222222222222222222 > "$T/ck/tc/b.pin"
cp "$T/ck/tc/a.pin" "$T/ck/tc/b.pin" "$T/ck/PINS/"
ck() { AMIX_PINS=$T/ck/PINS sh "$T/ck/tc/check-image" "$@"; }
check "check-image: the image's pins are the checkout's" \
	sh -c 'AMIX_PINS=$1 sh "$2" | grep -qx "check-image: the image.s pins are this checkout.s (a.pin b.pin)"' \
	sh "$T/ck/PINS" "$T/ck/tc/check-image"
printf 'https://example.invalid/a.git %s\n' 3333333333333333333333333333333333333333 > "$T/ck/PINS/a.pin"
refused "check-image: a pin that differs is refused, both commits named" "a.pin: image 3333333, checkout 1111111" ck
cp "$T/ck/tc/a.pin" "$T/ck/PINS/a.pin"; rm "${T:?}/ck/PINS/b.pin"
refused "check-image: a pin the image lacks is refused" "b.pin: image none, checkout 2222222" ck
cp "$T/ck/tc/b.pin" "$T/ck/PINS/"; cp "$T/ck/tc/a.pin" "$T/ck/PINS/c.pin"
refused "check-image: a pin only the image has is refused" "c.pin: image 1111111, checkout none" ck
refused "check-image: an image without the stamp is refused" "predates pin stamps" \
	env AMIX_PINS="$T/ck/none" sh "$T/ck/tc/check-image"
if [ "$(id -u)" != 0 ]; then
	chmod 0644 "$T/ck/PINS"
	refused "check-image: a stamp the caller cannot read is refused" "cannot read $T/ck/PINS" ck
	chmod 0755 "$T/ck/PINS"
fi
mkdir -p "$T/ck/bin"
printf '#!/bin/sh\nprintf "%%s\\n" "$@" > "%s"\n' "$T/ck/args" > "$T/ck/bin/docker"; chmod +x "$T/ck/bin/docker"
check "check-image IMAGE: runs itself in the image, the toolchain directory read-only" \
	sh -c 'PATH=$1/bin:$PATH sh "$1/tc/check-image" amix-toolchain:test &&
		[ "$(tr "\n" " " < "$1/args")" = "run --rm -v $1/tc:/check:ro amix-toolchain:test sh /check/check-image " ]' sh "$T/ck"

# --- image-manifest -------------------------------------------------------------
mkdir -p "$T/im/one/usr/bin" "$T/im/one/etc" "$T/bin"
printf 'tool\n' > "$T/im/one/usr/bin/a"
ln "$T/im/one/usr/bin/a" "$T/im/one/usr/bin/z"
ln -s a "$T/im/one/usr/bin/s"
printf 'runtime\n' > "$T/im/one/etc/hostname"
touch "$T/im/one/.dockerenv"
chmod 0755 "$T/im/one/usr/bin/a"
cat > "$T/bin/stand-in" <<'STANDIN'
#!/bin/sh
case $1 in
image) echo '["PATH=/bin"] null null "/src" ""' ;;
create) echo cid ;;
export) tar -C "$IMAGE_DIR" --sort=name -cf - . ;;
rm) echo "$2" > "$IMAGE_DIR.removed" ;;
esac
STANDIN
chmod 755 "$T/bin/stand-in"
im() { IMAGE_DIR=$1 CONTAINER=$T/bin/stand-in python3 -I "$here/image-manifest" any; }
im "$T/im/one" > "$T/im/1"
sha=$(sha256sum < "$T/im/one/usr/bin/a" | cut -c1-64)
check "image-manifest: the config comes first" sh -c "head -1 '$T/im/1' | grep -qF 'config [\"PATH=/bin\"]'"
check "image-manifest: a file's sha256 and mode" grep -qE "^$sha 0755 [0-9]+:[0-9]+ f usr/bin/a\$" "$T/im/1"
check "image-manifest: a hard link reads as its file" grep -qE "^$sha 0755 [0-9]+:[0-9]+ f usr/bin/z\$" "$T/im/1"
check "image-manifest: a symbolic link names its target" grep -qE " l usr/bin/s -> a\$" "$T/im/1"
check "image-manifest: the runtime's files are left out" sh -c "! grep -qE 'etc/hostname|dockerenv' '$T/im/1'"
check "image-manifest: the container is removed" grep -q cid "$T/im/one.removed"
touch -d 2001-01-01 "$T/im/one/usr/bin/a"
im "$T/im/one" > "$T/im/2"
check "image-manifest: a file's time is not compared" cmp "$T/im/1" "$T/im/2"
printf 'other\n' > "$T/im/one/usr/bin/a"
im "$T/im/one" > "$T/im/3"
check "image-manifest: a file's content is" sh -c "! cmp -s '$T/im/1' '$T/im/3'"

echo "$pass/$((pass + fail)) passed"
[ "$fail" -eq 0 ]
