#!/bin/sh
# fetch-distfile: fetch a pinned distfile into the cache, checked.
#
# MIT licence, see LICENSE at the top of the repository.
#
#     toolchain/fetch-distfile <name>.distfile [<cache dir>]   (default out/cache)
#
# A distfile pin (a .distfile, not a .pin: that is a repository and a commit,
# and the build image's cache key) is one line, `<URL> <sha256> [<URL>...]`:
# the original site first, then our copy, a release asset of
# amigaux/amix-distfiles under the upstream's own file name, for when the
# original moves (NetBSD 10.1 has already left cdn.netbsd.org). The order is
# build/pkg/common/fetch.sh's, a package's source's: the cache, AMIX_DISTFILES
# (a local directory of distfiles), then each URL; the sha256 decides every
# time. The file lands in the cache under the first URL's last component.
# Prints the cached file's path last.
set -e

here=$(cd "$(dirname "$0")" && pwd)
top=$(dirname "$here")
pin=${1:?usage: fetch-distfile <pin> [<cache dir>]}
cache=${2:-$top/out/cache}
read -r url sha more < "$pin" || :
for u in $url $more; do
	case "$u" in https://*) ;; *) echo "[FAIL] $pin: '$u' is not an https URL" >&2; exit 1 ;; esac
done
[ -n "$url" ] || { echo "[FAIL] $pin: no URL on its line" >&2; exit 1; }
echo "$sha" | grep -Eq '^[0-9a-f]{64}$' || { echo "[FAIL] $pin: no sha256 after the first URL" >&2; exit 1; }
name=${url##*/}
. "$top/build/pkg/common/fetch.sh"
if [ -f "$cache/$name" ] && [ "$(amix_sha256 "$cache/$name")" = "$sha" ]; then
	echo "  cached  $cache/$name" >&2
	echo "$cache/$name"
	exit 0
fi
# shellcheck disable=SC2086 (the fallback URLs, one word each)
amix_fetch "$url" "$sha" "$cache/$name" $more >&2
echo "$cache/$name"
