# .moddata keys of the z3660eth module, one key=value per line, for the ABI
# kit's mkmod (amix-dlm docs/contracts/C3-1-module-object.md section 3 and
# C3-6-driver-to-module.md section 2).  @KABI@, @CPU@ and @CC@ are the
# kernel line's; tools/build-module.sh writes the filled copy per line next
# to the object.  No match key: the board can be present without an
# AutoConfig entry (the AGA fixed-base fallback in z3660eth_map).
name=z3660eth
kabi=@KABI@
cc=@CC@
cpu=@CPU@
class=boot
majors=c:51
unload=never
param=intr:int:0:0:6
param=intrl2:int:1:0:1
desc=Z3660 ethernet zen0 (STREAMS/DLPI)
