# Patch for gcc-cross-amix/amix-gcc-wrapper.sh (and its installed instance
# <prefix>/bin/m68k-cbm-sysv4-gcc): add the .swbeg fixup to fix_asm.
#
# ROOT CAUSE (found via amix-packagemanager contents-fsck, on-box verified
# symptom, host-verified byte-level mechanism):
#   gcc 2.7.2.3 m68k-SVR4 emits switch jump tables as
#         mov.w  .LDnn(%pc,%a0.l*2),%d0
#         jmp    6(%pc,%d0.w)
#         .swbeg &N
#   .Lnn: .short .Lcase-.Lnn ...
#   The hard-coded "6" assumes the SGS assembler's .swbeg directive emits
#   4 bytes.  GNU as 2.8.1 parses .swbeg but emits ZERO bytes (verified:
#   labels around ".swbeg &58" are 0 bytes apart), so every switch case is
#   entered at <case label> + 4: its first instruction(s) are skipped and
#   the following conditional branch runs on stale flags from the switch
#   range check.  Every cross-built userspace binary containing a switch
#   statement is affected; rebuild and re-screen apkg/heirloom after
#   applying this.
#
# The fetch (.LDnn label reference) self-corrects, so only the jmp base is
# wrong; emitting an explicit 4-byte filler in place of .swbeg restores the
# exact layout gcc's displacement math assumes.  Verified by disassembly:
# fetch base == jmp base == table start, and each case dispatches to its
# first instruction (see src/contents-fsck/tests/kat-branch.c + kat-verify.sh).

--- a/amix-gcc-wrapper.sh
+++ b/amix-gcc-wrapper.sh
@@ -22,6 +22,17 @@

 fix_asm()
 {
+	# SGS ".swbeg &N" (emitted before every switch jump table) occupies
+	# 4 bytes under the native SGS assembler, and gcc's dispatch is
+	# hard-coded around that: "jmp 6(%pc,%d0.w)" expects the table at
+	# ext-word+6 = jmp-end+4.  GNU as parses .swbeg but emits ZERO
+	# bytes, so every switch case is entered 4 bytes late, skipping its
+	# first instruction(s) and branching on stale condition codes.
+	# Replace .swbeg with an explicit 4-byte filler to restore the
+	# layout the compiler assumed.  (Found via amix-packagemanager
+	# contents-fsck: validate_rest's switch misdispatched on the box.)
+	perl -pi -e 's/^(\s*)\.swbeg\s+&(\d+)[ \t]*$/$1.long $2/' "$1"
+
 	perl -pi -e 's/^(\s*\.lcomm\s+[^,]+,[^,]+),\d+\s*$/$1\n/' "$1"
 	perl -0pi -e '
 		sub split_operands {
