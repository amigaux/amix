#
#	Beginning of real code
#
#############################################################################

/etc/umount /mnt > /dev/null 2>&1	# in case we were restarted

# UNATTENDED demo-card branch: auto-run the proven install path + halt on a gated
# unattended medium; falls through to the interview otherwise (see unattended_check).
unattended_check

ask_kmap

# The chosen map has to reach the TARGET: the driver bakes it with stock's own
# one hard link (FB_KMAP -> /usr/amiga/lib/kmap/default.kmap, which /etc/sysinit
# loads on every boot). Two channels, because both survive different things: the
# EXPORT survives the exec chain below (profile -> setup.sh -> install.sh), and
# the FILE survives a Ctrl-C to an interactive shell and back. An EMPTY file is
# not "no answer" -- it is the answer `usa`, which means link nothing.
echo "$KMAP" > $KMAPFILE
export KMAP

MODE=
while [ "$MODE" = "" ]
do
	readask "\nDo you want to install or repair? [install] "

	case $ask in
		"install")	MODE="install"	;;
		"repair")	MODE="repair"	;;
		"")		MODE="install"	;;
	esac
done

if [ "$MODE" = "repair" ]
then
	repair
fi

find_source

# The interview lives on the medium and takes it from here: destination, sizes,
# packages, verbose, confirmation -- and then it execs the driver itself, with
# stdin from /dev/null (METAL-FIX.3). No argument: the medium declares its own
# base profile in /install/profiles/BASE.
exec sh $SETUP
