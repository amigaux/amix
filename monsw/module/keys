# The .moddata keys of the monsw module (amix-dlm C3-1 section 3, C3-6 section 4), one
# key=value string per line as the section carries them.  kabi, cc and cpu come from the
# ABI kit of the line (68030 on k30, 68040 on k46); module/Makefile turns this file into
# the kit's Master.
name=monsw
class=demand
majors=c:52
unload=never
desc=monitor switch /dev/monsw
param=config:int:-1:-1:51
