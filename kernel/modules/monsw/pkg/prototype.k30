# prototype.k30 -- monsw-k30 (monsw30): the module object, the package's
# defaults, the node of its major, monswctl, the boot step, the pages and the
# whatis fragment (amix-dlm C3-5 sec 1).  prototype.k30 and prototype.k46
# differ only in the whatis fragment's name, the package instance.
#
# AUTHORED, NOT GENERATED: build.sh hands it to kmodpkg, which runs pkgmk.
# PURE FILES (amix-dlm spec 40 sec 6): f/d of class none, i pkginfo/copyright
# only, no scripts and no links, so the boot step's rc2.d name is a copy of
# /etc/init.d/monsw; and the node of the driver's major as a device entry in
# the module's class, monsw (C3-5 v18 sec 1.2).  The stock directories are
# declared with the stock attributes (amix-system etc.md), except /usr and
# /usr/sbin, which the stock core owns and the packages do not declare.
i pkginfo
i copyright
d none /etc 0755 root root
d none /etc/conf 0755 root sys
d none /etc/conf/mod.d 0755 root sys
d none /etc/conf/modreg.d 0755 root sys
f none /etc/conf/mod.d/monsw 0644 root sys
f none /etc/conf/modreg.d/monsw 0644 root sys
d none /etc/init.d 0755 bin bin
d none /etc/rc2.d 0755 bin bin
f none /etc/init.d/monsw 0744 root sys
f none /etc/rc2.d/S20monsw 0744 root sys
f none /usr/sbin/monswctl 0755 root sys
d none /opt 0755 root sys
d none /opt/amix 0755 root sys
d none /opt/amix/man 0755 root sys
d none /opt/amix/man/1m 0755 root sys
d none /opt/amix/man/7 0755 root sys
d none /opt/amix/man/whatis.d 0755 root sys
f none /opt/amix/man/7/monsw 0644 root sys
f none /opt/amix/man/1m/monswctl 0644 root sys
f none /opt/amix/man/whatis.d/monsw30 0644 root sys
d none /dev 0755 bin bin
c monsw /dev/monsw 52 0 0644 root root
