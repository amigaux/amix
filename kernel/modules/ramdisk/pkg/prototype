# prototype -- ramdisk-<line> (ramdisk30, ramdisk46): the module object, the
# package's defaults and the nodes of its block major (amix-dlm C3-5 sec 1).
# The same paths on both lines: a box carries the package of its kernel's line.
#
# AUTHORED, NOT GENERATED: build.sh hands it to kmodpkg, which runs pkgmk.
# PURE FILES (amix-dlm spec 40 sec 6): f/d of class none, i pkginfo/copyright
# only, no scripts; and the nodes of the driver's block major as device
# entries in the module's class, ramdisk (C3-5 v18 sec 1.2): /dev/dsk/ram0-2,
# b 20 0-2, mode 0600 as the stock disk nodes.
i pkginfo
i copyright
d none /etc 0755 root root
d none /etc/conf 0755 root sys
d none /etc/conf/mod.d 0755 root sys
d none /etc/conf/modreg.d 0755 root sys
f none /etc/conf/mod.d/ramdisk 0644 root sys
f none /etc/conf/modreg.d/ramdisk 0644 root sys
d none /dev 0755 bin bin
d none /dev/dsk 0755 root root
b ramdisk /dev/dsk/ram0 20 0 0600 root root
b ramdisk /dev/dsk/ram1 20 1 0600 root root
b ramdisk /dev/dsk/ram2 20 2 0600 root root
