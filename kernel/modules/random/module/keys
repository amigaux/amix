# The .moddata keys of the random module (amix-dlm C3-1 section 3, C3-6 section 4), one
# key=value string per line as the section carries them.  kabi, cc and cpu come from the
# ABI kit of the line (68030 on k30, 68040 on k46); module/Makefile turns this file into
# the kit's Master.  unload=never: the key holds the seed randseed wrote at boot.
name=random
class=demand
majors=c:48
unload=never
desc=random numbers /dev/random, /dev/urandom
