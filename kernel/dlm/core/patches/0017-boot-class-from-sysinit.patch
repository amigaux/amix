+ * on.  dlm_marc_post() loads nothing when interrupts are masked and says
+ * where the modules load.  dlm_marc_run() reads the manifest the loader
+ * booted:
  *
  *   1. every demand-class record's character majors= are registered for
  *      that module, so the first open of one loads it;
@@ -74,9 +80,28 @@
 	return 0;
 }
 
+int	dlm_posted;
+
+/* the kernel's hook, in process 0 after vfs_mountroot */
 void
 dlm_marc_post()
 {
+#ifndef DLM_HOST
+	unsigned short sr;
+
+	__asm__ __volatile__("movew %%sr,%0" : "=d" (sr));
+	if (sr & 0x0700) {
+		if (dlm_inited && dlm_man)
+			printf("dlm: boot-class modules load from the first sysinit entry (modadmin -B)\n");
+		return;
+	}
+#endif
+	dlm_marc_run();
+}
+
+void
+dlm_marc_run()
+{
 	char name[MODMAXNAMELEN], v[MD_MAXSTR + 1], *p, *l, *lim, *q;
 	int pass, e, n;
 
