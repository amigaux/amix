+/* kinfo's module list (C2-1 offset 536) from the core */
+void
+kinfo_tests()
+{
+	static char buf[32 * 8];
+	struct dlm_mod *m;
+	int n, i, k = 0;
+
+	n = dlm_kinfo_list(buf, 8);
+	for (m = dlm_list; m; m = m->m_next)
+		if (!(m->m_flags & DM_TRANS))
+			k++;
+	check(n == (k < 8 ? k : 8), "kinfo: one entry per loaded module, at most max");
+	for (i = 0, m = dlm_list; m && i < n; m = m->m_next) {
+		if (m->m_flags & DM_TRANS)
+			continue;
+		if (strcmp(buf + 32 * i, m->m_name) != 0 || G32(buf + 32 * i + 24) != (unsigned long)m->m_run ||
+		    G32(buf + 32 * i + 28) != (unsigned long)m->m_size)
+			break;
+		i++;
+	}
+	check(i == n, "kinfo: each entry is the module's name, load address and size");
+}
