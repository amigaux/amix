-	rts
--- a/dlm_core.c
+++ b/dlm_core.c
@@ -1125,6 +1125,33 @@
 	return e;
 }
 
+/*
+ * The loaded modules for kinfo's record (amix-dlm docs/contracts/C2-1,
+ * offset 536): at most max entries of 32 bytes, the name NUL-padded to 24,
+ * the load address and the size, big-endian; returns the count.  A module
+ * still loading or unloading is left out.  The kinfo driver calls it on
+ * every read, so the list is current.
+ */
+int
+dlm_kinfo_list(buf, max)
+	char *buf;
+	int max;
+{
+	struct dlm_mod *m;
+	int n = 0;
+
+	for (m = dlm_list; m && n < max; m = m->m_next) {
+		if (m->m_flags & DM_TRANS)
+			continue;
+		bzero(buf + 32 * n, 24);
+		strncpy(buf + 32 * n, m->m_name, 23);
+		P32(buf + 32 * n + 24, (unsigned long)m->m_run);
+		P32(buf + 32 * n + 28, (unsigned long)m->m_size);
+		n++;
+	}
+	return n;
+}
+
