+/*
+ * A first-use load (the first mount of a demand filesystem type, a demand
+ * major's first open, a first exec, modadmin -l) runs in a user's process
+ * after multi-user, where a KM_SLEEP request the kernel map cannot meet
+ * waits for good (U2, U4).  So its process is in dlm_nwproc while it
+ * loads, and every allocation the core makes for it is KM_NOSLEEP, under
+ * the root pass's cap: short memory fails the load with ENOMEM and the
+ * kernel as it was, and a later use tries again.  Boot-class loads keep
+ * KM_SLEEP.  Per process, so another process's load is not affected.
+ */
+#define	DLM_NWMAX	8
+static char	*dlm_nwproc[DLM_NWMAX];
+
+static int
+nowait()
+{
+	int i;
+
+	for (i = 0; i < DLM_NWMAX; i++)
+		if (dlm_nwproc[i] && dlm_nwproc[i] == CURPROC())
+			return 1;
+	return 0;
+}
+
+static int
+nowait_enter()
+{
+	int i;
+
+	for (i = 0; i < DLM_NWMAX; i++)
+		if (dlm_nwproc[i] == 0) {
+			dlm_nwproc[i] = CURPROC();
+			return 1;
+		}
+	return 0;
+}
+
+static void
+nowait_leave()
+{
+	int i;
+
+	for (i = 0; i < DLM_NWMAX; i++)
+		if (dlm_nwproc[i] == CURPROC())
+			dlm_nwproc[i] = 0;
+}
+
+#define	NOMEM(e)	((e) == ENOMEM && (dlm_nosleep || nowait()))
 
