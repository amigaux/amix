+	host_nomem_after = 0;
+	fd_mounts = 0;
+	check(fdmount("fd4", &v1) == 0 && byname("fd4") && fd_mounts == 1,
+	    "nowait: the next mount, with memory, loads the module and mounts");
+	nfstype = base;			/* fd4 stays, pinned */
+	bzero((caddr_t)&vfssw[base], 4 * sizeof vfssw[0]);
+	dlm_nfsdem = 0;
+	dlm_man = om;
+	dlm_manlen = ol;
