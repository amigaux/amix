+void
+nowait_tests()
+{
+	static char a[4096], man[2048], s1[65], s2[65], s4[65];
+	extern long host_kmaxreq;
+	extern struct vfsops dlm_fsstub[];
+	extern int dlm_nfsdem;
+	char *om = dlm_man;
+	long ol = dlm_manlen, gen, bytes, blocks, sl, fsize;
+	struct dlm_mod *m;
+	struct vfs v1;
+	FILE *f;
+	char p[1024];
+	int id, k, e = -1, clean = 1, odev = dlm_devload, base = nfstype;
+
+	hexsha("nw1", s1);
+	hexsha("nw2", s2);
+	hexsha("fd4", s4);
+	sprintf(man, "GMF1\ngeneration 9\n"
+	    "module nw1 demand 300 path=/stand/gen/7/mod/nw1 sha256=%s\n"
+	    "module nw2 boot 300 path=/stand/gen/7/mod/nw2 sha256=%s match=always\n"
+	    "module fd4 demand 300 path=/stand/gen/7/mod/fd4 sha256=%s fs=fd4\n", s1, s2, s4);
+	mkarena(a, man, 1, 1);
+	dlm_arena_check(a, 4096L, &dlm_man, &dlm_manlen, &gen);
+	dlm_devload = 0;
+	/* the file's copy: its size exactly, and gone before _load */
+	host_handler("nw1_load", h_kbin);
+	sprintf(p, "%s/stand/gen/7/mod/nw1", host_root);
+	fsize = (f = fopen(p, "rb")) != 0 && fseek(f, 0L, 2) == 0 ? ftell(f) : -1;
+	if (f)
+		fclose(f);
+	host_kmaxreq = 0;
+	nw_kbin = -1;
+	check(fsize > 0 && fsize < 8192 && modload("nw1", &id) == 0 && (m = byname("nw1")) != 0,
+	    "nowait: a manifest member loads by modadmin -l");
+	check(host_kmaxreq < 8192 && host_kmaxreq >= fsize + 1,
+	    "nowait: the file's copy is its size plus one, one request (no doubling)");
+	check(nw_kbin >= 0 && nw_kbin - host_kbytes < fsize,
+	    "nowait: during _load the core no longer holds the file's copy");
+	moduload(id);
+	/* modadmin -l: KM_NOSLEEP; each failing request -> ENOMEM, the kernel as it was */
+	bytes = host_kbytes;
+	blocks = host_kblocks;
+	sl = host_km_sleep;
+	for (k = 1; k < 200; k++) {
+		host_nomem_after = k;
+		if ((e = modload("nw1", &id)) == 0)
+			break;
+		if (e != ENOMEM || byname("nw1") || host_kbytes != bytes || host_kblocks != blocks)
+			clean = 0;
+	}
+	host_nomem_after = 0;
+	check(k > 1 && k < 200 && clean && host_km_sleep == sl,
+	    "nowait: a first-use load asks KM_NOSLEEP only; short memory -> ENOMEM, the kernel as it was");
+	if ((m = byname("nw1")) != 0)
+		moduload(m->m_id);
+	/* a boot-class load (marc_post) keeps KM_SLEEP */
+	sl = host_km_sleep;
+	check(dlm_loadname("nw2") == 0 && byname("nw2") && host_km_sleep > sl,
+	    "nowait: a boot-class load still asks KM_SLEEP");
+	if ((m = byname("nw2")) != 0)
+		moduload(m->m_id);
+	/* the first mount of a demand filesystem type under short memory */
+	host_handler("fd4_load", h_vfown);
+	host_handler("fd4_mount", h_fdmount);
+	dlm_marc_run();
+	host_nomem_after = 2;
+	check(rowof("fd4") == base && fdmount("fd4", &v1) == ENOMEM && !byname("fd4") &&
+	    vfssw[base].vsw_vfsops == &dlm_fsstub[0],
