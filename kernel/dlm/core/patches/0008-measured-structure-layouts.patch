Subject: structure layouts measured by the kernel's compiler, not hard-coded

dlm_slot.c and dlm_str.c read struct mod_drv_data, cdevsw, mod_str_data,
streamtab and qinit inside module images at offsets written down for
AMIX 2.1, and the host test of them reused the same macros, so nothing
checked them against the real headers.  dlmoffs.c now states each
layout as an expression over the kernel's own headers; tools/mkoffs
compiles it with the kernel build's compiler and flags and writes
dlm_offs.h, which both files include (build.sh generates it first).
On the Amix 2.1 sysroot every value equals the one written down.
30-module-core.md section 2, patch 15.

--- a/build.sh
+++ b/build.sh
@@ -63,6 +63,11 @@
 pass() { echo "PASS $1"; }
 fail() { echo "FAIL $1: $2 (log: $LOG/$1.log)"; exit 1; }
 
+# 0. the structure layouts the core reads in module images, measured by
+# the kernel's compiler (dlm_offs.h; the host tools include it too)
+sh "$DLM/tools/mkoffs" m68k-cbm-sysv4-gcc $AMIX_KERNEL_CFLAGS -I"$DLM/include" \
+	> "$DLM/dlm_offs.h" || fail offs "tools/mkoffs"
+
 # 1. host tools
 {
 	$HCC -DDLM_TOOL -I"$DLM" -I"$DLM/include" -o "$B/tools/mkksym" \
--- a/dlmoffs.c
+++ b/dlmoffs.c
@@ -0,0 +1,41 @@
+/*
+ * dlmoffs.c -- the layouts the core reads in a module's image, measured
+ * by the compiler that builds the kernel, against the kernel's own
+ * headers (amix-dlm docs/spec/30-module-core.md section 2, patch 15).
+ * tools/mkoffs compiles this file to assembler and writes dlm_offs.h,
+ * which dlm_slot.c and dlm_str.c include; nothing is hard-coded.  The
+ * file is never linked.
+ *
+ * K&R C.
+ */
+
+#include "sys/types.h"
+#include "sys/param.h"
+#include "sys/conf.h"
+#include "sys/stream.h"
+#include "sys/moddefs.h"
+
+#define	OFF(s, m)	((int)&((struct s *)0)->m)
+
+/* struct mod_drv_data (sys/moddefs.h) and struct cdevsw (sys/conf.h) */
+int	dlm_off_DRVSZ = sizeof (struct mod_drv_data);
+int	dlm_off_DRV_BCOUNT = OFF(mod_drv_data, drv_bcount);
+int	dlm_off_DRV_CDEVSW = OFF(mod_drv_data, drv_cdevsw);
+int	dlm_off_DRV_CMAJOR = OFF(mod_drv_data, drv_cmajor);
+int	dlm_off_DRV_CCOUNT = OFF(mod_drv_data, drv_ccount);
+int	dlm_off_CD_NFN = OFF(cdevsw, d_ttys) / sizeof (int (*)());
+int	dlm_off_CD_TTYS = OFF(cdevsw, d_ttys);
+int	dlm_off_CD_STR = OFF(cdevsw, d_str);
+int	dlm_off_CD_FLAG = OFF(cdevsw, d_flag);
+
+/* struct mod_str_data (sys/moddefs.h), streamtab and qinit (sys/stream.h) */
+int	dlm_off_SD_NAME = OFF(mod_str_data, str_name[0]);
+int	dlm_off_SD_TAB = OFF(mod_str_data, str_tab);
+int	dlm_off_SD_FLAG = OFF(mod_str_data, str_flag);
+int	dlm_off_SDSZ = sizeof (struct mod_str_data);
+int	dlm_off_STSZ = sizeof (struct streamtab);
+int	dlm_off_QISZ = sizeof (struct qinit);
+int	dlm_off_QI_OPEN = OFF(qinit, qi_qopen);
+int	dlm_off_QI_CLOSE = OFF(qinit, qi_qclose);
+int	dlm_off_QI_MINFO = OFF(qinit, qi_minfo);
+int	dlm_off_QI_MSTAT = OFF(qinit, qi_mstat);
