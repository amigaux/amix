--- a/tools/mkoffs
+++ b/tools/mkoffs
@@ -0,0 +1,18 @@
+#!/bin/sh
+# mkoffs -- dlm_offs.h: the structure layouts the core reads in module
+# images, measured by the kernel's compiler against the kernel's headers
+# (dlmoffs.c).  Run with the kernel build's compiler and flags:
+#
+#   mkoffs m68k-cbm-sysv4-gcc $AMIX_KERNEL_CFLAGS -I<core>/include > dlm_offs.h
+#
+# Each "int dlm_off_X = <expression>;" in dlmoffs.c becomes
+# "#define X <value>"; mkoffs fails if any is missing from the output.
+set -e
+[ $# -ge 1 ] || { echo "usage: mkoffs CC [CFLAGS...]" >&2; exit 2; }
+D=$(cd "$(dirname "$0")/.." && pwd)
+n=$(grep -c '^int	dlm_off_' "$D/dlmoffs.c")
+"$@" -S -o - "$D/dlmoffs.c" | awk -v n="$n" '
+/^dlm_off_[A-Z_]*:$/ { name = substr($0, 9, length($0) - 9); next }
+name != "" && $1 == ".long" { printf "#define\t%s\t%s\n", name, $2; got++; name = ""; next }
+BEGIN { print "/* dlm_offs.h -- generated by tools/mkoffs from dlmoffs.c; do not edit */" }
+END { if (got != n) { print "mkoffs: " got " of " n " layouts found" > "/dev/stderr"; exit 1 } }'
