+/* ---- sd_register (C4-1, 30 section 2 patch 8, S4-03) ---- */
+static int sr_e[8], sr_n;
+
+/* register board k of the calling module, its own _load as the queue entry */
+static int
+sr_reg(m, rank, k)
+	char *m;
+	unsigned rank;
+	int k;
+{
+	struct dlm_mod *dm = (struct dlm_mod *)m;
+	char sym[16];
+
+	sprintf(sym, "%s_load", dm->m_name);
+	return sd_register((int (*)())modsym(dm, sym), (unsigned)k, (char *)0x40000000L + k,
+	    "HBA", rank);
+}
+
+int
+h_sr1(m, a, b)
+	char *m, *a;
+	long b;
+{
+	sr_e[sr_n++] = sr_reg(m, 1, 0);
+	return 0;
+}
+
+int
+h_sr2(m, a, b)
+	char *m, *a;
+	long b;
+{
+	sr_e[sr_n++] = sr_reg(m, 3, 0);		/* declared zorro, registers mobo */
+	return 0;
+}
+
+int
+h_sr3(m, a, b)
+	char *m, *a;
+	long b;
+{
+	sr_e[sr_n++] = sr_reg(m, 4, 0);
+	return EIO;				/* fails after registering */
+}
+
+int
+h_sr4(m, a, b)
+	char *m, *a;
+	long b;
+{
+	int k;
+
+	for (k = 0; k < 4; k++)
+		sr_e[sr_n++] = sr_reg(m, 2, k);
+	return 0;
+}
+
+void
+sdreg_tests()
+{
+	struct dlm_sdreg *t;
+	int i1, i2, i3, i4, n;
+
+	host_handler("sr1_load", h_sr1);
+	host_handler("sr2_load", h_sr2);
+	host_handler("sr3_load", h_sr3);
+	host_handler("sr4_load", h_sr4);
+	check(modload("srbad", &i1) == ECONFIG && !byname("srbad"), "sd: an unknown rank class -> ECONFIG");
+	check(sd_register(nodev, 0, (char *)0, "HBA", 1) == EINVAL && dlm_nsdreg == 0,
+	    "sd: registering outside a module's _load -> EINVAL");
+	sr_n = 0;
+	check(modload("sr1", &i1) == 0 && sr_e[0] == 0 && dlm_nsdreg == 1 && dlm_sdreg[0].sr_rank == 1 &&
+	    dlm_sdreg[0].sr_c == 0 && strcmp(dlm_sdreg[0].sr_name, "HBA") == 0,
+	    "sd: a z3660-class module registers its board from _load");
+	check(modload("sr2", &i2) == 0 && sr_e[1] == EINVAL && dlm_nsdreg == 1,
+	    "sd: a rank other than the module's declared class -> EINVAL");
+	check(modload("sr3", &i3) == EIO && !byname("sr3") && sr_e[2] == 0 && dlm_nsdreg == 1,
+	    "sd: a _load that fails after registering leaves no entry");
+	sr_n = 0;
+	check(modload("sr4", &i4) == 0 && sr_e[0] == 0 && sr_e[1] == 0 && sr_e[2] == 0 &&
+	    sr_e[3] == ENOSPC && dlm_nsdreg == 4, "sd: a fifth controller -> ENOSPC");
+	n = dlm_sd_close(&t);
+	check(n == 4 && t == dlm_sdreg && dlm_sdclosed, "sd: the first open takes the four and closes");
+	check(sd_register(nodev, 0, (char *)0, "HBA", 1) == EBUSY, "sd: after the first open -> EBUSY");
+	dlm_sdclosed = dlm_nsdreg = 0;
+	moduload(i4);
+	moduload(i2);
+	moduload(i1);
+}
+
