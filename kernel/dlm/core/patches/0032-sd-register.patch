+/*
+ * sd_register (C4-1 section 3, 30 section 2 patch 8): a disk controller
+ * module registers each board from its _load in the root pass.  The entry
+ * waits here until sd's first open takes the table (dlm_sd_close) and
+ * ranks it with the floor's controllers; after that registration is
+ * closed.  A failed load's entries go with the backstop above.
+ */
+struct dlm_sdreg dlm_sdreg[DLM_SDREG];
+int	dlm_nsdreg, dlm_sdclosed;
+
+int
+sd_register(f, c, base, name, rank)
+	int (*f)();
+	unsigned c;
+	char *base, *name;
+	unsigned rank;
+{
+	struct dlm_sdreg *r;
+	int s;
+
+	if (dlm_sdclosed) {
+		printf("sd: %s registered after the controllers closed\n", name ? name : "?");
+		return EBUSY;
+	}
+	if (f == 0 || name == 0 || rank < 1 || rank > 4 || dlm_curmod == 0 ||
+	    rank != (unsigned)dlm_curmod->m_rank) {
+		printf("sd: %s: bad rank or entry\n", name ? name : "?");
+		return EINVAL;
+	}
+	SPLHI(s);
+	if (dlm_nsdreg >= DLM_SDREG) {
+		SPLX(s);
+		printf("sd: too many controllers\n");
+		return ENOSPC;
+	}
+	r = &dlm_sdreg[dlm_nsdreg++];
+	r->sr_f = f;
+	r->sr_c = c;
+	r->sr_base = base;
+	r->sr_name = name;
+	r->sr_rank = rank;
+	SPLX(s);
+	return 0;
+}
+
+/* sd's first open: the pending registrations, and registration closes */
+int
+dlm_sd_close(tp)
+	struct dlm_sdreg **tp;
+{
+	dlm_sdclosed = 1;
+	*tp = dlm_sdreg;
+	return dlm_nsdreg;
+}
+
