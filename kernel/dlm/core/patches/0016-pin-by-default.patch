+/* pinning (C3-1 section 2): no unload without unload=allowed */
+static void
+pin_tests()
+{
+	struct dlm_mod *m;
+	int id = 0;
+
+	check(modload("pin1", &id) == 0 && (m = byname("pin1")) != 0,
+	    "pin: a module without unload=allowed loads");
+	check(moduload(id) == EBUSY && byname("pin1") == m,
+	    "pin: unload=never (the default) refuses moduload");
+	check(moduload(0) == EBUSY && byname("pin1") == m,
+	    "pin: moduload(0) leaves the pinned module");
+	m->m_flags |= DM_UNLOADOK;		/* the harness's own way out */
+	check(moduload(id) == 0 && !byname("pin1"), "pin: with unload=allowed it unloads");
+}
+
