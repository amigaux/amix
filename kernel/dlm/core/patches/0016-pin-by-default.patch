 		goto fail;
+	if (ld->ld_md.md_unload)		/* pinned unless it says so (C3-1) */
+		m->m_flags |= DM_UNLOADOK;
 
 	/* dependencies */
 	for (n = 0, pos = 0; dlm_ld_dep(ld, &pos, dep) > 0; n++)
@@ -919,6 +921,8 @@
 
 	if (how == DU_AUTO && (m->m_flags & DM_DEMAND))
 		return EBUSY;
+	if (!(m->m_flags & DM_UNLOADOK))	/* pinned: unload=never */
+		return EBUSY;
 	if (busy(m))
 		return EBUSY;
 	m->m_flags |= DM_UNLOADING;
@@ -1203,7 +1207,7 @@
 	}
 	strcpy(st->ms_name, m->m_name);
 	st->ms_flags = (m->m_flags & DM_DEMAND ? MS_DEMAND : 0) |
-	    (m->m_flags & DM_LOCKED ? MS_LOCKED : 0) |
+	    (m->m_flags & DM_LOCKED || !(m->m_flags & DM_UNLOADOK) ? MS_LOCKED : 0) |
 	    (m->m_flags & DM_CAND ? MS_CAND : 0);
 	e = copyout((caddr_t)st, (caddr_t)uap->st, sizeof (struct modstatus)) ?
