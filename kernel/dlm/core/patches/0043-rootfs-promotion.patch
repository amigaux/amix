 /* ---- ramdisk_image (C4-3 section 4) ---- */
+/* a boot-class filesystem from the arena: only as the manifest's rootfs */
+void
+promote_tests()
+{
+	static char *n[] = { "pfs" };
+	static int f[] = { 1 }, d[] = { 0 }, m[] = { 1 };
+	char *man = dlm_man;
+	long manlen = dlm_manlen;
+
+	rp_rootfs = "ufs";
+	check(rpbuild(n, f, d, m, 1) == 0 && dlm_root_pass(rp_arena) == 0 && !byname("pfs"),
+	    "arena: a boot-class filesystem that is not the manifest's rootfs -> not linked");
+	rp_rootfs = "pfs";
+	check(rpbuild(n, f, d, m, 1) == 0 && dlm_root_pass(rp_arena) == 1 && byname("pfs"),
+	    "arena: the manifest's rootfs, a boot-class module, links from the arena (C4-4 1.3)");
+	rp_rootfs = 0;
+	dlm_man = man;
+	dlm_manlen = manlen;
+}
