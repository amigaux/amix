Subject: promotion: the rootfs's boot-class module links from the arena

Contract C4-4 section 1.3 (the orchestrator's decision on amix-cdfs's
plan): cdfs is boot class on a disk-rooted box and root on the CD
medium, one object.  kbootset composes it as a root record on a
generation whose rootfs it is; the core links an arena module of boot
class only when its fs= is the manifest's rootfs, and refuses any other
as before.  The state harness checks both.

--- a/dlm_arena.c
+++ b/dlm_arena.c
@@ -148,6 +148,23 @@
 	return g == dlm_mangen && bcmp(p, "/mod/", 5) == 0 && strcmp(p + 5, name) == 0;
 }
 
+/* 1 if the manifest's rootfs record names fs (10 section 5.1) */
+int
+dlm_man_rootfs(fs)
+	char *fs;
+{
+	char *p = dlm_man, *lim = dlm_man + dlm_manlen, *l;
+	int n = strlen(fs);
+
+	for (; p && p < lim; p = l + 1) {
+		for (l = p; l < lim && *l != '\n'; l++)
+			;
+		if (l - p == 7 + n && bcmp(p, "rootfs ", 7) == 0 && bcmp(p + 7, fs, n) == 0)
+			return 1;
+	}
+	return 0;
+}
+
 /*
  * The manifest's record for a boot- or demand-class module: 0 with its
  * path= (into path, at most cap bytes) and sha256= (64 hex digits into
--- a/dlm_core.c
+++ b/dlm_core.c
@@ -795,7 +795,10 @@
 		printf("dlm: %s: root class is loaded from the arena only\n", name);
 		return ECONFIG;
 	}
-	if (md->md_class != MD_ROOT && arena) {
+	/* boot class in the arena: only the manifest's root filesystem, which
+	 * kbootset composes as a root record there (C4-4 section 1.3) */
+	if (md->md_class != MD_ROOT && arena &&
+	    !(md->md_class == MD_BOOT && md->md_fs[0] && dlm_man_rootfs(md->md_fs))) {
 		printf("dlm: %s: in the arena but not root class\n", name);
 		return ECONFIG;
 	}
