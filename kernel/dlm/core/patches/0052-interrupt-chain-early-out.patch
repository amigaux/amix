Subject: an empty interrupt chain costs two instructions, not a walk

Every level-2 interrupt (the clock, the A3000's SCSI, the network) went
through dlm_int2_walk, which walked all 8 slots of the module chain even
with none attached: about 390 cycles, 15.6 us on a 25 MHz 68030, so
1.6-3 % of the CPU at 1000-2000 interrupts a second under disk load.
The level-6 CIA-B wrapper did the same.  Each chain now keeps its count
of attached handlers, changed under SPLHI in intr_attach, intr_detach
and the backstop's dlm_intr_sweep, and the walk and the wrapper run the
chain only when it is not 0.  dlm_intr_attached(level) answers the
count, for the harness.

--- a/dlm_intr.c
+++ b/dlm_intr.c
@@ -23,7 +23,10 @@
  * A handler is called as fn(arg) at its level and returns nonzero if its
  * board raised the interrupt; every handler of the chain is called every
  * time, as the stock ones are, and what they return is counted, not used
- * to stop the chain.  No spl masks level 6 (C3-2): a level-6 handler's
+ * to stop the chain.  Each chain keeps the number of its handlers, so with
+ * none attached an interrupt costs two instructions here instead of a walk
+ * over every slot (about 390 cycles on a 68030 for the empty level-2
+ * chain).  No spl masks level 6 (C3-2): a level-6 handler's
  * driver masks at its own board.  A driver with a polled mode keeps it as
  * the default and attaches only once its board is set up to interrupt;
  * if intr_attach fails it stays polled.
@@ -43,6 +46,7 @@
 };
 
 static struct dlm_intr	int2_chain[INTR_MAX], int6_chain[INTR_MAX];
+static int		int2_n, int6_n;	/* handlers attached, changed under SPLHI */
 static int		(*int2_last)();	/* the stock handler the walk displaced */
 static int		dlm_intr_ready;
 
@@ -81,7 +85,8 @@
 {
 	if (int2_last)
 		(*int2_last)(a);
-	runchain(int2_chain);
+	if (int2_n)
+		runchain(int2_chain);
 	return 0;
 }
 
@@ -92,7 +97,8 @@
 {
 	int r = __amix_aciabintr(a);
 
-	runchain(int6_chain);
+	if (int6_n)
+		runchain(int6_chain);
 	return r;
 }
 
@@ -142,6 +148,10 @@
 	fr->i_calls = fr->i_claims = 0;
 	strncpy(fr->i_name, name ? name : "", MODMAXNAMELEN - 1);
 	fr->i_fn = fn;			/* last: the chain sees a whole entry */
+	if (level == 2)
+		int2_n++;
+	else
+		int6_n++;
 	SPLX(s);
 	return 0;
 }
@@ -162,6 +172,10 @@
 		if (c[i].i_fn == fn && c[i].i_arg == arg) {
 			SPLHI(s);
 			c[i].i_fn = 0;
+			if (level == 2)
+				int2_n--;
+			else
+				int6_n--;
 			SPLX(s);
 			return 0;
 		}
@@ -184,6 +198,10 @@
 			    (unsigned long)c[i].i_fn < hi) {
 				SPLHI(s);
 				c[i].i_fn = 0;
+				if (l)
+					int6_n--;
+				else
+					int2_n--;
 				SPLX(s);
 				n++;
 			}
@@ -191,6 +209,14 @@
 	return n;
 }
 
+/* the number of handlers attached at level 2 or 6, for diagnosis */
+int
+dlm_intr_attached(level)
+	int level;
+{
+	return level == 2 ? int2_n : level == 6 ? int6_n : -1;
+}
+
 /* a handler's counts, for diagnosis (the harness, modstat later) */
 int
 dlm_intr_count(level, fn, callsp, claimsp)
