Subject: root_defer: a root-class driver's call at the first sysinit entry

Contract C4-2 section 3 (S4-05).  The root pass runs at level 7 with the
clock stopped, where an interrupt self-test cannot run.  root_defer(fn,
arg), from a root-class module's _load in the root pass only, keeps up
to 8 calls; dlm_marc_run, at the first sysinit entry (MOD_C_POST), runs
each once, in order, before any boot-class module loads, in safe mode
too.  A nonzero return is printed; the module stays linked.  Outside the
root pass it is EINVAL, a ninth ENOSPC, and a failed load's calls go with
the backstop sweep.  A DDI name of minor 1.  The state harness covers
each case.

--- a/dlm_ddi.c
+++ b/dlm_ddi.c
@@ -104,6 +104,24 @@
 	cons_hook = 0;
 }
 
+/*
+ * root_defer (C4-2 section 3, S4-05): a root-class driver asks for one
+ * call at the first process-context point, where its interrupt
+ * self-test can run (level 0; the root pass runs at level 7 with the
+ * clock stopped).  From the module's _load in the root pass only; up to
+ * 8 calls, run once each, in order, by dlm_defer_run at the first
+ * sysinit entry, before any boot-class module loads.  A failed load's
+ * calls go with the backstop below.
+ */
+#define	DLM_DEFER	8
+
+static struct dlm_defer {
+	unsigned long	df_f;		/* the module's function */
+	char		*df_arg;
+	struct dlm_mod	*df_mod;
+} dlm_defer[DLM_DEFER];
+static int dlm_ndefer;
+
 /* every ifstats link and the console hook pointing into [lo, hi), removed:
  * a module's backstop (dlm_core.c sweep); the count */
 int
@@ -124,6 +142,12 @@
 		cons_hook = 0;
 		n++;
 	}
+	for (i = 0; i < dlm_ndefer; )
+		if (dlm_defer[i].df_f >= lo && dlm_defer[i].df_f < hi) {
+			dlm_defer[i] = dlm_defer[--dlm_ndefer];
+			n++;
+		} else
+			i++;
 	for (i = 0; !dlm_sdclosed && i < dlm_nsdreg; )
 		if ((unsigned long)dlm_sdreg[i].sr_f >= lo && (unsigned long)dlm_sdreg[i].sr_f < hi) {
 			dlm_sdreg[i] = dlm_sdreg[--dlm_nsdreg];
@@ -203,3 +227,43 @@
 	return __amix_scrcon_put(cp, p, n);
 }
 #endif
+
+int
+root_defer(f, arg)
+	int (*f)();
+	char *arg;
+{
+	struct dlm_defer *d;
+
+	if (!dlm_rootpass || dlm_curmod == 0 || f == 0) {
+		printf("dlm: root_defer outside a root-class module's _load\n");
+		return EINVAL;
+	}
+	if (dlm_ndefer >= DLM_DEFER) {
+		printf("dlm: root module %s: more than %d deferred calls\n", dlm_curmod->m_name,
+		    DLM_DEFER);
+		return ENOSPC;
+	}
+	d = &dlm_defer[dlm_ndefer++];
+	d->df_f = (unsigned long)f;
+	d->df_arg = arg;
+	d->df_mod = dlm_curmod;
+	return 0;
+}
+
+/* the first sysinit entry: each deferred call once, in order; safe mode too */
+void
+dlm_defer_run()
+{
+	struct dlm_defer *d;
+	int i, e;
+
+	for (i = 0; i < dlm_ndefer; i++) {
+		d = &dlm_defer[i];
+		if ((e = DLM_CALL(d->df_mod, d->df_f, d->df_arg, 0)) != 0)
+			printf("dlm: root module %s: its deferred call returned error %d\n",
+			    d->df_mod->m_name, e);
+	}
+	dlm_ndefer = 0;
+}
+
