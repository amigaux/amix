+/* ---- root_defer (C4-2 section 3, S4-05) ---- */
+static int rd_calls, rd_lastarg, rd_e[12], rd_n;
+
+int
+h_rdcb(m, a, b)
+	char *m, *a;
+	long b;
+{
+	rd_calls++;
+	rd_lastarg = (int)(long)a;
+	return 0;
+}
+
+static int
+rd_defer(m)
+	char *m;
+{
+	struct dlm_mod *dm = (struct dlm_mod *)m;
+	char sym[16];
+
+	sprintf(sym, "%s_cb", dm->m_name);
+	return root_defer((int (*)())modsym(dm, sym), (char *)7L);
+}
+
+int
+h_rd1(m, a, b)
+	char *m, *a;
+	long b;
+{
+	rd_e[rd_n++] = rd_defer(m);
+	return 0;
+}
+
+int
+h_rd2(m, a, b)
+	char *m, *a;
+	long b;
+{
+	int k;
+
+	for (k = 0; k < 9; k++)
+		rd_e[rd_n++] = rd_defer(m);
+	return 0;
+}
+
+int
+h_rd3(m, a, b)
+	char *m, *a;
+	long b;
+{
+	rd_e[rd_n++] = rd_defer(m);
+	return EIO;
+}
+
+void
+defer_tests()
+{
+	static char *n1[] = { "rd1", "rd3" }, *n2[] = { "rd2" };
+	static int f1[] = { 1, 1 }, d1[] = { 0, 0 }, m1[] = { 1, 1 }, f2[] = { 1 }, d2[] = { 0 }, m2[] = { 1 };
+	char *man = dlm_man;
+	long manlen = dlm_manlen;
+	int n, k, ok;
+
+	host_handler("rd1_load", h_rd1);
+	host_handler("rd2_load", h_rd2);
+	host_handler("rd3_load", h_rd3);
+	host_handler("rd1_cb", h_rdcb);
+	host_handler("rd2_cb", h_rdcb);
+	host_handler("rd3_cb", h_rdcb);
+	check(root_defer(h_rdcb, (char *)0) == EINVAL, "root_defer: outside a root-class _load -> EINVAL");
+	check(rpbuild(n1, f1, d1, m1, 2) == 0, "root_defer: an arena of two built");
+	rd_n = rd_calls = 0;
+	n = dlm_root_pass(rp_arena);
+	check(n == 1 && byname("rd1") && !byname("rd3") && rd_e[0] == 0 && rd_e[1] == 0 && rd_calls == 0,
+	    "root_defer: accepted from _load in the root pass, not called there");
+	dlm_marc_run();
+	check(rd_calls == 1 && rd_lastarg == 7,
+	    "root_defer: called once at the first sysinit entry; a failed load's call is gone");
+	dlm_marc_run();
+	check(rd_calls == 1, "root_defer: and never again");
+	check(rpbuild(n2, f2, d2, m2, 1) == 0, "root_defer: a third arena built");
+	rd_n = rd_calls = 0;
+	dlm_root_pass(rp_arena);
+	for (ok = 1, k = 0; k < 8; k++)
+		ok &= rd_e[k] == 0;
+	check(ok && rd_e[8] == ENOSPC, "root_defer: a ninth call -> ENOSPC");
+	dlm_safe = 1;
+	dlm_marc_run();
+	dlm_safe = 0;
+	check(rd_calls == 8, "root_defer: the calls run in safe mode too");
+	dlm_man = man;
+	dlm_manlen = manlen;
+}
+
 /* ---- sd_register (C4-1, 30 section 2 patch 8, S4-03) ---- */
 static int sr_e[8], sr_n;
 
