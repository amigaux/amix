+/* ---- -a: the allowlisted block (version 2) ---- */
+
+#define	MAXLIST	1024
+char	*lname[MAXLIST];
+int	lkind[MAXLIST], ltier[MAXLIST], nlist;
+
+void
+readlist(path, tier)
+	char *path;
+	int tier;
+{
+	FILE *f = fopen(path, "r");
+	char line[512], name[256], kind[16];
+	int i;
+
+	if (f == 0)
+		die("cannot open %s", path);
+	while (fgets(line, sizeof line, f)) {
+		if (line[0] == '#' || sscanf(line, "%255s %15s", name, kind) != 2)
+			continue;
+		if (nlist == MAXLIST)
+			die("too many names in %s", path);
+		for (i = 0; i < nlist; i++)
+			if (strcmp(lname[i], name) == 0)
+				die("%s listed twice", name);
+		if (strcmp(kind, "func") && strcmp(kind, "data"))
+			die("%s: kind is func or data", name);
+		lname[nlist] = strcpy(dlm_zalloc((long)strlen(name) + 1), name);
+		lkind[nlist] = strcmp(kind, "func") == 0 ? STT_FUNC : STT_OBJECT;
+		ltier[nlist++] = tier;
+	}
+	fclose(f);
+}
+
+int
+allowblock()
+{
+	long n = nlist + 1, ss = 1, i, nb, size, so, w;
+	char *b, *e, *str;
+
+	for (i = 0; i < nlist; i++)
+		ss += strlen(lname[i]) + 1;
+	nb = dlm_prime(n / 4);
+	size = dlm_blksize(n, ss, nb);
+	b = dlm_zalloc(size);
+	dlm_blkinit(b, n, ss, nb, 0L, 0L);
+	str = b + G32(b + KH_STROFF);
+	e = b + G32(b + KH_SYMOFF);
+	for (i = 0, so = 1; i < nlist; i++) {
+		P32(e + (i + 1) * SYMSZ + ST_NAME, so);
+		e[(i + 1) * SYMSZ + ST_INFO] = (STB_GLOBAL << 4) | lkind[i];
+		e[(i + 1) * SYMSZ + ST_OTHER] = ltier[i];
+		P16(e + (i + 1) * SYMSZ + ST_SHNDX, SHN_ABS);
+		strcpy(str + so, lname[i]);
+		so += strlen(lname[i]) + 1;
+	}
+	dlm_blkhash(b);
+	printf("| the kernel symbol block (<sys/ksym.h> version 2), from the allowlist\n"
+	    "| by mkksym -a: %ld names, %ld bytes; values are relocations\n"
+	    "\t.data\n\t.balign\t16\n\t.globl\tdlm_ksym\n\t.type\tdlm_ksym,@object\n"
+	    "\t.size\tdlm_ksym,%ld\ndlm_ksym:\n", n - 1, size, size);
+	for (w = 0; w < size; w += 4) {
+		i = w - G32(b + KH_SYMOFF);
+		if (w == KH_LO)
+			printf("\t.long\tstext\n");
+		else if (w == KH_HI)
+			printf("\t.long\tend\n");
+		else if (i >= SYMSZ && i < n * SYMSZ && i % SYMSZ == ST_VALUE)
+			printf("\t.long\t%s\n", lname[i / SYMSZ - 1]);
+		else
+			printf("\t.long\t0x%08lx\n", G32(b + w));
+	}
+	printf("\t.globl\tdlm_ksym_space\ndlm_ksym_space:\n\t.long\t%ld\n", size);
+	fprintf(stderr, "%s: %ld names, %ld bytes\n", progname, n - 1, size);
+	return 0;
+}
+
+/* ---- -f: st_size after the link ---- */
+
+int
+fill(path)
+	char *path;
+{
+	long off, sp, i, j, n, bad = 0;
+	char *b, *e, *str, *nm;
+	int t, want;
+	FILE *f;
+
+	sp = space(&off);
+	b = img + off;
+	if (dlm_blkcheck(b, sp) != 0)
+		die("%s: dlm_ksym is not a valid block", path);
+	n = G32(b + KH_NSYM);
+	e = b + G32(b + KH_SYMOFF);
+	str = b + G32(b + KH_STROFF);
+	for (i = 1; i < n; i++) {
+		nm = str + G32(e + i * SYMSZ + ST_NAME);
+		for (j = 1; j < nsyms; j++)
+			if (G16(syms + j * SYMSZ + ST_SHNDX) != SHN_UNDEF &&
+			    ST_BIND(syms[j * SYMSZ + ST_INFO]) != STB_LOCAL &&
+			    strcmp(symname(j), nm) == 0)
+				break;
+		if (j == nsyms) {
+			fprintf(stderr, "%s: %s is listed but not defined\n", progname, nm);
+			bad++;
+			continue;
+		}
+		t = ST_TYPE(syms[j * SYMSZ + ST_INFO]);
+		want = ST_TYPE(e[i * SYMSZ + ST_INFO]);
+		if (t != STT_NOTYPE && t != want) {
+			fprintf(stderr, "%s: %s is listed as %s\n", progname, nm,
+			    want == STT_FUNC ? "func" : "data");
+			bad++;
+		}
+		P32(e + i * SYMSZ + ST_SIZE, G32(syms + j * SYMSZ + ST_SIZE));
+	}
+	if (bad)
+		return 1;
+	if ((f = fopen(path, "r+b")) == 0 || fseek(f, off, 0) != 0 ||
+	    fwrite(b, 1, (size_t)sp, f) != (size_t)sp || fclose(f))
+		die("cannot write %s", path);
+	printf("%s: %ld sizes filled\n", path, n - 1);
+	return 0;
+}
