+/* the core tier (C3-2): a core-tier kernel name only for a core-tier module */
+static void
+settier(name, tier)
+	char *name;
+	int tier;
+{
+	char *sym = dlm_ksym + G32(dlm_ksym + KH_SYMOFF);
+	char *str = dlm_ksym + G32(dlm_ksym + KH_STROFF);
+	long i;
+
+	for (i = 1; i < G32(dlm_ksym + KH_NSYM); i++)
+		if (strcmp(str + G32(sym + i * SYMSZ + ST_NAME), name) == 0)
+			sym[i * SYMSZ + ST_OTHER] = tier;
+}
+
+void
+tier_tests()
+{
+	int id;
+
+	settier("lbolt", KSYM_CORE);
+	check(modload("tiu", &id) == ERELOC && !byname("tiu"),
+	    "a DDI-tier module does not resolve a core-tier name -> ERELOC");
+	check(modload("tic", &id) == 0 && word(byname("tic"), modsym(byname("tic"), "tic_ref")) ==
+	    kval("lbolt"), "a core-tier module resolves it");
+	settier("lbolt", KSYM_DDI);
+}
