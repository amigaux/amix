 int		nfstype = 0;
 static int	vstatic;
 
+/*
+ * Demand filesystems (C4-6 section 5): a demand-class record with fs=<type>
+ * puts a stub row for <type> into a spare row at the first sysinit entry.
+ * The first mount of the type reaches the stub's vfs_mount, which loads the
+ * module as a demand major's first open does and hands the mount to the row
+ * the module's vfs_register fills in place.  One stub table per spare row,
+ * so the stub knows its type from the vfs's ops pointer.  The other entries
+ * answer without loading: sync 0 (the stock sync() calls every row's), the
+ * rest EINVAL (vfs_mountroot tries only rootfstype, and nothing else
+ * reaches a row no vfs is mounted from).
+ */
+struct dlm_fsdem {
+	char	fd_mod[MODMAXNAMELEN];		/* the module */
+	char	fd_type[MODMAXNAMELEN];		/* its fs= */
+};
+static struct dlm_fsdem dlm_fsdem[VFS_SPARE];
+int		dlm_nfsdem;
+static int	fsstub_mount(), fsstub_zero(), fsstub_inval();
+#define	FSSTUB	{ fsstub_mount, fsstub_inval, fsstub_inval, fsstub_inval, \
+		  fsstub_zero, fsstub_inval, fsstub_inval, fsstub_inval }
+struct vfsops	dlm_fsstub[VFS_SPARE] = { FSSTUB, FSSTUB, FSSTUB, FSSTUB };
+#define	ISSTUB(o)	((struct vfsops *)(o) >= dlm_fsstub && \
+			 (struct vfsops *)(o) < dlm_fsstub + VFS_SPARE)
+
