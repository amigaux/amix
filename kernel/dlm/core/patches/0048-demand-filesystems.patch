+/* ---- demand filesystems: load on the first mount (C4-6 section 5) ---- */
+static int fd_mounts;
+static char *fd_vfsp;
+
+int
+h_fdmount(m, a, b)
+	char *m, *a;
+	long b;
+{
+	fd_mounts++;
+	fd_vfsp = a;
+	return 0;
+}
+
+int
+h_fd2(m, a, b)
+	char *m, *a;
+	long b;
+{
+	vf_e[vf_n++] = vf_reg(m, "fd2");
+	return EIO;
+}
+
+/* the stock smount's part: the row's ops into the vfs, then VFS_MOUNT (a
+ * module's ops are run addresses here, so its vfs_mount goes by host_call) */
+static int
+fdmount(type, vfsp)
+	char *type;
+	struct vfs *vfsp;
+{
+	extern struct vfsops dlm_fsstub[];
+	struct vfssw *v = 0;
+	struct dlm_mod *m;
+	int i;
+
+	for (i = 1; i < nfstype; i++)
+		if (vfssw[i].vsw_name && strcmp(vfssw[i].vsw_name, type) == 0)
+			v = &vfssw[i];
+	if (v == 0)
+		return EINVAL;
+	bzero((caddr_t)vfsp, sizeof *vfsp);
+	vfsp->vfs_op = v->vsw_vfsops;
+	if (vfsp->vfs_op >= dlm_fsstub && vfsp->vfs_op < dlm_fsstub + 4)
+		return (*vfsp->vfs_op->vfs_mount)(vfsp, (char *)0, (char *)0, (char *)0);
+	if ((m = byname(type)) == 0)
+		return EINVAL;
+	return DLM_CALL(m, G32(DLM_RP(m, vfsp->vfs_op)), (char *)vfsp, 0L);
+}
+
+static int
+rowof(type)
+	char *type;
+{
+	int i;
+
+	for (i = 1; i < nfstype; i++)
+		if (vfssw[i].vsw_name && strcmp(vfssw[i].vsw_name, type) == 0)
+			return i;
+	return -1;
+}
