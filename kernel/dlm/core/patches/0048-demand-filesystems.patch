+
+/*
+ * A demand type's stub row (the first sysinit entry, from the manifest's
+ * demand record with fs=).  EEXIST when the kernel or a module has the type
+ * already: the module would never load.  ENOSPC when the spare rows are
+ * taken.
+ */
+int
+dlm_fsreg(mod, type)
+	char *mod, *type;
+{
+	struct vfssw *v;
+	int i, k;
+
+	if (*type == 0 || strlen(mod) >= MODMAXNAMELEN || strlen(type) >= MODMAXNAMELEN)
+		return EINVAL;
+	for (i = 1; i < nfstype; i++)
+		if (vfssw[i].vsw_name && strcmp(vfssw[i].vsw_name, type) == 0)
+			return EEXIST;
+	if (nfstype >= vstatic + VFS_SPARE || dlm_nfsdem >= VFS_SPARE)
+		return ENOSPC;
+	k = dlm_nfsdem++;
+	strcpy(dlm_fsdem[k].fd_mod, mod);
+	strcpy(dlm_fsdem[k].fd_type, type);
+	v = &vfssw[nfstype++];
+	v->vsw_name = dlm_fsdem[k].fd_type;
+	v->vsw_init = 0;
+	v->vsw_vfsops = &dlm_fsstub[k];
+	v->vsw_flag = 0;
 	return 0;
 }
+
+/*
+ * The stub's vfs_mount, in the mount system call's process context: load
+ * the module, then mount through the row it filled.  A mount that took the
+ * stub while another loaded the module finds the row filled and goes on.
+ */
+static int
+fsstub_mount(vfsp, mvp, uap, cr)
+	struct vfs *vfsp;
+	char *mvp, *uap, *cr;
+{
+	struct dlm_fsdem *f;
+	struct dlm_mod *m;
+	long a[8];
+	int i, k, e;
+
+	k = (struct vfsops *)vfsp->vfs_op - dlm_fsstub;
+	if (k < 0 || k >= dlm_nfsdem)
+		return EINVAL;
+	f = &dlm_fsdem[k];
+	e = dlm_loadname(f->fd_mod);
+	for (i = vstatic; i < nfstype; i++)
+		if (vfssw[i].vsw_name && strcmp(vfssw[i].vsw_name, f->fd_type) == 0 &&
+		    !ISSTUB(vfssw[i].vsw_vfsops))
+			break;
+	for (m = dlm_list; m && strcmp(m->m_name, f->fd_mod); m = m->m_next)
+		;
+	if (i == nfstype || m == 0) {
+		if (e == 0)
+			e = ENXIO;
+		printf("dlm: demand module %s not loaded for a %s mount (error %d)\n",
+		    f->fd_mod, f->fd_type, e);
+		return e;
+	}
+	vfsp->vfs_op = vfssw[i].vsw_vfsops;
+	a[0] = (long)vfsp;
+	a[1] = (long)mvp;
+	a[2] = (long)uap;
+	a[3] = (long)cr;
+	a[4] = a[5] = a[6] = a[7] = 0;
+	return DLM_CALL8(m, G32(DLM_RP(m, vfsp->vfs_op)), a);
+}
+
+static int
+fsstub_zero()
+{
+	return 0;
+}
+
+static int
+fsstub_inval()
+{
+	return EINVAL;
+}
