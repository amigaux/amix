+	host_handler("fd1_mount", h_fdmount);
+	host_handler("fd2_load", h_fd2);
+	hexsha("fd1", s1);
+	hexsha("fd2", s2);
+	hexsha("fd3", s3);
+	sprintf(man, "GMF1\ngeneration 9\n"
+	    "module fd1 demand 300 path=/stand/gen/7/mod/fd1 sha256=%s fs=fd1\n"
+	    "module fd2 demand 300 path=/stand/gen/7/mod/fd2 sha256=%s fs=fd2\n"
+	    "module fd3 demand 300 path=/stand/gen/7/mod/fd3 sha256=%s fs=fd3\n"
+	    "module fdu demand 300 path=/stand/gen/7/mod/fdu sha256=%s fs=ufs\n", s1, s2, s3, s3);
+	mkarena(a, man, 1, 1);
+	dlm_arena_check(a, 4096L, &dlm_man, &dlm_manlen, &gen);
+	dlm_marc_run();
+	r1 = rowof("fd1");
+	r2 = rowof("fd2");
+	r3 = rowof("fd3");
+	check(r1 == base && r2 == base + 1 && r3 == base + 2 && nfstype == base + 3 &&
+	    vfssw[r1].vsw_vfsops == &dlm_fsstub[0] && vfssw[r1].vsw_init == 0 && !byname("fd1"),
+	    "fsdem: a demand record's fs= gets a stub row; the module is not loaded");
+	check(rowof("ufs") < base, "fsdem: a type the kernel has (ufs) gets no stub row");
+	for (ok = 1, i = 0; i < 3; i++)
+		ok &= (*dlm_fsstub[i].vfs_sync)((char *)0, 0, (char *)0) == 0 &&
+		    (*dlm_fsstub[i].vfs_mountroot)((char *)0, 0) == EINVAL;
+	check(ok && !byname("fd1") && !byname("fd2"),
+	    "fsdem: a stub's sync is 0 and its mountroot EINVAL, and neither loads the module");
+	fd_mounts = 0;
+	check(fdmount("fd1", &v1) == 0 && (m = byname("fd1")) != 0 && fd_mounts == 1 &&
+	    fd_vfsp == (char *)&v1, "fsdem: the first mount loads the module and mounts through it");
+	check(m && rowof("fd1") == r1 && nfstype == base + 3 &&
+	    (unsigned long)vfssw[r1].vsw_vfsops == modsym(m, "fd1_ops") &&
+	    (unsigned long)v1.vfs_op == modsym(m, "fd1_ops"),
+	    "fsdem: the module's row is the stub's, filled in place; the vfs has its ops");
+	check(fdmount("fd1", &v2) == 0 && fd_mounts == 2 && byname("fd1") == m,
+	    "fsdem: a second mount goes to the module's row directly");
+	bzero((caddr_t)&v3, sizeof v3);
+	v3.vfs_op = &dlm_fsstub[0];
+	check((*v3.vfs_op->vfs_mount)(&v3, (char *)0, (char *)0, (char *)0) == 0 && fd_mounts == 3 &&
+	    (unsigned long)v3.vfs_op == modsym(m, "fd1_ops"),
+	    "fsdem: a mount that took the stub before the load finds the row filled");
+	vf_n = 0;
+	check(fdmount("fd2", &v1) == EIO && !byname("fd2") && vf_e[0] == 0 &&
+	    vfssw[r2].vsw_vfsops == &dlm_fsstub[1] && rowof("fd2") == r2 && nfstype == base + 3,
+	    "fsdem: a _load that fails after registering -> its error; the row is the stub again");
+	check(fdmount("fd3", &v1) == ENXIO && vfssw[r3].vsw_vfsops == &dlm_fsstub[2],
+	    "fsdem: a module that registers no row -> ENXIO; the stub stays");
+	if ((m = byname("fd3")) != 0)
