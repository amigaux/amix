+	    "fsdem: in safe mode no stub row: a mount of the type is EINVAL, nothing loads");
+	nfstype = base;			/* fd1 stays, pinned */
+	bzero((caddr_t)&vfssw[base], 4 * sizeof vfssw[0]);
+	dlm_nfsdem = 0;
