+void
+pw_tests()
+{
+	int id;
+
+	host_handler("pw1_load", h_pw);
+	host_handler("pw1_unload", h_pw);
+	host_handler("pw1_halt", h_pw);
+	prt_where = 2;
+	pw_ret = ENXIO;
+	check(modload("pw1", &id) == ENXIO && !byname("pw1") && prt_where == 2,
+	    "prt_where: a _load refusing after a plain cmn_err leaves it as it was (2)");
