+	check(modload("pw1", &id) == 0 && prt_where == 2,
+	    "prt_where: a _load with a plain cmn_err leaves it as it was");
+	prt_where = 1;
+	check(dlm_halt() == 1 && prt_where == 1, "prt_where: a halt entry's plain cmn_err leaves it as it was (1)");
+	dlm_halted = 0;
+	prt_where = 2;
+	check(moduload(id) == 0 && !byname("pw1") && prt_where == 2,
+	    "prt_where: an _unload with a plain cmn_err leaves it as it was");
+}
