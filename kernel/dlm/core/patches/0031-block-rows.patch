+/* a driver's block rows: consecutive majors, each registered to it */
+static int
+blk_install(m, d, r)
+	struct dlm_mod *m;
+	unsigned long d;
+	char *r;
+{
+	struct dlm_bslot *bs;
+	struct bdevsw *bp;
+	unsigned long b = d + DRV_BDEVSW, fl, f;
+	int mj, n, i, k, s, nfree;
+
+	mj = (int)S32(G32(r + DRV_BMAJOR));
+	n = (int)S32(G32(r + DRV_BCOUNT));
+	if (mj < 0 || mj >= bdevcnt || n < 1 || n > bdevcnt - mj ||
+	    G32(DLM_RP(m, d + DRV_CDEVSW) + CD_STR))
+		return EINVAL;
+	if (m->m_flags & DM_UNLOADOK) {
+		printf("dlm: %s: a block driver must be pinned (no unload=allowed)\n", m->m_name);
+		return EINVAL;
+	}
+	for (i = 0; i < n; i++) {
+		if (dlm_majowned('b', mj + i, m->m_name) != 0) {
+			printf("dlm: %s: major b:%d is not registered to it\n", m->m_name, mj + i);
+			return ECONFIG;
+		}
+		if (bslot(mj + i) || !bempty(&bdevsw[mj + i])) {
+			printf("dlm: %s: block row %d is in use\n", m->m_name, mj + i);
+			return ECONFIG;
+		}
+	}
+	if ((fl = G32(DLM_RP(m, b) + BD_FLAG)) != 0) {
+		if (!inimg(m, fl, 4L))
+			return ERELOC;
+		if (G32(DLM_RP(m, fl)) & D_OLD)
+			return EINVAL;
+	}
+	for (k = 0; k < BD_NFN; k++)
+		if (!dlm_okcode(m, G32(DLM_RP(m, b) + 4 * k)))
+			return ERELOC;
+	for (i = nfree = 0; i < BSLOT_MAX; i++)
+		if (dlm_bslot[i].bs_mod == 0)
+			nfree++;
+	if (nfree < n) {
+		printf("dlm: %s: more than %d block rows taken by modules\n", m->m_name, BSLOT_MAX);
+		return ECONFIG;
+	}
+	for (i = 0, bs = dlm_bslot; i < n; i++, bs++) {
+		while (bs->bs_mod)
+			bs++;
+		bp = &bdevsw[mj + i];
+		bs->bs_major = mj + i;
+		bs->bs_old = *bp;
+		s = dlm_splhi();
+		for (k = 0; k < BD_NFN; k++) {
+			f = G32(DLM_RP(m, b) + 4 * k);
+			bfn(bp)[k] = f ? (int (*)())f : nodev;
+		}
+		bp->d_flag = fl ? (int *)DLM_RP(m, fl) : dlm_cflag;
+		bs->bs_mod = m;
+		dlm_splx(s);
+	}
+	return 0;
+}
+
+static void
+blk_remove(m)
+	struct dlm_mod *m;
+{
+	int i, s;
+
+	for (i = 0; i < BSLOT_MAX; i++)
+		if (dlm_bslot[i].bs_mod == m) {
+			s = dlm_splhi();
+			bdevsw[dlm_bslot[i].bs_major] = dlm_bslot[i].bs_old;
+			dlm_bslot[i].bs_mod = 0;
+			dlm_splx(s);
+		}
+}
