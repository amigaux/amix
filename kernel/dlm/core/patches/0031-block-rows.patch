+/*
+ * Block rows (30 section 2 patch 7, S4-06).  The block switch has no
+ * first-open trampoline, so a block driver's row is filled when the
+ * module links, and only a pinned module may have one: the row then
+ * stays until the kernel halts.  A failed load puts the row back.
+ */
+#define	BSLOT_MAX	8
+#define	bfn(bp)	((int (**)())&(bp)->d_open)
+
+static struct dlm_bslot {
+	struct dlm_mod	*bs_mod;	/* 0: free */
+	int		bs_major;
+	struct bdevsw	bs_old;		/* the row before */
+} dlm_bslot[BSLOT_MAX];
+
+static struct dlm_bslot *
+bslot(mj)
+	int mj;
+{
+	int i;
+
+	for (i = 0; i < BSLOT_MAX; i++)
+		if (dlm_bslot[i].bs_mod && dlm_bslot[i].bs_major == mj)
+			return &dlm_bslot[i];
+	return 0;
+}
+
+/* every routine nodev and no flag set: free for a module */
+static int
+bempty(bp)
+	struct bdevsw *bp;
+{
+	int k;
+
+	for (k = 0; k < BD_NFN; k++)
+		if (bfn(bp)[k] != nodev)
+			return 0;
+	return bp->d_flag == 0 || *bp->d_flag == 0;
+}
