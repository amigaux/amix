+/* ---- block rows (30 section 2 patch 7, S4-06) ---- */
+void
+blk_tests()
+{
+	struct dlm_mod *m;
+	struct bdevsw b23;
+	int id;
+
+	b23 = bdevsw[23];
+	check(modload("bd1", &id) == 0 && (m = byname("bd1")) != 0 &&
+	    bdevsw[24].d_open == (int (*)())modsym(m, "bd1_open") &&
+	    bdevsw[24].d_strategy == (int (*)())modsym(m, "bd1_strategy") &&
+	    bdevsw[24].d_print == nodev && bdevsw[24].d_flag == (int *)DLM_RP(m, modsym(m, "bd1_flag")),
+	    "bdev: a pinned block-only driver fills its row, 0 entries nodev");
+	check(moduload(id) == EBUSY && byname("bd1"), "bdev: and stays (pinned)");
+	check(modload("bdun", &id) == EINVAL && !byname("bdun") && bdevsw[21].d_open == nodev,
+	    "bdev: an unpinned block driver -> EINVAL, the row untouched");
+	check(modload("bdreg", &id) == ECONFIG && !byname("bdreg") && bdevsw[22].d_open == nodev,
+	    "bdev: a block major the registry gives no one -> ECONFIG");
+	check(modload("bdused", &id) == ECONFIG && !byname("bdused") &&
+	    bcmp((char *)&bdevsw[23], (char *)&b23, sizeof b23) == 0,
+	    "bdev: a block row in use -> ECONFIG, the row as it was");
+	check(modload("bdcf", &id) == ECONFIG && !byname("bdcf") &&
+	    bcmp((char *)&bdevsw[23], (char *)&b23, sizeof b23) == 0 && cdevsw[59].d_read == nodev,
+	    "bdev: a character row that links, then a block row that cannot: both as before");
+}
