+/*
+ * sd_limits, sd_lim, sdqueuex (C4-7, k30.1.6, k46.1.7).  A controller
+ * that registered (queuefn, c) may attach limits to that registration in
+ * the same _load (sd_limits); dd asks a card's limits after sd's first
+ * open (sd_lim) and queues the extended command to the card's sl_queue
+ * (sdqueuex).  The core keeps no card numbers: sd ranks the table after
+ * dlm_sd_close, and a card is matched to its registration by what sd's
+ * own sdcardbase and sdhardwarename return, which are the registration's
+ * base and name.  Registrations alike in both get no limits.
+ */
+struct sdlim	*dlm_sdlim[DLM_SDREG];	/* dlm_sdreg[i]'s limits, or 0 */
+extern char	*sdcardbase(), *sdhardwarename();
+
+#define	POW2(v)		((v) != 0 && ((v) & ((v) - 1)) == 0)
+
+int
+sd_limits(f, c, l)
+	int (*f)();
+	unsigned c;
+	struct sdlim *l;
+{
+	struct dlm_mod *m = dlm_curmod;
+	int i, e = 0;
+
+	for (i = 0; i < dlm_nsdreg; i++)
+		if (dlm_sdreg[i].sr_f == f && dlm_sdreg[i].sr_c == c)
+			break;
+	if (dlm_sdclosed)
+		e = EBUSY;
+	else if (i == dlm_nsdreg || m == 0 || (unsigned long)f < m->m_run ||
+	    (unsigned long)f >= m->m_run + m->m_size)
+		e = ENOENT;
+	else if (l == 0 || l->sl_ver < 1 || l->sl_queue == 0 ||
+	    (l->sl_flags & ~(SDL_SEG | SDL_ALLRAM)) != 0 ||
+	    l->sl_maxbytes < 512 || l->sl_maxbytes % 512 != 0 || l->sl_maxseg < 1 ||
+	    (!(l->sl_flags & SDL_SEG) && l->sl_maxseg != 1) ||
+	    !POW2(l->sl_align) || l->sl_align > 4096 || !POW2(l->sl_gran) || l->sl_gran > 512 ||
+	    l->sl_pad != 0 || l->sl_reach == 0)
+		e = EINVAL;
+	if (e) {
+		printf("sd: %s: limits refused (%d)\n", i < dlm_nsdreg ? dlm_sdreg[i].sr_name : "?", e);
+		return e;
+	}
+	dlm_sdlim[i] = l;
+	return 0;
+}
+
+/* the registration a card came from, or -1 (none, or two alike) */
+static int
+sdreg_of(card)
+	unsigned card;
+{
+	char *b, *nm;
+	int i, k = -1;
+
+	if (!dlm_sdclosed || card >= DLM_SDREG)
+		return -1;
+	b = sdcardbase(card);
+	nm = sdhardwarename(card);
+	for (i = 0; i < dlm_nsdreg; i++)
+		if (dlm_sdreg[i].sr_base == b && dlm_sdreg[i].sr_name == nm) {
+			if (k >= 0)
+				return -1;
+			k = i;
+		}
+	return k;
+}
+
+/* a card's limits after sd's first open, or 0: dd asks only about a card sdopen took */
+struct sdlim *
+sd_lim(card)
+	unsigned card;
+{
+	int k = sdreg_of(card);
+
+	return k < 0 ? (struct sdlim *)0 : dlm_sdlim[k];
+}
+
+/*
+ * The extended command to its card's sl_queue, as sdqueue gives a stock
+ * one to queuefn.  A card with no limits cannot take it: the command is
+ * completed at once, okay false, nothing transferred.
+ */
+void
+sdqueuex(cpx)
+	struct sdcomx *cpx;
+{
+	int k = sdreg_of(cpx->sx_com.card);
+
+	if (k < 0 || dlm_sdlim[k] == 0) {
+		cpx->sx_com.okay = 0;
+		cpx->sx_resid = cpx->sx_com.nbyte;
+		(*cpx->sx_com.intr)(cpx);
+		return;
+	}
+	(void)(*dlm_sdlim[k]->sl_queue)(dlm_sdreg[k].sr_c, cpx);
+}
+
