+/* ---- sd_limits, sd_lim, sdqueuex (C4-7) ---- */
+static int	sl_e[8], sl_n, sl_qc, sl_qn, sl_in;
+static unsigned	sl_qcard;
+static struct sdcomx	*sl_qp;
+
+static bool
+sl_queue(c, cpx)
+	unsigned c;
+	struct sdcomx *cpx;
+{
+	sl_qc = c;
+	sl_qp = cpx;
+	sl_qn++;
+	cpx->sx_com.okay = 1;
+	cpx->sx_resid = 0;
+	(*cpx->sx_com.intr)(cpx);
+	return 1;
+}
+
+static void
+sl_intr(cpx)
+	struct sdcomx *cpx;
+{
+	sl_in++;
+	sl_qcard = cpx->sx_com.card;
+}
+
+static struct sdlim	sl_good = { SDLIM_VER, SDL_SEG, 65536, 16, 4, 4, 0, 0xFFFFFFFF, sl_queue };
+static struct sdlim	sl_bad = { SDLIM_VER, 0, 65536, 2, 4, 4, 0, 0xFFFFFFFF, sl_queue };	/* 2 segments, no SDL_SEG */
+static struct sdlim	sl_one = { SDLIM_VER, 0, 65536, 1, 1, 1, 0, 0x00FFFFFF, sl_queue };
+
+static int (*sl_f1)();		/* sl1's queue entry */
+
+int
+h_sl1(m, a, b)
+	char *m, *a;
+	long b;
+{
+	struct dlm_mod *dm = (struct dlm_mod *)m;
+
+	sl_f1 = (int (*)())modsym(dm, "sl1_load");
+	sl_e[sl_n++] = sr_reg(m, 2, 0);
+	sl_e[sl_n++] = sr_reg(m, 2, 1);
+	sl_e[sl_n++] = sd_limits(sl_f1, 0, &sl_good);	/* 0 */
+	sl_e[sl_n++] = sd_limits(sl_f1, 1, &sl_bad);	/* EINVAL */
+	sl_e[sl_n++] = sd_limits(sl_f1, 5, &sl_good);	/* ENOENT: no board 5 */
+	return 0;
+}
+
+int
+h_sl2(m, a, b)
+	char *m, *a;
+	long b;
+{
+	sl_e[sl_n++] = sd_limits(sl_f1, 1, &sl_one);	/* ENOENT: sl1's, not ours */
+	return 0;
+}
+
+int
+h_sl3(m, a, b)
+	char *m, *a;
+	long b;
+{
+	struct dlm_mod *dm = (struct dlm_mod *)m;
+
+	sl_e[sl_n++] = sr_reg(m, 4, 0);
+	sl_e[sl_n++] = sd_limits((int (*)())modsym(dm, "sl3_load"), 0, &sl_one);
+	return EIO;				/* fails after declaring limits */
+}
+
+void
+sdlim_tests()
+{
+	struct dlm_sdreg *t;
+	struct sdcomx x;
+	int i1, i2, i3, b0, b1, n;
+
+	host_handler("sl1_load", h_sl1);
+	host_handler("sl2_load", h_sl2);
+	host_handler("sl3_load", h_sl3);
+	check(sd_limits(nodev, 0, &sl_good) == ENOENT, "sd_limits: outside a module's _load -> ENOENT");
+	sl_n = 0;
+	check(modload("sl1", &i1) == 0 && sl_e[0] == 0 && sl_e[1] == 0 && sl_e[2] == 0,
+	    "sd_limits: after sd_register in the same _load -> 0");
+	check(sl_e[3] == EINVAL, "sd_limits: two segments without SDL_SEG -> EINVAL");
+	check(sl_e[4] == ENOENT, "sd_limits: a board the module did not register -> ENOENT");
+	check(dlm_nsdreg == 2 && dlm_sdlim[0] == &sl_good && dlm_sdlim[1] == 0,
+	    "sd_limits: the limits sit beside their registration; a refusal leaves none");
+	check(modload("sl2", &i2) == 0 && sl_e[5] == ENOENT && dlm_sdlim[1] == 0,
+	    "sd_limits: another module's registration -> ENOENT");
+	sl_n = 0;
+	check(modload("sl3", &i3) == EIO && !byname("sl3") && sl_e[0] == 0 && sl_e[1] == 0 &&
+	    dlm_nsdreg == 2 && dlm_sdlim[2] == 0,
+	    "sd_limits: a _load that fails after declaring limits leaves neither entry");
+	check(sd_lim(0) == 0, "sd_lim: before sd's first open -> 0");
+
+	/* sd ranks: card 0 is board 1 (no limits), card 1 board 0 */
+	n = dlm_sd_close(&t);
+	b0 = t[0].sr_c == 0 ? 0 : 1;
+	b1 = 1 - b0;
+	host_sdbase[0] = t[b1].sr_base;
+	host_sdname[0] = t[b1].sr_name;
+	host_sdbase[1] = t[b0].sr_base;
+	host_sdname[1] = t[b0].sr_name;
+	check(n == 2 && sd_lim(1) == &sl_good && sd_lim(0) == 0 && sd_lim(5) == 0,
+	    "sd_lim: a card's limits by sdcardbase and sdhardwarename; 0 for a card without");
+	check(sd_limits(sl_f1, 0, &sl_good) == EBUSY, "sd_limits: after sd's first open -> EBUSY");
+
+	bzero((caddr_t)&x, sizeof x);
+	x.sx_com.card = 1;
+	x.sx_com.nbyte = 4096;
+	x.sx_com.intr = sl_intr;
+	x.sx_resid = 4096;
+	sl_qn = sl_in = 0;
+	sl_qc = -1;
+	sdqueuex(&x);
+	check(sl_qn == 1 && sl_qc == 0 && sl_qp == &x && sl_in == 1 && x.sx_com.okay && x.sx_resid == 0,
+	    "sdqueuex: the card's sl_queue gets the board index and the command");
+	x.sx_com.card = 0;
+	x.sx_com.okay = 1;
+	x.sx_resid = 0;
+	sl_qn = sl_in = 0;
+	sdqueuex(&x);
+	check(sl_qn == 0 && sl_in == 1 && sl_qcard == 0 && !x.sx_com.okay && x.sx_resid == 4096,
+	    "sdqueuex: a card without limits completes the command at once, okay 0, resid nbyte");
+
+	/* two registrations alike in base and name: none of them has limits */
+	t[b1].sr_base = t[b0].sr_base;
+	t[b1].sr_name = t[b0].sr_name;
+	host_sdbase[0] = t[b0].sr_base;
+	host_sdname[0] = t[b0].sr_name;
+	check(sd_lim(1) == 0 && sd_lim(0) == 0, "sd_lim: two registrations alike -> 0 for both");
+
+	dlm_sdclosed = dlm_nsdreg = 0;
+	dlm_sdlim[0] = dlm_sdlim[1] = 0;
+	moduload(i2);
+	moduload(i1);
+}
+
