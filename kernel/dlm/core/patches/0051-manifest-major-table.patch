+/* ---- the manifest's major table (patch 51, C3-5 version 22) ---- */
+/* regok (majors=c:58) loaded under a manifest with these records: its errno */
+static int
+majrun(recs)
+	char *recs;
+{
+	static char a[4096], man[2048];
+	int id, e;
+
+	sprintf(man, "GMF1\ngeneration 7\nline k46\n%s", recs);
+	mkarena(a, man, 1, 1);
+	if (dlm_arena_check(a, 4096L, &dlm_man, &dlm_manlen, &dlm_mangen) != 0)
+		return -1;
+	if ((e = modload("regok", &id)) == 0)
+		moduload(id);
+	return e;
+}
+
+void
+major_tests()
+{
+	char *om = dlm_man, o[MODMAXNAMELEN];
+	long oml = dlm_manlen, omg = dlm_mangen;
+	int id, dv = dlm_devload;
+
+	dlm_devload = 1;		/* regok, regown, regnone are no members */
+	check(majrun(HREG) == 0, "major table: a module whose row is its own loads");
+	check(dlm_man_major('c', 58, o) == 0 && !strcmp(o, "regok") &&
+	    dlm_man_major('b', 20, o) == 0 && !strcmp(o, "ramdisk") &&
+	    dlm_man_major('c', 57, o) == ENOENT && dlm_man_major('b', 58, o) == ENOENT,
+	    "major table: a row answers by its type and number");
+	check(modload("regown", &id) == ECONFIG && !byname("regown"),
+	    "major table: another module's row -> ECONFIG");
+	check(modload("regnone", &id) == ECONFIG && !byname("regnone"),
+	    "major table: a number with no row -> ECONFIG");
+	check(majrun("") == ECONFIG && dlm_man_major('c', 58, o) == ENODEV,
+	    "major table: a manifest without one (an older kbootset's) -> every major refused");
+	check(majrun(HREG "major c 58 other\n") == ECONFIG && dlm_man_major('c', 51, o) == EINVAL,
+	    "major table: one number in two rows -> the whole table refused");
+	check(majrun(HREG "major c 70 far\n") == ECONFIG && majrun(HREG "major b 32 far\n") == ECONFIG,
+	    "major table: a row past the switch -> the whole table refused");
+	check(majrun("major x 58 regok\n") == ECONFIG && majrun("major c 58\n") == ECONFIG &&
+	    majrun("major c 58 regok more\n") == ECONFIG && majrun("major c regok\n") == ECONFIG &&
+	    majrun("major c 058x regok\n") == ECONFIG,
+	    "major table: a malformed row -> the whole table refused");
+	check(majrun("major c 58 regok\n") == 0, "major table: one row is a table");
+	majrun(HREG "major c 3 stk\n");
+	check(dlm_creg("stk", 3) == ECONFIG, "major table: a row on a stock row in use -> dlm_creg refuses it");
+	dlm_man = 0;
+	check(dlm_majowned('c', 58, "regok") == 0 && dlm_majowned('c', 58, "other") == ECONFIG &&
+	    dlm_majowned('c', 57, "regok") == ECONFIG,
+	    "major table: no booted manifest -> the table built into the kernel answers");
+	dlm_man = om;
+	dlm_manlen = oml;
+	dlm_mangen = omg;
+	dlm_devload = dv;
+}
