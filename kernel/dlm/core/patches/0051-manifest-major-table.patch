+	"major c 68 pbcd\nmajor c 69 pbsd\nmajor b 20 ramdisk\nmajor b 21 bdun\n" \
+	"major b 23 bdused\nmajor b 24 bd1\nmajor b 25 bdnb\nmajor c 59 bdcf\n"
