 /*
+ * The booted manifest's major table (C3-5 section 3, version 22): one
+ * "major <c|b> <n> <name>" record per registry row, which kbootset writes
+ * from the major registry, so a module's major is boot data and a new
+ * one needs no new kernel.  The owner of major mj of type 'c' or 'b'
+ * goes into owner (MODMAXNAMELEN bytes) and the answer is 0; ENOENT when
+ * the table has no such row; ENODEV when the manifest has no table (one
+ * an older kbootset composed); EINVAL when any record is malformed, is
+ * past the switch, or names a number another record names: the whole
+ * table is refused then, never half of it.  Read where asked, not kept:
+ * a load or a registration asks, rarely.
+ */
+int
+dlm_man_major(type, mj, owner)
+	int type, mj;
+	char *owner;
+{
+	unsigned char seen[64];		/* c 0-255, then b 0-255 */
+	char *p, *l, *q, *lim = dlm_man + dlm_manlen, nm[MODMAXNAMELEN];
+	int rows = 0, t, n, k;
+
+	owner[0] = 0;
+	bzero((caddr_t)seen, (unsigned)sizeof seen);
+	for (p = dlm_man; p && p < lim; p = l + 1) {
+		for (l = p; l < lim && *l != '\n'; l++)
+			;
+		if (l - p < 6 || bcmp(p, "major ", 6) != 0)
+			continue;
+		q = p + 6;
+		t = *q++;
+		if ((t != 'c' && t != 'b') || q >= l || *q++ != ' ')
+			return EINVAL;
+		for (n = 0, k = 0; q < l && *q >= '0' && *q <= '9' && k < 4; q++, k++)
+			n = n * 10 + (*q - '0');
+		if (k == 0 || q >= l || *q++ != ' ' || n >= (t == 'c' ? cdevcnt : bdevcnt) || n > 255)
+			return EINVAL;
+		for (k = 0; q < l && *q != ' ' && k < MODMAXNAMELEN - 1; )
+			nm[k++] = *q++;
+		nm[k] = 0;
+		if (k == 0 || q != l)
+			return EINVAL;
+		k = (t == 'b') * 256 + n;
+		if (seen[k >> 3] & 1 << (k & 7))
+			return EINVAL;
+		seen[k >> 3] |= 1 << (k & 7);
+		rows++;
+		if (t == type && n == mj)
+			strcpy(owner, nm);
+	}
+	return rows == 0 ? ENODEV : owner[0] ? 0 : ENOENT;
+}
