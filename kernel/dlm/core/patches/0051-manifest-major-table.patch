+/*
+ * The owner of major mj of type 'c' or 'b' into owner (MODMAXNAMELEN
+ * bytes), as dlm_man_major answers: the booted manifest's major table.
+ * Without a booted manifest no module loads (patch 17), and the table
+ * built into the kernel (dlmreg.c) answers instead.
+ */
+static int
+majowner(type, mj, owner)
+	int type, mj;
+	char *owner;
+{
+	struct dlm_majreg *r;
+
+	if (dlm_man != 0)
+		return dlm_man_major(type, mj, owner);
+	for (r = dlm_majreg; r->r_type; r++)
+		if (r->r_type == type && r->r_major == mj && strlen(r->r_name) < MODMAXNAMELEN) {
+			strcpy(owner, r->r_name);
+			return 0;
+		}
+	owner[0] = 0;
+	return ENOENT;
+}
