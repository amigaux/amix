 /*
+ * Is name a boot-class member the owner marked safe=1 (S5-09, C4-4 section
+ * 2): one that loads in safe mode too?  kbootset writes the mark from a
+ * `safe` line in modreg.local.d, and on the boot members it depends on.
+ */
+int
+dlm_man_safeboot(name)
+	char *name;
+{
+	char rn[MODMAXNAMELEN], v[4], *p, *l, *lim;
+
+	if (dlm_man == 0)
+		return 0;
+	lim = dlm_man + dlm_manlen;
+	for (p = dlm_man; p < lim; p = l + 1) {
+		for (l = p; l < lim && *l != '\n'; l++)
+			;
+		if (l - p < 8 || bcmp(p, "module ", 7) != 0)
+			continue;
+		recname(p + 7, l, rn);
+		if (strcmp(rn, name) != 0)
+			continue;
+		p += 8 + strlen(rn);
+		return l - p > 5 && bcmp(p, "boot ", 5) == 0 && attr(p, l, "safe=", v, (int)sizeof v) &&
+		    v[0] == '1' && v[1] == 0;
+	}
+	return 0;
+}
+
+/*
  * A member's parameters from the manifest ("param <name>.<pname>=<value>"
  * records), as one string "<pname>=<value> ..." into buf; buf[0] is 0 when
  * there are none.  C3-5: passed to the module's _load.
