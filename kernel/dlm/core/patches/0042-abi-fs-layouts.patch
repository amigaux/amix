Subject: dlmoffs: a filesystem module's structures in the fingerprint

Contract C4-6, from amix-cdfs's module plan: the size and every member
offset of fid, vfs, mounta, vnode, vattr, iovec, uio, dirent, statvfs
and sdcom, and the sizes of vnodeops and vfsops, measured by the kernel
compiler like the core's own layouts (patch 0015).  The core reads none
of them; they go into abi= (C3-3 section 4), so a kernel whose headers
move one of them is refused by the fingerprint check.

--- a/dlmoffs.c
+++ b/dlmoffs.c
@@ -14,6 +14,13 @@
 #include "sys/conf.h"
 #include "sys/stream.h"
 #include "sys/moddefs.h"
+#include "sys/vfs.h"
+#include "sys/vnode.h"
+#include "sys/uio.h"
+#include "sys/dirent.h"
+#include "sys/statvfs.h"
+#include "amiga/alien/rico.h"	/* bool, uchar: as the stock sd.c */
+#include "amiga/alien/sd.h"
 
 #define	OFF(s, m)	((int)&((struct s *)0)->m)
 
@@ -43,3 +50,108 @@
 int	dlm_off_QI_CLOSE = OFF(qinit, qi_qclose);
 int	dlm_off_QI_MINFO = OFF(qinit, qi_minfo);
 int	dlm_off_QI_MSTAT = OFF(qinit, qi_mstat);
