+/* "k<fam>.<major>.<minor>" into its numbers: 0, or -1 if malformed */
+static int
+sscanf3(s, fam, major, minor)
+	char *s;
+	int *fam, *major, *minor;
+{
+	int *v[3], i;
+
+	v[0] = fam, v[1] = major, v[2] = minor;
+	if (*s++ != 'k')
+		return -1;
+	for (i = 0; i < 3; i++) {
+		if (*s < '0' || *s > '9')
+			return -1;
+		for (*v[i] = 0; *s >= '0' && *s <= '9'; s++)
+			*v[i] = *v[i] * 10 + (*s - '0');
+		if (*s != (i < 2 ? '.' : 0))
+			return -1;
+		s++;
+	}
+	return 0;
+}
+
+/*
