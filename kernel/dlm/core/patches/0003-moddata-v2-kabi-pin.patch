+/* the first c in s, or 0 (no strchr in every kernel's DDI) */
+static char *
+chr(s, c)
+	char *s;
+	int c;
+{
+	for (; *s; s++)
+		if (*s == c)
+			return s;
+	return 0;
+}
+
+static int
+isname(c)
+	int c;
+{
+	return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '-';
+}
+
+static int
+ishex(c)
+	int c;
+{
+	return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+}
+
+/* a decimal number of 1..5 digits at *pp, up to stop; -1 if none */
+static long
+decnum(pp, stop)
+	char **pp;
+	int stop;
+{
+	char *p = *pp;
+	long v = 0;
+	int n = 0;
+
+	while (*p >= '0' && *p <= '9' && n < 5)
+		v = v * 10 + (*p++ - '0'), n++;
+	if (n == 0 || *p != stop)
+		return -1;
+	*pp = p;
+	return v;
+}
+
+/* comma-separated items of v, each checked by ok(); 0 when all pass */
+static int
+eachitem(v, ok)
+	char *v;
+	int (*ok)();
+{
+	char item[MD_MAXSTR + 1], *p = v;
+	int n;
+
+	if (*v == 0)
+		return ECONFIG;
+	for (;;) {
+		for (n = 0; *p && *p != ','; )
+			item[n++] = *p++;
+		item[n] = 0;
+		if (!(*ok)(item))
+			return ECONFIG;
+		if (*p == 0)
+			return 0;
+		p++;
+	}
+}
+
+static int
+okname(s)
+	char *s;
+{
+	int n;
+
+	for (n = 0; s[n]; n++)
+		if (!isname(s[n]) || n >= MODMAXNAMELEN - 1)
+			return 0;
+	return n > 0;
+}
+
+/* zorro:MMMM:PP (neither all zero), mobo:<probe>, always */
+static int
+okmatch(s)
+	char *s;
+{
+	int i;
+
+	if (strcmp(s, "always") == 0)
+		return 1;
+	if (strncmp(s, "mobo:", 5) == 0)
+		return okname(s + 5);
+	if (strncmp(s, "zorro:", 6) != 0 || strlen(s) != 13 || s[10] != ':')
+		return 0;
+	for (i = 6; i < 13; i++)
+		if (i != 10 && !ishex(s[i]))
+			return 0;
+	return strncmp(s + 6, "0000", 4) != 0 && strncmp(s + 11, "00", 2) != 0;
+}
+
+/* c:<n> or b:<n>, n 0..255 */
+static int
+okmajor(s)
+	char *s;
+{
+	char *p = s + 2;
+	long n;
+
+	if ((s[0] != 'c' && s[0] != 'b') || s[1] != ':')
+		return 0;
+	n = decnum(&p, 0);
+	return n >= 0 && n <= 255;
+}
+
+/* <name>:<int|bool|str|hex>:<default>[:<min>:<max>] */
+static int
+okparam(s)
+	char *s;
+{
+	char *p = chr(s, ':');
+	int n, colons = 0;
+
+	if (p == 0)
+		return 0;
+	*p = 0;
+	n = okname(s);
+	*p = ':';
+	if (!n)
+		return 0;
+	p++;
+	if (strncmp(p, "int:", 4) && strncmp(p, "bool:", 5) && strncmp(p, "str:", 4) &&
+	    strncmp(p, "hex:", 4))
+		return 0;
+	for (; *p; p++)
+		if (*p == ':')
+			colons++;
+	return colons == 1 || colons == 3;
