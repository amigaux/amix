+ * minor not above it, the compiler pin is the kernel's, a core-tier
+ * module was built against this kernel, and the class is one this core
+ * loads (root class comes with the arena load path).
+ */
+static int
+md_check(ld, name)
+	struct dlm_ld *ld;
+	char *name;
+{
+	struct dlm_md *md = &ld->ld_md;
+	int fam, major, minor;
+
+	if (strcmp(md->md_name, name) != 0) {
+		printf("dlm: %s: .moddata names %s\n", name, md->md_name);
+		return ECONFIG;
+	}
+	if (dlm_kabi == 0 || dlm_pin == 0 ||
+	    sscanf3(dlm_kabi, &fam, &major, &minor) != 0 || md->md_fam != fam ||
+	    md->md_major != major || md->md_minor > minor ||
+	    strcmp(md->md_cc, dlm_pin) != 0 ||
+	    (md->md_tier && (dlm_build == 0 || strcmp(md->md_build, dlm_build) != 0))) {
+		printf("dlm: %s: built for another kernel (kabi, compiler pin or build)\n", name);
+		return EBADVER;
+	}
+	if (md->md_class == MD_ROOT) {
+		printf("dlm: %s: root class is loaded from the arena only\n", name);
+		return ECONFIG;
+	}
+	return 0;
+}
