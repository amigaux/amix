- *	mkksym -a ddi.list [-a core.list] > ksym.s
+ *	mkksym [-k kabi] -a ddi.list [-a core.list] > ksym.s
  *					the allowlisted block as assembler
  *	mkksym -f image			fill st_size in an image's block
