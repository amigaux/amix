 #define BSIZE 512
 
+/*
+ * dd says D_NOBRKUP (its bdevsw row points at ddflag), so the kernel's gen_strategy no longer
+ * cuts block requests for it and dd cuts them itself, into the pieces gen_strategy and
+ * buf_breakup made, one command per piece:
+ *   - a request of at most a page: one command, as it comes;
+ *   - a page list (B_PAGEIO) longer than a page: a command per page, at the page's physical
+ *     address, every page tried;
+ *   - any other buffer longer than a page: to the first page boundary, then a page at a time,
+ *     stopping at the first error.
+ * A request's pieces run one after another on its unit.  Nothing is allocated, nothing sleeps,
+ * and no page count is assumed: the count and the page list both end it.
+ */
+int	ddflag = D_NOBRKUP;
 
 struct dd {
 	uint		state;
 	struct buf	*bhead,
 			*btail;
 	struct sdcom	com;
-	uchar		sense[16];
+	uint		off,		/* bytes of bhead done */
+			boff,		/* blocks of bhead done */
+			len;		/* bytes in the command */
+	struct page	*pp;		/* the command's page, for a page list */
+	bool		inq,		/* in sdqueue( ) */
+			again;		/* a command was set up meanwhile */
 };
 /* dd.state
