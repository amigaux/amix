+/*
+ * Queue dp's command.  A controller may complete a command inside the queue call (a polled one
+ * does), and the completion sets up the next command of that unit or, passing a bounce region on,
+ * of another unit of the card.  While a call for the card is running those are only marked, and
+ * the outermost call queues them in turn when it returns: no queue call ever runs inside another
+ * for the same card, and a request of many pieces does not nest a call per piece on the stack.
+ */
+static void
+kick( dp)
+struct dd	*dp;
+{
+	struct dd	*q,
+			*u0;
+	bool		more;
+	uint		c;
+
+	dp->again = TRUE;
+	c = (dp - &ddtab[0][0]) / SDUNITS;
+	if (ddinq[c])
+		return;
+	ddinq[c] = TRUE;
+	u0 = &ddtab[c][0];
+	do {
+		more = FALSE;
+		for (q = u0; q < u0 + SDUNITS; q++)
+			if (q->again) {
+				q->again = FALSE;
+				more = TRUE;
+#ifdef DD_SDLIM
+				if (BOUNCED( q))
+					sdqueuex( &q->comx);
+				else
+#endif
+				sdqueue( &q->com);
+			}
+	} while (more);
+	ddinq[c] = FALSE;
 }
