+
+/*
+ * Queue dp's command.  A controller that completes it inside sdqueue( ) calls ihandle, which
+ * sets up the next command; that one is queued here when sdqueue( ) returns, so a request of
+ * many pieces does not nest a call per piece on the stack.
+ */
+static void
+kick( dp)
+struct dd	*dp;
+{
+
+	if (dp->inq) {
+		dp->again = TRUE;
+		return;
+	}
+	do {
+		dp->again = FALSE;
+		dp->inq = TRUE;
+		sdqueue( &dp->com);
+		dp->inq = FALSE;
+	} while (dp->again);
 }
