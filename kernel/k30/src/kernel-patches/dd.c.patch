+/*
+ * Copy dp's piece, dp->len bytes from byte dp->off of the request, into the region (in) or out of
+ * it.  k30 maps all RAM at its own address (phystokv), so a frame or a locked page of a process is
+ * reached at any level.  1 when a page cannot be reached.
+ */
+static int
+ddcopy( dp, bp, in)
+struct dd	*dp;
+struct buf	*bp;
+bool		in;
+{
+	caddr_t		b, d;
+	uint		o, n, c;
+	struct page	*pp;
+	paddr_t		pa;
+
+	b = ddcardof( dp)->va;
+	n = dp->len;
+	if (bp->b_flags & B_PAGEIO) {
+		/* the page list's bytes, from b_addr's offset for a request of at most a page (as gen_strategy) */
+		o = dp->off + (bp->b_bcount <= PAGESIZE ? (uint)bp->b_un.b_addr : 0);
+		pp = bp->b_pages;
+		for (c = o / PAGESIZE; c; c--)
+			if ((pp = pp->p_next) == bp->b_pages)
+				return 1;
+		o &= PAGEOFFSET;
+		while (n) {
+			c = min( n, PAGESIZE - o);
+			d = (caddr_t)phystokv( ptob( pages_base + (pp - pages))) + o;
+			if (in)
+				bcopy( d, b, c);
+			else
+				bcopy( b, d, c);
+			b += c;
+			n -= c;
+			o = 0;
+			if ((pp = pp->p_next) == bp->b_pages and n)
+				return 1;
+		}
+		return 0;
+	}
+	d = bp->b_un.b_addr + dp->off;
+	if (not bp->b_proc) {
+		if (in)
+			bcopy( d, b, n);
+		else
+			bcopy( b, d, n);
+		return 0;
+	}
+	while (n) {				/* a process's buffer physio locked: page by page */
+		c = min( n, PAGESIZE - ((uint)d & PAGEOFFSET));
+		if (not (pa = vtop( d, bp->b_proc)))
+			return 1;
+		if (in)
+			bcopy( (caddr_t)phystokv( pa), b, c);
+		else
+			bcopy( b, (caddr_t)phystokv( pa), c);
+		b += c;
+		d += c;
+		n -= c;
+	}
+	return 0;
+}
+#endif
