+#ifdef DD_SDLIM
+/*
+ * At dd's first open (the root's, early in boot): every card sd took is probed, while the memory
+ * dma_alloc draws on is least broken up; a card first opened later would seldom find 64 KiB in
+ * one piece in a fragmented heap.
+ */
+static void
+ddprobeall( )
+{
+	static bool	done;
+	uint		c;
+
+	if (done)
+		return;
+	done = TRUE;
+	for (c = 0; c < SDCARDS; c++)
+		if (sdopen( c) == 0)
+			ddprobe( c);
+}
+
+
+/*
+ * One card's probe (at dd's first open, or else at the card's own): its limits, and if it has
+ * some, its bounce region and sense area from dma_alloc.  A region below a page, one dma_alloc
+ * cannot give, or one out of the controller's reach leaves the card on page commands, with one
+ * console line; the open goes on either way.
+ */
+static void
+ddprobe( card)
+uint	card;
+{
+	struct ddcard	*dc;
+	struct sdlim	*l;
+	char		*why;
+	int		x;
+
+	dc = &ddcard[card];
+	x = sdspl( );
+	while (dc->state == DC_PROBING)
+		sleep( (caddr_t)dc, PRIBIO);
+	if (dc->state != DC_NEW) {
+		splx( x);
+		return;
+	}
+	dc->state = DC_PROBING;
+	splx( x);
+	why = 0;
+	if (not (l = sd_lim( card)))
+		;
+	else if ((dc->size = min( l->sl_maxbytes, ddx_maxbytes) & ~(BSIZE-1)) < PAGESIZE)
+		why = "limits below a page";
+	else if (not (dc->va = dma_alloc( dc->size, &dc->pa))
+	      or not (dc->sva = dma_alloc( 16*SDUNITS, &dc->spa)))
+		why = "no bounce region";
+	else if (dc->pa + dc->size - 1 > l->sl_reach or dc->spa + 16*SDUNITS - 1 > l->sl_reach)
+		why = "bounce region out of reach";
+	if (why) {
+		if (dc->va)
+			dma_free( dc->va, dc->size);
+		if (dc->sva)
+			dma_free( dc->sva, 16*SDUNITS);
+		dc->va = dc->sva = 0;
+		ddxstat.fallback++;
+		printf( "dd: %s: %s, page commands\n", sdhardwarename( card), why);
+	}
+	else if (l)
+		printf( "dd: %s: commands of up to %d bytes through a bounce region\n",
+		        sdhardwarename( card), dc->size);
+	x = sdspl( );
+	if (l and not why) {
+		dc->lim = l;
+		dc->state = DC_BOUNCE;
+	}
+	else
+		dc->state = DC_PAGES;
+	wakeup( (caddr_t)dc);
+	splx( x);
+}
