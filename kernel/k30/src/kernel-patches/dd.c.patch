+/*
+ * A command through the region is done: a read's data copied out, the region passed to the next
+ * unit waiting, then dp's next piece or its next request.  A failed or short command fails the
+ * request from that piece on (b_resid counts it and the rest), as the first kernels treat a command
+ * whose data did not all land.
+ */
+static void
+bnext( dp, bp, bad)
+struct dd	*dp;
+struct buf	*bp;
+bool		bad;
+{
+	struct ddcard	*dc;
+	struct dd	*n;
+
+	dc = ddcardof( dp);
+	if (not bad and dp->comx.sx_resid)
+		bad = TRUE;
+	if (not bad and (bp->b_flags & B_READ) and ddcopy( dp, bp, FALSE))
+		bad = TRUE;
+	if (n = dc->qhead) {
+		if (not (dc->qhead = n->qnext))
+			dc->qtail = 0;
+		n->waiting = FALSE;
+	}
+	dc->owner = n;
+	if (bad) {
+		bp->b_flags |= B_ERROR;
+		bp->b_resid = bp->b_bcount - dp->off;
+		ddxstat.err++;
+	}
+	dp->off += dp->len;
+	dp->boff += (dp->len + BSIZE-1)/BSIZE;
+	if (bad or dp->off >= bp->b_bcount) {
+		dp->off = 0;
+		dp->boff = 0;
+		dp->bhead = bp->av_forw;
+		startio( FIRST, dp);			/* the next request before iodone, as above */
+		iodone( bp);
+	}
+	else
+		startio( FIRST, dp);
+	if (n)
+		startio( FIRST, n);
+}
