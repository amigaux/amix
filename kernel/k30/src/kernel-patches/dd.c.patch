+/*
+ * Start dp's command on a card with a region: for the next piece (FIRST) take the region or wait
+ * for it, and for a write fill it; a RETRY reissues the piece in the region dp still holds.
+ */
+static void
+bstart( s, dp, bp)
+struct dd	*dp;
+struct buf	*bp;
+{
+	struct ddcard	*dc;
+	uint		bn;
+
+	dc = ddcardof( dp);
+	if (s == FIRST) {
+		if (dc->owner and dc->owner != dp) {
+			unless (dp->waiting) {
+				dp->waiting = TRUE;
+				dp->qnext = 0;
+				if (dc->qtail)
+					dc->qtail->qnext = dp;
+				else
+					dc->qhead = dp;
+				dc->qtail = dp;
+				ddxstat.wait++;
+			}
+			return;
+		}
+		dc->owner = dp;
+		dp->len = min( bp->b_bcount - dp->off, dc->size);
+		if (not (bp->b_flags & B_READ) and ddcopy( dp, bp, TRUE)) {
+			bnext( dp, bp, TRUE);		/* a page that cannot be reached: fail, no command */
+			return;
+		}
+	}
+	bn = sdblkno( bp) + dp->boff;
+	dp->com.card = sdcard( bp->b_edev);
+	dp->com.unit = sdunit( bp->b_edev);
+	dp->com.addr = (caddr_t)dc->pa;
+	dp->com.reading = (bp->b_flags & B_READ) ? TRUE : FALSE;
+	dp->com.cdb[0] = (bp->b_flags & B_READ) ? 0x28 : 0x2A;
+	dp->com.cdb[1] = 0;
+	dp->com.cdb[2] = byte3( bn);
+	dp->com.cdb[3] = byte2( bn);
+	dp->com.cdb[4] = byte1( bn);
+	dp->com.cdb[5] = byte0( bn);
+	dp->com.cdb[6] = 0;
+	dp->com.cdb[7] = byte1( dp->len/BSIZE);
+	dp->com.cdb[8] = byte0( dp->len/BSIZE);
+	dp->com.cdb[9] = 0;
+	dp->com.nbyte = dp->len;
+	dp->com.intr = ihandle;
+	dp->comx.sx_flags = 0;			/* one segment: the region */
+	dp->comx.sx_nseg = 0;
+	dp->comx.sx_seg = 0;
+	dp->comx.sx_resid = 0;
+	dp->state = s;
+	ddxstat.cmd++;
+	kick( dp);
+}
