# Z3660 native ethernet (zen0) -- an EXAMPLE snippet to append to
# /etc/inet/network-config on the box.  The address is the box's own, from
# /etc/default/zen (the file S99zen reads; its header shows the form).
#
# Presence-gated by `zen -S` so a board-less boot (or a degraded firmware) does not
# stall waiting on a non-existent interface.  Edit the file in place (it is hardlinked
# with S69inet/inetinit -- never unlink/recreate it, never leave an S* backup in rc2.d).
#
# ** Use a LITERAL IP, never `uname -n` ** -- on SVR4.0 the name path triggers a DNS
# lookup that stalls boot ~180s when the resolver can't reach a server.  ZEN_ADDR
# in /etc/default/zen is that literal.
#
# The device node must exist on the on-disk root once:  mknod /dev/zen0 c 51 0
#
ZEN_ADDR= ZEN_NETMASK=255.255.255.0
[ -r /etc/default/zen ] && . /etc/default/zen
[ -n "$ZEN_ADDR" ] && /usr/amiga/bin/zen -S && \
    /usr/sbin/slink addaen /dev/zen0 zen0 && \
        /usr/sbin/ifconfig zen0 $ZEN_ADDR netmask $ZEN_NETMASK up -trailers

# Add to /etc/inet/hosts:
#   <address>   <nodename>   <nodename>.<domain>
# Default route (if not already set elsewhere): route add default <gateway> 1
