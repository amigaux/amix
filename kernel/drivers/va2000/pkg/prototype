#
# prototype -- va2000-<line>: the module object, the package's defaults, the
# card file /etc/display.d/va2000 (amix-base display.d(4)), the node of its
# major, the driver's header, the page va2000(7) and its whatis line
# (amix-dlm C3-5 sec 1).  The same paths on both lines: a box carries
# the package of its kernel's line; @PKG@ is the line's instance, va200030
# or va200046.
#
# AUTHORED, NOT GENERATED: build.sh hands it to kmodpkg, which runs pkgmk.
# PURE FILES (amix-dlm spec 40 sec 6): f/d of class none, i pkginfo and
# copyright only, no scripts; and the node of the driver's major as a device
# entry in the module's class, va2000 (C3-5 v18 sec 1.2), which pkginfo's
# CLASSES lists; the class has no action script, so stock pkgadd lays it and
# pkgrm removes it as a none object.  The node is 0660 root sys, as
# z3660rtg's /dev/zz9000: it maps the card's registers and framebuffer, so
# only root and the group sys may open it (the X server runs as root).  /etc, /dev, /usr, /usr/include and /opt are the stock
# core's directories, declared with core's attributes; /etc/conf and below
# and /opt/amix/man are shared by every module package.
#
i pkginfo
i copyright
d none /etc 0755 root root
d none /etc/conf 0755 root sys
d none /etc/conf/mod.d 0755 root sys
d none /etc/conf/modreg.d 0755 root sys
f none /etc/conf/mod.d/va2000 0644 root sys
f none /etc/conf/modreg.d/va2000 0644 root sys
d none /etc/display.d 0755 root sys
f none /etc/display.d/va2000 0444 root sys
d none /dev 0755 bin bin
c va2000 /dev/va2000 68 0 0660 root sys
d none /usr 0755 bin bin
d none /usr/include 0755 bin bin
f none /usr/include/va2000.h 0644 bin bin
d none /opt 0755 root sys
d none /opt/amix 0755 root sys
d none /opt/amix/man 0755 root sys
d none /opt/amix/man/7 0755 root sys
d none /opt/amix/man/whatis.d 0755 root sys
f none /opt/amix/man/7/va2000 0644 root sys
f none /opt/amix/man/whatis.d/@PKG@ 0644 root sys
