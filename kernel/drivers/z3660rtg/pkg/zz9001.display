# /etc/display.d/zz9001 -- an MNT ZZ9000 beside a Z3660: unit 1 (display.d(4))
# It needs x11r63 6.3-10 or later, whose server takes -dev; an older server
# refuses the option and stops before it opens any board.
# The card passes the Amiga picture through its own output and switches it
# back when X ends, so it needs no monitor switch.  1920x1080 works only on
# a Zorro III card: a Zorro II card refuses it and the server stops.
name      MNT ZZ9000 (beside a Z3660)
node      /dev/zz9001
module    z3660rtg
server    /opt/amix/X11R6/bin/Xzz9000
modes     1024x768 640x480 800x600 1280x720 1280x1024 1920x800
depths    16
args      -mode %m -dev /dev/zz9001 -ac -kb
limits    vmem=131072 data=65536
monsw     no
restore   /opt/amix/bin/rtg-kbdback
