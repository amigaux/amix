#
# prototype -- paula-<line>: the module object, the package's defaults, the
# node of its major and the driver's header (amix-dlm C3-5 sec 1).  The same
# paths on both lines: a box carries the package of its kernel's line.
#
# AUTHORED, NOT GENERATED: build.sh runs `pkgmk -r <destroot>`.
# PURE FILES (amix-dlm spec 40 sec 6): f/d of class none, i pkginfo,
# copyright and depend only, no scripts; and the node of the driver's major
# as a device entry in the module's class, paula (C3-5 v18 sec 1.2), which
# pkginfo's CLASSES lists; the class has no action script, so stock pkgadd
# lays it and pkgrm removes it as a none object.  The node is 0660 root
# audio: the group audio may open it, and amix-base, which makes the group,
# is the package's depend.  /etc, /dev, /usr and /usr/include are the stock
# core's directories, declared with core's attributes; /etc/conf and below
# are shared by every module package.
#
i pkginfo
i copyright
i depend
d none /etc 0755 root root
d none /etc/conf 0755 root sys
d none /etc/conf/mod.d 0755 root sys
d none /etc/conf/modreg.d 0755 root sys
f none /etc/conf/mod.d/paula 0644 root sys
f none /etc/conf/modreg.d/paula 0644 root sys
d none /dev 0755 bin bin
c paula /dev/paula 54 0 0660 root audio
d none /usr 0755 bin bin
d none /usr/include 0755 bin bin
f none /usr/include/paula.h 0644 bin bin
