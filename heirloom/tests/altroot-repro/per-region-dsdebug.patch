diff --git a/heirloom/libpkg/dstream.c b/heirloom/libpkg/dstream.c
index b8bc541..4d92061 100644
--- a/heirloom/libpkg/dstream.c
+++ b/heirloom/libpkg/dstream.c
@@ -58,6 +58,34 @@
 #include <pkglibmsgs.h>
 #include "pkglocale.h"
 #include "libadm.h"
+
+/*
+ * AMIX PORT (diagnostic): per-region DS_DEBUG bisection helper.  Caches
+ * the environment on first call (pkginstall main()'s first statement,
+ * before the environ=NULL reset).  DS_DEBUG (any value) enables every
+ * region; DBG_<REGION> enables one.  See pkglib.h for DR_* indices.
+ */
+int
+dsreg(int which)
+{
+	static int	inited;
+	static int	v[7];
+
+	if (!inited) {
+		int all = getenv("DS_DEBUG") ? 1 : 0;
+		inited = 1;
+		v[DR_DS]   = all || (getenv("DBG_DS")   ? 1 : 0);
+		v[DR_ESYS] = all || (getenv("DBG_ESYS") ? 1 : 0);
+		v[DR_MAIN] = all || (getenv("DBG_MAIN") ? 1 : 0);
+		v[DR_MNT]  = all || (getenv("DBG_MNT")  ? 1 : 0);
+		v[DR_LOCK] = all || (getenv("DBG_LOCK") ? 1 : 0);
+		v[DR_MERG] = all || (getenv("DBG_MERG") ? 1 : 0);
+		v[DR_CGR]  = all || (getenv("DBG_CGR")  ? 1 : 0);
+	}
+	if (which < 0 || which > DR_CGR)
+		return (0);
+	return (v[which]);
+}
 #ifdef u3b2
 static
 struct stat	orig_st_buf; /* Stat structure of original file (3B2/CTC) */
@@ -122,7 +150,7 @@ dsdbg(void)
 	static int flag = -1;
 
 	if (flag == -1)
-		flag = (getenv("DS_DEBUG") != NULL) ? 1 : 0;
+		flag = (dsreg(DR_DS)) ? 1 : 0;
 	return (flag);
 }
 
