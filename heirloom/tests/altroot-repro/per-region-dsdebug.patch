diff --git a/heirloom/libpkg/pkglib.h b/heirloom/libpkg/pkglib.h
index c7ed319..12f281d 100644
--- a/heirloom/libpkg/pkglib.h
+++ b/heirloom/libpkg/pkglib.h
@@ -59,6 +59,25 @@ extern "C" {
 #include "keystore.h"
 #include "cfext.h"
 
+/*
+ * AMIX PORT (diagnostic): per-region DS_DEBUG bisection.  The stock
+ * instrumentation is all gated on a single getenv("DS_DEBUG"); to find
+ * WHICH region's mere presence suppresses the -R add_cache crash, each
+ * region is given its own env var (DBG_DS/ESYS/MAIN/MNT/LOCK/MERG/CGR).
+ * DS_DEBUG (any value) still lights every region.  dsreg() caches the
+ * environment on first call -- which happens at pkginstall main()'s
+ * first statement, BEFORE the environ=NULL reset -- so the per-region
+ * flags survive that reset without needing re-injection.
+ */
+#define	DR_DS	0	/* dstream ds_init/ds_scan (front-end) */
+#define	DR_ESYS	1	/* runcmd esystem / pkgexecv spawn */
+#define	DR_MAIN	2	/* pkginstall main + quit */
+#define	DR_MNT	3	/* get_mntinfo (mntinfo.c) */
+#define	DR_LOCK	4	/* lockinst / ocfile / vfpops */
+#define	DR_MERG	5	/* pkgdbmerg / sortmap */
+#define	DR_CGR	6	/* cgrnam family (ncgrpw.c) + averify (verify.c) */
+extern int dsreg(int which);
+
 #ifndef	S_IAMB
 #define	S_IAMB	0x1FF	/* access mode bits */
 #endif
